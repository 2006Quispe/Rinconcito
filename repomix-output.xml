    <aside th:replace="~{fragments/mesero-sidebar
            :: sidebar('nuevo-pedido')}">
    </aside>

    <div class="mesero-pagina">

        <header class="pedido-encabezado">

            <div>
                <p class="pedido-etiqueta">
                    ATENCIÓN EN MESA
                </p>

                <h1>Nuevo pedido presencial</h1>

                <p>
                    Selecciona una mesa ocupada y agrega
                    los productos solicitados por el cliente.
                </p>
            </div>

            <div class="pedido-usuario">

                <i class="bi bi-person-circle"></i>

                <span sec:authentication="name">
                    mesero
                </span>

            </div>

        </header>

        <main class="mesero-contenido">

            <div th:if="${error}"
                 class="alert alert-danger"
                 th:text="${error}">
            </div>

            <form th:action="@{/mesero/pedidos/guardar}"
                  th:object="${pedidoForm}"
                  method="post"
                  class="pedido-formulario"
                  id="pedidoPresencialForm">

                <input type="hidden"
                       th:name="${_csrf.parameterName}"
                       th:value="${_csrf.token}">

                <!-- Conserva la reserva que originó el pedido -->
                <input type="hidden"
                       th:field="*{idReserva}">

                <section class="pedido-seccion">

                    <div class="pedido-seccion-encabezado">

                        <div class="pedido-seccion-icono">
                            <i class="bi bi-grid-3x3-gap"></i>
                        </div>

                        <div>
                            <h2>Mesa de atención</h2>

                            <p>
                                Selecciona la mesa donde se
                                encuentra el cliente.
                            </p>
                        </div>

                    </div>

                    <div class="mesa-seleccion">

                        <label for="idMesa"
                               class="form-label">
                            Mesa ocupada
                            <span class="text-danger">*</span>
                        </label>

                        <select id="idMesa"
                                th:field="*{idMesa}"
                                class="form-select"
                                required>

                            <option value="">
                                Selecciona una mesa
                            </option>

                            <option th:each="mesa : ${mesas}"
                                    th:value="${mesa.idMesa}"
                                    th:text="${mesa.piso != null
                                        ? mesa.piso.nombre
                                            + ' · Mesa '
                                            + mesa.numero
                                            + ' · Capacidad '
                                            + mesa.capacidad
                                        : 'Mesa '
                                            + mesa.numero
                                            + ' · Capacidad '
                                            + mesa.capacidad}">
