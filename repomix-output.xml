<file path="src/main/resources/static/css/mi-cuenta.css">
:root {
    --cuenta-rojo: #8c2f1b;
    --cuenta-dorado: #d4a017;
    --cuenta-verde: #5c6e49;
    --cuenta-texto: #2f2926;
    --cuenta-suave: #746b66;
    --cuenta-borde: #eadfd7;
    --cuenta-fondo: #faf8f5;
    --cuenta-blanco: #ffffff;
}

.cuenta-pagina {
    background-color: var(--cuenta-fondo);
}

.cuenta-encabezado {
    padding: 46px 0;
    color: #ffffff;
    background:
        linear-gradient(
            135deg,
            #8c2f1b,
            #a73c25
        );
}

.cuenta-etiqueta {
    display: block;
    margin-bottom: 6px;
    color: #f2cc68;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.cuenta-encabezado h1 {
    margin: 0 0 7px;
    font-family: "Merriweather", serif;
    font-size: 31px;
}

.cuenta-encabezado p {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
}

.cuenta-contenedor {
    padding-top: 38px;
    padding-bottom: 65px;
}

.perfil-tarjeta,
.cuenta-seccion {
    border: 1px solid var(--cuenta-borde);
    border-radius: 17px;
    background-color: var(--cuenta-blanco);
    box-shadow: 0 7px 24px rgba(59, 42, 34, 0.07);
}

.perfil-tarjeta {
    position: sticky;
    top: 20px;
    padding: 25px;
}

.perfil-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin-bottom: 16px;
    color: #ffffff;
    background-color: var(--cuenta-rojo);
    border-radius: 50%;
    font-size: 31px;
}

.perfil-nombre > span,
.cuenta-seccion-titulo > div > span {
    display: block;
    margin-bottom: 4px;
    color: var(--cuenta-rojo);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

.perfil-nombre h2 {
    margin: 0 0 5px;
    font-size: 21px;
    font-weight: 800;
}

.perfil-nombre p {
    margin: 0;
    color: var(--cuenta-suave);
    overflow-wrap: anywhere;
}

.perfil-datos {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--cuenta-borde);
}

.perfil-dato {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 17px;
}

.perfil-dato i {
    color: var(--cuenta-rojo);
    font-size: 18px;
}

.perfil-dato span,
.operacion-informacion span {
    display: block;
    color: var(--cuenta-suave);
    font-size: 12px;
}

.perfil-dato strong {
    display: block;
    font-size: 14px;
    overflow-wrap: anywhere;
}

.perfil-resumen {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 9px;
}

.perfil-resumen div {
    padding: 14px;
    text-align: center;
    background-color: #f7f1eb;
    border-radius: 11px;
}

.perfil-resumen strong {
    display: block;
    color: var(--cuenta-rojo);
    font-size: 22px;
}

.perfil-resumen span {
    color: var(--cuenta-suave);
    font-size: 12px;
}

.cuenta-seccion {
    margin-bottom: 24px;
    padding: 23px;
}

.cuenta-seccion-titulo {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 19px;
}

.cuenta-seccion-titulo h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
}

.cuenta-enlace {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--cuenta-rojo);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
}

.cuenta-vacio {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 19px;
    color: var(--cuenta-suave);
    background-color: #faf7f3;
    border: 1px dashed #d9c9be;
    border-radius: 12px;
}

.cuenta-vacio > i {
    color: var(--cuenta-rojo);
    font-size: 25px;
}

.cuenta-vacio strong {
    display: block;
    color: var(--cuenta-texto);
}

.cuenta-vacio p {
    margin: 2px 0 0;
    font-size: 13px;
}

.operacion-tarjeta {
    display: grid;
    grid-template-columns:
        minmax(180px, 1.4fr)
        minmax(160px, 1fr)
        auto;
    gap: 17px;
    align-items: center;
    margin-bottom: 13px;
    padding: 17px;
    border: 1px solid var(--cuenta-borde);
    border-radius: 13px;
}

.operacion-principal {
    display: flex;
    align-items: center;
    gap: 12px;
}

.operacion-icono {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    font-size: 20px;
}

.pedido-icono {
    color: var(--cuenta-rojo);
    background-color: #f9e9e4;
}

.reserva-icono {
    color: var(--cuenta-verde);
    background-color: #ebf0e7;
}

.operacion-tipo {
    color: var(--cuenta-suave);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

.operacion-principal h3 {
    margin: 1px 0;
    font-size: 15px;
    font-weight: 800;
}

.operacion-principal p {
    margin: 0;
    color: var(--cuenta-suave);
    font-size: 12px;
}

.operacion-informacion {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
}

.operacion-informacion strong {
    font-size: 13px;
}

.operacion-estado {
    text-align: right;
}

.operacion-acciones {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 9px;
    padding-top: 13px;
    border-top: 1px solid var(--cuenta-borde);
}

.estado-badge {
    display: inline-flex;
    padding: 6px 10px;
    color: #615b57;
    background-color: #eeeae7;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.estado-pendiente_pago {
    color: #855d00;
    background-color: #fff1c6;
}

.estado-pendiente_validacion {
    color: #7d5200;
    background-color: #ffe5aa;
}

.estado-confirmado,
.estado-confirmada {
    color: #276037;
    background-color: #dff1e3;
}

.estado-finalizado,
.estado-finalizada {
    color: #355877;
    background-color: #e0edf8;
}

.estado-cancelado,
.estado-cancelada {
    color: #8b2f2f;
    background-color: #f8dddd;
}

.btn-operacion-principal,
.btn-operacion-secundario {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
}

.btn-operacion-principal {
    color: #3b2a22;
    background-color: var(--cuenta-dorado);
}

.btn-operacion-secundario {
    color: var(--cuenta-rojo);
    border: 1px solid #d9b8ad;
    background-color: #ffffff;
}

.historial-bloque + .historial-bloque {
    margin-top: 26px;
}

.historial-bloque h3 {
    margin-bottom: 13px;
    font-size: 15px;
    font-weight: 800;
}

.historial-bloque h3 i {
    margin-right: 6px;
    color: var(--cuenta-rojo);
}

.historial-vacio {
    padding: 15px;
    color: var(--cuenta-suave);
    background-color: #faf7f3;
    border-radius: 9px;
    font-size: 13px;
}

.historial-tabla {
    margin: 0;
    font-size: 13px;
}

.historial-tabla th {
    color: var(--cuenta-suave);
    font-size: 11px;
    text-transform: uppercase;
}

.historial-tabla td {
    vertical-align: middle;
}

.historial-ver {
    color: var(--cuenta-rojo);
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
}

@media (max-width: 991.98px) {
    .perfil-tarjeta {
        position: static;
    }

    .operacion-tarjeta {
        grid-template-columns: 1fr 1fr;
    }

    .operacion-estado {
        text-align: left;
    }
}

@media (max-width: 575.98px) {
    .cuenta-encabezado {
        padding: 34px 0;
    }

    .cuenta-encabezado h1 {
        font-size: 25px;
    }

    .cuenta-contenedor {
        padding-top: 25px;
    }

    .cuenta-seccion,
    .perfil-tarjeta {
        padding: 18px;
    }

    .cuenta-seccion-titulo {
        align-items: flex-start;
        flex-direction: column;
    }

    .operacion-tarjeta {
        grid-template-columns: 1fr;
    }

    .operacion-acciones {
        flex-direction: column;
    }

    .btn-operacion-principal,
    .btn-operacion-secundario {
        width: 100%;
    }
	
	/* Ajustes compactos de Mi cuenta */

	.cuenta-contenedor {
	    padding-top: 28px;
	}

	.perfil-nombre h2 {
	    font-size: 18px;
	}

	.perfil-nombre p {
	    font-size: 13px;
	}

	.cuenta-seccion-titulo h2 {
	    font-size: 19px;
	}

	.cuenta-seccion-titulo > div > span,
	.perfil-nombre > span {
	    font-size: 10px;
	}

	.operacion-principal h3 {
	    font-size: 14px;
	}

	.operacion-principal p,
	.operacion-informacion strong {
	    font-size: 12px;
	}

	.perfil-dato strong {
	    font-size: 13px;
	}

	.perfil-resumen strong {
	    font-size: 19px;
	}

	.cuenta-vacio strong {
	    font-size: 14px;
	}

	.cuenta-vacio p {
	    font-size: 12px;
	}
}
</file>

<file path="src/main/resources/static/css/notas-venta.css">
/* =========================================================
   NOTAS DE VENTA
   Utiliza el panel lateral principal definido en caja.css
   ========================================================= */

.notas-principal {
    min-width: 0;
}

.notas-encabezado {
    align-items: flex-start;
}

.notas-volver {
    display: inline-flex;
    min-height: 43px;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--caja-borde);
    border-radius: 11px;
    background-color: var(--caja-blanco);
    color: var(--caja-texto);
    font-family: "Nunito", sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(59, 42, 34, 0.05);
    transition:
        border-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}

.notas-volver:hover {
    border-color: var(--caja-rojo);
    color: var(--caja-rojo);
    transform: translateY(-1px);
}


/* =========================================================
   TARJETAS DE RESUMEN
   ========================================================= */

.notas-resumen {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 28px;
}

.nota-resumen-card {
    display: flex;
    min-width: 0;
    min-height: 110px;
    align-items: center;
    gap: 15px;
    padding: 20px;
    border: 1px solid var(--caja-borde);
    border-radius: 15px;
    background-color: var(--caja-blanco);
    box-shadow: 0 7px 20px rgba(59, 42, 34, 0.05);
}

.nota-resumen-icono {
    display: grid;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 13px;
    font-size: 21px;
}

.resumen-total {
    background-color: #fff0e4;
    color: #c26124;
}

.resumen-emitidas {
    background-color: var(--caja-verde-claro);
    color: var(--caja-verde);
}

.resumen-anuladas {
    background-color: var(--caja-rojo-claro);
    color: #c74835;
}

.resumen-ventas {
    background-color: #fff4cc;
    color: #a77400;
}

.nota-resumen-card span {
    display: block;
    overflow: hidden;
    margin-bottom: 3px;
    color: var(--caja-texto-suave);
    font-size: 11px;
    font-weight: 800;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.nota-resumen-card strong {
    display: block;
    color: var(--caja-texto);
    font-size: 25px;
    font-weight: 800;
    line-height: 1.15;
}


/* =========================================================
   PANEL DEL HISTORIAL
   ========================================================= */

.notas-panel {
    overflow: hidden;
    border: 1px solid var(--caja-borde);
    border-radius: 17px;
    background-color: var(--caja-blanco);
    box-shadow: var(--caja-sombra);
}

.notas-panel-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 23px 25px;
    border-bottom: 1px solid var(--caja-borde);
}

.notas-panel-cabecera h2 {
    margin: 0;
    color: var(--caja-texto);
    font-size: 18px;
    font-weight: 800;
}

.notas-panel-cabecera p {
    margin: 5px 0 0;
    color: var(--caja-texto-suave);
    font-size: 12px;
}


/* =========================================================
   BUSCADOR
   ========================================================= */

.notas-buscador {
    display: flex;
    align-items: center;
    gap: 9px;
}

.notas-campo-busqueda {
    position: relative;
}

.notas-campo-busqueda > i {
    position: absolute;
    top: 50%;
    left: 14px;
    color: #a09289;
    font-size: 15px;
    transform: translateY(-50%);
}

.notas-campo-busqueda input {
    width: 325px;
    height: 43px;
    padding: 0 15px 0 41px;
    border: 1px solid var(--caja-borde);
    border-radius: 10px;
    background-color: var(--caja-blanco);
    color: var(--caja-texto);
    font-family: "Nunito", sans-serif;
    font-size: 13px;
    outline: none;
}

.notas-campo-busqueda input:focus {
    border-color: var(--caja-rojo);
    box-shadow: 0 0 0 3px rgba(140, 47, 27, 0.08);
}

.notas-buscador button {
    height: 43px;
    padding: 0 20px;
    border: 0;
    border-radius: 10px;
    background-color: var(--caja-rojo);
    color: var(--caja-blanco);
    font-family: "Nunito", sans-serif;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.notas-buscador button:hover {
    background-color: var(--caja-rojo-oscuro);
}

.notas-limpiar {
    display: grid;
    flex: 0 0 43px;
    width: 43px;
    height: 43px;
    place-items: center;
    border: 1px solid var(--caja-borde);
    border-radius: 10px;
    color: var(--caja-texto-suave);
    text-decoration: none;
}

.notas-limpiar:hover {
    border-color: var(--caja-rojo);
    color: var(--caja-rojo);
}


/* =========================================================
   TABLA
   ========================================================= */

.notas-tabla-contenedor {
    overflow-x: auto;
}

.notas-tabla {
    width: 100%;
    min-width: 1050px;
    border-collapse: collapse;
}

.notas-tabla thead {
    background-color: #f7f0e6;
}

.notas-tabla th {
    padding: 14px 17px;
    color: #65534a;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
}

.notas-tabla td {
    padding: 17px;
    border-bottom: 1px solid #eee6df;
    color: var(--caja-texto);
    font-size: 12px;
    vertical-align: middle;
}

.notas-tabla tbody tr {
    transition: background-color 0.2s ease;
}

.notas-tabla tbody tr:hover {
    background-color: #fdfaf6;
}

.notas-tabla tbody tr:last-child td {
    border-bottom: 0;
}

.nota-numero {
    color: var(--caja-rojo);
    font-size: 12px;
    white-space: nowrap;
}

.nota-pedido,
.nota-fecha,
.nota-monto {
    white-space: nowrap;
}

.nota-cliente strong,
.nota-cliente span {
    display: block;
}

.nota-cliente strong {
    margin-bottom: 3px;
    font-size: 12px;
}

.nota-cliente span {
    color: var(--caja-texto-suave);
    font-size: 10px;
}

.nota-metodo {
    display: inline-flex;
    padding: 5px 9px;
    border-radius: 7px;
    background-color: var(--caja-azul-claro);
    color: var(--caja-azul);
    font-size: 10px;
    font-weight: 800;
}

.nota-estado {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 9px;
    border-radius: 20px;
    font-size: 9px;
    font-weight: 800;
    white-space: nowrap;
}

.nota-emitida {
    background-color: var(--caja-verde-claro);
    color: var(--caja-verde);
}

.nota-anulada {
    background-color: var(--caja-rojo-claro);
    color: #bd3d2d;
}


/* =========================================================
   ACCIONES
   ========================================================= */

.nota-acciones {
    display: flex;
    align-items: center;
    gap: 7px;
}

.nota-accion {
    display: grid;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 8px;
    font-size: 14px;
    text-decoration: none;
    transition:
        color 0.2s ease,
        background-color 0.2s ease,
        transform 0.2s ease;
}

.nota-accion:hover {
    color: var(--caja-blanco);
    transform: translateY(-2px);
}

.nota-ver {
    background-color: #fff0e4;
    color: #b85620;
}

.nota-ver:hover {
    background-color: #b85620;
}

.nota-descargar {
    background-color: var(--caja-verde-claro);
    color: var(--caja-verde);
}

.nota-descargar:hover {
    background-color: var(--caja-verde);
}

.nota-imprimir {
    background-color: #edf3ff;
    color: #3d6cac;
}

.nota-imprimir:hover {
    background-color: #3d6cac;
}


/* =========================================================
   ESTADO VACÍO
   ========================================================= */

.notas-vacio {
    padding: 65px 20px;
    text-align: center;
}

.notas-vacio-icono {
    display: grid;
    width: 62px;
    height: 62px;
    margin: 0 auto 16px;
    place-items: center;
    border-radius: 17px;
    background-color: #f7f0e6;
    color: var(--caja-rojo);
    font-size: 26px;
}

.notas-vacio h3 {
    margin: 0 0 7px;
    color: var(--caja-texto);
    font-size: 17px;
    font-weight: 800;
}

.notas-vacio p {
    max-width: 480px;
    margin: auto;
    color: var(--caja-texto-suave);
    font-size: 12px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {
    .notas-resumen {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .notas-panel-cabecera {
        align-items: stretch;
        flex-direction: column;
    }

    .notas-buscador {
        width: 100%;
    }

    .notas-campo-busqueda {
        flex: 1;
    }

    .notas-campo-busqueda input {
        width: 100%;
    }
}

@media (max-width: 767px) {
    .notas-resumen {
        grid-template-columns: 1fr;
    }

    .notas-buscador {
        align-items: stretch;
        flex-direction: column;
    }

    .notas-buscador button,
    .notas-limpiar {
        width: 100%;
    }

    .notas-limpiar {
        flex-basis: 43px;
    }
}
</file>

<file path="src/main/resources/static/css/pago-pedido.css">
/*
   PÁGINA DE PAGO
*/

:root {
    --rojo: #8c2f1b;
    --rojo-oscuro: #682114;
    --dorado: #d4a017;
    --dorado-claro: #f7edcf;
    --crema: #f8f3ea;
    --blanco: #ffffff;
    --texto: #3b2a22;
    --texto-suave: #76665d;
    --borde: #e6ddd2;
    --verde: #2f7d4a;
    --verde-claro: #eaf6ee;
    --azul-claro: #edf6fb;
    --rojo-claro: #fff0ed;
    --sombra: 0 12px 35px rgba(66, 44, 31, 0.09);
}

* {
    box-sizing: border-box;
}

.pagina-pago {
    min-height: 75vh;
    padding: 45px 0 70px;
    background-color: var(--crema);
    color: var(--texto);
    font-family: "Nunito", sans-serif;
}

.pago-contenido {
    max-width: 1180px;
}


/* =========================================================
   ENCABEZADO
   ========================================================= */

.encabezado-pagina {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 28px;
}

.encabezado-pagina > div:first-child > span {
    display: block;
    margin-bottom: 3px;
    color: var(--rojo);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.1px;
    text-transform: uppercase;
}

.encabezado-pagina h1 {
    margin: 0;
    color: var(--texto);
    font-family: "Merriweather", serif;
    font-size: clamp(29px, 4vw, 42px);
    font-weight: 700;
}

.codigo-pedido {
    min-width: 225px;
    padding: 13px 18px;
    border: 1px solid var(--borde);
    border-radius: 13px;
    background: var(--blanco);
    text-align: right;
    box-shadow: 0 5px 18px rgba(66, 44, 31, 0.05);
}

.codigo-pedido span {
    display: block;
    margin-bottom: 3px;
    color: var(--texto-suave);
    font-size: 12px;
}

.codigo-pedido strong {
    color: var(--rojo);
    font-size: 16px;
    font-weight: 800;
}


/* =========================================================
   PANELES
   ========================================================= */

.panel {
    padding: 28px;
    border: 1px solid var(--borde);
    border-radius: 19px;
    background-color: var(--blanco);
    box-shadow: var(--sombra);
}

.titulo-panel {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 24px;
}

.titulo-icono {
    display: grid;
    flex: 0 0 45px;
    width: 45px;
    height: 45px;
    place-items: center;
    border-radius: 13px;
    background-color: var(--dorado-claro);
    color: var(--rojo);
    font-size: 20px;
}

.titulo-panel span {
    display: block;
    margin-bottom: 2px;
    color: var(--rojo);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.titulo-panel h2 {
    margin: 0;
    color: var(--texto);
    font-family: "Merriweather", serif;
    font-size: 22px;
}


/*
   SELECCIÓN DE MÉTODO
*/

.radio-metodo {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
}

.selector-metodos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 22px;
}

.opcion-metodo {
    display: block;
    min-width: 0;
    cursor: pointer;
}

.opcion-contenido {
    position: relative;
    display: flex;
    min-height: 94px;
    align-items: center;
    gap: 11px;
    padding: 15px 13px;
    overflow: hidden;
    border: 2px solid var(--borde);
    border-radius: 15px;
    background-color: var(--blanco);
    transition:
        border-color 0.2s ease,
        background-color 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.opcion-metodo:hover .opcion-contenido {
    border-color: #c9b9aa;
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(66, 44, 31, 0.08);
}

.metodo-logo {
    display: grid;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    color: var(--blanco);
    font-size: 19px;
    font-weight: 800;
}

.logo-yape {
    background: linear-gradient(135deg, #742284, #9b35ae);
}

.logo-plin {
    background: linear-gradient(135deg, #04a5b2, #24c2c7);
}

.logo-banco {
    background: linear-gradient(135deg, var(--rojo), #b44c32);
}

.opcion-texto {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
}

.opcion-texto strong {
    color: var(--texto);
    font-size: 15px;
    font-weight: 800;
}

.opcion-texto small {
    color: var(--texto-suave);
    font-size: 11px;
    line-height: 1.3;
}

.seleccion-check {
    position: absolute;
    top: 8px;
    right: 8px;
    color: var(--rojo);
    font-size: 17px;
    opacity: 0;
    transition: opacity 0.2s ease;
}


/* =========================================================
   DATOS DEL MÉTODO
   ========================================================= */

.datos-yape,
.datos-plin,
.datos-transferencia,
.evidencia-pago {
    display: none;
}

.datos-metodo {
    margin-top: 18px;
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: 16px;
    background-color: #fffdfa;
}

.datos-metodo-cabecera {
    padding: 17px 20px;
    border-bottom: 1px solid var(--borde);
    background-color: #fbf7f0;
}

.datos-metodo-cabecera > div {
    display: flex;
    align-items: center;
    gap: 12px;
}

.datos-metodo-cabecera span:not(.metodo-logo) {
    display: block;
    color: var(--texto-suave);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.7px;
    text-transform: uppercase;
}

.datos-metodo-cabecera h3 {
    margin: 2px 0 0;
    color: var(--texto);
    font-family: "Merriweather", serif;
    font-size: 19px;
}

.datos-metodo-contenido {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 165px;
    gap: 22px;
    align-items: center;
    padding: 21px;
}

.datos-cuenta {
    display: grid;
    gap: 12px;
}

.dato-cuenta {
    padding: 13px 15px;
    border: 1px solid var(--borde);
    border-radius: 11px;
    background-color: var(--blanco);
}

.dato-cuenta span {
    display: block;
    margin-bottom: 3px;
    color: var(--texto-suave);
    font-size: 12px;
}

.dato-cuenta strong {
    display: block;
    overflow-wrap: anywhere;
    color: var(--texto);
    font-size: 15px;
}

.monto-pagar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 14px 16px;
    border-radius: 11px;
    background-color: var(--dorado-claro);
}

.monto-pagar span {
    color: var(--texto-suave);
    font-size: 13px;
    font-weight: 700;
}

.monto-pagar strong {
    color: var(--rojo);
    font-size: 21px;
    font-weight: 800;
}

.qr-pago {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 9px;
    text-align: center;
}

.qr-pago img {
    display: block;
    width: 145px;
    height: 145px;
    padding: 5px;
    border: 1px solid var(--borde);
    border-radius: 12px;
    background-color: var(--blanco);
    object-fit: contain;
}

.qr-pago span {
    color: var(--texto-suave);
    font-size: 11px;
}


/* =========================================================
   TRANSFERENCIA
   ========================================================= */

.transferencia-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 20px 20px 12px;
}

.transferencia-monto {
    margin: 0 20px 20px;
}


/* =========================================================
   SELECCIÓN SIN JAVASCRIPT
   ========================================================= */

#metodoYape:checked ~ .datos-yape {
    display: block;
}

#metodoPlin:checked ~ .datos-plin {
    display: block;
}

#metodoTransferencia:checked ~ .datos-transferencia {
    display: block;
}

#metodoYape:checked
    ~ .selector-metodos
    label[for="metodoYape"]
    .opcion-contenido,
#metodoPlin:checked
    ~ .selector-metodos
    label[for="metodoPlin"]
    .opcion-contenido,
#metodoTransferencia:checked
    ~ .selector-metodos
    label[for="metodoTransferencia"]
    .opcion-contenido {
    border-color: var(--rojo);
    background-color: #fff5f1;
    box-shadow: 0 7px 18px rgba(158, 50, 31, 0.12);
}

#metodoYape:checked
    ~ .selector-metodos
    label[for="metodoYape"]
    .seleccion-check,
#metodoPlin:checked
    ~ .selector-metodos
    label[for="metodoPlin"]
    .seleccion-check,
#metodoTransferencia:checked
    ~ .selector-metodos
    label[for="metodoTransferencia"]
    .seleccion-check {
    opacity: 1;
}

#metodoYape:checked ~ .evidencia-pago,
#metodoPlin:checked ~ .evidencia-pago,
#metodoTransferencia:checked ~ .evidencia-pago {
    display: block;
    margin-top: 25px;
    padding-top: 25px;
    border-top: 1px solid var(--borde);
    animation: mostrarPago 0.25s ease;
}

#metodoYape:checked ~ .datos-yape,
#metodoPlin:checked ~ .datos-plin,
#metodoTransferencia:checked ~ .datos-transferencia {
    animation: mostrarPago 0.25s ease;
}

@keyframes mostrarPago {
    from {
        opacity: 0;
        transform: translateY(-6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* =========================================================
   FORMULARIO DEL COMPROBANTE
   ========================================================= */

.evidencia-pago .titulo-panel {
    margin-bottom: 20px;
}

.campo-formulario {
    margin-bottom: 18px;
}

.campo-formulario > label:first-child {
    display: block;
    margin-bottom: 7px;
    color: var(--texto);
    font-size: 13px;
    font-weight: 800;
}

.campo-formulario > label:first-child span {
    color: var(--rojo);
}

.campo-formulario em {
    color: var(--texto-suave);
    font-size: 12px;
    font-weight: 600;
}

.zona-archivo {
    display: flex;
    min-height: 145px;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding: 22px;
    border: 2px dashed #cebbaa;
    border-radius: 14px;
    background-color: #fffcf8;
    cursor: pointer;
    text-align: center;
    transition:
        border-color 0.2s ease,
        background-color 0.2s ease;
}

.zona-archivo:hover {
    border-color: var(--rojo);
    background-color: #fff7f3;
}

.zona-archivo i {
    margin-bottom: 7px;
    color: var(--rojo);
    font-size: 30px;
}

.zona-archivo strong {
    color: var(--texto);
    font-size: 14px;
}

.zona-archivo span {
    margin-top: 3px;
    color: var(--texto-suave);
    font-size: 12px;
}

.zona-archivo input[type="file"] {
    width: 100%;
    margin-top: 13px;
    color: var(--texto-suave);
    font-size: 12px;
}

.zona-archivo input[type="file"]::file-selector-button {
    margin-right: 10px;
    padding: 8px 13px;
    border: 0;
    border-radius: 8px;
    background-color: var(--rojo);
    color: var(--blanco);
    font-weight: 700;
    cursor: pointer;
}

.campo-formulario > input[type="text"] {
    width: 100%;
    height: 47px;
    padding: 0 14px;
    border: 1px solid var(--borde);
    border-radius: 11px;
    outline: none;
    background-color: var(--blanco);
    color: var(--texto);
    font-family: "Nunito", sans-serif;
    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.campo-formulario > input[type="text"]:focus {
    border-color: var(--rojo);
    box-shadow: 0 0 0 3px rgba(140, 47, 27, 0.11);
}

.boton-enviar,
.boton-principal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    border-radius: 11px;
    background-color: var(--rojo);
    color: var(--blanco);
    font-weight: 800;
    text-decoration: none;
    transition:
        background-color 0.2s ease,
        transform 0.2s ease;
}

.boton-enviar {
    width: 100%;
    min-height: 49px;
    padding: 12px 20px;
    font-size: 15px;
}

.boton-principal {
    min-height: 45px;
    padding: 11px 20px;
}

.boton-enviar:hover,
.boton-principal:hover {
    background-color: var(--rojo-oscuro);
    color: var(--blanco);
    transform: translateY(-1px);
}

.aviso-validacion {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 15px;
    padding: 12px 14px;
    border-radius: 10px;
    background-color: var(--azul-claro);
    color: #365766;
    font-size: 12px;
    line-height: 1.45;
}

.aviso-validacion i {
    margin-top: 1px;
    color: #39758e;
    font-size: 16px;
}


/* =========================================================
   RESUMEN DEL PEDIDO
   ========================================================= */

.resumen-pedido {
    position: sticky;
    top: 25px;
}

.estado-resumen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
    padding: 11px 13px;
    border-radius: 10px;
    background-color: #fbf5e6;
}

.estado-resumen span {
    color: var(--texto-suave);
    font-size: 12px;
}

.estado-resumen strong {
    color: var(--rojo);
    font-size: 11px;
    font-weight: 800;
}

.lista-productos {
    margin-bottom: 18px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--borde);
}

.producto-resumen {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    padding: 11px 0;
}

.producto-resumen > div {
    min-width: 0;
}

.producto-resumen > div strong {
    display: block;
    color: var(--texto);
    font-size: 14px;
}

.producto-resumen > div span {
    display: block;
    margin-top: 2px;
    color: var(--texto-suave);
    font-size: 12px;
}

.producto-resumen > strong {
    flex: 0 0 auto;
    color: var(--texto);
    font-size: 14px;
}

.resumen-linea,
.resumen-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.resumen-linea {
    margin-bottom: 11px;
    color: var(--texto-suave);
    font-size: 14px;
}

.resumen-linea strong {
    color: var(--texto);
}

.resumen-total {
    margin-top: 16px;
    padding-top: 17px;
    border-top: 2px solid var(--texto);
}

.resumen-total span {
    color: var(--texto);
    font-weight: 800;
}

.resumen-total strong {
    color: var(--rojo);
    font-size: 23px;
    font-weight: 800;
}

.delivery-aviso {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 18px;
    padding: 13px;
    border-radius: 11px;
    background-color: var(--dorado-claro);
    color: #665628;
    font-size: 12px;
    line-height: 1.45;
}

.delivery-aviso i {
    flex: 0 0 auto;
    margin-top: 1px;
    color: var(--rojo);
    font-size: 17px;
}

.enlaces-pago {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 18px;
}

.enlaces-pago a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--rojo);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
}

.enlaces-pago a:hover {
    color: var(--rojo-oscuro);
    text-decoration: underline;
}


/* =========================================================
   MENSAJES
   ========================================================= */

.mensaje {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    padding: 13px 16px;
    border: 1px solid transparent;
    border-radius: 11px;
    font-size: 14px;
    font-weight: 700;
}

.mensaje-exito {
    border-color: #b7ddc2;
    background-color: var(--verde-claro);
    color: var(--verde);
}

.mensaje-error {
    border-color: #efc1b9;
    background-color: var(--rojo-claro);
    color: #a13423;
}

.mensaje-info {
    border-color: #bddbe8;
    background-color: var(--azul-claro);
    color: #32677e;
}


/* =========================================================
   ESTADOS DEL PEDIDO
   ========================================================= */

.estado-panel,
.pedido-no-encontrado {
    padding: 45px 30px;
    text-align: center;
}

.pedido-no-encontrado {
    max-width: 600px;
    margin: 50px auto;
}

.estado-icono {
    display: grid;
    width: 75px;
    height: 75px;
    margin: 0 auto 18px;
    place-items: center;
    border-radius: 50%;
    background-color: var(--dorado-claro);
    color: var(--rojo);
    font-size: 34px;
}

.estado-revision {
    background-color: #fff2d3;
    color: #a66a00;
}

.estado-confirmado {
    background-color: var(--verde-claro);
    color: var(--verde);
}

.estado-panel h2,
.pedido-no-encontrado h1 {
    margin: 0 0 10px;
    color: var(--texto);
    font-family: "Merriweather", serif;
}

.estado-panel p,
.pedido-no-encontrado p {
    max-width: 470px;
    margin: 0 auto 22px;
    color: var(--texto-suave);
    line-height: 1.6;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 991px) {
    .resumen-pedido {
        position: static;
    }
}

@media (max-width: 767px) {
    .pagina-pago {
        padding: 28px 0 50px;
    }

    .encabezado-pagina {
        align-items: stretch;
        flex-direction: column;
    }

    .codigo-pedido {
        width: 100%;
        text-align: left;
    }

    .panel {
        padding: 20px;
        border-radius: 15px;
    }

    .selector-metodos {
        grid-template-columns: 1fr;
    }

    .opcion-contenido {
        min-height: 75px;
    }

    .datos-metodo-contenido {
        grid-template-columns: 1fr;
    }

    .transferencia-grid {
        grid-template-columns: 1fr;
    }

    .qr-pago img {
        width: 165px;
        height: 165px;
    }

    .enlaces-pago {
        align-items: flex-start;
        flex-direction: column;
        gap: 10px;
    }
}

@media (max-width: 480px) {
    .pago-contenido {
        padding-right: 13px;
        padding-left: 13px;
    }

    .encabezado-pagina h1 {
        font-size: 28px;
    }

    .panel {
        padding: 17px;
    }

    .titulo-panel h2 {
        font-size: 19px;
    }

    .datos-metodo-contenido,
    .transferencia-grid {
        padding: 15px;
    }

    .transferencia-monto {
        margin: 0 15px 15px;
    }

    .monto-pagar strong {
        font-size: 18px;
    }
}
