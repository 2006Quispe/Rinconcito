                    "btnGuardarPedido"
                );

            boton.disabled = true;

            boton.innerHTML =
                '<span class="spinner-border '
                + 'spinner-border-sm me-2"></span>'
                + 'Registrando...';
        }
    );
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/mesero/pedidos.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Pedidos activos
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap"
          rel="stylesheet">
    <link th:href="@{/css/mesero-pedidos.css}"
          rel="stylesheet">
    <link th:href="@{/css/mesero-pedidosact.css}"
          rel="stylesheet">
</head>

<body class="mesero-body">

<div class="mesero-layout">

    <aside th:replace="~{fragments/mesero-sidebar
        :: sidebar('pedidos')}">
    </aside>

    <div class="mesero-pagina">

        <header class="pedidos-encabezado">

            <div>

                <p class="pedidos-etiqueta">
                    ATENCIÓN EN MESA
                </p>

                <h1>Pedidos activos</h1>

                <p>
                    Consulta los pedidos presenciales que están
                    siendo atendidos o esperando el cobro.
                </p>

            </div>

            <a th:href="@{/mesero/pedidos/nuevo}"
               class="btn-nuevo-pedido">

                <i class="bi bi-plus-circle"></i>
                Nuevo pedido
            </a>

        </header>

        <main class="mesero-contenido">

            <div th:if="${exito}"
                 class="alert alert-success"
                 th:text="${exito}">
            </div>

            <div th:if="${error}"
                 class="alert alert-danger"
                 th:text="${error}">
            </div>

            <section class="pedidos-resumen">

                <div class="pedidos-resumen-texto">

                    <i class="bi bi-receipt-cutoff"></i>

                    <div>
                        <strong>Pedidos presenciales</strong>

                        <span>
                            Pedidos registrados en las mesas
                            del restaurante.
                        </span>
                    </div>

                </div>

                <span class="pedidos-resumen-total"
                      th:text="${#lists.size(pedidos)
                        + (#lists.size(pedidos) == 1
                            ? ' pedido'
                            : ' pedidos')}">
                    0 pedidos
                </span>

            </section>

            <section th:if="${#lists.isEmpty(pedidos)}"
                     class="pedidos-vacio">

                <i class="bi bi-journal-check"></i>

                <h2>No hay pedidos activos</h2>

                <p>
                    Los pedidos registrados por el mesero
                    aparecerán en esta sección.
                </p>

                <a th:href="@{/mesero/pedidos/nuevo}"
                   class="btn-nuevo-pedido">

                    <i class="bi bi-plus-circle"></i>
                    Registrar pedido
                </a>

            </section>

            <section th:unless="${#lists.isEmpty(pedidos)}"
                     class="pedidos-grid">

                <article th:each="pedido : ${pedidos}"
                         class="pedido-activo"
                         th:classappend="${pedido.estado.name()
                            == 'PENDIENTE_PAGO'}
                            ? ' pedido-activo-cobro'
                            : ''">

                    <header class="pedido-activo-cabecera">

                        <div>

                            <span class="pedido-mesa-etiqueta">
                                Mesa
                            </span>

                            <strong class="pedido-mesa-numero"
                                    th:text="${pedido.mesa != null
                                        ? pedido.mesa.numero
                                        : '—'}">
                                1
                            </strong>

                        </div>

                        <span th:if="${pedido.estado.name()
                                == 'CONFIRMADO'}"
                              class="pedido-estado
                                     pedido-estado-confirmado">

                            <i class="bi bi-check-circle"></i>
                            En atención
                        </span>

                        <span th:if="${pedido.estado.name()
                                == 'PENDIENTE_PAGO'}"
                              class="pedido-estado
                                     pedido-estado-cobro">

                            <i class="bi bi-hourglass-split"></i>
                            Esperando Caja
                        </span>

                        <span th:if="${pedido.estado.name()
                                == 'PENDIENTE_VALIDACION'}"
                              class="pedido-estado
                                     pedido-estado-validacion">

                            <i class="bi bi-clock-history"></i>
                            En validación
                        </span>

                        <span th:if="${pedido.estado.name()
                                != 'CONFIRMADO'
                                and pedido.estado.name()
                                != 'PENDIENTE_PAGO'
                                and pedido.estado.name()
                                != 'PENDIENTE_VALIDACION'}"
                              class="pedido-estado">

                            <i class="bi bi-info-circle"></i>

                            <span th:text="${pedido.estado}">
                                ESTADO
                            </span>
                        </span>

                    </header>

                    <div class="pedido-activo-informacion">

                        <div class="pedido-dato">

                            <span>Pedido:</span>

                            <strong th:text="${pedido.codigoPedido}">
                                PED-2026-000001
                            </strong>

                        </div>

                        <div class="pedido-dato">

                            <span>Piso:</span>

                            <strong th:text="${pedido.mesa != null
                                and pedido.mesa.piso != null
                                ? pedido.mesa.piso.nombre
                                : '—'}">
                                Piso 1
                            </strong>

                        </div>

                        <div class="pedido-dato">

                            <span>Registrado:</span>

                            <strong th:text="${pedido.fechaRegistro != null
                                ? #temporals.format(
                                    pedido.fechaRegistro,
                                    'dd/MM/yyyy HH:mm'
                                  )
                                : '—'}">
                                10/10/2026 10:00
                            </strong>

                        </div>

                        <div class="pedido-dato">

                            <span>Mesero:</span>

                            <strong th:if="${pedido.mesero != null}"
                                    th:text="${pedido.mesero.nombres
                                        + ' '
                                        + pedido.mesero.apellidos}">
                                Mesero
                            </strong>

                            <strong th:unless="${pedido.mesero != null}">
                                —
                            </strong>

                        </div>

                    </div>

                    <section class="pedido-productos"
                             th:with="detalles=${detallesPorPedido[
                                pedido.idPedido
                             ]}">

                        <h3>

                            <i class="bi bi-card-list"></i>
                            Productos
                        </h3>

                        <p th:if="${detalles == null
                            or #lists.isEmpty(detalles)}"
                           class="pedido-sin-detalles">

                            No hay productos registrados.
                        </p>

                        <ul th:unless="${detalles == null
                            or #lists.isEmpty(detalles)}">

                            <li th:each="detalle : ${detalles}">

                                <span class="producto-cantidad-lista"
                                      th:text="${detalle.cantidad
                                        + 'x'}">
                                    1x
                                </span>

                                <span class="producto-nombre-lista"
                                      th:text="${detalle.producto != null
                                        ? detalle.producto.nombre
                                        : 'Producto'}">
                                    Producto
                                </span>

                                <span class="producto-precio-lista"
                                      th:text="'S/ '
                                        + ${detalle.subtotal}">
                                    S/ 0
                                </span>

                                <small th:if="${detalle.observaciones != null
                                    and !detalle.observaciones.isBlank()}"
                                       class="producto-indicacion-lista"
                                       th:text="${detalle.observaciones}">
                                    Indicación
                                </small>

                            </li>

                        </ul>

                    </section>

                    <div th:if="${pedido.observaciones != null
                        and !pedido.observaciones.isBlank()}"
                         class="pedido-observacion-general">

                        <strong>Observaciones</strong>

                        <p th:text="${pedido.observaciones}">
                            Observaciones del pedido.
                        </p>

                    </div>

                    <div class="pedido-activo-total">

                        <span>Total</span>

                        <strong th:text="'S/ ' + ${pedido.total}">
                            S/ 0
                        </strong>

                    </div>

                    <div class="pedido-activo-acciones">

                        <a th:if="${pedido.estado.name()
                                == 'CONFIRMADO'}"
                           th:href="@{/mesero/pedidos/{idPedido}/agregar(
                                idPedido=${pedido.idPedido}
                           )}"
                           class="btn-agregar-productos">

                            <i class="bi bi-plus-circle"></i>
                            Agregar productos
                        </a>

                        <a th:href="@{/mesero/pedidos/{idPedido}/comanda(
                                idPedido=${pedido.idPedido}
                           )}"
                           class="btn-ver-comanda">

                            <i class="bi bi-printer"></i>
                            Ver comanda
                        </a>

                        <form th:if="${pedido.estado.name()
                                == 'CONFIRMADO'}"
                              th:action="@{/mesero/pedidos/{idPedido}/solicitar-cobro(
                                    idPedido=${pedido.idPedido}
                              )}"
                              method="post"
                              class="form-solicitar-cobro"
                              data-form-solicitar-cobro>

                            <input type="hidden"
                                   th:name="${_csrf.parameterName}"
                                   th:value="${_csrf.token}">

                            <button type="submit"
                                    class="btn-solicitar-cobro">

                                <i class="bi bi-cash-coin"></i>
                                Solicitar cobro
                            </button>

                        </form>

                        <div th:if="${pedido.estado.name()
                                == 'PENDIENTE_PAGO'}"
                             class="pedido-esperando-caja">

                            <i class="bi bi-hourglass-split"></i>
                            Esperando que Caja registre el pago
                        </div>

                        <div th:if="${pedido.estado.name()
                                == 'PENDIENTE_VALIDACION'}"
                             class="pedido-esperando-validacion">

                            <i class="bi bi-clock-history"></i>
                            Pago en proceso de validación
                        </div>

                    </div>

                </article>

            </section>

        </main>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<script>
    document.addEventListener(
        "DOMContentLoaded",
        function () {
            const formularios =
                document.querySelectorAll(
                    "[data-form-solicitar-cobro]"
                );

            formularios.forEach(
                function (formulario) {
                    formulario.addEventListener(
                        "submit",
                        function (event) {
                            const confirmar =
                                window.confirm(
                                    "¿Deseas enviar este "
                                    + "pedido a Caja para "
                                    + "registrar el pago?"
                                );

                            if (!confirmar) {
                                event.preventDefault();
                                return;
                            }

                            const boton =
                                formulario.querySelector(
                                    "button[type='submit']"
                                );

                            if (boton) {
                                boton.disabled = true;

                                boton.innerHTML =
                                    '<span class="spinner-border '
                                    + 'spinner-border-sm" '
                                    + 'aria-hidden="true"></span> '
                                    + 'Enviando...';
                            }
                        }
                    );
                }
            );
        }
    );
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/mesero/reservas.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo
            + ' - El Rinconcito Ayacuchano'}">
        Reservas del día
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap"
          rel="stylesheet">

    <link th:href="@{/css/mesero-mesas.css}"
          rel="stylesheet">

    <link th:href="@{/css/mesero-reservas.css}"
          rel="stylesheet">
</head>

<body>

<div class="mesero-layout">

    <aside th:replace="~{fragments/mesero-sidebar
            :: sidebar('reservas')}">
    </aside>

    <div class="mesero-pagina">

        <header class="reservas-encabezado">

            <div>
                <p class="reservas-etiqueta">
                    ATENCIÓN DE CLIENTES
                </p>

                <h1>Reservas del día</h1>

                <p>
                    Registra la llegada de los clientes
                    y controla su atención en mesa.
                </p>
            </div>

            <div class="reservas-usuario">

                <i class="bi bi-person-circle"></i>

                <div>
                    <span>Mesero</span>

                    <strong sec:authentication="name">
                        mesero
                    </strong>
                </div>

            </div>

        </header>

        <main class="reservas-contenido">

            <div th:if="${exito}"
                 class="alert alert-success"
                 th:text="${exito}">
            </div>

            <div th:if="${error}"
                 class="alert alert-danger"
                 th:text="${error}">
            </div>

            <section class="reservas-fecha">

                <div class="reservas-fecha-icono">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <span>Fecha de atención</span>

                    <strong th:text="${#temporals.format(
                            fechaActual,
                            'dd/MM/yyyy'
                    )}">
                        10/10/2026
                    </strong>
                </div>

            </section>

            <section class="reservas-resumen">

                <article class="resumen-tarjeta">

                    <div class="resumen-icono resumen-total-icono">
                        <i class="bi bi-calendar3"></i>
                    </div>

                    <div>
                        <span>Total de reservas</span>

                        <strong th:text="${totalReservas}">
                            0
                        </strong>
                    </div>

                </article>

                <article class="resumen-tarjeta">

                    <div class="resumen-icono resumen-confirmadas-icono">
                        <i class="bi bi-clock"></i>
                    </div>

                    <div>
                        <span>Por llegar</span>

                        <strong th:text="${totalConfirmadas}">
                            0
                        </strong>
                    </div>

                </article>

                <article class="resumen-tarjeta">

                    <div class="resumen-icono resumen-llegaron-icono">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div>
                        <span>Ya llegaron</span>

                        <strong th:text="${totalLlegaron}">
                            0
                        </strong>
                    </div>

                </article>

                <article class="resumen-tarjeta">

                    <div class="resumen-icono resumen-atencion-icono">
                        <i class="bi bi-cup-hot"></i>
                    </div>

                    <div>
                        <span>En atención</span>

                        <strong th:text="${totalEnAtencion}">
                            0
                        </strong>
                    </div>

                </article>

            </section>

            <section th:if="${reservas != null
                    and !#lists.isEmpty(reservas)}"
                     class="reservas-grid">

                <article th:each="reserva : ${reservas}"
                         class="reserva-tarjeta"
                         th:classappend="${reserva.estado.name() == 'CONFIRMADA'}
                            ? ' reserva-confirmada'
                            : (${reserva.estado.name() == 'CLIENTE_LLEGO'}
                                ? ' reserva-llego'
                                : ' reserva-atencion')">

                    <header class="reserva-cabecera">

                        <div class="reserva-horario">

                            <span>Horario</span>

                            <strong>
                                <i class="bi bi-clock"></i>

                                <span th:text="${#temporals.format(
                                        reserva.horaInicio,
                                        'HH:mm'
                                )}">
                                    12:00
                                </span>

                                <span>–</span>

                                <span th:text="${#temporals.format(
                                        reserva.horaFin,
                                        'HH:mm'
                                )}">
                                    14:00
                                </span>
                            </strong>

                        </div>

                        <span th:if="${reserva.estado.name()
                                == 'CONFIRMADA'}"
                              class="reserva-estado estado-confirmada">

                            <i class="bi bi-clock"></i>
                            Por llegar
                        </span>

                        <span th:if="${reserva.estado.name()
                                == 'CLIENTE_LLEGO'}"
                              class="reserva-estado estado-llego">

                            <i class="bi bi-person-check"></i>
                            Cliente llegó
                        </span>

                        <span th:if="${reserva.estado.name()
                                == 'EN_ATENCION'}"
                              class="reserva-estado estado-atencion">

                            <i class="bi bi-cup-hot"></i>
                            En atención
                        </span>

                    </header>

                    <div class="reserva-codigo">

                        <span>Código de reserva</span>

                        <strong th:text="${reserva.codigoReserva}">
                            RES-2026-000001
                        </strong>

                    </div>

                    <div class="reserva-cliente">

                        <div class="cliente-avatar">

                            <span th:text="${reserva.cliente != null
                                    and reserva.cliente.nombres != null
                                    and !reserva.cliente.nombres.isBlank()
                                    ? #strings.substring(
                                        reserva.cliente.nombres,
                                        0,
                                        1
                                    )
                                    : 'C'}">
                                C
                            </span>

                        </div>

                        <div class="cliente-informacion">

                            <span>Cliente</span>

                            <strong th:text="${reserva.cliente != null
                                    ? reserva.cliente.nombres
                                        + ' '
                                        + reserva.cliente.apellidos
                                    : 'Cliente no disponible'}">
                                Nombre del cliente
                            </strong>

                            <small th:if="${reserva.cliente != null
                                    and reserva.cliente.dni != null
                                    and !reserva.cliente.dni.isBlank()}">

                                <i class="bi bi-person-vcard"></i>

                                DNI:

                                <span th:text="${reserva.cliente.dni}">
                                    00000000
                                </span>

                            </small>

                            <small th:if="${reserva.cliente != null
                                    and reserva.cliente.telefono != null
                                    and !reserva.cliente.telefono.isBlank()}">

                                <i class="bi bi-telephone"></i>

                                <span th:text="${reserva.cliente.telefono}">
                                    999999999
                                </span>

                            </small>

                        </div>

                    </div>

                    <div class="reserva-datos">

                        <div class="reserva-dato">

                            <span>
                                <i class="bi bi-people"></i>
                                Personas
                            </span>

                            <strong th:text="${reserva.numeroPersonas}">
                                2
                            </strong>

                        </div>

                        <div class="reserva-dato">

                            <span>
                                <i class="bi bi-layers"></i>
                                Piso
                            </span>

                            <strong th:text="${reserva.pisoSolicitado != null
                                    ? reserva.pisoSolicitado.nombre
                                    : 'Sin piso'}">
                                Piso 1
                            </strong>

                        </div>

                        <div class="reserva-dato">

                            <span>
                                <i class="bi bi-grid-3x3-gap"></i>
                                Mesa
                            </span>

                            <strong th:text="${reserva.mesa != null
                                    ? 'Mesa ' + reserva.mesa.numero
                                    : 'Sin mesa'}">
                                Mesa 1
                            </strong>

                        </div>

                    </div>

                    <div th:if="${reserva.evento != null}"
                         class="reserva-evento">

                        <i class="bi bi-stars"></i>

                        <div>
                            <span>Evento</span>

                            <strong th:text="${reserva.evento.titulo}">
                                Evento especial
                            </strong>
                        </div>

                    </div>

                    <div th:if="${reserva.ocasionEspecial != null
                            and !reserva.ocasionEspecial.isBlank()}"
                         class="reserva-observacion">

                        <strong>Ocasión especial</strong>

                        <p th:text="${reserva.ocasionEspecial}">
                            Cumpleaños
                        </p>

                    </div>

                    <div th:if="${reserva.comentarios != null
                            and !reserva.comentarios.isBlank()}"
                         class="reserva-observacion">

                        <strong>Comentarios</strong>

                        <p th:text="${reserva.comentarios}">
                            Comentario
                        </p>

                    </div>

                    <footer class="reserva-acciones">

                        <form th:if="${reserva.estado.name()
                                == 'CONFIRMADA'}"
                              th:action="@{/mesero/reservas/{idReserva}/llegada(
                                    idReserva=${reserva.idReserva}
                              )}"
                              method="post">

                            <input type="hidden"
                                   th:name="${_csrf.parameterName}"
                                   th:value="${_csrf.token}">

                            <button type="submit"
                                    class="btn-reserva btn-registrar-llegada"
                                    onclick="return confirm(
                                        '¿Confirmas que el cliente llegó?'
                                    );">

                                <i class="bi bi-person-check"></i>
                                Registrar llegada
                            </button>

                        </form>

                        <form th:if="${reserva.estado.name()
                                == 'CLIENTE_LLEGO'}"
                              th:action="@{/mesero/reservas/{idReserva}/iniciar(
                                    idReserva=${reserva.idReserva}
                              )}"
                              method="post">

                            <input type="hidden"
                                   th:name="${_csrf.parameterName}"
                                   th:value="${_csrf.token}">

                            <button type="submit"
                                    class="btn-reserva btn-iniciar-atencion">

                                <i class="bi bi-play-circle"></i>
                                Iniciar atención
                            </button>

                        </form>

                        <div th:if="${reserva.estado.name()
                                == 'EN_ATENCION'}"
                             class="acciones-atencion">

                            <a th:if="${reserva.mesa != null}"
                               th:href="@{/mesero/pedidos/nuevo(
                                    idMesa=${reserva.mesa.idMesa},
                                    idReserva=${reserva.idReserva}
                               )}"
                               class="btn-reserva btn-crear-pedido">

                                <i class="bi bi-plus-circle"></i>
                                Registrar pedido
                            </a>

                            <form th:action="@{/mesero/reservas/{idReserva}/finalizar(
                                        idReserva=${reserva.idReserva}
                                  )}"
                                  method="post">

                                <input type="hidden"
                                       th:name="${_csrf.parameterName}"
                                       th:value="${_csrf.token}">

                                <button type="submit"
                                        class="btn-reserva btn-finalizar-reserva"
                                        onclick="return confirm(
                                            '¿Deseas finalizar esta reserva?'
                                        );">

                                    <i class="bi bi-check-circle"></i>
                                    Finalizar reserva
                                </button>

                            </form>

                        </div>

                    </footer>

                </article>

            </section>

            <section th:if="${reservas == null
                    or #lists.isEmpty(reservas)}"
                     class="reservas-vacio">

                <div class="reservas-vacio-icono">
                    <i class="bi bi-calendar2-check"></i>
                </div>

                <h2>No hay reservas para atender</h2>

                <p>
                    No existen reservas confirmadas o en atención
                    para la fecha actual.
                </p>

                <a th:href="@{/mesero/mesas}"
                   class="btn-ir-mesas">

                    <i class="bi bi-grid-3x3-gap"></i>
                    Ver control de mesas
                </a>

            </section>

        </main>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/pedidos/consultar.html">
<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo} + ' - El Rinconcito Ayacuchano'">Consultar pedido</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600&amp;display=swap" rel="stylesheet">
    <link th:href="@{/css/estilos.css}" rel="stylesheet">
</head>
<body>
<header th:replace="~{fragments/header :: header}"></header>
<main>
    <section class="text-center text-light py-4" style="background-color:#8C2F1B;">
        <div class="container">
            <h1 class="fw-title">Consultar pedido</h1>
            <p class="mb-0">Ingresa tu codigo para ver el estado del pago</p>
        </div>
    </section>
    <section class="container py-5" style="max-width:640px;">
        <div th:if="${exito}" class="alert alert-success" th:text="${exito}"></div>
        <div th:if="${error}" class="alert alert-danger" th:text="${error}"></div>

        <form th:action="@{/pedidos/consultar}" method="get" class="card shadow-sm mb-4">
            <div class="card-body">
                <label class="form-label">Codigo de pedido</label>
                <div class="input-group">
                    <input type="text" name="codigo" class="form-control"
                           th:value="${codigoBusqueda}" placeholder="PED-2026-000001" required>
                    <button type="submit" class="btn" style="background-color:#D4A017;color:#3B2A22;">Buscar</button>
                </div>
            </div>
        </form>

        <div th:if="${pedido != null}" class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Resultado</h5>
                <p class="mb-1">Codigo: <strong th:text="${pedido.codigoPedido}"></strong></p>
                <p class="mb-1">Estado pedido: <strong th:text="${pedido.estado}"></strong></p>
                <p class="mb-1">Total: <strong th:text="'S/ ' + ${pedido.total}"></strong></p>
                <p class="mb-1" th:if="${pago != null}">
                    Estado pago: <strong th:text="${pago.estado}"></strong>
                    - Medio: <span th:text="${pago.metodoPago}"></span>
                </p>
                <ul class="small" th:if="${detalles != null}">
                    <li th:each="d : ${detalles}"
                        th:text="${d.producto.nombre + ' x ' + d.cantidad + ' = S/ ' + d.subtotal}"></li>
                </ul>
                <div class="alert mt-3 mb-0"
                     th:classappend="${pedido.estado.name() == 'CONFIRMADO'} ? 'alert-success' : (${pedido.estado.name() == 'PENDIENTE_VALIDACION'} ? 'alert-warning' : 'alert-secondary')"
                     th:text="${mensajeEstado}"></div>
                <p class="small text-muted mt-2 mb-0" th:if="${mensajeTraslado}" th:text="${mensajeTraslado}"></p>

                <div class="mt-3" th:if="${pedido.estado.name() == 'PENDIENTE_PAGO'}">
                    <a class="btn" style="background-color:#D4A017;color:#3B2A22;"
                       th:href="@{/pedidos/pago(codigo=${pedido.codigoPedido})}">
                        Ir a pagar / reenviar evidencia
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>
<footer th:replace="~{fragments/footer :: footer}"></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/pedidos/pago.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo != null
            ? titulo + ' - El Rinconcito Ayacuchano'
            : 'Pagar pedido - El Rinconcito Ayacuchano'}">
        Pagar pedido
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap"
          rel="stylesheet">

    <link th:href="@{/css/estilos.css}"
          rel="stylesheet">

    <link th:href="@{/css/pago-pedido.css(v=3)}"
          rel="stylesheet">
</head>

<body>

<header th:replace="~{fragments/header :: header}">
</header>

<main class="pagina-pago">

    <section class="container pago-contenido">

        <!-- MENSAJES -->

        <div th:if="${exito}"
             class="mensaje mensaje-exito">

            <i class="bi bi-check-circle-fill"></i>
            <span th:text="${exito}"></span>
        </div>

        <div th:if="${error}"
             class="mensaje mensaje-error">

            <i class="bi bi-exclamation-circle-fill"></i>
            <span th:text="${error}"></span>
        </div>

        <div th:if="${info}"
             class="mensaje mensaje-info">

            <i class="bi bi-info-circle-fill"></i>
            <span th:text="${info}"></span>
        </div>

        <!-- PEDIDO NO ENCONTRADO -->

        <section th:if="${pedido == null}"
                 class="panel pedido-no-encontrado">

            <div class="estado-icono">
                <i class="bi bi-receipt"></i>
            </div>

            <h1>No se encontró el pedido</h1>

            <p>
                Verifica el código del pedido o regresa a la carta.
            </p>

            <a th:href="@{/carta}"
               class="boton-principal">

                <i class="bi bi-arrow-left"></i>
                Volver a la carta
            </a>

        </section>

        <!-- PEDIDO ENCONTRADO -->

        <div th:if="${pedido != null}">

            <div class="encabezado-pagina">

                <div>
                    <span>Finaliza tu compra</span>
                    <h1>Pago del pedido</h1>
                </div>

                <div class="codigo-pedido">

                    <span>Código del pedido</span>

                    <strong th:text="${pedido.codigoPedido}">
                        PED-2026-000001
                    </strong>

                </div>

            </div>

            <div class="row g-4">

                <!-- COLUMNA DE PAGO -->

                <div class="col-lg-7">

                    <section class="panel"
                             th:if="${pedido.estado.name()
                                == 'PENDIENTE_PAGO'}">

                        <div class="titulo-panel">

                            <div class="titulo-icono">
                                <i class="bi bi-wallet2"></i>
                            </div>

                            <div>
                                <span>Paso 1</span>
                                <h2>Selecciona el medio de pago</h2>
                            </div>

                        </div>

                        <form th:action="@{/pedidos/pago}"
                              method="post"
                              enctype="multipart/form-data">

                            <input th:if="${_csrf != null}"
                                   type="hidden"
                                   th:name="${_csrf.parameterName}"
                                   th:value="${_csrf.token}">

                            <input type="hidden"
                                   name="codigo"
                                   th:value="${pedido.codigoPedido}">

                            <!-- RADIOS OCULTOS -->

                            <input class="radio-metodo"
                                   type="radio"
                                   id="metodoYape"
                                   name="metodoPago"
                                   value="YAPE"
                                   required>

                            <input class="radio-metodo"
                                   type="radio"
                                   id="metodoPlin"
                                   name="metodoPago"
                                   value="PLIN"
                                   required>

                            <input class="radio-metodo"
                                   type="radio"
                                   id="metodoTransferencia"
                                   name="metodoPago"
                                   value="TRANSFERENCIA"
                                   required>

                            <!-- OPCIONES DE PAGO -->

                            <div class="selector-metodos">

                                <label class="opcion-metodo"
                                       for="metodoYape">

                                    <span class="opcion-contenido">

                                        <span class="metodo-logo logo-yape">
                                            Y
                                        </span>

                                        <span class="opcion-texto">
                                            <strong>Yape</strong>
                                            <small>Pago mediante celular</small>
                                        </span>

                                        <i class="bi bi-check-circle-fill seleccion-check"></i>

                                    </span>

                                </label>

                                <label class="opcion-metodo"
                                       for="metodoPlin">

                                    <span class="opcion-contenido">

                                        <span class="metodo-logo logo-plin">
                                            P
                                        </span>

                                        <span class="opcion-texto">
                                            <strong>Plin</strong>
                                            <small>Pago mediante celular</small>
                                        </span>

                                        <i class="bi bi-check-circle-fill seleccion-check"></i>

                                    </span>

                                </label>

                                <label class="opcion-metodo"
                                       for="metodoTransferencia">

                                    <span class="opcion-contenido">

                                        <span class="metodo-logo logo-banco">
                                            <i class="bi bi-bank"></i>
                                        </span>

                                        <span class="opcion-texto">
                                            <strong>Transferencia</strong>
                                            <small>Cuenta bancaria o CCI</small>
                                        </span>

                                        <i class="bi bi-check-circle-fill seleccion-check"></i>

                                    </span>

                                </label>

                            </div>

                            <!-- DATOS DE YAPE -->

                            <section class="datos-metodo datos-yape">

                                <div class="datos-metodo-cabecera">

                                    <div>

                                        <span class="metodo-logo logo-yape">
                                            Y
                                        </span>

                                        <div>
                                            <span>Medio seleccionado</span>
                                            <h3>Pagar con Yape</h3>
                                        </div>

                                    </div>

                                </div>

                                <div class="datos-metodo-contenido">

                                    <div class="datos-cuenta">

                                        <div class="dato-cuenta">

                                            <span>Número de Yape</span>

                                            <strong th:text="${configPago != null
                                                    and configPago.numeroYape != null
                                                    and !configPago.numeroYape.isBlank()
                                                    ? configPago.numeroYape
                                                    : 'No configurado'}">
                                                No configurado
                                            </strong>

                                        </div>

                                        <div class="dato-cuenta">

                                            <span>Titular</span>

                                            <strong th:text="${configPago != null
                                                    and configPago.titularYape != null
                                                    and !configPago.titularYape.isBlank()
                                                    ? configPago.titularYape
                                                    : 'No configurado'}">
                                                No configurado
                                            </strong>

                                        </div>

                                        <div class="monto-pagar">

                                            <span>Monto a pagar</span>

                                            <strong th:text="'S/ '
                                                + ${pedido.total}">
                                                S/ 0
                                            </strong>

                                        </div>

                                    </div>

                                    <!-- QR YAPE CORREGIDO -->

                                    <div class="qr-pago"
                                         th:if="${configPago != null
                                            and configPago.qrYape != null
                                            and !configPago.qrYape.isBlank()}">

                                        <img th:src="@{/configuracion/qr/yape(
                                                v=${configPago.qrYape}
                                             )}"
                                             alt="Código QR de Yape">

                                        <span>
                                            Escanea el código QR
                                        </span>

                                    </div>

                                    <div class="qr-pago"
                                         th:unless="${configPago != null
                                            and configPago.qrYape != null
                                            and !configPago.qrYape.isBlank()}">

                                        <i class="bi bi-qr-code"
                                           style="font-size:55px;"></i>

                                        <span>
                                            QR no configurado
                                        </span>

                                    </div>

                                </div>

                            </section>

                            <!-- DATOS DE PLIN -->

                            <section class="datos-metodo datos-plin">

                                <div class="datos-metodo-cabecera">

                                    <div>

                                        <span class="metodo-logo logo-plin">
                                            P
                                        </span>

                                        <div>
                                            <span>Medio seleccionado</span>
                                            <h3>Pagar con Plin</h3>
                                        </div>

                                    </div>

                                </div>

                                <div class="datos-metodo-contenido">

                                    <div class="datos-cuenta">

                                        <div class="dato-cuenta">

                                            <span>Número de Plin</span>

                                            <strong th:text="${configPago != null
                                                    and configPago.numeroPlin != null
                                                    and !configPago.numeroPlin.isBlank()
                                                    ? configPago.numeroPlin
                                                    : 'No configurado'}">
                                                No configurado
                                            </strong>

                                        </div>

                                        <div class="dato-cuenta">

                                            <span>Titular</span>

                                            <strong th:text="${configPago != null
                                                    and configPago.titularPlin != null
                                                    and !configPago.titularPlin.isBlank()
                                                    ? configPago.titularPlin
                                                    : 'No configurado'}">
                                                No configurado
                                            </strong>

                                        </div>

                                        <div class="monto-pagar">

                                            <span>Monto a pagar</span>

                                            <strong th:text="'S/ '
                                                + ${pedido.total}">
                                                S/ 0
                                            </strong>

                                        </div>

                                    </div>

                                    <!-- QR PLIN CORREGIDO -->

                                    <div class="qr-pago"
                                         th:if="${configPago != null
                                            and configPago.qrPlin != null
                                            and !configPago.qrPlin.isBlank()}">

                                        <img th:src="@{/configuracion/qr/plin(
                                                v=${configPago.qrPlin}
                                             )}"
                                             alt="Código QR de Plin">

                                        <span>
                                            Escanea el código QR
                                        </span>

                                    </div>

                                    <div class="qr-pago"
                                         th:unless="${configPago != null
                                            and configPago.qrPlin != null
                                            and !configPago.qrPlin.isBlank()}">

                                        <i class="bi bi-qr-code"
                                           style="font-size:55px;"></i>

                                        <span>
                                            QR no configurado
                                        </span>

                                    </div>

                                </div>

                            </section>

                            <!-- TRANSFERENCIA -->

                            <section class="datos-metodo datos-transferencia">

                                <div class="datos-metodo-cabecera">

                                    <div>

                                        <span class="metodo-logo logo-banco">
                                            <i class="bi bi-bank"></i>
                                        </span>

                                        <div>
                                            <span>Medio seleccionado</span>
                                            <h3>Transferencia bancaria</h3>
                                        </div>

                                    </div>

                                </div>

                                <div class="transferencia-grid">

                                    <div class="dato-cuenta">

                                        <span>Banco</span>

                                        <strong th:text="${configPago != null
                                                and configPago.bancoTransferencia != null
                                                and !configPago.bancoTransferencia.isBlank()
                                                ? configPago.bancoTransferencia
                                                : 'No configurado'}">
                                            No configurado
                                        </strong>

                                    </div>

                                    <div class="dato-cuenta">

                                        <span>Titular</span>

                                        <strong th:text="${configPago != null
                                                and configPago.titularTransferencia != null
                                                and !configPago.titularTransferencia.isBlank()
                                                ? configPago.titularTransferencia
                                                : 'No configurado'}">
                                            No configurado
                                        </strong>

                                    </div>

                                    <div class="dato-cuenta">

                                        <span>Número de cuenta</span>

                                        <strong th:text="${configPago != null
                                                and configPago.numeroCuentaTransferencia != null
                                                and !configPago.numeroCuentaTransferencia.isBlank()
                                                ? configPago.numeroCuentaTransferencia
                                                : 'No configurado'}">
                                            No configurado
                                        </strong>

                                    </div>

                                    <div class="dato-cuenta">

                                        <span>CCI</span>

                                        <strong th:text="${configPago != null
                                                and configPago.cciTransferencia != null
                                                and !configPago.cciTransferencia.isBlank()
                                                ? configPago.cciTransferencia
                                                : 'No configurado'}">
                                            No configurado
                                        </strong>

                                    </div>

                                </div>

                                <div class="monto-pagar transferencia-monto">

                                    <span>Monto a pagar</span>

                                    <strong th:text="'S/ '
                                        + ${pedido.total}">
                                        S/ 0
                                    </strong>

                                </div>

                            </section>

                            <!-- SUBIR COMPROBANTE -->

                            <section class="evidencia-pago">

                                <div class="titulo-panel">

                                    <div class="titulo-icono">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                    </div>

                                    <div>
                                        <span>Paso 2</span>
                                        <h2>Sube tu comprobante</h2>
                                    </div>

                                </div>

                                <div class="campo-formulario">

                                    <label for="captura">

                                        Captura del pago
                                        <span>*</span>
                                    </label>

                                    <label class="zona-archivo"
                                           for="captura">

                                        <i class="bi bi-cloud-arrow-up"></i>

                                        <strong>
                                            Seleccionar comprobante
                                        </strong>

                                        <span>
                                            JPG, JPEG, PNG o WEBP.
                                            Máximo 5 MB.
                                        </span>

                                        <input id="captura"
                                               type="file"
                                               name="captura"
                                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                               required>

                                    </label>

                                </div>

                                <div class="campo-formulario">

                                    <label for="numeroOperacion">

                                        Número de operación
                                        <em>(opcional)</em>
                                    </label>

                                    <input id="numeroOperacion"
                                           type="text"
                                           name="numeroOperacion"
                                           maxlength="50"
                                           placeholder="Ejemplo: 45896321">

                                </div>

                                <button type="submit"
                                        class="boton-enviar">

                                    <i class="bi bi-send-check"></i>
                                    Enviar comprobante
                                </button>

                                <div class="aviso-validacion">

                                    <i class="bi bi-shield-check"></i>

                                    <span>
                                        Caja revisará el comprobante antes
                                        de confirmar tu pedido.
                                    </span>

                                </div>

                            </section>

                        </form>

                    </section>

                    <!-- PAGO RECHAZADO -->

                    <section class="panel estado-panel"
                             th:if="${pedido.estado.name() == 'PENDIENTE_PAGO'
                                and pago != null
                                and pago.estado.name() == 'RECHAZADO'}">

                        <div class="estado-icono"
                             style="color:#b45309;
                                    background:#fff7ed;">

                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>

                        <h2>Comprobante rechazado</h2>

                        <p>
                            El comprobante anterior fue rechazado.
                            Puedes seleccionar un método de pago y
                            enviar una nueva captura.
                        </p>

                        <p th:if="${pago.observacionValidacion != null
                                and !pago.observacionValidacion.isBlank()}">

                            Motivo:

                            <strong th:text="${pago.observacionValidacion}">
                            </strong>
                        </p>

                    </section>

                    <!-- PAGO EN REVISIÓN -->

                    <section class="panel estado-panel"
                             th:if="${pedido.estado.name()
                                == 'PENDIENTE_VALIDACION'}">

                        <div class="estado-icono estado-revision">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <h2>Comprobante en revisión</h2>

                        <p>
                            Tu comprobante fue enviado correctamente.
                            Caja verificará el pago.
                        </p>

                        <a th:href="@{/pedidos/consultar(
                                codigo=${pedido.codigoPedido}
                            )}"
                           class="boton-principal">

                            Consultar estado
                        </a>

                    </section>

                    <!-- PEDIDO CONFIRMADO -->

                    <section class="panel estado-panel"
                             th:if="${pedido.estado.name()
                                == 'CONFIRMADO'}">

                        <div class="estado-icono estado-confirmado">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>

                        <h2>Pedido confirmado</h2>

                        <p>
                            Caja verificó correctamente tu pago.
                        </p>

                        <a th:href="@{/pedidos/consultar(
                                codigo=${pedido.codigoPedido}
                            )}"
                           class="boton-principal">

                            Ver pedido
                        </a>

                    </section>

                </div>

                <!-- RESUMEN DEL PEDIDO -->

                <div class="col-lg-5">

                    <aside class="panel resumen-pedido">

                        <div class="titulo-panel">

                            <div class="titulo-icono">
                                <i class="bi bi-receipt"></i>
                            </div>

                            <div>
                                <span>Resumen</span>
                                <h2>Tu pedido</h2>
                            </div>

                        </div>

                        <div class="estado-resumen">

                            <span>Estado</span>

                            <strong th:text="${pedido.estado}">
                                PENDIENTE_PAGO
                            </strong>

                        </div>

                        <div class="lista-productos"
                             th:if="${detalles != null
                                and !detalles.isEmpty()}">

                            <article th:each="detalle : ${detalles}"
                                     class="producto-resumen">

                                <div>

                                    <strong th:text="${detalle.producto.nombre}">
                                        Producto
                                    </strong>

                                    <span th:text="'Cantidad: '
                                        + ${detalle.cantidad}
                                        + ' × S/ '
                                        + ${detalle.precioUnitario}">
                                        Cantidad: 1 × S/ 0
                                    </span>

                                </div>

                                <strong th:text="'S/ '
                                    + ${detalle.subtotal}">
                                    S/ 0
                                </strong>

                            </article>

                        </div>

                        <div class="resumen-linea">

                            <span>Subtotal</span>

                            <strong th:text="'S/ '
                                + ${pedido.subtotal}">
                                S/ 0
                            </strong>

                        </div>

                        <!-- MODALIDAD -->

                        <div class="resumen-linea">

                            <span>Modalidad</span>

                            <strong th:text="${pedido.tipoPedido.name()
                                    == 'RECOJO_LOCAL'
                                    ? 'Recojo en local'
                                    : 'Delivery'}">
                                Delivery
                            </strong>

                        </div>

                        <!-- COSTO DE DELIVERY -->

                        <div class="resumen-linea"
                             th:if="${pedido.tipoPedido.name()
                                == 'DELIVERY'}">

                            <span>Delivery</span>

                            <strong th:text="${pedido.costoDelivery != null
                                    and pedido.costoDelivery > 0
                                    ? 'S/ ' + pedido.costoDelivery
                                    : 'Por coordinar'}">
                                Por coordinar
                            </strong>

                        </div>

                        <div class="resumen-total">

                            <span>Total de productos</span>

                            <strong th:text="'S/ '
                                + ${pedido.total}">
                                S/ 0
                            </strong>

                        </div>

                        <!-- AVISO DELIVERY -->

                        <div class="delivery-aviso"
                             th:if="${pedido.tipoPedido.name()
                                == 'DELIVERY'}">

                            <i class="bi bi-truck"></i>

                            <span>
                                El delivery se coordina mediante
                                InDrive u otro servicio externo.
                            </span>

                        </div>

                        <!-- AVISO RECOJO -->

                        <div class="delivery-aviso"
                             th:if="${pedido.tipoPedido.name()
                                == 'RECOJO_LOCAL'}">

                            <i class="bi bi-shop"></i>

                            <span>
                                Recogerás el pedido directamente
                                en el restaurante.
                            </span>

                        </div>

                    </aside>

                    <nav class="enlaces-pago">

                        <a th:href="@{/pedidos/consultar(
                                codigo=${pedido.codigoPedido}
                            )}">

                            <i class="bi bi-search"></i>
                            Consultar pedido
                        </a>

                        <a th:href="@{/carta}">

                            <i class="bi bi-arrow-left"></i>
                            Volver a la carta
                        </a>

                    </nav>

                </div>

            </div>

        </div>

    </section>

</main>

<footer th:replace="~{fragments/footer :: footer}">
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/reservas/consultar.html">
<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo} + ' - El Rinconcito Ayacuchano'">Consultar reserva</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600&amp;display=swap" rel="stylesheet">
    <link th:href="@{/css/estilos.css}" rel="stylesheet">
</head>
<body>
<header th:replace="~{fragments/header :: header}"></header>
<main>
    <section class="text-center text-light py-4" style="background-color:#8C2F1B;">
        <div class="container">
            <h1 class="fw-title">Consultar reserva</h1>
            <p class="mb-0">Ingresa tu código para ver el estado del pago</p>
        </div>
    </section>

    <section class="container py-5" style="max-width:640px;">
        <div th:if="${exito}" class="alert alert-success" th:text="${exito}"></div>
        <div th:if="${error}" class="alert alert-danger" th:text="${error}"></div>

        <form th:action="@{/reservas/consultar}" method="get" class="card shadow-sm mb-4">
            <div class="card-body">
                <label class="form-label">Código de reserva</label>
                <div class="input-group">
                    <input type="text" name="codigo" class="form-control"
                           th:value="${codigoBusqueda}"
                           placeholder="RES-2026-000001" required>
                    <button type="submit" class="btn" style="background-color:#D4A017;color:#3B2A22;">Buscar</button>
                </div>
            </div>
        </form>

        <div th:if="${reserva != null}" class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Resultado</h5>
                <p class="mb-1">Código: <strong th:text="${reserva.codigoReserva}"></strong></p>
                <p class="mb-1" th:if="${reserva.evento != null}">
                    Evento: <strong th:text="${reserva.evento.titulo}"></strong>
                </p>
                <p class="mb-1">
                    Fecha:
                    <strong th:text="${#temporals.format(reserva.fechaReserva, 'dd/MM/yyyy')}"></strong>
                    ·
                    <strong th:text="${#temporals.format(reserva.horaInicio, 'HH:mm')}"></strong>
                </p>
                <p class="mb-1">Estado reserva: <strong th:text="${reserva.estado}"></strong></p>
                <p class="mb-1" th:if="${pago != null}">
                    Estado pago: <strong th:text="${pago.estado}"></strong>
                    · Medio: <span th:text="${pago.metodoPago}"></span>
                </p>
                <p class="mb-1" th:if="${reserva.mesa != null}">
                    Mesa: <strong th:text="${reserva.mesa.numero}"></strong>
                    (<span th:text="${reserva.pisoSolicitado.nombre}"></span>)
                </p>
                <div class="alert mt-3 mb-0"
                     th:classappend="${reserva.estado.name() == 'CONFIRMADA'} ? 'alert-success' : (${reserva.estado.name() == 'PENDIENTE_VALIDACION'} ? 'alert-warning' : 'alert-secondary')"
                     th:text="${mensajeEstado}">
                </div>

                <div class="mt-3" th:if="${reserva.estado.name() == 'PENDIENTE_PAGO'}">
                    <a class="btn"
                       style="background-color:#D4A017;color:#3B2A22;"
                       th:href="@{/reservas/pago(codigo=${reserva.codigoReserva})}">
                        Ir a pagar / reenviar evidencia
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>
<footer th:replace="~{fragments/footer :: footer}"></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/reservas/pago.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo}+ ' - El Rinconcito Ayacuchano'">
        Pagar reserva
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600&amp;display=swap"
          rel="stylesheet">
    <link th:href="@{/css/estilos.css}"
          rel="stylesheet">
</head>
<body>

<header th:replace="~{fragments/header :: header}">
</header>

<main>

    <section class="text-center text-light py-4"
             style="background-color:#8C2F1B;">

        <div class="container">

            <h1 class="fw-title">
                Pagar reserva
            </h1>

            <p class="mb-0">
                Yape o Plin · adjunta tu captura
            </p>

        </div>

    </section>

    <section class="container py-5"
             style="max-width:720px;">

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <div th:if="${info}"
             class="alert alert-info"
             th:text="${info}">
        </div>

        <div th:if="${reserva != null}">

            <!-- DATOS DE LA RESERVA -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h5 class="card-title">
                        Datos de la reserva
                    </h5>

                    <p class="mb-1">
                        Código:

                        <strong th:text="${reserva.codigoReserva}">
                            RES-...
                        </strong>
                    </p>

                    <p class="mb-1"
                       th:if="${reserva.evento != null}">

                        Evento:

                        <strong th:text="${reserva.evento.titulo}">
                            Evento
                        </strong>
                    </p>

                    <p class="mb-1">
                        Personas:

                        <strong th:text="${reserva.numeroPersonas}">
                            1
                        </strong>
                    </p>

                    <p class="mb-1"
                       th:if="${reserva.evento != null
                            and reserva.evento.precioEntrada != null}">

                        Precio por persona:

                        <strong th:text="'S/ '
                            + ${reserva.evento.precioEntrada}">
                            S/ 0
                        </strong>
                    </p>

                    <p class="mb-0 fs-5">

                        Monto total:

                        <strong th:text="'S/ '
                            + ${reserva.montoReserva}">
                            S/ 0
                        </strong>
                    </p>

                    <p class="small text-muted mt-2 mb-0">
                        No escribas el código de reserva como número
                        de operación en Yape o Plin. La captura se
                        asociará automáticamente con tu reserva.
                    </p>

                </div>

            </div>

            <!-- PAGO PENDIENTE -->
            <div th:if="${reserva.estado.name() == 'PENDIENTE_PAGO'
                    and configPago != null}">

                <!-- DATOS DE YAPE Y PLIN -->
                <div class="row g-3 mb-4">

                    <!-- YAPE -->
                    <div class="col-md-6">

                        <div class="border rounded p-3 h-100">

                            <h6 class="text-uppercase"
                                style="color:#8C2F1B;">
                                Yape
                            </h6>

                            <p class="mb-1">
                                Número:

                                <strong th:text="${configPago.numeroYape != null
                                    and !configPago.numeroYape.isBlank()
                                    ? configPago.numeroYape
                                    : '—'}">
                                    —
                                </strong>
                            </p>

                            <p class="mb-2">
                                Titular:

                                <strong th:text="${configPago.titularYape != null
                                    and !configPago.titularYape.isBlank()
                                    ? configPago.titularYape
                                    : '—'}">
                                    —
                                </strong>
                            </p>

                            <div th:if="${configPago.qrYape != null
                                    and !configPago.qrYape.isBlank()}"
                                 class="text-center mt-3">

                                <img th:src="@{/configuracion/qr/yape(
                                        v=${configPago.qrYape}
                                     )}"
                                     alt="Código QR de Yape"
                                     class="img-fluid rounded border"
                                     style="width:180px;
                                            height:180px;
                                            object-fit:contain;
                                            background:#fff;">

                                <p class="small text-muted mt-2 mb-0">
                                    Escanea el código QR
                                </p>

                            </div>

                            <div th:unless="${configPago.qrYape != null
                                    and !configPago.qrYape.isBlank()}"
                                 class="alert alert-light border small mt-3 mb-0">

                                Código QR no disponible.
                            </div>

                        </div>

                    </div>

                    <!-- PLIN -->
                    <div class="col-md-6">

                        <div class="border rounded p-3 h-100">

                            <h6 class="text-uppercase"
                                style="color:#8C2F1B;">
                                Plin
                            </h6>

                            <p class="mb-1">
                                Número:

                                <strong th:text="${configPago.numeroPlin != null
                                    and !configPago.numeroPlin.isBlank()
                                    ? configPago.numeroPlin
                                    : '—'}">
                                    —
                                </strong>
                            </p>

                            <p class="mb-2">
                                Titular:

                                <strong th:text="${configPago.titularPlin != null
                                    and !configPago.titularPlin.isBlank()
                                    ? configPago.titularPlin
                                    : '—'}">
                                    —
                                </strong>
                            </p>

                            <div th:if="${configPago.qrPlin != null
                                    and !configPago.qrPlin.isBlank()}"
                                 class="text-center mt-3">

                                <img th:src="@{/configuracion/qr/plin(
                                        v=${configPago.qrPlin}
                                     )}"
                                     alt="Código QR de Plin"
                                     class="img-fluid rounded border"
                                     style="width:180px;
                                            height:180px;
                                            object-fit:contain;
                                            background:#fff;">

                                <p class="small text-muted mt-2 mb-0">
                                    Escanea el código QR
                                </p>

                            </div>

                            <div th:unless="${configPago.qrPlin != null
                                    and !configPago.qrPlin.isBlank()}"
                                 class="alert alert-light border small mt-3 mb-0">

                                Código QR no disponible.
                            </div>

                        </div>

                    </div>

                </div>

                <!-- FORMULARIO PARA ENVIAR EVIDENCIA -->
                <form th:action="@{/reservas/pago}"
                      method="post"
                      enctype="multipart/form-data"
                      class="card shadow-sm">

                    <div class="card-body">

                        <input type="hidden"
                               th:name="${_csrf.parameterName}"
                               th:value="${_csrf.token}">

                        <input type="hidden"
                               name="codigo"
                               th:value="${reserva.codigoReserva}">

                        <div class="mb-3">

                            <label for="metodoPago"
                                   class="form-label">

                                Medio de pago
                            </label>

                            <select id="metodoPago"
                                    name="metodoPago"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Selecciona...
                                </option>

                                <option value="YAPE">
                                    Yape
                                </option>

                                <option value="PLIN">
                                    Plin
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label for="captura"
                                   class="form-label">

                                Captura del pago

                                <span class="text-danger">
                                    *
                                </span>
                            </label>

                            <input type="file"
                                   id="captura"
                                   name="captura"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   required>

                            <div class="form-text">
                                JPG, JPEG, PNG o WEBP · máximo 5 MB
                            </div>

                        </div>

                        <div class="mb-3">

                            <label for="numeroOperacion"
                                   class="form-label">

                                Número de operación

                                <span class="text-muted">
                                    (opcional)
                                </span>
                            </label>

                            <input type="text"
                                   id="numeroOperacion"
                                   name="numeroOperacion"
                                   class="form-control"
                                   maxlength="50"
                                   placeholder="Solo si lo ves en el voucher">

                        </div>

                        <button type="submit"
                                class="btn btn-lg w-100"
                                style="background-color:#D4A017;
                                       color:#3B2A22;">

                            <i class="bi bi-cloud-arrow-up me-1"></i>
                            Enviar evidencia
                        </button>

                    </div>

                </form>

            </div>

            <!-- PAGO RECHAZADO -->
            <div class="mt-3"
                 th:if="${reserva.estado.name() == 'PENDIENTE_PAGO'
                    and pago != null
                    and pago.estado.name() == 'RECHAZADO'}">

                <div class="alert alert-warning">

                    Último pago rechazado.

                    <span th:if="${pago.observacionValidacion != null
                            and !pago.observacionValidacion.isBlank()}">

                        Motivo:

                        <strong th:text="${pago.observacionValidacion}">
                        </strong>

                    </span>

                </div>

            </div>

            <!-- EN REVISIÓN -->
            <div class="alert alert-info mt-3"
                 th:if="${reserva.estado.name()
                    == 'PENDIENTE_VALIDACION'}">

                <i class="bi bi-hourglass-split me-1"></i>

                Tu evidencia fue enviada correctamente y está
                pendiente de validación por Caja.
            </div>

            <!-- CONFIRMADA -->
            <div class="alert alert-success mt-3"
                 th:if="${reserva.estado.name() == 'CONFIRMADA'}">

                <i class="bi bi-check-circle me-1"></i>

                El pago fue aprobado y tu reserva está confirmada.
            </div>

            <p class="mt-3 mb-0">

                <a th:href="@{/reservas/consultar(
                        codigo=${reserva.codigoReserva}
                    )}">
                    Consultar estado
                </a>

                <span class="mx-1">·</span>

                <a th:href="@{/reservas}">
                    Nueva reserva
                </a>

            </p>

        </div>

        <!-- SIN RESERVA -->
        <div th:if="${reserva == null}"
             class="text-center">

            <a th:href="@{/reservas/consultar}"
               class="btn btn-outline-secondary">

                Consultar por código
            </a>

        </div>

    </section>

</main>

<footer th:replace="~{fragments/footer :: footer}">
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/carrito.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo} + ' - Rinconcito Ayacuchano Campestre'">
        Carrito - Rinconcito Ayacuchano Campestre
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap"
          rel="stylesheet">
    <link th:href="@{/css/estilos.css}"
          rel="stylesheet">
    <link th:href="@{/css/carrito.css}"
          rel="stylesheet">
</head>

<body class="pagina-carrito">

<header th:replace="~{fragments/header :: header}"></header>

<main>

    <section class="container carrito-contenedor">

        <!-- MENSAJE DE ÉXITO -->
        <div th:if="${exito}"
             class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            <span th:text="${exito}">
                Operación realizada correctamente.
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>

        <!-- MENSAJE DE ERROR -->
        <div th:if="${error}"
             class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle-fill me-2"></i>

            <span th:text="${error}">
                Ocurrió un error.
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>

        <!-- CARRITO VACÍO -->
        <div th:if="${items == null or items.isEmpty()}"
             class="carrito-vacio">

            <div class="carrito-vacio-icono">
                <i class="bi bi-cart-x"></i>
            </div>

            <h1>Tu carrito está vacío</h1>

            <p>
                Todavía no agregaste ningún plato. Revisa nuestra carta
                y descubre los sabores del Rinconcito Ayacuchano.
            </p>

            <a th:href="@{/carta}"
               class="btn-carrito-principal">

                <i class="bi bi-journal-richtext"></i>
                Ver nuestra carta
            </a>
        </div>

        <!-- CARRITO CON PRODUCTOS -->
        <div th:if="${items != null and !items.isEmpty()}"
             class="row g-4 align-items-start">

            <!-- PRODUCTOS -->
            <div class="col-lg-8">

                <div class="carrito-titulo-seccion">

                    <div>
                        <span>PRODUCTOS SELECCIONADOS</span>
                        <h1>Detalle de tu pedido</h1>
                    </div>

                    <a th:href="@{/carta}"
                       class="carrito-seguir-comprando">

                        <i class="bi bi-arrow-left"></i>
                        Seguir comprando
                    </a>
                </div>

                <!-- PRODUCTO -->
                <article class="carrito-producto"
                         th:each="item : ${items}"
                         th:attr="data-producto-id=${item.idProducto},
                                  data-precio=${item.precioUnitario}">

                    <!-- IMAGEN -->
                    <div class="carrito-producto-imagen">

                        <img th:if="${item.imagen != null and !#strings.isEmpty(item.imagen)}"
                             th:src="${item.imagen}"
                             th:alt="${item.nombre}"
                             onerror="
                                 this.style.display='none';
                                 this.nextElementSibling.style.display='flex';
                             ">

                        <div class="carrito-imagen-vacia"
                             th:style="${item.imagen != null and !#strings.isEmpty(item.imagen)}
                                ? 'display:none;'
                                : 'display:flex;'">

                            <i class="bi bi-image"></i>
                        </div>
                    </div>

                    <!-- INFORMACIÓN -->
                    <div class="carrito-producto-informacion">

                        <div class="carrito-producto-superior">

                            <div class="carrito-producto-nombre">

                                <span class="carrito-producto-etiqueta">
                                    Plato seleccionado
                                </span>

                                <h2 th:text="${item.nombre}">
                                    Nombre del producto
                                </h2>
                            </div>

                            <!-- ELIMINAR PRODUCTO -->
                            <form th:action="@{/carrito/eliminar}"
                                  method="post"
                                  class="form-eliminar-producto"
                                  onsubmit="return confirm('¿Deseas eliminar este producto?');">

                                <input type="hidden"
                                       th:name="${_csrf.parameterName}"
                                       th:value="${_csrf.token}">

                                <input type="hidden"
                                       name="idProducto"
                                       th:value="${item.idProducto}">

                                <button type="submit"
                                        class="btn-eliminar-producto"
                                        title="Eliminar producto"
                                        aria-label="Eliminar producto">

                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>

                        <div class="carrito-producto-datos">

                            <!-- PRECIO -->
                            <div class="carrito-dato">

                                <span>Precio unitario</span>

                                <strong class="precio-unitario"
                                        th:text="'S/ ' + ${item.precioUnitario}">
                                    S/ 0
                                </strong>
                            </div>

                            <!-- CANTIDAD -->
                            <form th:action="@{/carrito/actualizar}"
                                  method="post"
                                  class="form-cantidad">

                                <input type="hidden"
                                       th:name="${_csrf.parameterName}"
                                       th:value="${_csrf.token}">

                                <input type="hidden"
                                       name="idProducto"
                                       th:value="${item.idProducto}">

                                <span class="cantidad-titulo">
                                    Cantidad
                                </span>

                                <div class="control-cantidad">

                                    <button type="button"
                                            class="btn-cantidad btn-restar"
                                            aria-label="Disminuir cantidad">

                                        <i class="bi bi-dash-lg"></i>
                                    </button>

                                    <input type="number"
                                           name="cantidad"
                                           class="input-cantidad"
                                           min="1"
                                           max="30"
                                           th:value="${item.cantidad}"
                                           readonly
                                           aria-label="Cantidad del producto">

                                    <button type="button"
                                            class="btn-cantidad btn-sumar"
                                            aria-label="Aumentar cantidad">

                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </form>

                            <!-- SUBTOTAL -->
                            <div class="carrito-producto-subtotal">

                                <span>Subtotal</span>

                                <strong class="subtotal-producto"
                                        th:text="'S/ ' + ${item.subtotal}">
                                    S/ 0
                                </strong>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- VACIAR CARRITO -->
                <div class="carrito-acciones-secundarias">

                    <form th:action="@{/carrito/vaciar}"
                          method="post"
                          onsubmit="return confirm('¿Deseas eliminar todos los productos del carrito?');">

                        <input type="hidden"
                               th:name="${_csrf.parameterName}"
                               th:value="${_csrf.token}">

                        <button type="submit"
                                class="btn-vaciar-carrito">

                            <i class="bi bi-trash3"></i>
                            Vaciar carrito
                        </button>
                    </form>
                </div>
            </div>

            <!-- RESUMEN -->
            <div class="col-lg-4">

                <aside class="carrito-resumen">

                    <div class="carrito-resumen-encabezado">
                        <span>RESUMEN</span>
                        <h2>Tu pedido</h2>
                    </div>

                    <div class="carrito-resumen-fila">

                        <span>Productos</span>

                        <strong id="cantidadTotalProductos"
                                th:text="${#aggregates.sum(items.![cantidad])}">
                            0
                        </strong>
                    </div>

                    <div class="carrito-resumen-fila">

                        <span>Subtotal</span>

                        <strong id="subtotalGeneral"
                                th:text="'S/ ' + ${subtotal}">
                            S/ 0
                        </strong>
                    </div>

                    <div class="carrito-resumen-fila">

                        <span>Servicio de delivery</span>

                        <strong class="texto-por-coordinar">
                            Por coordinar
                        </strong>
                    </div>

                    <div class="carrito-resumen-separador"></div>

                    <div class="carrito-resumen-total">

                        <span>Total de productos</span>

                        <strong id="totalGeneral"
                                th:text="'S/ ' + ${subtotal}">
                            S/ 0
                        </strong>
                    </div>

                    <div th:if="${mensajeTraslado}"
                         class="carrito-aviso-delivery">

                        <i class="bi bi-info-circle-fill"></i>

                        <p th:text="${mensajeTraslado}">
                            El servicio de delivery se coordina por separado.
                        </p>
                    </div>

                    <a th:href="@{/pedidos}"
                       class="btn-continuar-pedido">

                        Continuar con el pedido
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <div class="carrito-pago-seguro">

                        <i class="bi bi-shield-check"></i>

                        <span>
                            Pago mediante Yape, Plin o transferencia
                        </span>
                    </div>
                </aside>
            </div>
        </div>
    </section>
</main>

<footer th:replace="~{fragments/footer :: footer}"></footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const productos =
            document.querySelectorAll(".carrito-producto");

        const temporizadores = new Map();

        productos.forEach(function (producto) {

            const formulario =
                producto.querySelector(".form-cantidad");

            const inputCantidad =
                producto.querySelector(".input-cantidad");

            const botonRestar =
                producto.querySelector(".btn-restar");

            const botonSumar =
                producto.querySelector(".btn-sumar");

            if (
                !formulario ||
                !inputCantidad ||
                !botonRestar ||
                !botonSumar
            ) {
                return;
            }

            const idProducto =
                producto.dataset.productoId;

            botonRestar.addEventListener(
                "click",
                function () {
                    cambiarCantidad(
                        producto,
                        inputCantidad,
                        -1,
                        formulario,
                        idProducto
                    );
                }
            );

            botonSumar.addEventListener(
                "click",
                function () {
                    cambiarCantidad(
                        producto,
                        inputCantidad,
                        1,
                        formulario,
                        idProducto
                    );
                }
            );

            actualizarEstadoBotones(
                inputCantidad,
                botonRestar,
                botonSumar
            );
        });

        function cambiarCantidad(
            producto,
            inputCantidad,
            cambio,
            formulario,
            idProducto
        ) {
            const cantidadActual =
                parseInt(inputCantidad.value, 10) || 1;

            let nuevaCantidad =
                cantidadActual + cambio;

            if (nuevaCantidad < 1) {
                nuevaCantidad = 1;
            }

            if (nuevaCantidad > 30) {
                nuevaCantidad = 30;
            }

            if (nuevaCantidad === cantidadActual) {
                return;
            }

            inputCantidad.value = nuevaCantidad;

            actualizarSubtotalProducto(
                producto,
                nuevaCantidad
            );

            actualizarResumenGeneral();

            const botonRestar =
                producto.querySelector(".btn-restar");

            const botonSumar =
                producto.querySelector(".btn-sumar");

            actualizarEstadoBotones(
                inputCantidad,
                botonRestar,
                botonSumar
            );

            if (temporizadores.has(idProducto)) {
                clearTimeout(
                    temporizadores.get(idProducto)
                );
            }

            const temporizador = setTimeout(
                function () {
                    guardarCantidad(formulario);
                },
                350
            );

            temporizadores.set(
                idProducto,
                temporizador
            );
        }

        function actualizarSubtotalProducto(
            producto,
            cantidad
        ) {
            const precio =
                parseInt(producto.dataset.precio, 10) || 0;

            const subtotal =
                precio * cantidad;

            const elementoSubtotal =
                producto.querySelector(".subtotal-producto");

            if (elementoSubtotal) {
                elementoSubtotal.textContent =
                    "S/ " + subtotal;
            }
        }

        function actualizarResumenGeneral() {

            let subtotalGeneral = 0;
            let cantidadTotal = 0;

            document
                .querySelectorAll(".carrito-producto")
                .forEach(function (producto) {

                    const precio =
                        parseInt(
                            producto.dataset.precio,
                            10
                        ) || 0;

                    const inputCantidad =
                        producto.querySelector(
                            ".input-cantidad"
                        );

                    const cantidad =
                        parseInt(
                            inputCantidad.value,
                            10
                        ) || 0;

                    subtotalGeneral +=
                        precio * cantidad;

                    cantidadTotal += cantidad;
                });

            const elementoSubtotal =
                document.getElementById(
                    "subtotalGeneral"
                );

            const elementoTotal =
                document.getElementById(
                    "totalGeneral"
                );

            const elementoCantidad =
                document.getElementById(
                    "cantidadTotalProductos"
                );

            if (elementoSubtotal) {
                elementoSubtotal.textContent =
                    "S/ " + subtotalGeneral;
            }

            if (elementoTotal) {
                elementoTotal.textContent =
                    "S/ " + subtotalGeneral;
            }

            if (elementoCantidad) {
                elementoCantidad.textContent =
                    cantidadTotal;
            }
        }

        function actualizarEstadoBotones(
            inputCantidad,
            botonRestar,
            botonSumar
        ) {
            const cantidad =
                parseInt(inputCantidad.value, 10) || 1;

            botonRestar.disabled =
                cantidad <= 1;

            botonSumar.disabled =
                cantidad >= 30;
        }

        async function guardarCantidad(formulario) {

            const datosFormulario =
                new FormData(formulario);

            try {
                formulario.classList.add(
                    "actualizando"
                );

                const respuesta = await fetch(
                    formulario.action,
                    {
                        method: "POST",
                        body: datosFormulario,
                        credentials: "same-origin"
                    }
                );

                if (!respuesta.ok) {
                    throw new Error(
                        "No se pudo actualizar la cantidad."
                    );
                }

            } catch (error) {
                console.error(error);

                alert(
                    "No se pudo guardar la cantidad. " +
                    "La página se actualizará."
                );

                window.location.reload();

            } finally {
                formulario.classList.remove(
                    "actualizando"
                );
            }
        }
    });
</script>

</body>
</html>
</file>

