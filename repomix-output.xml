<file path="src/main/resources/templates/paginas/pedidos.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo} + ' - Rinconcito Ayacuchano Campestre'">
        Completar pedido
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    <link th:href="@{/css/estilos.css}"
          rel="stylesheet">

    <link th:href="@{/css/pedidos.css}"
          rel="stylesheet">
</head>

<body>

<header th:replace="~{fragments/header :: header}"></header>

<main>

    <section class="container pedido-contenedor">

        <!-- MENSAJE DE ERROR -->
        <div th:if="${error}"
             class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle-fill me-2"></i>

            <span th:text="${error}">
                Ocurrió un error.
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>

        <!-- CARRITO VACÍO -->
        <div th:if="${carritoVacio}"
             class="pedido-vacio">

            <div class="pedido-vacio-icono">
                <i class="bi bi-bag-x"></i>
            </div>

            <h1>No tienes productos para pedir</h1>

            <p>
                Agrega tus platos favoritos desde nuestra carta
                antes de registrar el pedido.
            </p>

            <a th:href="@{/carta}"
               class="btn-ir-carta">

                <i class="bi bi-journal-richtext"></i>
                Ir a la carta
            </a>
        </div>

        <!-- PEDIDO CON PRODUCTOS -->
        <div th:if="${carritoVacio == null or !carritoVacio}"
             class="row g-4 align-items-start">

            <!-- FORMULARIO -->
            <form th:action="@{/pedidos}"
                  th:object="${pedidoForm}"
                  method="post"
                  class="col-lg-7 pedido-formulario"
                  id="formularioPedido"
                  th:attr="data-cliente-logueado=${clienteLogueado}">

                <input type="hidden"
                       th:name="${_csrf.parameterName}"
                       th:value="${_csrf.token}">

                <!-- MODALIDAD DE ENTREGA -->
                <div class="pedido-formulario-seccion">

                    <div class="pedido-seccion-encabezado">

                        <div class="pedido-seccion-icono">
                            <i class="bi bi-shop"></i>
                        </div>

                        <div>
                            <h2>Modalidad de entrega</h2>

                            <p>
                                Selecciona Delivery o Recojo en local.
                            </p>
                        </div>
                    </div>

                    <div class="pedido-modalidades">

                        <!-- DELIVERY -->
                        <label class="pedido-modalidad"
                               for="tipoDelivery">

                            <input type="radio"
                                   id="tipoDelivery"
                                   th:field="*{tipoEntrega}"
                                   value="DELIVERY">

                            <span class="pedido-modalidad-contenido">

                                <span class="pedido-modalidad-icono">
                                    <i class="bi bi-truck"></i>
                                </span>

                                <span class="pedido-modalidad-texto">

                                    <strong>Delivery</strong>

                                    <small>
                                        Envío mediante InDrive u otro servicio externo.
                                    </small>
                                </span>

                                <span class="pedido-modalidad-check">
                                    <i class="bi bi-check-circle-fill"></i>
                                </span>
                            </span>
                        </label>

                        <!-- RECOJO EN LOCAL -->
                        <label class="pedido-modalidad"
                               for="tipoRecojo">

                            <input type="radio"
                                   id="tipoRecojo"
                                   th:field="*{tipoEntrega}"
                                   value="RECOJO_LOCAL">

                            <span class="pedido-modalidad-contenido">

                                <span class="pedido-modalidad-icono">
                                    <i class="bi bi-bag-check"></i>
                                </span>

                                <span class="pedido-modalidad-texto">

                                    <strong>Recojo en local</strong>

                                    <small>
                                        Recoge personalmente tu pedido en el restaurante.
                                    </small>
                                </span>

                                <span class="pedido-modalidad-check">
                                    <i class="bi bi-check-circle-fill"></i>
                                </span>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- INFORMACIÓN PERSONAL -->
                <div class="pedido-formulario-seccion"
                     id="seccionInformacionPersonal">

                    <div class="pedido-seccion-encabezado">

                        <div class="pedido-seccion-icono">
                            <i class="bi bi-person"></i>
                        </div>

                        <div>
                            <h2>Información personal</h2>

                            <p>
                                Datos de la persona que recibirá o recogerá el pedido.
                            </p>
                        </div>
                    </div>

                    <div th:if="${clienteLogueado}"
                         class="pedido-cuenta-aviso">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Utilizaremos los datos registrados en tu cuenta.
                        </span>
                    </div>

                    <div class="row g-3">

                        <!-- DNI -->
                        <div class="col-md-5">

                            <label for="dni"
                                   class="pedido-label">

                                DNI
                                <span>*</span>
                            </label>

                            <div class="pedido-input-contenedor">

                                <i class="bi bi-person-vcard"></i>

                                <input type="text"
                                       id="dni"
                                       class="pedido-input"
                                       th:field="*{dni}"
                                       maxlength="8"
                                       minlength="8"
                                       inputmode="numeric"
                                       pattern="[0-9]{8}"
                                       placeholder="Ej. 74125896"
                                       th:readonly="${clienteLogueado}"
                                       required>
                            </div>
                        </div>

                        <!-- TELÉFONO -->
                        <div class="col-md-7">

                            <label for="telefono"
                                   class="pedido-label">

                                Teléfono
                                <span>*</span>
                            </label>

                            <div class="pedido-input-contenedor">

                                <i class="bi bi-telephone"></i>

                                <input type="tel"
                                       id="telefono"
                                       class="pedido-input"
                                       th:field="*{telefono}"
                                       maxlength="9"
                                       minlength="9"
                                       inputmode="numeric"
                                       pattern="[0-9]{9}"
                                       placeholder="Ej. 987654321"
                                       required>
                            </div>
                        </div>

                        <!-- NOMBRES -->
                        <div class="col-md-6">

                            <label for="nombres"
                                   class="pedido-label">

                                Nombres
                                <span>*</span>
                            </label>

                            <div class="pedido-input-contenedor">

                                <i class="bi bi-person"></i>

                                <input type="text"
                                       id="nombres"
                                       class="pedido-input"
                                       th:field="*{nombres}"
                                       maxlength="50"
                                       placeholder="Ingresa tus nombres"
                                       th:readonly="${clienteLogueado}"
                                       required>
                            </div>
                        </div>

                        <!-- APELLIDOS -->
                        <div class="col-md-6">

                            <label for="apellidos"
                                   class="pedido-label">

                                Apellidos
                                <span>*</span>
                            </label>

                            <div class="pedido-input-contenedor">

                                <i class="bi bi-person"></i>

                                <input type="text"
                                       id="apellidos"
                                       class="pedido-input"
                                       th:field="*{apellidos}"
                                       maxlength="50"
                                       placeholder="Ingresa tus apellidos"
                                       th:readonly="${clienteLogueado}"
                                       required>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DIRECCIÓN PARA DELIVERY -->
                <div class="pedido-formulario-seccion"
                     id="seccionDireccion">

                    <div class="pedido-seccion-encabezado">

                        <div class="pedido-seccion-icono">
                            <i class="bi bi-geo-alt"></i>
                        </div>

                        <div>
                            <h2>Dirección de entrega</h2>

                            <p>
                                Indica dónde debe entregarse el pedido.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <!-- DIRECCIÓN -->
                        <div class="col-12">

                            <label for="direccionTexto"
                                   class="pedido-label">

                                Dirección
                                <span>*</span>
                            </label>

                            <div class="pedido-input-contenedor">

                                <i class="bi bi-house-door"></i>

                                <input type="text"
                                       id="direccionTexto"
                                       class="pedido-input campo-direccion"
                                       th:field="*{direccionTexto}"
                                       maxlength="200"
                                       placeholder="Ej. Av. Mariscal Cáceres 325">
                            </div>
                        </div>

                        <!-- DISTRITO -->
                        <div class="col-md-5">

                            <label for="distrito"
                                   class="pedido-label">

                                Distrito
                                <span>*</span>
                            </label>

                            <div class="pedido-input-contenedor">

                                <i class="bi bi-map"></i>

                                <input type="text"
                                       id="distrito"
                                       class="pedido-input campo-direccion"
                                       th:field="*{distrito}"
                                       maxlength="50"
                                       placeholder="Ej. Ayacucho">
                            </div>
                        </div>

                        <!-- REFERENCIA -->
                        <div class="col-md-7">

                            <label for="referencia"
                                   class="pedido-label">

                                Referencia
                                <span>*</span>
                            </label>

                            <div class="pedido-input-contenedor">

                                <i class="bi bi-signpost-2"></i>

                                <input type="text"
                                       id="referencia"
                                       class="pedido-input campo-direccion"
                                       th:field="*{referencia}"
                                       maxlength="200"
                                       placeholder="Ej. Frente al parque principal">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- OBSERVACIONES -->
                <div class="pedido-formulario-seccion">

                    <div class="pedido-seccion-encabezado">

                        <div class="pedido-seccion-icono">
                            <i class="bi bi-chat-left-text"></i>
                        </div>

                        <div>
                            <h2>Indicaciones adicionales</h2>

                            <p>
                                Puedes dejar una indicación para el pedido.
                            </p>
                        </div>
                    </div>

                    <label for="observaciones"
                           class="pedido-label">

                        Observaciones
                        <small>(opcional)</small>
                    </label>

                    <textarea id="observaciones"
                              class="pedido-textarea"
                              th:field="*{observaciones}"
                              rows="3"
                              maxlength="300"></textarea>
                </div>

                <!-- AVISO DELIVERY -->
                <div class="pedido-aviso-delivery"
                     id="avisoDelivery">

                    <i class="bi bi-info-circle-fill"></i>

                    <div>
                        <strong>Servicio de traslado</strong>

                        <p th:text="${mensajeTraslado}">
                            El servicio de delivery se coordina por separado.
                        </p>
                    </div>
                </div>

                <!-- AVISO RECOJO -->
                <div class="pedido-aviso-delivery aviso-recojo"
                     id="avisoRecojo">

                    <i class="bi bi-shop"></i>

                    <div>
                        <strong>Recojo en el restaurante</strong>

                        <p th:text="${mensajeRecojo}">
                            Podrás recoger tu pedido en el restaurante.
                        </p>
                    </div>
                </div>

                <!-- ACCIONES -->
                <div class="pedido-formulario-acciones">

                    <a th:href="@{/carrito}"
                       class="btn-regresar-carrito">

                        <i class="bi bi-arrow-left"></i>
                        Volver al carrito
                    </a>

                    <button type="submit"
                            class="btn-registrar-pedido">

                        Registrar pedido
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>

                <div class="pedido-siguiente-paso">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Después de registrar el pedido podrás pagar
                        mediante Yape, Plin o transferencia bancaria.
                    </span>
                </div>
            </form>

            <!-- RESUMEN DEL PEDIDO -->
            <div class="col-lg-5">

                <aside class="pedido-resumen">

                    <div class="pedido-resumen-encabezado">

                        <div>
                            <span>RESUMEN</span>
                            <h2>Tu pedido</h2>
                        </div>

                        <a th:href="@{/carrito}">

                            <i class="bi bi-pencil"></i>
                            Editar
                        </a>
                    </div>

                    <!-- PRODUCTOS -->
                    <div class="pedido-productos">

                        <article class="pedido-producto"
                                 th:each="item : ${items}">

                            <div class="pedido-producto-imagen">

                                <img th:if="${item.imagen != null and !#strings.isEmpty(item.imagen)}"
                                     th:src="${item.imagen}"
                                     th:alt="${item.nombre}"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

                                <div class="pedido-producto-sin-imagen"
                                     th:style="${item.imagen != null and !#strings.isEmpty(item.imagen)}
                                         ? 'display:none;'
                                         : 'display:flex;'">

                                    <i class="bi bi-image"></i>
                                </div>
                            </div>

                            <div class="pedido-producto-informacion">

                                <h3 th:text="${item.nombre}">
                                    Nombre del producto
                                </h3>

                                <span th:text="'Cantidad: ' + ${item.cantidad}">
                                    Cantidad: 1
                                </span>

                                <small th:text="'S/ ' + ${item.precioUnitario} + ' c/u'">
                                    S/ 0 c/u
                                </small>
                            </div>

                            <strong class="pedido-producto-subtotal"
                                    th:text="'S/ ' + ${item.subtotal}">
                                S/ 0
                            </strong>
