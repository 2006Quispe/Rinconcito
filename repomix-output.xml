    private boolean esDelivery(Pedido pedido) {

        return pedido != null
                && pedido.getTipoPedido()
                == Pedido.TipoPedido.DELIVERY;
    }

    private boolean esRecojoLocal(Pedido pedido) {

        return pedido != null
                && pedido.getTipoPedido()
                == Pedido.TipoPedido.RECOJO_LOCAL;
    }

    private String nombreModalidad(Pedido pedido) {

        if (pedido == null
                || pedido.getTipoPedido() == null) {
            return "PEDIDO";
        }

        if (esDelivery(pedido)) {
            return "DELIVERY";
        }

        if (esRecojoLocal(pedido)) {
            return "RECOJO EN LOCAL";
        }

        return "PRESENCIAL";
    }

    private String construirNombre(
            Usuario usuario
    ) {

        String nombres =
                valor(
                        usuario.getNombres(),
                        ""
                );

        String apellidos =
                valor(
                        usuario.getApellidos(),
                        ""
                );

        String nombreCompleto =
                (nombres + " " + apellidos).trim();

        return nombreCompleto.isBlank()
                ? "-"
                : nombreCompleto;
    }

    private String valor(
            String texto,
            String valorDefecto
    ) {

        if (texto == null || texto.isBlank()) {
            return valorDefecto;
        }

        return texto.trim();
    }

    private String recortar(
            String texto,
            int longitud
    ) {

        if (texto == null) {
            return "";
        }

        if (texto.length() <= longitud) {
            return texto;
        }

        return texto.substring(
                0,
                longitud - 3
        ) + "...";
    }

    private String limpiarTexto(
            String texto
    ) {

        if (texto == null) {
            return "";
        }

        String limpio =
                texto
                        .replace("×", "x")
                        .replace("–", "-")
                        .replace("—", "-")
                        .replace("“", "\"")
                        .replace("”", "\"")
                        .replace("‘", "'")
                        .replace("’", "'")
                        .replace("\n", " ")
                        .replace("\r", " ")
                        .replace("\t", " ");

        StringBuilder resultado =
                new StringBuilder();

        for (char caracter : limpio.toCharArray()) {

            if (caracter >= 32
                    && caracter <= 255) {

                resultado.append(caracter);

            } else if (Character.isWhitespace(caracter)) {

                resultado.append(' ');

            } else {

                resultado.append('?');
            }
        }

        return resultado.toString();
    }

    private class LienzoPdf {

        private final PDDocument documento;

        private PDPageContentStream contenido;

        private float y;

        private boolean paginaNueva;

        private LienzoPdf(
                PDDocument documento
        ) {
            this.documento = documento;
        }

        private void nuevaPagina()
                throws IOException {

            if (contenido != null) {
                contenido.close();
            }

            PDPage pagina =
                    new PDPage(
                            PDRectangle.A4
                    );

            documento.addPage(pagina);

            contenido =
                    new PDPageContentStream(
                            documento,
                            pagina
                    );

            y = 790;
            paginaNueva = true;
        }

        private void asegurarEspacio(
                float espacio
        ) throws IOException {

            if (y - espacio < 70) {
                nuevaPagina();
            }
        }

        private void texto(
                String texto,
                float x,
                float posicionY,
                float tamano,
                PDType1Font fuente
        ) throws IOException {

            texto(
                    texto,
                    x,
                    posicionY,
                    tamano,
                    fuente,
                    59,
                    42,
                    34
            );
        }

        private void texto(
                String texto,
                float x,
                float posicionY,
                float tamano,
                PDType1Font fuente,
                int rojo,
                int verde,
                int azul
        ) throws IOException {

            contenido.beginText();

            contenido.setFont(
                    fuente,
                    tamano
            );

            contenido.setNonStrokingColor(
                    rojo / 255f,
                    verde / 255f,
                    azul / 255f
            );

            contenido.newLineAtOffset(
                    x,
                    posicionY
            );

            contenido.showText(
                    limpiarTexto(texto)
            );

            contenido.endText();
        }

        private void textoCentrado(
                String texto,
                float inicioX,
                float ancho,
                float posicionY,
                float tamano,
                PDType1Font fuente
        ) throws IOException {

            String textoLimpio =
                    limpiarTexto(texto);

            float anchoTexto =
                    fuente.getStringWidth(
                            textoLimpio
                    )
                            / 1000
                            * tamano;

            float x =
                    inicioX
                            + (
                            ancho - anchoTexto
                    ) / 2;

            texto(
                    textoLimpio,
                    x,
                    posicionY,
                    tamano,
                    fuente
            );
        }

        private void linea(
                float posicionY
        ) throws IOException {

            contenido.setStrokingColor(
                    140 / 255f,
                    47 / 255f,
                    27 / 255f
            );

            contenido.setLineWidth(1);

            contenido.moveTo(
                    MARGEN,
                    posicionY
            );

            contenido.lineTo(
                    ANCHO_PAGINA - MARGEN,
                    posicionY
            );

            contenido.stroke();
        }

        private void lineaSuave(
                float posicionY
        ) throws IOException {

            contenido.setStrokingColor(
                    225 / 255f,
                    217 / 255f,
                    208 / 255f
            );

            contenido.setLineWidth(0.5f);

            contenido.moveTo(
                    MARGEN,
                    posicionY
            );

            contenido.lineTo(
                    ANCHO_PAGINA - MARGEN,
                    posicionY
            );

            contenido.stroke();
        }

        private void rectangulo(
                float x,
                float posicionY,
                float ancho,
                float alto,
                int rojo,
                int verde,
                int azul
        ) throws IOException {

            contenido.setStrokingColor(
                    rojo / 255f,
                    verde / 255f,
                    azul / 255f
            );

            contenido.setLineWidth(1.2f);

            contenido.addRect(
                    x,
                    posicionY,
                    ancho,
                    alto
            );

            contenido.stroke();
        }

        private void relleno(
                float x,
                float posicionY,
                float ancho,
                float alto,
                int rojo,
                int verde,
                int azul
        ) throws IOException {

            contenido.setNonStrokingColor(
                    rojo / 255f,
                    verde / 255f,
                    azul / 255f
            );

            contenido.addRect(
                    x,
                    posicionY,
                    ancho,
                    alto
            );

            contenido.fill();
        }

        private void tituloSeccion(
                String titulo
        ) throws IOException {

            asegurarEspacio(45);

            texto(
                    titulo,
                    MARGEN,
                    y,
                    10,
                    fuenteNegrita,
                    140,
                    47,
                    27
            );

            y -= 18;
        }

        private void cerrar()
                throws IOException {

            if (contenido != null) {
                contenido.close();
                contenido = null;
            }
        }
    }
}
