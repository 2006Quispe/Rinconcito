                                                <i class="bi bi-dash-lg"></i>
                                            </button>

                                            <input type="number"
                                                   th:field="*{items[__${estado.index}__].cantidad}"
                                                   class="cantidad-input"
                                                   min="0"
                                                   max="30"
                                                   step="1"
                                                   oninput="actualizarPedido()"
                                                   onchange="normalizarCantidad(this)">

                                            <button type="button"
                                                    class="cantidad-boton"
                                                    onclick="cambiarCantidad(this, 1)"
                                                    aria-label="Aumentar cantidad">

                                                <i class="bi bi-plus-lg"></i>
                                            </button>

                                        </div>

                                        <button type="button"
                                                class="btn-observacion"
                                                th:attr="data-bs-target=${'#observacionProducto'
                                                    + estado.index}"
                                                data-bs-toggle="collapse">

                                            <i class="bi bi-chat-left-text"></i>
                                            Indicaciones
                                        </button>

                                    </div>

                                    <div class="collapse producto-observacion"
                                         th:id="${'observacionProducto'
                                            + estado.index}">

                                        <label th:for="${'campoObservacion'
                                                + estado.index}">
                                            Indicaciones del producto
                                        </label>

                                        <input type="text"
                                               th:id="${'campoObservacion'
                                                    + estado.index}"
                                               th:field="*{items[__${estado.index}__].observaciones}"
                                               maxlength="200"
                                               placeholder="Ej.: sin cebolla, poco picante">

                                    </div>

                                </div>

                            </article>

                        </div>

                    </div>

                    <div id="sinResultados"
                         class="pedido-vacio d-none">

                        <i class="bi bi-search"></i>

                        <strong>
                            No se encontraron productos
                        </strong>

                        <span>
                            Intenta escribir otro nombre.
                        </span>

                    </div>

                </section>

                <section class="pedido-seccion">

                    <div class="pedido-seccion-encabezado">

                        <div class="pedido-seccion-icono">
                            <i class="bi bi-card-text"></i>
                        </div>

                        <div>
                            <h2>Observaciones generales</h2>

                            <p>
                                Agrega indicaciones generales
                                para el pedido.
                            </p>
                        </div>

                    </div>

                    <label for="observaciones"
                           class="form-label">
                        Observaciones
                    </label>

                    <textarea id="observaciones"
                              th:field="*{observaciones}"
                              class="form-control"
                              rows="3"
                              maxlength="300"
                              placeholder="Ej.: servir primero las entradas"></textarea>

                    <div class="form-text">
                        Este campo es opcional.
                    </div>

                </section>

                <section class="pedido-resumen">

                    <div class="pedido-resumen-informacion">

                        <span>Productos seleccionados</span>

                        <strong id="cantidadProductos">
                            0
                        </strong>

                    </div>

                    <div class="pedido-resumen-total">

                        <span>Total del pedido</span>

                        <strong id="totalPedido">
                            S/ 0
                        </strong>

                    </div>

                    <div class="pedido-acciones">

                        <a th:href="@{/mesero/mesas}"
                           class="btn-cancelar-pedido">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn-guardar-pedido"
                                id="btnGuardarPedido"
                                th:disabled="${mesas == null
                                    or #lists.isEmpty(mesas)
                                    or productos == null
                                    or #lists.isEmpty(productos)}">

                            <i class="bi bi-check-circle"></i>
                            Registrar pedido
                        </button>

                    </div>

                </section>

            </form>

        </main>

    </div>

</div>

