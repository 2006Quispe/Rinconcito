<file path="src/main/resources/static/css/mesero-pedidos.css">
:root {
    --mesero-sidebar-ancho: 265px;
    --mesero-vino: #8c2f1b;
    --mesero-vino-oscuro: #682114;
    --mesero-dorado: #d4a017;
    --mesero-crema: #f7f2e9;
    --mesero-blanco: #ffffff;
    --mesero-cafe: #3b2a22;
    --mesero-texto: #49372e;
    --mesero-texto-suave: #796a61;
    --mesero-borde: #e5d8ca;
    --mesero-verde: #5c6e49;
    --mesero-verde-claro: #edf2e8;
    --mesero-rojo-claro: #fff0ed;
    --mesero-sombra: 0 6px 18px rgba(59, 42, 34, 0.07);
}

* {
    box-sizing: border-box;
}

html {
    font-size: 14px;
}

body.mesero-body {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background-color: var(--mesero-crema);
    color: var(--mesero-texto);
    font-family: "Nunito", sans-serif;
}

button,
input,
select,
textarea {
    font-family: inherit;
}

.mesero-layout {
    min-height: 100vh;
}

.mesero-sidebar {
    position: fixed;
    z-index: 1000;
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--mesero-sidebar-ancho);
    display: flex;
    overflow: hidden;
    flex-direction: column;
    background: linear-gradient(
        180deg,
        #9b321e 0%,
        #6c2115 100%
    );
    color: var(--mesero-blanco);
    box-shadow: 4px 0 18px rgba(59, 42, 34, 0.12);
}

.mesero-sidebar-superior {
    padding: 1.2rem 1rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
}

.mesero-sidebar-marca {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--mesero-blanco);
    text-decoration: none;
}

.mesero-sidebar-marca:hover {
    color: var(--mesero-blanco);
}

.mesero-sidebar-logo {
    width: 44px;
    height: 44px;
    display: grid;
    flex: 0 0 44px;
    place-items: center;
    border-radius: 12px;
    background-color: var(--mesero-dorado);
    color: var(--mesero-cafe);
    font-size: 1.15rem;
}

.mesero-sidebar-nombre {
    min-width: 0;
}

.mesero-sidebar-nombre strong {
    display: block;
    overflow: hidden;
    color: var(--mesero-blanco);
    font-family: "Merriweather", serif;
    font-size: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mesero-sidebar-nombre small {
    display: block;
    margin-top: 0.12rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.7rem;
}

.mesero-sidebar-cerrar {
    display: none;
    border: 0;
    background-color: transparent;
    color: var(--mesero-blanco);
    font-size: 1.2rem;
}

.mesero-sidebar-menu {
    padding: 1rem 0.8rem;
    display: flex;
    overflow-y: auto;
    flex: 1;
    flex-direction: column;
    gap: 0.28rem;
}

.mesero-sidebar-menu::-webkit-scrollbar {
    width: 5px;
}

.mesero-sidebar-menu::-webkit-scrollbar-thumb {
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.2);
}

.mesero-sidebar-etiqueta {
    margin: 0.35rem 0.6rem 0.55rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.mesero-sidebar-etiqueta-separada {
    margin-top: 1rem;
}

.mesero-sidebar-enlace {
    position: relative;
    min-height: 55px;
    padding: 0.55rem 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-radius: 11px;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    transition:
        color 0.2s ease,
        background-color 0.2s ease,
        transform 0.2s ease;
}

.mesero-sidebar-enlace:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--mesero-blanco);
    transform: translateX(2px);
}

.mesero-sidebar-enlace.activo {
    background-color: var(--mesero-dorado);
    color: var(--mesero-cafe);
}

.mesero-sidebar-enlace.activo::before {
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: -0.8rem;
    width: 4px;
    border-radius: 0 4px 4px 0;
