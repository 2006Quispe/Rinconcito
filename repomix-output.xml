                                : null,
                        "-"
                );

        lienzo.texto(
                nombreRestaurante,
                MARGEN,
                lienzo.y,
                17,
                fuenteNegrita
        );

        lienzo.y -= 19;

        lienzo.texto(
                direccion,
                MARGEN,
                lienzo.y,
                9,
                fuenteNormal
        );

        lienzo.y -= 14;

        lienzo.texto(
                "Teléfono: " + telefono,
                MARGEN,
                lienzo.y,
                9,
                fuenteNormal
        );

        float cajaX = 360;
        float cajaY = 748;
        float cajaAncho = 190;
        float cajaAlto = 67;

        lienzo.rectangulo(
                cajaX,
                cajaY,
                cajaAncho,
                cajaAlto,
                140,
                47,
                27
        );

        lienzo.textoCentrado(
                "NOTA DE VENTA",
                cajaX,
                cajaAncho,
                cajaY + 43,
                14,
                fuenteNegrita
        );

        lienzo.textoCentrado(
                notaVentaService.formarNumero(nota),
                cajaX,
                cajaAncho,
                cajaY + 20,
                12,
                fuenteNegrita
        );

        lienzo.y -= 24;
        lienzo.linea(lienzo.y);
        lienzo.y -= 21;

        String fecha =
                nota.getFechaEmision() != null
                        ? nota.getFechaEmision().format(FORMATO_FECHA)
                        : "-";

        lienzo.texto(
                "Fecha de emisión: " + fecha,
