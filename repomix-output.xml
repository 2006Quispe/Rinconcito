}

.mesa-ocupada .mesa-estado {
    background-color: var(--mesero-rojo-claro);
    color: var(--mesero-rojo);
}

.mesa-reservada .mesa-estado {
    background-color: var(--mesero-naranja-claro);
    color: #a65d08;
}

.mesa-informacion {
    margin-top: 0.65rem;
    padding-top: 0.6rem;
    border-top: 1px solid #eee7df;
}

.mesa-capacidad {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    color: var(--mesero-texto-suave);
    font-size: 0.74rem;
}

.mesa-capacidad i {
    color: var(--mesero-vino);
}

.reserva-mesa {
    margin-top: 0.75rem;
    padding: 0.7rem;
    border-radius: 10px;
    background-color: #faf6f0;
}

.reserva-mesa-titulo {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    color: var(--mesero-vino);
    font-size: 0.71rem;
}

.reserva-codigo {
    margin: 0.42rem 0 0.28rem;
    color: var(--mesero-cafe);
    font-size: 0.7rem;
    font-weight: 800;
}

.reserva-cliente {
    margin: 0 0 0.35rem;
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    color: var(--mesero-texto);
    font-size: 0.74rem;
