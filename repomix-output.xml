                            <i class="bi bi-person-check"></i>

                            Este pedido está vinculado a una reserva.
                            La nota de venta utilizará los datos
                            del cliente reservado.
                        </div>

                        <div th:if="${mesas == null
                                or #lists.isEmpty(mesas)}"
                             class="alert alert-warning mt-3 mb-0">

                            No existen mesas ocupadas disponibles.
                            Primero debes ocupar una mesa desde
                            Control de mesas.
                        </div>

                    </div>

                </section>

                <section class="pedido-seccion">

                    <div class="pedido-seccion-encabezado productos-encabezado">

                        <div class="d-flex align-items-start gap-3">

                            <div class="pedido-seccion-icono">
                                <i class="bi bi-journal-richtext"></i>
                            </div>

                            <div>
                                <h2>Productos del pedido</h2>

                                <p>
                                    Utiliza los botones − y +
                                    para indicar las cantidades.
                                </p>
                            </div>

                        </div>

                        <div class="producto-buscador">

                            <i class="bi bi-search"></i>

                            <input type="search"
                                   id="buscarProducto"
                                   placeholder="Buscar producto"
                                   autocomplete="off">

                        </div>

                    </div>

                    <div th:if="${productos == null
                            or #lists.isEmpty(productos)}"
                         class="pedido-vacio">

                        <i class="bi bi-basket"></i>

                        <strong>
                            No hay productos disponibles
                        </strong>

                        <span>
                            Actualmente no existen productos
                            activos para registrar el pedido.
                        </span>

                    </div>

                    <div th:if="${productos != null
                            and !#lists.isEmpty(productos)}"
                         class="productos-grid"
                         id="productosGrid">

                        <div th:each="producto, estado : ${productos}"
                             class="producto-contenedor">

                            <article th:if="${producto != null}"
                                     class="producto-pedido"
                                     th:attr="
                                        data-nombre=${#strings.toLowerCase(
                                            producto.nombre != null
                                            ? producto.nombre
                                            : ''
                                        )},
                                        data-precio=${producto.precio != null
                                            ? producto.precio
                                            : 0}
                                     ">

                                <input type="hidden"
                                       th:field="*{items[__${estado.index}__].idProducto}">

                                <div class="producto-imagen">

                                    <img th:if="${producto.imagen != null
                                            and !#strings.isEmpty(producto.imagen)}"
                                         th:src="${producto.imagen}"
                                         th:alt="${producto.nombre != null
                                            ? producto.nombre
                                            : 'Producto'}"
                                         onerror="this.style.display='none';
                                         this.nextElementSibling.style.display='flex';">

                                    <div class="producto-sin-imagen"
                                         th:style="${producto.imagen != null
                                            and !#strings.isEmpty(producto.imagen)}
                                            ? 'display:none;'
                                            : 'display:flex;'">

                                        <i class="bi bi-image"></i>
                                    </div>

                                </div>

                                <div class="producto-informacion">

                                    <div class="producto-cabecera">

                                        <div>

                                            <span class="producto-categoria"
                                                  th:text="${producto.categoria != null
                                                    and producto.categoria.nombre != null
                                                    ? producto.categoria.nombre
                                                    : 'Sin categoría'}">
                                                Categoría
                                            </span>

                                            <h3 th:text="${producto.nombre != null
                                                    ? producto.nombre
                                                    : 'Producto'}">
                                                Producto
                                            </h3>

                                        </div>

                                        <strong class="producto-precio"
                                                th:text="${'S/ '
                                                    + (producto.precio != null
