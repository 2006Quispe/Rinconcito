    color: var(--mesero-blanco);
    font-size: 0.68rem;
    font-weight: 800;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.mesero-sidebar-salir:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.mesero-sidebar-fondo {
    display: none;
}

.mesero-pagina {
    width: calc(100% - var(--mesero-sidebar-ancho));
    min-height: 100vh;
    margin-left: var(--mesero-sidebar-ancho);
}

.pedido-encabezado {
    width: calc(100% - 2.2rem);
    max-width: 1580px;
    margin: 0 auto 1.2rem;
    padding-top: 1.45rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
}

.pedido-encabezado > div:first-child {
    min-width: 0;
}

.pedido-etiqueta {
    margin: 0 0 0.25rem;
    color: var(--mesero-vino);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.pedido-encabezado h1 {
    margin: 0;
    color: var(--mesero-cafe);
    font-family: "Merriweather", serif;
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
}

.pedido-encabezado > div:first-child > p:last-child {
    margin: 0.35rem 0 0;
