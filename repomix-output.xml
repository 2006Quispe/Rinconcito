    font-size: 0.65rem;
}

.experiencia-tarjeta {
    min-height: 130px;
    padding: 0.95rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border: 1px solid rgba(116, 31, 24, 0.17);
    border-radius: 10px;
    background-color: rgba(250, 245, 238, 0.65);
    box-shadow: 0 5px 17px rgba(46, 33, 28, 0.04);
