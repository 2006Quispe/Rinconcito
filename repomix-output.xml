    .hero-contenedor {
        padding-top: 2.2rem;
        padding-bottom: 3.2rem;
    }

    .hero-informacion {
        max-width: 650px;
        margin: 0 auto;
        text-align: center;
    }

    .hero-descripcion {
        margin-right: auto;
        margin-left: auto;
    }

    .hero-acciones,
    .hero-beneficios {
        justify-content: center;
    }

    .hero-carrusel-contenedor {
        max-width: 600px;
        margin: 1rem auto 0;
    }

    .reservas-disponibles {
        right: 50%;
        transform: translateX(50%);
