                Publica la primera fotografía para que aparezca
                en la página pública del restaurante.
            </p>

            <a th:href="@{/admin/galeria/nueva}"
               class="btn-nueva-imagen">

                <i class="bi bi-plus-lg"></i>
                Publicar primera imagen
            </a>

        </section>

        <section th:unless="${#lists.isEmpty(imagenes)}"
                 class="galeria-grid">

            <article th:each="imagen : ${imagenes}"
                     class="galeria-tarjeta"
                     th:classappend="${imagen.estado.name()
                            == 'INACTIVO'}
                            ? ' galeria-tarjeta-inactiva'">

                <div class="galeria-imagen-contenedor">

                    <img th:src="${imagen.rutaImagen}"
                         th:alt="${imagen.titulo != null
                                ? imagen.titulo
                                : 'Imagen de la galería'}"
                         class="galeria-imagen"
                         loading="lazy">

                    <span class="galeria-estado"
                          th:classappend="${imagen.estado.name()
                                == 'ACTIVO'}
                                ? ' estado-activo'
                                : ' estado-inactivo'">

                        <i th:class="${imagen.estado.name()
                                == 'ACTIVO'}
                                ? 'bi bi-eye'
                                : 'bi bi-eye-slash'">
                        </i>

                        <span th:text="${imagen.estado.name()
                                == 'ACTIVO'}
                                ? 'Visible'
                                : 'Oculta'">
                            Visible
                        </span>

                    </span>

                </div>

                <div class="galeria-tarjeta-cuerpo">

                    <h2 th:text="${imagen.titulo != null
                            and !imagen.titulo.isBlank()}
                            ? imagen.titulo
                            : 'Sin título'">
                        Fotografía
                    </h2>

                    <p class="galeria-descripcion"
                       th:text="${imagen.descripcion != null
                            and !imagen.descripcion.isBlank()}
                            ? imagen.descripcion
                            : 'Sin descripción.'">
                        Descripción
                    </p>

                    <div class="galeria-fecha">

                        <i class="bi bi-calendar3"></i>

                        <span th:text="${#temporals.format(
                                imagen.fechaPublicacion,
                                'dd/MM/yyyy HH:mm'
                              )}">
                            09/10/2026 14:30
                        </span>

                    </div>

                </div>

                <div class="galeria-tarjeta-acciones">

                    <a th:href="@{/admin/galeria/{id}/editar(
                            id=${imagen.idImagen}
                         )}"
                       class="btn-editar-imagen">

                        <i class="bi bi-pencil"></i>
                        Editar
                    </a>

                    <form th:action="@{/admin/galeria/{id}/estado(
                            id=${imagen.idImagen}
                           )}"
                          method="post">

                        <input type="hidden"
                               th:name="${_csrf.parameterName}"
                               th:value="${_csrf.token}">

                        <input type="hidden"
                               name="estado"
                               th:value="${imagen.estado.name()
                                    == 'ACTIVO'}
                                    ? 'INACTIVO'
                                    : 'ACTIVO'">

                        <button type="submit"
                                class="btn-estado-imagen"
                                th:classappend="${imagen.estado.name()
                                    == 'ACTIVO'}
                                    ? ' btn-ocultar-imagen'
                                    : ' btn-mostrar-imagen'">

                            <i th:class="${imagen.estado.name()
                                    == 'ACTIVO'}
                                    ? 'bi bi-eye-slash'
                                    : 'bi bi-eye'">
                            </i>

                            <span th:text="${imagen.estado.name()
                                    == 'ACTIVO'}
                                    ? 'Ocultar'
                                    : 'Mostrar'">
                                Ocultar
                            </span>

                        </button>

                    </form>

                    <form th:action="@{/admin/galeria/{id}/eliminar(
                            id=${imagen.idImagen}
                           )}"
                          method="post"
                          onsubmit="return confirm(
                            '¿Deseas eliminar definitivamente esta imagen?'
                          );">

                        <input type="hidden"
                               th:name="${_csrf.parameterName}"
                               th:value="${_csrf.token}">

                        <button type="submit"
                                class="btn-eliminar-imagen"
                                title="Eliminar imagen">

                            <i class="bi bi-trash"></i>

                        </button>

                    </form>

                </div>

            </article>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/mesa-form.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Mesa
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

    <link th:href="@{/css/admin-pisos-mesas.css(v=1)}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar
        :: sidebar('mesas')}">
    </aside>

    <main class="admin-contenido piso-mesa-form-contenido">

        <header class="formulario-encabezado">

            <div>
                <p class="pisos-mesas-etiqueta">
                    ADMINISTRACIÓN
                </p>

                <h1 th:text="${mesaForm.esNueva()}
                    ? 'Registrar mesa'
                    : 'Editar mesa'">
                    Registrar mesa
                </h1>

                <p>
                    Define el piso, número, capacidad y
                    disponibilidad de la mesa.
                </p>
            </div>
        </header>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${pisos == null or pisos.isEmpty()}"
             class="alert alert-warning">

            No existen pisos activos. Primero debes registrar
            o activar un piso.

            <a th:href="@{/admin/pisos/nuevo}"
               class="alert-link">
                Registrar piso
            </a>

        </div>

        <form th:if="${pisos != null and !pisos.isEmpty()}"
              th:action="@{/admin/mesas/guardar}"
              th:object="${mesaForm}"
              method="post"
              class="formulario-panel">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

            <input type="hidden"
                   th:field="*{idMesa}">

            <div class="formulario-seccion-titulo">

                <div class="formulario-seccion-icono">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>

                <div>
                    <h2>Información de la mesa</h2>

                    <p>
                        Los campos marcados con asterisco
                        son obligatorios.
                    </p>
                </div>

            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label for="idPiso"
                           class="form-label">
                        Piso
                        <span>*</span>
                    </label>

                    <select id="idPiso"
                            th:field="*{idPiso}"
                            class="form-select"
                            required>

                        <option value="">
                            Selecciona un piso
                        </option>

                        <option th:each="piso : ${pisos}"
                                th:value="${piso.idPiso}"
                                th:text="${piso.nombre}">
                            Primer piso
                        </option>

                    </select>

                    <div class="form-text">
                        Cada número de mesa es único
                        dentro de su piso.
                    </div>

                </div>

                <div class="col-md-6">

                    <label for="numero"
                           class="form-label">
                        Número de mesa
                        <span>*</span>
                    </label>

                    <input type="number"
                           id="numero"
                           th:field="*{numero}"
                           class="form-control"
                           min="1"
                           max="999"
                           step="1"
                           placeholder="Ejemplo: 1"
                           required>

                    <div class="form-text">
                        Ingresa un número entre 1 y 999.
                    </div>

                </div>

                <div class="col-md-6">

                    <label for="capacidad"
                           class="form-label">
                        Capacidad
                        <span>*</span>
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-people"></i>
                        </span>

                        <input type="number"
                               id="capacidad"
                               th:field="*{capacidad}"
                               class="form-control"
                               min="1"
                               max="30"
                               step="1"
                               placeholder="Ejemplo: 4"
                               required>

                        <span class="input-group-text">
                            personas
                        </span>

                    </div>

                    <div class="form-text">
                        Capacidad máxima permitida:
                        30 personas.
                    </div>

                </div>

                <div class="col-md-6">

                    <label for="estado"
                           class="form-label">
                        Estado administrativo
                        <span>*</span>
                    </label>

                    <select id="estado"
                            th:field="*{estado}"
                            class="form-select"
                            required>

                        <option value="DISPONIBLE">
                            Disponible
                        </option>

                        <option value="INACTIVA">
                            Inactiva
                        </option>

                    </select>

                    <div class="form-text">
                        Los estados ocupada y reservada
                        serán gestionados por el mozo.
                    </div>

                </div>

            </div>

            <div class="alert alert-info mt-4 mb-0">

                <i class="bi bi-info-circle me-1"></i>

                El cliente no seleccionará una mesa específica.
                Solamente escogerá el piso y el sistema asignará
                automáticamente una mesa con capacidad suficiente.

            </div>

            <div class="formulario-acciones">

                <a th:href="@{/admin/pisos-mesas(
                        piso=${mesaForm.idPiso}
                   )}"
                   class="btn-cancelar">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-guardar">

                    <i class="bi bi-floppy"></i>

                    <span th:text="${mesaForm.esNueva()}
                        ? 'Registrar mesa'
                        : 'Guardar cambios'">
                        Guardar
                    </span>

                </button>

            </div>

        </form>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/pedidos.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Consultar pedidos
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

    <link th:href="@{/css/admin-pedidos.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar
        :: sidebar('pedidos')}">
    </aside>

    <main class="admin-contenido pedidos-admin-contenido">

        <header class="pedidos-encabezado">

            <div>
                <p class="pedidos-etiqueta">
                    ADMINISTRACIÓN
                </p>

                <h1>Consultar pedidos</h1>

                <p>
                    Revisa los pedidos registrados, sus productos,
                    modalidad de entrega y estado actual.
                </p>
        </header>

        <section class="pedidos-resumen">

            <article class="pedido-resumen-card">

                <div class="pedido-resumen-icono total">
                    <i class="bi bi-bag"></i>
                </div>

                <div>
                    <span>Total encontrados</span>

                    <strong th:text="${totalPedidos}">
                        0
                    </strong>
                </div>

            </article>

            <article class="pedido-resumen-card">

                <div class="pedido-resumen-icono pendiente">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <span>Pendientes de pago</span>

                    <strong th:text="${pendientesPago}">
                        0
                    </strong>
                </div>

            </article>

            <article class="pedido-resumen-card">

                <div class="pedido-resumen-icono validacion">
                    <i class="bi bi-search"></i>
                </div>

                <div>
                    <span>Por validar</span>

                    <strong th:text="${pendientesValidacion}">
                        0
                    </strong>
                </div>

            </article>

            <article class="pedido-resumen-card">

                <div class="pedido-resumen-icono confirmado">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div>
                    <span>Confirmados</span>

                    <strong th:text="${confirmados}">
                        0
                    </strong>
                </div>

            </article>

            <article class="pedido-resumen-card">

                <div class="pedido-resumen-icono importe">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <span>Importe mostrado</span>

                    <strong th:text="'S/ ' + ${totalImporte}">
                        S/ 0
                    </strong>
                </div>

            </article>

        </section>

        <section class="pedidos-filtros">

            <div class="pedidos-filtros-encabezado">

                <div class="pedidos-filtros-icono">
                    <i class="bi bi-funnel"></i>
                </div>

                <div>
                    <h2>Filtros de búsqueda</h2>

                    <p>
                        Busca por código, cliente o DNI y combina
                        los demás filtros.
                    </p>
                </div>

            </div>

            <form method="get"
                  th:action="@{/admin/pedidos}"
                  class="pedidos-filtros-formulario">

                <div class="filtro-campo filtro-busqueda">

                    <label for="q">
                        Buscar pedido
                    </label>

                    <div class="campo-con-icono">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               id="q"
                               name="q"
                               class="form-control"
                               maxlength="100"
                               placeholder="Código, cliente o DNI"
                               th:value="${filtroBusqueda}">

                    </div>

                </div>

                <div class="filtro-campo">

                    <label for="fecha">
                        Fecha
                    </label>

                    <input type="date"
                           id="fecha"
                           name="fecha"
                           class="form-control"
                           th:value="${filtroFecha}">

                </div>

                <div class="filtro-campo">

                    <label for="tipoPedido">
                        Modalidad
                    </label>

                    <select id="tipoPedido"
                            name="tipoPedido"
                            class="form-select">

                        <option value="">
                            Todas
                        </option>

                        <option th:each="tipo : ${tiposPedido}"
                                th:value="${tipo}"
                                th:selected="${filtroTipoPedido
                                    == tipo}"
                                th:text="${#strings.replace(
                                    tipo.name(),
                                    '_',
                                    ' '
                                )}">
                            Modalidad
                        </option>

                    </select>

                </div>

                <div class="filtro-campo">

                    <label for="estado">
                        Estado
                    </label>

                    <select id="estado"
                            name="estado"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        <option th:each="estadoPedido : ${estados}"
                                th:value="${estadoPedido}"
                                th:selected="${filtroEstado
                                    == estadoPedido}"
                                th:text="${#strings.replace(
                                    estadoPedido.name(),
                                    '_',
                                    ' '
                                )}">
                            Estado
                        </option>

                    </select>

                </div>

                <div class="pedidos-filtros-acciones">

                    <button type="submit"
                            class="btn-filtrar-pedidos">

                        <i class="bi bi-search"></i>
                        Filtrar
                    </button>

                    <a th:href="@{/admin/pedidos}"
                       class="btn-limpiar-filtros">

                        <i class="bi bi-arrow-counterclockwise"></i>
                        Limpiar
                    </a>

                </div>

            </form>

        </section>

        <section class="pedidos-panel">

            <div class="pedidos-panel-encabezado">

                <div>
                    <h2>Pedidos registrados</h2>

                    <p>
                        Resultados encontrados con los filtros
                        seleccionados.
                    </p>
                </div>

                <span class="pedidos-contador"
                      th:text="${totalPedidos}
                          + ' pedidos'">
                    0 pedidos
                </span>

            </div>

            <div th:if="${pedidos == null
                or pedidos.isEmpty()}"
                 class="pedidos-vacios">

                <div class="pedidos-vacios-icono">
                    <i class="bi bi-bag-x"></i>
                </div>

                <h3>No se encontraron pedidos</h3>

                <p>
                    Prueba modificando o eliminando
                    los filtros de búsqueda.
                </p>

                <a th:href="@{/admin/pedidos}"
                   class="btn-limpiar-vacio">

                    <i class="bi bi-arrow-counterclockwise"></i>
                    Limpiar filtros
                </a>

            </div>

            <div class="pedidos-tabla-contenedor"
                 th:if="${pedidos != null
                    and !pedidos.isEmpty()}">

                <div class="table-responsive">

                    <table class="pedidos-tabla">

                        <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Productos</th>
                            <th>Modalidad</th>
                            <th>Entrega</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Total</th>
                        </tr>
                        </thead>

                        <tbody>

                        <tr th:each="pedido : ${pedidos}">

                            <td>

                                <span class="pedido-codigo"
                                      th:text="${pedido.codigoPedido}">
                                    PED-2026-000001
                                </span>

                                <span class="pedido-observacion"
                                      th:if="${pedido.observaciones != null
                                          and !pedido.observaciones.isBlank()}"
                                      th:text="${pedido.observaciones}">
                                    Observaciones
                                </span>

                            </td>

                            <td>

                                <div class="pedido-cliente">

                                    <div class="pedido-cliente-icono">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>
                                        <strong th:text="${pedido.cliente.nombres
                                            + ' '
                                            + pedido.cliente.apellidos}">
                                            Cliente
                                        </strong>

                                        <span th:text="'DNI '
                                            + ${pedido.cliente.dni}">
                                            DNI
                                        </span>

                                        <span th:if="${pedido.cliente.telefono != null}"
                                              th:text="'Tel. '
                                                  + ${pedido.cliente.telefono}">
                                            Teléfono
                                        </span>
                                    </div>

                                </div>

                            </td>

                            <td>

                                <ul class="pedido-productos"
                                    th:if="${detallesPorPedido[
                                        pedido.idPedido
                                    ] != null}">

                                    <li th:each="detalle : ${detallesPorPedido[
                                            pedido.idPedido
                                        ]}">

                                        <span th:text="${detalle.producto.nombre}">
                                            Producto
                                        </span>

                                        <strong th:text="'x'
                                            + ${detalle.cantidad}">
                                            x1
                                        </strong>

                                    </li>

                                </ul>

                                <span class="sin-productos"
                                      th:if="${detallesPorPedido[
                                          pedido.idPedido
                                      ] == null
                                      or detallesPorPedido[
                                          pedido.idPedido
                                      ].isEmpty()}">
                                    Sin productos
                                </span>

                            </td>

                            <td>

                                <span class="pedido-modalidad"
                                      th:classappend="' modalidad-'
                                          + ${#strings.toLowerCase(
                                              pedido.tipoPedido.name()
                                          )}">

                                    <i th:class="${pedido.tipoPedido.name()
                                        == 'DELIVERY'}
                                        ? 'bi bi-scooter'
                                        : 'bi bi-shop'">
                                    </i>

                                    <span th:text="${#strings.replace(
                                        pedido.tipoPedido.name(),
                                        '_',
                                        ' '
                                    )}">
                                        Modalidad
                                    </span>

                                </span>

                            </td>

                            <td>

                                <div th:if="${pedido.tipoPedido.name()
                                    == 'DELIVERY'
                                    and pedido.direccion != null}"
                                     class="pedido-entrega">

                                    <strong th:text="${pedido.direccion.direccion}">
                                        Dirección
                                    </strong>

                                    <span th:text="${pedido.direccion.distrito}">
                                        Distrito
                                    </span>

                                    <span th:if="${pedido.direccion.referencia != null
                                        and !pedido.direccion.referencia.isBlank()}"
                                          th:text="'Ref. '
                                              + ${pedido.direccion.referencia}">
                                        Referencia
                                    </span>

                                </div>

                                <div th:unless="${pedido.tipoPedido.name()
                                    == 'DELIVERY'
                                    and pedido.direccion != null}"
                                     class="pedido-recojo">

                                    <i class="bi bi-shop"></i>
                                    Recojo en el local
                                </div>

                            </td>

                            <td>

                                <span class="pedido-fecha">

                                    <i class="bi bi-calendar3"></i>

                                    <span th:text="${#temporals.format(
                                        pedido.fechaRegistro,
                                        'dd/MM/yyyy'
                                    )}">
                                        Fecha
                                    </span>

                                </span>

                                <span class="pedido-hora"
                                      th:text="${#temporals.format(
                                          pedido.fechaRegistro,
                                          'HH:mm'
                                      )}">
                                    Hora
                                </span>

                            </td>

                            <td>

                                <span class="pedido-estado"
                                      th:classappend="' estado-'
                                          + ${#strings.toLowerCase(
                                              pedido.estado.name()
                                          )}"
                                      th:text="${#strings.replace(
                                          pedido.estado.name(),
                                          '_',
                                          ' '
                                      )}">
                                    Estado
                                </span>

                            </td>

                            <td>

                                <div class="pedido-total">

                                    <strong th:text="'S/ '
                                        + ${pedido.total}">
                                        S/ 0
                                    </strong>

                                    <span th:if="${pedido.costoDelivery != null
                                        and pedido.costoDelivery > 0}"
                                          th:text="'Delivery S/ '
                                              + ${pedido.costoDelivery}">
                                        Delivery
                                    </span>

                                </div>

                            </td>

                        </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/piso-form.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Piso
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

    <link th:href="@{/css/admin-pisos-mesas.css(v=1)}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar
        :: sidebar('mesas')}">
    </aside>

    <main class="admin-contenido piso-mesa-form-contenido">

        <header class="formulario-encabezado">

            <div>
                <p class="pisos-mesas-etiqueta">
                    ADMINISTRACIÓN
                </p>

                <h1 th:text="${pisoForm.esNuevo()}
                    ? 'Registrar piso'
                    : 'Editar piso'">
                    Registrar piso
                </h1>

                <p>
                    Configura el nombre, descripción y estado
                    del piso del restaurante.
                </p>
            </div>
        </header>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <form th:action="@{/admin/pisos/guardar}"
              th:object="${pisoForm}"
              method="post"
              class="formulario-panel">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

            <input type="hidden"
                   th:field="*{idPiso}">

            <div class="formulario-seccion-titulo">

                <div class="formulario-seccion-icono">
                    <i class="bi bi-building"></i>
                </div>

                <div>
                    <h2>Información del piso</h2>

                    <p>
                        Los campos marcados con asterisco
                        son obligatorios.
                    </p>
                </div>

            </div>

            <div class="row g-3">

                <div class="col-md-7">

                    <label for="nombre"
                           class="form-label">
                        Nombre del piso
                        <span>*</span>
                    </label>

                    <input type="text"
                           id="nombre"
                           th:field="*{nombre}"
                           class="form-control"
                           minlength="2"
                           maxlength="20"
                           pattern="[\p{L}0-9 .'-]{2,20}"
                           placeholder="Ejemplo: Primer piso"
                           required>

                    <div class="form-text">
                        Puedes usar nombres como Primer piso,
                        Segundo piso o Terraza.
                    </div>

                </div>

                <div class="col-md-5">

                    <label for="estado"
                           class="form-label">
                        Estado
                        <span>*</span>
                    </label>

                    <select id="estado"
                            th:field="*{estado}"
                            class="form-select"
                            required>

                        <option value="ACTIVO">
                            Activo
                        </option>

                        <option value="INACTIVO">
                            Inactivo
                        </option>

                    </select>

                    <div class="form-text">
                        Los pisos inactivos no estarán
                        disponibles para nuevas reservas.
                    </div>

                </div>

                <div class="col-12">

                    <label for="descripcion"
                           class="form-label">
                        Descripción
                    </label>

                    <textarea id="descripcion"
                              th:field="*{descripcion}"
                              class="form-control"
                              maxlength="200"
                              rows="4"
                              placeholder="Describe brevemente la ubicación o características del piso">
                    </textarea>

                    <div class="form-text">
                        Máximo 200 caracteres.
                    </div>

                </div>

            </div>

            <div class="formulario-acciones">

                <a th:href="@{/admin/pisos-mesas}"
                   class="btn-cancelar">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-guardar">

                    <i class="bi bi-floppy"></i>

                    <span th:text="${pisoForm.esNuevo()}
                        ? 'Registrar piso'
                        : 'Guardar cambios'">
                        Guardar
                    </span>

                </button>

            </div>

        </form>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/pisos-mesas.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Pisos y mesas
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

    <link th:href="@{/css/admin-pisos-mesas.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

	<aside th:replace="~{fragments/admin-sidebar
	    :: sidebar('mesas')}">
	</aside>

    <main class="admin-contenido pisos-mesas-contenido">

        <header class="pisos-mesas-encabezado">

            <div>
                <p class="pisos-mesas-etiqueta">
                    ADMINISTRACIÓN
                </p>

                <h1>Pisos y mesas</h1>

                <p>
                    Configura la distribución, capacidad y
                    disponibilidad de las mesas del restaurante.
                </p>
            </div>

            <div class="encabezado-acciones">

                <a th:href="@{/admin/pisos/nuevo}"
                   class="btn-secundario">

                    <i class="bi bi-building-add"></i>
                    Nuevo piso
                </a>

                <a th:if="${pisos != null
                    and !pisos.isEmpty()}"
                   th:href="@{/admin/mesas/nueva(
                        piso=${idPisoSeleccionado}
                   )}"
                   class="btn-principal">

                    <i class="bi bi-plus-lg"></i>
                    Nueva mesa
                </a>

            </div>

        </header>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <!-- Pisos -->

        <section class="pisos-seccion">

            <div class="seccion-titulo">

                <div>
                    <h2>Pisos registrados</h2>

                    <p>
                        Selecciona un piso para filtrar sus mesas.
                    </p>
                </div>

                <a th:href="@{/admin/pisos-mesas}"
                   class="enlace-ver-todos"
                   th:classappend="${idPisoSeleccionado == null}
                       ? ' enlace-activo'
                       : ''">

                    <i class="bi bi-grid"></i>
                    Ver todos
                </a>

            </div>

            <div th:if="${pisos == null or pisos.isEmpty()}"
                 class="estado-vacio">

                <div class="estado-vacio-icono">
                    <i class="bi bi-building"></i>
                </div>

                <h3>No hay pisos registrados</h3>

                <p>
                    Registra el primer piso para comenzar
                    a agregar mesas.
                </p>

                <a th:href="@{/admin/pisos/nuevo}"
                   class="btn-principal">

                    <i class="bi bi-plus-lg"></i>
                    Registrar piso
                </a>

            </div>

            <div class="pisos-grid"
                 th:if="${pisos != null
                    and !pisos.isEmpty()}">

                <article th:each="piso : ${pisos}"
                         class="piso-tarjeta"
                         th:classappend="${idPisoSeleccionado != null
                             and idPisoSeleccionado == piso.idPiso}
                             ? ' piso-tarjeta-activa'
                             : ''">

                    <div class="piso-tarjeta-superior">

                        <div class="piso-icono">
                            <i class="bi bi-building"></i>
                        </div>

                        <span class="estado-piso"
                              th:classappend="${piso.estado.name()
                                  == 'ACTIVO'}
                                  ? ' estado-activo'
                                  : ' estado-inactivo'"
                              th:text="${piso.estado.name()
                                  == 'ACTIVO'}
                                  ? 'Activo'
                                  : 'Inactivo'">
                            Activo
                        </span>

                    </div>

                    <div class="piso-informacion">

                        <h3 th:text="${piso.nombre}">
                            Primer piso
                        </h3>

                        <p th:text="${piso.descripcion != null
                            and !piso.descripcion.isBlank()}
                            ? piso.descripcion
                            : 'Sin descripción registrada.'">
                            Descripción
                        </p>

                    </div>

                    <div class="piso-estadisticas">

                        <div>
                            <strong th:text="${totalMesasPorPiso[
                                piso.idPiso]}">
                                0
                            </strong>

                            <span>Total</span>
                        </div>

                        <div>
                            <strong class="texto-disponible"
                                    th:text="${mesasDisponiblesPorPiso[
                                        piso.idPiso]}">
                                0
                            </strong>

                            <span>Disponibles</span>
                        </div>

                        <div>
                            <strong class="texto-ocupada"
                                    th:text="${mesasOcupadasPorPiso[
                                        piso.idPiso]}">
                                0
                            </strong>

                            <span>Ocupadas</span>
                        </div>

                        <div>
                            <strong class="texto-reservada"
                                    th:text="${mesasReservadasPorPiso[
                                        piso.idPiso]}">
                                0
                            </strong>

                            <span>Reservadas</span>
                        </div>

                    </div>

                    <div class="piso-acciones">

                        <a th:href="@{/admin/pisos-mesas(
                                piso=${piso.idPiso}
                           )}"
                           class="btn-ver-mesas">

                            <i class="bi bi-grid-3x3-gap"></i>
                            Ver mesas
                        </a>

                        <a th:href="@{/admin/pisos/{id}/editar(
                                id=${piso.idPiso}
                           )}"
                           class="btn-icono"
                           title="Editar piso">

                            <i class="bi bi-pencil"></i>
                        </a>

                        <form th:action="@{/admin/pisos/{id}/estado(
                                id=${piso.idPiso}
                              )}"
                              method="post">

                            <input type="hidden"
                                   th:name="${_csrf.parameterName}"
                                   th:value="${_csrf.token}">

                            <button type="submit"
                                    class="btn-icono"
                                    th:classappend="${piso.estado.name()
                                        == 'ACTIVO'}
                                        ? ' btn-desactivar'
                                        : ' btn-activar'"
                                    th:title="${piso.estado.name()
                                        == 'ACTIVO'}
                                        ? 'Desactivar piso'
                                        : 'Activar piso'"
                                    onclick="return confirm(
                                        '¿Deseas cambiar el estado de este piso?'
                                    );">

                                <i th:class="${piso.estado.name()
                                    == 'ACTIVO'}
                                    ? 'bi bi-pause-circle'
                                    : 'bi bi-play-circle'">
                                </i>

                            </button>

                        </form>

                    </div>

                </article>

            </div>

        </section>

        <!-- Mesas -->

        <section class="mesas-seccion">

            <div class="seccion-titulo">

                <div>
                    <h2>
                        Mesas

                        <span th:if="${idPisoSeleccionado != null}"
                              class="filtro-indicador">
                            Piso seleccionado
                        </span>
                    </h2>

                    <p>
                        La ocupación diaria será gestionada
                        posteriormente desde el panel del mozo.
                    </p>
                </div>

                <a th:if="${pisos != null
                    and !pisos.isEmpty()}"
                   th:href="@{/admin/mesas/nueva(
                        piso=${idPisoSeleccionado}
                   )}"
                   class="btn-principal btn-nueva-mesa">

                    <i class="bi bi-plus-lg"></i>
                    Agregar mesa
                </a>

            </div>

            <div th:if="${mesas == null or mesas.isEmpty()}"
                 class="estado-vacio estado-vacio-mesas">

                <div class="estado-vacio-icono">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>

                <h3>No hay mesas para mostrar</h3>

                <p>
                    Agrega una mesa o selecciona otro piso.
                </p>

            </div>

            <div class="tabla-contenedor"
                 th:if="${mesas != null
                    and !mesas.isEmpty()}">

                <div class="table-responsive">

                    <table class="tabla-mesas">

                        <thead>
                        <tr>
                            <th>Mesa</th>
                            <th>Piso</th>
                            <th>Capacidad</th>
                            <th>Estado</th>
                            <th class="columna-acciones">
                                Acciones
                            </th>
                        </tr>
                        </thead>

                        <tbody>

                        <tr th:each="mesa : ${mesas}">

                            <td>

                                <div class="mesa-identidad">

                                    <div class="mesa-numero-icono">
                                        <i class="bi bi-grid-3x3"></i>
                                    </div>

                                    <div>
                                        <strong th:text="'Mesa '
                                            + ${mesa.numero}">
                                            Mesa 1
                                        </strong>

                                        <span th:text="'Código M-'
                                            + ${mesa.idMesa}">
                                            Código
                                        </span>
                                    </div>

                                </div>

                            </td>

                            <td>

                                <div class="mesa-piso">
                                    <i class="bi bi-building"></i>

                                    <span th:text="${mesa.piso.nombre}">
                                        Primer piso
                                    </span>
                                </div>

                            </td>

                            <td>

                                <div class="mesa-capacidad">
                                    <i class="bi bi-people"></i>

                                    <span th:text="${mesa.capacidad}
                                        + ' personas'">
                                        4 personas
                                    </span>
                                </div>

                            </td>

                            <td>

                                <span class="estado-mesa"
                                      th:classappend="${' estado-'
                                          + #strings.toLowerCase(
                                              mesa.estado.name()
                                          )}">

                                    <i class="bi bi-circle-fill"></i>

                                    <span th:switch="${mesa.estado.name()}">
                                        <span th:case="'DISPONIBLE'">
                                            Disponible
                                        </span>

                                        <span th:case="'OCUPADA'">
                                            Ocupada
                                        </span>

                                        <span th:case="'RESERVADA'">
                                            Reservada
                                        </span>

                                        <span th:case="'INACTIVA'">
                                            Inactiva
                                        </span>
                                    </span>

                                </span>

                            </td>

                            <td>

                                <div class="mesa-acciones"
                                     th:if="${mesa.estado.name()
                                        == 'DISPONIBLE'
                                        or mesa.estado.name()
                                        == 'INACTIVA'}">

                                    <a th:href="@{/admin/mesas/{id}/editar(
                                            id=${mesa.idMesa}
                                       )}"
                                       class="btn-tabla btn-editar">

                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>

                                    <form th:action="@{/admin/mesas/{id}/estado(
                                            id=${mesa.idMesa}
                                          )}"
                                          method="post">

                                        <input type="hidden"
                                               th:name="${_csrf.parameterName}"
                                               th:value="${_csrf.token}">

                                        <input type="hidden"
                                               name="piso"
                                               th:value="${idPisoSeleccionado}">

                                        <button type="submit"
                                                class="btn-tabla"
                                                th:classappend="${mesa.estado.name()
                                                    == 'DISPONIBLE'}
                                                    ? ' btn-inactivar'
                                                    : ' btn-habilitar'"
                                                onclick="return confirm(
                                                    '¿Deseas cambiar el estado de esta mesa?'
                                                );">

                                            <i th:class="${mesa.estado.name()
                                                == 'DISPONIBLE'}
                                                ? 'bi bi-pause-circle'
                                                : 'bi bi-play-circle'">
                                            </i>

                                            <span th:text="${mesa.estado.name()
                                                == 'DISPONIBLE'}
                                                ? 'Inactivar'
                                                : 'Habilitar'">
                                                Inactivar
                                            </span>

                                        </button>

                                    </form>

                                </div>

                                <div class="mesa-control-mozo"
                                     th:if="${mesa.estado.name()
                                        == 'OCUPADA'
                                        or mesa.estado.name()
                                        == 'RESERVADA'}">

                                    <i class="bi bi-person-badge"></i>
                                    Gestionada por el mozo

                                </div>

                            </td>

                        </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/producto-form.html">
<!DOCTYPE html>
<html lang="es"xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo}+ ' - El Rinconcito Ayacuchano'">Producto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"rel="stylesheet">
    <link th:href="@{/css/admin.css}"rel="stylesheet">
    <link th:href="@{/css/admin-carta.css}"rel="stylesheet">
</head>
<body>

<div class="admin-layout">
    <aside th:replace="~{fragments/admin-sidebar :: sidebar('carta')}">
    </aside>
    <main class="admin-contenido">
        <header class="producto-form-encabezado">
            <div>
                <p class="producto-form-etiqueta">GESTIÓN DE CARTA</p>
                <h1 th:text="${titulo}">
                    Producto
                </h1>

                <p>
                    Registra la información, precio,
                    imagen y disponibilidad del producto.
                </p>
            </div>

            <a th:href="@{/admin/carta}"
               class="btn-volver-carta">

                <i class="bi bi-arrow-left"></i>
                Volver a productos
            </a>

        </header>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <form th:action="@{/admin/carta/guardar}"
              method="post"
              enctype="multipart/form-data"
              class="producto-formulario">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

            <input type="hidden"
                   name="idProducto"
                   th:value="${producto.idProducto}">

            <section class="producto-form-seccion">

                <div class="producto-form-seccion-titulo">

                    <div class="producto-form-icono">
                        <i class="bi bi-journal-text"></i>
                    </div>

                    <div>
                        <h2>Información del producto</h2>

                        <p>
                            Datos que verá el cliente en la carta.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-12">

                        <label for="nombre"
                               class="form-label">
                            Nombre del producto
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="nombre"
                               name="nombre"
                               class="form-control"
                               maxlength="100"
                               required
                               placeholder="Ejemplo: Puca picante"
                               th:value="${producto.nombre}">

                    </div>

                    <div class="col-12">

                        <label for="descripcion"
                               class="form-label">
                            Descripción
                        </label>

                        <textarea id="descripcion"
                                  name="descripcion"
                                  class="form-control"
                                  rows="4"
                                  maxlength="300"
                                  placeholder="Describe brevemente el producto"
                                  th:text="${producto.descripcion}">
                        </textarea>

                        <div class="form-text">
                            Máximo 300 caracteres.
                        </div>

                    </div>

                    <div class="col-md-5">

                        <label for="precio"
                               class="form-label">
                            Precio
                            <span class="text-danger">*</span>
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                S/
                            </span>

                            <input type="number"
                                   id="precio"
                                   name="precio"
                                   class="form-control"
                                   min="1"
                                   step="1"
                                   required
                                   th:value="${producto.precio}">

                        </div>

                    </div>

                    <div class="col-md-7">

                        <label for="idCategoria"
                               class="form-label">
                            Categoría
                            <span class="text-danger">*</span>
                        </label>

                        <select id="idCategoria"
                                name="idCategoria"
                                class="form-select"
                                required>

                            <option value="">
                                Selecciona una categoría
                            </option>

                            <option th:each="categoria : ${categorias}"
                                    th:value="${categoria.idCategoria}"
                                    th:text="${categoria.nombre
                                        + (categoria.estado.name()
                                        == 'INACTIVO'
                                        ? ' (inactiva)'
                                        : '')}"
                                    th:selected="${producto.categoria != null
                                        and producto.categoria.idCategoria
                                        == categoria.idCategoria}">
                            </option>

                        </select>

                    </div>

                </div>

            </section>

            <section class="producto-form-seccion">

                <div class="producto-form-seccion-titulo">

                    <div class="producto-form-icono">
                        <i class="bi bi-image"></i>
                    </div>

                    <div>
                        <h2>Imagen del producto</h2>

                        <p>
                            Selecciona una imagen desde tu computadora.
                        </p>
                    </div>

                </div>

                <div class="producto-imagen-grid">

                    <div class="producto-form-vista">

                        <img id="vistaPreviaImagen"
                             th:if="${producto.imagen != null
                                and !producto.imagen.isBlank()}"
                             th:src="${producto.imagen}"
                             alt="Imagen actual del producto">

                        <div id="sinImagen"
                             class="producto-form-sin-imagen"
                             th:style="${producto.imagen != null
                                and !producto.imagen.isBlank()}
                                ? 'display:none'
                                : ''">

                            <i class="bi bi-image"></i>
                            <span>Sin imagen seleccionada</span>

                        </div>

                    </div>

                    <div class="producto-imagen-controles">

                        <label for="archivoImagen"
                               class="form-label">
                            Seleccionar imagen
                        </label>

                        <input type="file"
                               id="archivoImagen"
                               name="archivoImagen"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">

                        <div class="form-text">
                            Formatos permitidos: JPG, PNG o WEBP.
                            Tamaño máximo: 3 MB.
                        </div>

                        <div th:if="${producto.imagen != null
                            and !producto.imagen.isBlank()}"
                             class="form-check mt-3">

                            <input type="checkbox"
                                   id="eliminarImagen"
                                   name="eliminarImagen"
                                   value="true"
                                   class="form-check-input">

                            <label for="eliminarImagen"
                                   class="form-check-label">
                                Eliminar la imagen actual
                            </label>

                        </div>

                    </div>

                </div>

            </section>

            <section class="producto-form-seccion">

                <div class="producto-form-seccion-titulo">

                    <div class="producto-form-icono">
                        <i class="bi bi-toggles"></i>
                    </div>

                    <div>
                        <h2>Disponibilidad y estado</h2>

                        <p>
                            Controla si el producto aparece disponible.
                        </p>
                    </div>

                </div>

                <div class="row g-3 align-items-end">

                    <div class="col-md-6">

                        <div class="producto-disponibilidad">

                            <div>
                                <strong>Producto disponible</strong>

                                <span>
                                    Desactívalo cuando esté agotado.
                                </span>
                            </div>

                            <div class="form-check form-switch">

                                <input type="checkbox"
                                       id="disponible"
                                       name="disponible"
                                       value="true"
                                       class="form-check-input"
                                       th:checked="${producto.idProducto == null
                                           or producto.disponible}">

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <label for="estado"
                               class="form-label">
                            Estado del producto
                        </label>

                        <select id="estado"
                                name="estado"
                                class="form-select">

                            <option th:each="estadoProducto : ${estados}"
                                    th:value="${estadoProducto}"
                                    th:text="${estadoProducto}"
                                    th:selected="${producto.estado
                                        == estadoProducto
                                        or (producto.estado == null
                                        and estadoProducto.name()
                                        == 'ACTIVO')}">
                            </option>

                        </select>

                    </div>

                </div>

            </section>

            <div class="producto-form-acciones">

                <a th:href="@{/admin/carta}"
                   class="btn-cancelar-producto">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-guardar-producto">

                    <i class="bi bi-floppy"></i>
                    Guardar producto
                </button>

            </div>

        </form>

    </main>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const archivoImagen =
            document.getElementById("archivoImagen");

        const vistaPrevia =
            document.getElementById("vistaPreviaImagen");

        const sinImagen =
            document.getElementById("sinImagen");

        const eliminarImagen =
            document.getElementById("eliminarImagen");

        archivoImagen.addEventListener("change", function () {
            const archivo = this.files[0];

            if (!archivo) {
                return;
            }

            const maximo = 3 * 1024 * 1024;

            if (archivo.size > maximo) {
                alert("La imagen no puede superar los 3 MB.");
                this.value = "";
                return;
            }

            const tiposPermitidos = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!tiposPermitidos.includes(archivo.type)) {
                alert("Selecciona una imagen JPG, PNG o WEBP.");
                this.value = "";
                return;
            }

            const lector = new FileReader();

            lector.onload = function (evento) {
                let imagen = vistaPrevia;

                if (!imagen) {
                    imagen = document.createElement("img");
                    imagen.id = "vistaPreviaImagen";
                    imagen.alt = "Vista previa del producto";

                    document.querySelector(
                        ".producto-form-vista"
                    ).prepend(imagen);
                }

                imagen.src = evento.target.result;
                imagen.style.display = "block";
                sinImagen.style.display = "none";

                if (eliminarImagen) {
                    eliminarImagen.checked = false;
                }
            };

            lector.readAsDataURL(archivo);
        });

        if (eliminarImagen) {
            eliminarImagen.addEventListener(
                "change",
                function () {
                    const imagen =
                        document.getElementById(
                            "vistaPreviaImagen"
                        );

                    if (this.checked) {
                        archivoImagen.value = "";

                        if (imagen) {
                            imagen.style.display = "none";
                        }

                        sinImagen.style.display = "flex";
                    } else if (imagen) {
                        imagen.style.display = "block";
                        sinImagen.style.display = "none";
                    }
                }
            );
        }
    });
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/reportes.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
            + ' - El Rinconcito Ayacuchano'">
        Reportes
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

    <link th:href="@{/css/admin-reportes.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar
            :: sidebar('reportes')}">
    </aside>

    <main class="admin-contenido reportes-contenido">

        <header class="reportes-encabezado">

            <div>
                <p class="reportes-etiqueta">
                    INFORMACIÓN DEL NEGOCIO
                </p>

                <h1>Reportes administrativos</h1>

                <p>
                    Consulta ventas, pagos, pedidos, reservas
                    y productos más vendidos.
                </p>
            </div>

            <div class="reportes-descargas">

                <a th:href="@{/admin/reportes/pdf(
                        desde=${filtroDesde},
                        hasta=${filtroHasta}
                     )}"
                   class="btn-reporte btn-reporte-pdf">

                    <i class="bi bi-file-earmark-pdf"></i>
                    Descargar PDF
                </a>

                <a th:href="@{/admin/reportes/excel(
                        desde=${filtroDesde},
                        hasta=${filtroHasta}
                     )}"
                   class="btn-reporte btn-reporte-excel">

                    <i class="bi bi-file-earmark-excel"></i>
                    Descargar Excel
                </a>

            </div>

        </header>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <section class="reportes-filtros">

            <form th:action="@{/admin/reportes}"
                  method="get"
                  class="reportes-filtros-formulario">

                <div class="filtro-campo">

                    <label for="desde">
                        Desde
                    </label>

                    <input type="date"
                           id="desde"
                           name="desde"
                           class="form-control"
                           th:value="${filtroDesde}"
                           required>

                </div>

                <div class="filtro-campo">

                    <label for="hasta">
                        Hasta
                    </label>

                    <input type="date"
                           id="hasta"
                           name="hasta"
                           class="form-control"
                           th:value="${filtroHasta}"
                           required>

                </div>

                <button type="submit"
                        class="btn-aplicar-filtro">

                    <i class="bi bi-funnel"></i>
                    Aplicar filtro
                </button>

                <a th:href="@{/admin/reportes}"
                   class="btn-limpiar-filtro">

                    <i class="bi bi-arrow-counterclockwise"></i>
                    Mes actual
                </a>

            </form>

            <div class="reportes-periodo">

                <i class="bi bi-calendar3"></i>

                <span>
                    Periodo:
                    <strong th:text="${#temporals.format(
                            reporte.desde,
                            'dd/MM/yyyy'
                          )}">
                        01/10/2026
                    </strong>

                    al

                    <strong th:text="${#temporals.format(
                            reporte.hasta,
                            'dd/MM/yyyy'
                          )}">
                        09/10/2026
                    </strong>
                </span>

            </div>

        </section>

        <section class="reportes-resumen">

            <article class="resumen-tarjeta resumen-ventas">

                <div class="resumen-icono">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <span>Ventas aprobadas</span>

                    <strong th:text="'S/ '
                            + ${reporte.totalVentas}">
                        S/ 0
                    </strong>
                </div>

            </article>

            <article class="resumen-tarjeta">

                <div class="resumen-icono">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>
                    <span>Operaciones</span>

                    <strong th:text="${reporte.totalOperaciones}">
                        0
                    </strong>
                </div>

            </article>

            <article class="resumen-tarjeta resumen-aprobados">

                <div class="resumen-icono">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div>
                    <span>Pagos aprobados</span>

                    <strong th:text="${reporte.aprobados}">
                        0
                    </strong>
                </div>

            </article>

            <article class="resumen-tarjeta resumen-pendientes">

                <div class="resumen-icono">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <span>Pendientes</span>

                    <strong th:text="${reporte.pendientes}">
                        0
                    </strong>
                </div>

            </article>

            <article class="resumen-tarjeta resumen-rechazados">

                <div class="resumen-icono">
                    <i class="bi bi-x-circle"></i>
                </div>

                <div>
                    <span>Rechazados</span>

                    <strong th:text="${reporte.rechazados}">
                        0
                    </strong>
                </div>

            </article>

            <article class="resumen-tarjeta resumen-tipos">

                <div class="resumen-icono">
                    <i class="bi bi-bar-chart"></i>
                </div>

                <div class="resumen-tipos-valores">

                    <span>
                        Pedidos:
                        <strong th:text="${reporte.pedidosAprobados}">
                            0
                        </strong>
                    </span>

                    <span>
                        Reservas:
                        <strong th:text="${reporte.reservasAprobadas}">
                            0
                        </strong>
                    </span>

                </div>

            </article>

        </section>

        <section class="reportes-graficos">

            <article class="reporte-panel grafico-ventas-panel">

                <div class="reporte-panel-encabezado">

                    <div>
                        <h2>Ventas por día</h2>

                        <p>
                            Ingresos correspondientes a pagos aprobados.
                        </p>
                    </div>

                    <div class="panel-icono">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                </div>

                <div class="grafico-contenedor grafico-lineas">

                    <canvas id="graficoVentas">
                    </canvas>

                </div>

            </article>

            <article class="reporte-panel grafico-metodos-panel">

                <div class="reporte-panel-encabezado">

                    <div>
                        <h2>Métodos de pago</h2>

                        <p>
                            Distribución del importe aprobado.
                        </p>
                    </div>

                    <div class="panel-icono">
                        <i class="bi bi-wallet2"></i>
                    </div>

                </div>

                <div th:if="${#lists.isEmpty(
                        reporte.metodosPago
                     )}"
                     class="panel-sin-datos">

                    <i class="bi bi-pie-chart"></i>
                    <span>Sin pagos aprobados.</span>

                </div>

                <div th:unless="${#lists.isEmpty(
                        reporte.metodosPago
                     )}"
                     class="grafico-contenedor grafico-circular">

                    <canvas id="graficoMetodos">
                    </canvas>

                </div>

            </article>

        </section>

        <section class="reporte-panel productos-panel">

            <div class="reporte-panel-encabezado">

                <div>
                    <h2>Productos más vendidos</h2>

                    <p>
                        Los diez productos con mayor cantidad vendida.
                    </p>
                </div>

                <div class="panel-icono">
                    <i class="bi bi-trophy"></i>
                </div>

            </div>

            <div th:if="${#lists.isEmpty(
                    reporte.productosVendidos
                 )}"
                 class="panel-sin-datos">

                <i class="bi bi-basket"></i>
                <span>
                    No existen productos vendidos en este periodo.
                </span>

            </div>

            <div th:unless="${#lists.isEmpty(
                    reporte.productosVendidos
                 )}"
                 class="table-responsive">

                <table class="table tabla-reporte">

                    <thead>
                    <tr>
                        <th>Posición</th>
                        <th>Producto</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Importe</th>
                    </tr>
                    </thead>

                    <tbody>

                    <tr th:each="producto, estado
                            : ${reporte.productosVendidos}">

                        <td>
                            <span class="producto-posicion"
                                  th:text="${estado.count}">
                                1
                            </span>
                        </td>

                        <td>
                            <strong th:text="${producto.producto}">
                                Producto
                            </strong>
                        </td>

                        <td class="text-center"
                            th:text="${producto.cantidad}">
                            0
                        </td>

                        <td class="text-end importe-tabla"
                            th:text="'S/ ' + ${producto.monto}">
                            S/ 0
                        </td>

                    </tr>

                    </tbody>

                </table>

            </div>

        </section>

        <section class="reporte-panel operaciones-panel">

            <div class="reporte-panel-encabezado">

                <div>
                    <h2>Detalle de operaciones</h2>

                    <p>
                        Pagos enviados, aprobados y rechazados
                        durante el periodo.
                    </p>
                </div>

                <div class="panel-icono">
                    <i class="bi bi-list-check"></i>
                </div>

            </div>

            <div th:if="${#lists.isEmpty(
                    reporte.operaciones
                 )}"
                 class="panel-sin-datos">

                <i class="bi bi-inbox"></i>
                <span>
                    No existen operaciones en este periodo.
                </span>

            </div>

            <div th:unless="${#lists.isEmpty(
                    reporte.operaciones
                 )}"
                 class="table-responsive">

                <table class="table tabla-reporte tabla-operaciones">

                    <thead>
                    <tr>
                        <th>Tipo / código</th>
                        <th>Cliente</th>
                        <th>Método</th>
                        <th>Operación</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th class="text-end">Monto</th>
                    </tr>
                    </thead>

                    <tbody>

                    <tr th:each="pago : ${reporte.operaciones}">

                        <td>

                            <span th:if="${pago.pedido != null}"
                                  class="operacion-tipo tipo-pedido">
                                Pedido
                            </span>

                            <span th:if="${pago.reserva != null}"
                                  class="operacion-tipo tipo-reserva">
                                Reserva
                            </span>

                            <strong th:if="${pago.pedido != null}"
                                    th:text="${pago.pedido.codigoPedido}">
                                PED-001
                            </strong>

                            <strong th:if="${pago.reserva != null}"
                                    th:text="${pago.reserva.codigoReserva}">
                                RES-001
                            </strong>

                        </td>

                        <td>

                            <th:block th:if="${pago.pedido != null}">

                                <strong th:text="${pago.pedido.cliente.nombres
                                        + ' '
                                        + pago.pedido.cliente.apellidos}">
                                    Cliente
                                </strong>

                                <small th:text="${pago.pedido.cliente.dni}">
                                    00000000
                                </small>

                            </th:block>

                            <th:block th:if="${pago.reserva != null}">

                                <strong th:text="${pago.reserva.cliente.nombres
                                        + ' '
                                        + pago.reserva.cliente.apellidos}">
                                    Cliente
                                </strong>

                                <small th:text="${pago.reserva.cliente.dni}">
                                    00000000
                                </small>

                            </th:block>

                        </td>

                        <td th:text="${pago.metodoPago}">
                            YAPE
                        </td>

                        <td th:text="${pago.numeroOperacion != null
                                and !pago.numeroOperacion.isBlank()}
                                ? pago.numeroOperacion
                                : 'Sin número'">
                            Sin número
                        </td>

                        <td>

                            <span class="estado-operacion"
                                  th:classappend="' estado-'
                                        + ${#strings.toLowerCase(
                                            pago.estado.name()
                                          )}"
                                  th:text="${pago.estado}">
                                APROBADO
                            </span>

                        </td>

                        <td th:text="${#temporals.format(
                                pago.fechaValidacion != null
                                    ? pago.fechaValidacion
                                    : pago.fechaPago,
                                'dd/MM/yyyy HH:mm'
                              )}">
                            09/10/2026 15:00
                        </td>

                        <td class="text-end importe-tabla"
                            th:text="'S/ ' + ${pago.monto}">
                            S/ 0
                        </td>

                    </tr>

                    </tbody>

                </table>

            </div>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js">
</script>

<script th:inline="javascript">
    const etiquetasVentas =
        /*[[${etiquetasVentas}]]*/ [];

    const montosVentas =
        /*[[${montosVentas}]]*/ [];

    const etiquetasMetodos =
        /*[[${etiquetasMetodos}]]*/ [];

    const montosMetodos =
        /*[[${montosMetodos}]]*/ [];

    const graficoVentasElemento =
        document.getElementById("graficoVentas");

    if (graficoVentasElemento) {
        new Chart(
            graficoVentasElemento,
            {
                type: "line",

                data: {
                    labels: etiquetasVentas,

                    datasets: [
                        {
                            label: "Ventas S/",
                            data: montosVentas,
                            borderColor: "#8C2F1B",
                            backgroundColor:
                                "rgba(140, 47, 27, 0.12)",
                            borderWidth: 2,
                            pointRadius: 3,
                            pointHoverRadius: 5,
                            pointBackgroundColor: "#D4A017",
                            tension: 0.32,
                            fill: true
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: false
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return "S/ "
                                        + context.parsed.y;
                                }
                            }
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,

                            ticks: {
                                callback: function (valor) {
                                    return "S/ " + valor;
                                }
                            },

                            grid: {
                                color: "rgba(80, 65, 55, 0.08)"
                            }
                        },

                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            }
        );
    }

    const graficoMetodosElemento =
        document.getElementById("graficoMetodos");

    if (
        graficoMetodosElemento
        && etiquetasMetodos.length > 0
    ) {
        new Chart(
            graficoMetodosElemento,
            {
                type: "doughnut",

                data: {
                    labels: etiquetasMetodos,

                    datasets: [
                        {
                            data: montosMetodos,

                            backgroundColor: [
                                "#8C2F1B",
                                "#D4A017",
                                "#5C6E49",
                                "#6C757D"
                            ],

                            borderColor: "#FFFFFF",
                            borderWidth: 3,
                            hoverOffset: 5
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "62%",

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,
                                padding: 16,
                                font: {
                                    size: 11
                                }
                            }
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.label
                                        + ": S/ "
                                        + context.parsed;
                                }
                            }
                        }
                    }
                }
            }
        );
    }
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/reservas.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo}+ ' - El Rinconcito Ayacuchano'">Consultar reservas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"rel="stylesheet">
    <link th:href="@{/css/admin.css}"rel="stylesheet">
    <link th:href="@{/css/admin-reservas.css}"rel="stylesheet">
</head>
<body>
<div class="admin-layout">
    <aside th:replace="~{fragments/admin-sidebar :: sidebar('reservas')}"></aside>
    <main class="admin-contenido reservas-admin-contenido">
        <header class="reservas-encabezado"></header>
            <div>
                <h1>Consultar reservas</h1>
                <p>
                    Revisa las reservas registradas y consulta
                    su fecha, piso, mesa y estado actual.
                </p>
            </div>
        </header>

        <section class="reservas-filtros">

            <div class="reservas-filtros-encabezado">

                <div class="reservas-filtros-icono">
                    <i class="bi bi-funnel"></i>
                </div>

                <div>
                    <h2>Filtros de búsqueda</h2>

                    <p>
                        Puedes combinar los filtros para encontrar
                        una reserva específica.
                    </p>
                </div>

            </div>

            <form method="get"
                  th:action="@{/admin/reservas}"
                  class="reservas-filtros-formulario">

                <div class="filtro-campo">

                    <label for="fecha">
                        Fecha
                    </label>

                    <input type="date"
                           id="fecha"
                           name="fecha"
                           class="form-control"
                           th:value="${filtroFecha}">

                </div>

                <div class="filtro-campo">

                    <label for="idPiso">
                        Piso
                    </label>

                    <select id="idPiso"
                            name="idPiso"
                            class="form-select">

                        <option value="">
                            Todos los pisos
                        </option>

                        <option th:each="piso : ${pisos}"
                                th:value="${piso.idPiso}"
                                th:selected="${filtroIdPiso != null
                                    and filtroIdPiso
                                    == piso.idPiso}"
                                th:text="${piso.nombre}">
                            Piso
                        </option>

                    </select>

                </div>

                <div class="filtro-campo">

                    <label for="estado">
                        Estado
                    </label>

                    <select id="estado"
                            name="estado"
                            class="form-select">

                        <option value="">
                            Todos los estados
                        </option>

                        <option th:each="estadoReserva : ${estados}"
                                th:value="${estadoReserva}"
                                th:selected="${filtroEstado
                                    == estadoReserva}"
                                th:text="${#strings.replace(
                                    estadoReserva.name(),
                                    '_',
                                    ' '
                                )}">
                            Estado
                        </option>

                    </select>

                </div>

                <div class="reservas-filtros-acciones">

                    <button type="submit"
                            class="btn-filtrar-reservas">

                        <i class="bi bi-search"></i>
                        Filtrar
                    </button>

                    <a th:href="@{/admin/reservas}"
                       class="btn-limpiar-filtros">

                        <i class="bi bi-arrow-counterclockwise"></i>
                        Limpiar
                    </a>

                </div>

            </form>

        </section>

        <section class="reservas-panel">

            <div class="reservas-panel-encabezado">

                <div>
                    <h2>Reservas registradas</h2>

                    <p>
                        Resultados encontrados con los filtros
                        seleccionados.
                    </p>
                </div>

                <span class="reservas-contador"
                      th:text="${reservas != null
                          ? reservas.size() + ' reservas'
                          : '0 reservas'}">
                    0 reservas
                </span>

            </div>

            <div th:if="${reservas == null
                or reservas.isEmpty()}"
                 class="reservas-vacias">

                <div class="reservas-vacias-icono">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h3>No se encontraron reservas</h3>

                <p>
                    Prueba cambiando o eliminando los filtros
                    de búsqueda.
                </p>

                <a th:href="@{/admin/reservas}"
                   class="btn-limpiar-vacio">

                    <i class="bi bi-arrow-counterclockwise"></i>
                    Limpiar filtros
                </a>

            </div>

            <div class="reservas-tabla-contenedor"
                 th:if="${reservas != null
                    and !reservas.isEmpty()}">

                <div class="table-responsive">

                    <table class="reservas-tabla">

                        <thead>
                        <tr>
                            <th>Código</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Horario</th>
                            <th>Personas</th>
                            <th>Piso</th>
                            <th>Mesa</th>
                            <th>Estado</th>
                            <th>Monto</th>
                        </tr>
                        </thead>

                        <tbody>

                        <tr th:each="reserva : ${reservas}">

                            <td>

                                <span class="reserva-codigo"
                                      th:text="${reserva.codigoReserva}">
                                    RES-2026-000001
                                </span>

                            </td>

                            <td>

                                <div class="reserva-cliente">

                                    <div class="reserva-cliente-icono">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>
                                        <strong th:text="${reserva.cliente.nombres
                                            + ' '
                                            + reserva.cliente.apellidos}">
                                            Cliente
                                        </strong>

                                        <span th:text="'DNI '
                                            + ${reserva.cliente.dni}">
                                            DNI
                                        </span>
                                    </div>

                                </div>

                            </td>

                            <td>

                                <span class="reserva-fecha"
                                      th:text="${#temporals.format(
                                          reserva.fechaReserva,
                                          'dd/MM/yyyy'
                                      )}">
                                    01/01/2026
                                </span>

                            </td>

                            <td>

                                <span class="reserva-horario">

                                    <i class="bi bi-clock"></i>

                                    <span th:text="${#temporals.format(
                                        reserva.horaInicio,
                                        'HH:mm'
                                    )}">
                                        11:00
                                    </span>

                                    <span>–</span>

                                    <span th:text="${#temporals.format(
                                        reserva.horaFin,
                                        'HH:mm'
                                    )}">
                                        13:00
                                    </span>

                                </span>

                            </td>

                            <td>

                                <span class="reserva-personas">

                                    <i class="bi bi-people"></i>

                                    <span th:text="${reserva.numeroPersonas}">
                                        2
                                    </span>

                                </span>

                            </td>

                            <td>

                                <span class="reserva-piso"
                                      th:text="${reserva.pisoSolicitado.nombre}">
                                    Piso 1
                                </span>

                            </td>

                            <td>

                                <span th:if="${reserva.mesa != null}"
                                      class="reserva-mesa"
                                      th:text="'Mesa '
                                          + ${reserva.mesa.numero}">
                                    Mesa 1
                                </span>

                                <span th:if="${reserva.mesa == null}"
                                      class="reserva-sin-mesa">
                                    Sin asignar
                                </span>

                            </td>

                            <td>

                                <span class="reserva-estado"
                                      th:classappend="' estado-'
                                          + ${#strings.toLowerCase(
                                              reserva.estado.name()
                                          )}"
                                      th:text="${#strings.replace(
                                          reserva.estado.name(),
                                          '_',
                                          ' '
                                      )}">
                                    Estado
                                </span>

                            </td>

                            <td>

                                <strong th:if="${reserva.requierePago}"
                                        class="reserva-monto"
                                        th:text="'S/ '
                                            + ${reserva.montoReserva}">
                                    S/ 0
                                </strong>

                                <span th:unless="${reserva.requierePago}"
                                      class="reserva-sin-pago">
                                    Sin pago
                                </span>

                            </td>

                        </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/usuario-form.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Usuario
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">
    <link th:href="@{/css/admin.css}"
          rel="stylesheet">
    <link th:href="@{/css/admin-usuarios.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar
        :: sidebar('usuarios')}">
    </aside>

    <main class="admin-contenido">

        <header class="usuario-form-encabezado">

            <div>
                <p class="usuarios-etiqueta">
                    PERSONAL Y USUARIOS
                </p>

                <h1 th:text="${usuarioForm.idUsuario == null
                    ? 'Registrar usuario'
                    : 'Editar usuario'}">
                    Registrar usuario
                </h1>

                <p th:text="${usuarioForm.idUsuario == null
                    ? 'Crea una nueva cuenta para el personal o un cliente.'
                    : 'Actualiza los datos y permisos del usuario.'}">
                </p>
            </div>

            <a th:href="@{/admin/usuarios}"
               class="btn-volver-usuarios">

                <i class="bi bi-arrow-left"></i>
                Volver
            </a>

        </header>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <form th:action="@{/admin/usuarios/guardar}"
              th:object="${usuarioForm}"
              method="post"
              class="usuario-formulario">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

            <input type="hidden"
                   th:field="*{idUsuario}">

            <section class="usuario-form-seccion">

                <div class="usuario-seccion-titulo">

                    <div class="usuario-seccion-icono">
                        <i class="bi bi-person"></i>
                    </div>

                    <div>
                        <h2>Datos personales</h2>

                        <p>
                            Información de identificación del usuario.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label for="nombres"
                               class="form-label">

                            Nombres
                            <span>*</span>
                        </label>

                        <input type="text"
                               id="nombres"
                               th:field="*{nombres}"
                               class="form-control"
                               minlength="2"
                               maxlength="50"
                               pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü' -]{2,50}"
                               title="Solo se permiten letras, espacios, apóstrofes y guiones."
                               autocomplete="given-name"
                               required>

                    </div>

                    <div class="col-md-6">

                        <label for="apellidos"
                               class="form-label">

                            Apellidos
                            <span>*</span>
                        </label>

                        <input type="text"
                               id="apellidos"
                               th:field="*{apellidos}"
                               class="form-control"
                               minlength="2"
                               maxlength="50"
                               pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü' -]{2,50}"
                               title="Solo se permiten letras, espacios, apóstrofes y guiones."
                               autocomplete="family-name"
                               required>

                    </div>

                    <div class="col-md-6">

                        <label for="dni"
                               class="form-label">

                            DNI
                            <span>*</span>
                        </label>

                        <input type="text"
                               id="dni"
                               th:field="*{dni}"
                               class="form-control"
                               inputmode="numeric"
                               minlength="8"
                               maxlength="8"
                               pattern="[0-9]{8}"
                               title="El DNI debe contener exactamente 8 números."
                               autocomplete="off"
                               required>

                    </div>

                    <div class="col-md-6">

                        <label for="telefono"
                               class="form-label">

                            Teléfono
                            <span>*</span>
                        </label>

                        <input type="tel"
                               id="telefono"
                               th:field="*{telefono}"
                               class="form-control"
                               inputmode="numeric"
                               minlength="9"
                               maxlength="9"
                               pattern="9[0-9]{8}"
                               title="El teléfono debe comenzar con 9 y contener 9 números."
                               autocomplete="tel"
                               required>

                    </div>

                </div>

            </section>

            <section class="usuario-form-seccion">

                <div class="usuario-seccion-titulo">

                    <div class="usuario-seccion-icono">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <div>
                        <h2>Acceso al sistema</h2>

                        <p>
                            Correo, contraseña y rol asignado.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label for="correo"
                               class="form-label">

                            Correo electrónico
                            <span>*</span>
                        </label>

                        <input type="email"
                               id="correo"
                               th:field="*{correo}"
                               class="form-control"
                               maxlength="120"
                               autocomplete="username"
                               required>

                    </div>

                    <div class="col-md-6">

                        <label for="idRol"
                               class="form-label">

                            Rol
                            <span>*</span>
                        </label>

                        <select id="idRol"
                                th:field="*{idRol}"
                                class="form-select"
                                required>

                            <option value="">
                                Selecciona un rol
                            </option>

                            <option th:each="rol : ${roles}"
                                    th:value="${rol.idRol}"
                                    th:text="${rol.nombre}">
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label for="contrasena"
                               class="form-label">

                            <span th:text="${usuarioForm.idUsuario == null
                                ? 'Contraseña'
                                : 'Nueva contraseña'}">
                                Contraseña
                            </span>

                            <span th:if="${usuarioForm.idUsuario == null}">
                                *
                            </span>
                        </label>

                        <div class="input-group">

                            <input type="password"
                                   id="contrasena"
                                   th:field="*{contrasena}"
                                   class="form-control"
                                   minlength="8"
                                   maxlength="72"
                                   pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,72}"
                                   title="Debe contener al menos 8 caracteres, una letra y un número."
                                   autocomplete="new-password"
                                   th:required="${usuarioForm.idUsuario == null}">

                            <button type="button"
                                    class="btn-mostrar-contrasena"
                                    id="btnMostrarContrasena"
                                    title="Mostrar contraseña">

                                <i class="bi bi-eye"
                                   id="iconoContrasena"></i>
                            </button>

                        </div>

                        <div class="form-text"
                             th:if="${usuarioForm.idUsuario == null}">

                            Mínimo 8 caracteres, una letra y un número.
                        </div>

                        <div class="form-text"
                             th:if="${usuarioForm.idUsuario != null}">

                            Déjalo vacío para conservar la contraseña actual.
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label for="estado"
                               class="form-label">

                            Estado
                            <span>*</span>
                        </label>

                        <select id="estado"
                                th:field="*{estado}"
                                class="form-select"
                                required>

                            <option value="ACTIVO">
                                Activo
                            </option>

                            <option value="INACTIVO">
                                Inactivo
                            </option>

                        </select>

                    </div>

                </div>

            </section>

            <div class="usuario-form-aviso">

                <i class="bi bi-info-circle"></i>

                <span>
                    Los usuarios inactivos conservarán su historial,
                    pero no podrán iniciar sesión en el sistema.
                </span>

            </div>

            <div class="usuario-form-acciones">

                <a th:href="@{/admin/usuarios}"
                   class="btn-cancelar-usuario">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-guardar-usuario">

                    <i class="bi bi-floppy"></i>

                    <span th:text="${usuarioForm.idUsuario == null
                        ? 'Registrar usuario'
                        : 'Guardar cambios'}">
                        Guardar
                    </span>

                </button>

            </div>

        </form>

    </main>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input =
            document.getElementById("contrasena");

        const boton =
            document.getElementById("btnMostrarContrasena");

        const icono =
            document.getElementById("iconoContrasena");

        boton.addEventListener("click", function () {
            const mostrar =
                input.type === "password";

            input.type =
                mostrar ? "text" : "password";

            icono.className =
                mostrar
                    ? "bi bi-eye-slash"
                    : "bi bi-eye";
        });
    });
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/usuarios.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo} + ' - El Rinconcito Ayacuchano'">
        Personal y usuarios
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

    <link th:href="@{/css/admin-usuarios.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <!-- Reemplaza el nombre del fragment únicamente si el tuyo es diferente -->
    <aside th:replace="~{fragments/admin-sidebar :: sidebar('usuarios')}"></aside>

    <main class="admin-contenido">

        <header class="usuarios-encabezado">

            <div>
                <p class="usuarios-etiqueta">
                    ADMINISTRACIÓN
                </p>

                <h1>Personal y usuarios</h1>

                <p>
                    Gestiona las cuentas, roles y accesos al sistema.
                </p>
            </div>

            <a th:href="@{/admin/usuarios/nuevo}"
               class="btn-nuevo-usuario">

                <i class="bi bi-person-plus"></i>
                Registrar usuario
            </a>

        </header>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <!-- Filtros -->
        <section class="usuarios-filtros">

            <form th:action="@{/admin/usuarios}"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-lg-4 col-md-6">

                    <label for="buscar"
                           class="form-label">
                        Buscar
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="buscar"
                               name="buscar"
                               class="form-control"
                               th:value="${buscar}"
                               placeholder="Nombre, DNI, correo o teléfono"
                               maxlength="120">

                    </div>

                </div>

                <div class="col-lg-2 col-md-6">

                    <label for="idRol"
                           class="form-label">
                        Rol
                    </label>

                    <select id="idRol"
                            name="idRol"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        <option th:each="rol : ${roles}"
                                th:value="${rol.idRol}"
                                th:text="${rol.nombre}"
                                th:selected="${idRolSeleccionado != null
                                    and idRolSeleccionado == rol.idRol}">
                        </option>

                    </select>

                </div>

                <div class="col-lg-2 col-md-6">

                    <label for="estado"
                           class="form-label">
                        Estado
                    </label>

                    <select id="estado"
                            name="estado"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        <option value="ACTIVO"
                                th:selected="${estadoSeleccionado == 'ACTIVO'}">
                            Activo
                        </option>

                        <option value="INACTIVO"
                                th:selected="${estadoSeleccionado == 'INACTIVO'}">
                            Inactivo
                        </option>

                    </select>

                </div>

                <div class="col-lg-2 col-md-6">

                    <label for="tipoRegistro"
                           class="form-label">
                        Tipo
                    </label>

                    <select id="tipoRegistro"
                            name="tipoRegistro"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        <option value="CUENTA"
                                th:selected="${tipoRegistroSeleccionado == 'CUENTA'}">
                            Cuenta
                        </option>

                        <option value="INVITADO"
                                th:selected="${tipoRegistroSeleccionado == 'INVITADO'}">
                            Invitado
                        </option>

                    </select>

                </div>

                <div class="col-lg-2 col-md-12">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn-filtrar">

                            <i class="bi bi-funnel"></i>
                            Filtrar
                        </button>

                        <a th:href="@{/admin/usuarios}"
                           class="btn-limpiar"
                           title="Limpiar filtros">

                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>

                    </div>

                </div>

            </form>

        </section>

        <!-- Sin resultados -->
        <section th:if="${usuarios == null or usuarios.isEmpty()}"
                 class="usuarios-vacio">

            <i class="bi bi-people"></i>

            <h2>No se encontraron usuarios</h2>

            <p>
                No existen usuarios que coincidan con los filtros aplicados.
            </p>

            <a th:href="@{/admin/usuarios/nuevo}"
               class="btn-nuevo-usuario">

                Registrar usuario
            </a>

        </section>

        <!-- Tabla -->
        <section th:if="${usuarios != null and !usuarios.isEmpty()}"
                 class="usuarios-tabla-contenedor">

            <div class="usuarios-tabla-cabecera">

                <div>
                    <h2>Usuarios registrados</h2>

                    <p th:text="${usuarios.size()} + ' resultado(s)'">
                        0 resultados
                    </p>
                </div>

            </div>

            <div class="table-responsive">

                <table class="table usuarios-tabla">

                    <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Contacto</th>
                        <th>Rol</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Registro</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                    </thead>

                    <tbody>

                    <tr th:each="usuario : ${usuarios}">

                        <td>

                            <div class="usuario-identidad">

                                <div class="usuario-avatar"
                                     th:text="${#strings.substring(usuario.nombres, 0, 1)
                                         + #strings.substring(usuario.apellidos, 0, 1)}">
                                    U
                                </div>

                                <div>

                                    <strong th:text="${usuario.nombres
                                        + ' '
                                        + usuario.apellidos}">
                                        Nombre del usuario
                                    </strong>

                                    <span th:text="${usuario.dni != null
                                        ? 'DNI: ' + usuario.dni
                                        : 'Sin DNI'}">
                                        DNI
                                    </span>

                                </div>

                            </div>

                        </td>

                        <td>

                            <div class="usuario-contacto">

                                <span>
                                    <i class="bi bi-envelope"></i>

                                    <span th:text="${usuario.correo != null
                                        ? usuario.correo
                                        : 'Sin correo'}">
                                    </span>
                                </span>

                                <span>
                                    <i class="bi bi-telephone"></i>

                                    <span th:text="${usuario.telefono != null
                                        ? usuario.telefono
                                        : 'Sin teléfono'}">
                                    </span>
                                </span>

                            </div>

                        </td>

                        <td>

                            <span class="usuario-rol"
                                  th:text="${usuario.rol != null
                                      ? usuario.rol.nombre
                                      : 'SIN ROL'}">
                            </span>

                        </td>

                        <td>

                            <span class="usuario-tipo"
                                  th:classappend="${usuario.tipoRegistro.name() == 'INVITADO'}
                                      ? ' usuario-tipo-invitado'
                                      : ''"
                                  th:text="${usuario.tipoRegistro}">
                            </span>

                        </td>

                        <td>

                            <span class="usuario-estado"
                                  th:classappend="${usuario.estado.name() == 'ACTIVO'}
                                      ? ' usuario-activo'
                                      : ' usuario-inactivo'">

                                <span class="estado-punto"></span>

                                <span th:text="${usuario.estado}">
                                </span>

                            </span>

                        </td>

                        <td>

                            <span th:if="${usuario.fechaRegistro != null}"
                                  th:text="${#temporals.format(
                                      usuario.fechaRegistro,
                                      'dd/MM/yyyy'
                                  )}">
                            </span>

                            <span th:unless="${usuario.fechaRegistro != null}">
                                -
                            </span>

                        </td>

                        <td>

                            <div class="usuario-acciones">

                                <a th:href="@{/admin/usuarios/{id}/editar(
                                        id=${usuario.idUsuario}
                                   )}"
                                   class="accion-editar"
                                   title="Editar usuario">

                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <button type="button"
                                        class="accion-contrasena"
                                        title="Restablecer contraseña"
                                        data-bs-toggle="modal"
                                        th:data-bs-target="'#modalContrasena'
                                            + ${usuario.idUsuario}">

                                    <i class="bi bi-key"></i>
                                </button>

                                <form th:action="@{/admin/usuarios/{id}/estado(
                                          id=${usuario.idUsuario}
                                      )}"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           th:name="${_csrf.parameterName}"
                                           th:value="${_csrf.token}">

                                    <button type="submit"
                                            class="accion-estado"
                                            th:classappend="${usuario.estado.name() == 'ACTIVO'}
                                                ? ' accion-desactivar'
                                                : ' accion-activar'"
                                            th:title="${usuario.estado.name() == 'ACTIVO'}
                                                ? 'Inactivar usuario'
                                                : 'Activar usuario'"
                                            onclick="return confirm(
                                                '¿Deseas cambiar el estado de este usuario?'
                                            );">

                                        <i th:class="${usuario.estado.name() == 'ACTIVO'}
                                            ? 'bi bi-person-x'
                                            : 'bi bi-person-check'">
                                        </i>

                                    </button>

                                </form>

                            </div>

                            <!-- Modal de contraseña -->
                            <div class="modal fade"
                                 th:id="'modalContrasena'
                                     + ${usuario.idUsuario}"
                                 tabindex="-1"
                                 aria-hidden="true">

                                <div class="modal-dialog modal-dialog-centered">

                                    <div class="modal-content modal-contrasena">

                                        <form th:action="@{/admin/usuarios/{id}/contrasena(
                                                  id=${usuario.idUsuario}
                                              )}"
                                              method="post">

                                            <input type="hidden"
                                                   th:name="${_csrf.parameterName}"
                                                   th:value="${_csrf.token}">

                                            <div class="modal-header">

                                                <div>
                                                    <h2 class="modal-title">
                                                        Restablecer contraseña
                                                    </h2>

                                                    <p th:text="${usuario.nombres
                                                        + ' '
                                                        + usuario.apellidos}">
                                                    </p>
                                                </div>

                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Cerrar">
                                                </button>

                                            </div>

                                            <div class="modal-body">

                                                <label th:for="'contrasena'
                                                       + ${usuario.idUsuario}"
                                                       class="form-label">

                                                    Nueva contraseña
                                                </label>

                                                <input type="password"
                                                       th:id="'contrasena'
                                                           + ${usuario.idUsuario}"
                                                       name="nuevaContrasena"
                                                       class="form-control"
                                                       minlength="8"
                                                       maxlength="72"
                                                       pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,72}"
                                                       autocomplete="new-password"
                                                       required>

                                                <div class="form-text">
                                                    Mínimo 8 caracteres, una letra
                                                    y un número.
                                                </div>

                                            </div>

                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-light"
                                                        data-bs-dismiss="modal">
                                                    Cancelar
                                                </button>

                                                <button type="submit"
                                                        class="btn-guardar-contrasena">
                                                    Guardar contraseña
                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </td>

                    </tr>

                    </tbody>

                </table>

            </div>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/caja/dashboard.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
    >

    <title th:text="${titulo} + ' - El Rinconcito Ayacuchano'">
        Panel de Caja
    </title>

    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
    >

    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
            rel="stylesheet"
    >

    <link
            href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Nunito:wght@400;600;700;800&display=swap"
            rel="stylesheet"
    >

    <link
            th:href="@{/css/estilos.css}"
            rel="stylesheet"
    >

    <link
            th:href="@{/css/caja.css(v=4)}"
            rel="stylesheet"
    >

    <link
            th:href="@{/css/caja-reportes.css(v=1)}"
            rel="stylesheet"
    >
</head>

<body class="caja-body">

<div class="caja-layout">

    <aside
            th:replace="~{fragments/caja-sidebar :: sidebar('inicio')}"
    ></aside>

    <main class="caja-principal">

        <header class="caja-encabezado">

            <div>
                <span class="encabezado-etiqueta">
                    Gestión de pagos
                </span>

                <h1>Panel de Caja</h1>

                <p>
                    Revisa los pagos pendientes y consulta
                    las ventas registradas.
                </p>
            </div>

            <div class="encabezado-fecha">

                <i class="bi bi-calendar3"></i>

                <div>
                    <span>Fecha actual</span>

                    <strong th:text="${fechaActual}">
                        Jueves 8 de octubre de 2026
                    </strong>
                </div>

            </div>

        </header>

        <!-- CONTADORES DE VALIDACIÓN -->

        <section class="caja-estadisticas">

            <article class="estadistica-card estadistica-pendiente">

                <div class="estadistica-icono">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <span>Total por validar</span>

                    <strong th:text="${totalPendientes}">
                        0
                    </strong>

                    <small>Pagos pendientes</small>
                </div>

            </article>

            <article class="estadistica-card estadistica-pedido">

                <div class="estadistica-icono">
                    <i class="bi bi-bag"></i>
                </div>

                <div>
                    <span>Pedidos</span>

                    <strong th:text="${pedidosPendientes}">
                        0
                    </strong>

                    <small>Pagos por revisar</small>
                </div>

            </article>

            <article class="estadistica-card estadistica-reserva">

                <div class="estadistica-icono">
                    <i class="bi bi-calendar2-check"></i>
                </div>

                <div>
                    <span>Reservas</span>

                    <strong th:text="${reservasPendientes}">
                        0
                    </strong>

                    <small>Pagos por revisar</small>
                </div>

            </article>

            <article class="estadistica-card estadistica-aprobado">

                <div class="estadistica-icono">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div>
                    <span>Aprobados hoy</span>

                    <strong th:text="${aprobadosHoy}">
                        0
                    </strong>

                    <small>Pagos verificados</small>
                </div>

            </article>

            <article class="estadistica-card estadistica-rechazado">

                <div class="estadistica-icono">
                    <i class="bi bi-x-circle"></i>
                </div>

                <div>
                    <span>Rechazados hoy</span>

                    <strong th:text="${rechazadosHoy}">
                        0
                    </strong>

                    <small>Pagos observados</small>
                </div>

            </article>

        </section>

        <!-- RESUMEN DE VENTAS -->

        <section class="reporte-resumen">

            <article class="reporte-resumen-card ventas-dia">

                <div class="reporte-resumen-icono">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <span>Ventas de hoy</span>

                    <strong th:text="'S/ ' + ${ventasHoy}">
                        S/ 0
                    </strong>

                    <small>
                        Total de notas emitidas durante el día
                    </small>
                </div>

            </article>

            <article class="reporte-resumen-card notas-dia">

                <div class="reporte-resumen-icono">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>

                <div>
                    <span>Notas emitidas hoy</span>

                    <strong th:text="${notasEmitidasHoy}">
                        0
                    </strong>

                    <small>
                        Comprobantes internos generados
                    </small>
                </div>

            </article>

        </section>

        <!-- GRÁFICOS -->

        <section class="dashboard-graficos">

            <article class="grafico-card">

                <div class="grafico-cabecera">

                    <div>
                        <span>Últimos 7 días</span>
                        <h2>Ventas registradas</h2>
                    </div>

                    <div class="grafico-icono">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                </div>

                <div
                        class="grafico-contenedor"
                        th:if="${tieneVentas}"
                >
                    <canvas id="graficoVentas"></canvas>
                </div>

                <div
                        class="grafico-vacio"
                        th:unless="${tieneVentas}"
                >
                    <i class="bi bi-bar-chart"></i>

                    <p>
                        Todavía no existen ventas registradas
                        durante los últimos siete días.
                    </p>
                </div>

            </article>

            <article class="grafico-card">

                <div class="grafico-cabecera">

                    <div>
                        <span>Últimos 7 días</span>
                        <h2>Métodos de pago</h2>
                    </div>

                    <div class="grafico-icono metodo">
                        <i class="bi bi-wallet2"></i>
                    </div>

                </div>

                <div
                        class="grafico-contenedor grafico-circular"
                        th:if="${tieneMetodosPago}"
                >
                    <canvas id="graficoMetodos"></canvas>
                </div>

                <div
                        class="grafico-vacio"
                        th:unless="${tieneMetodosPago}"
                >
                    <i class="bi bi-pie-chart"></i>

                    <p>
                        Todavía no existen métodos de pago
                        para mostrar.
                    </p>
                </div>

            </article>

        </section>

        <!-- ACCIONES PRINCIPALES -->

        <section class="caja-seccion">

            <div class="seccion-titulo">

                <div>
                    <span>Acciones principales</span>
                    <h2>Gestión de Caja</h2>
                </div>

            </div>

            <div class="acciones-grid acciones-caja-grid">

                <a
                        th:href="@{/caja/pedidos-pendientes}"
                        class="accion-card"
                >

                    <div class="accion-icono accion-pedidos">
                        <i class="bi bi-bag-check"></i>
                    </div>

                    <div class="accion-contenido">

                        <span class="accion-categoria">
                            Pedidos delivery
                        </span>

                        <h3>Validar pagos de pedidos</h3>

                        <p>
                            Revisa el comprobante, los productos,
                            el importe y los datos del cliente.
                        </p>

                        <div class="accion-inferior">

                            <span>
                                <strong th:text="${pedidosPendientes}">
                                    0
                                </strong>
                                pendientes
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </div>

                    </div>

                </a>

                <a
                        th:href="@{/caja/reservas-pendientes}"
                        class="accion-card"
                >

                    <div class="accion-icono accion-reservas">
                        <i class="bi bi-calendar2-week"></i>
                    </div>

                    <div class="accion-contenido">

                        <span class="accion-categoria">
                            Reservas
                        </span>

                        <h3>Validar pagos de reservas</h3>

                        <p>
                            Verifica los pagos para confirmar
                            la reserva y asignar una mesa.
                        </p>

                        <div class="accion-inferior">

                            <span>
                                <strong th:text="${reservasPendientes}">
                                    0
                                </strong>
                                pendientes
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </div>

                    </div>

                </a>

                <a
                        th:href="@{/caja/notas-venta}"
                        class="accion-card"
                >

                    <div class="accion-icono accion-notas">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <div class="accion-contenido">

                        <span class="accion-categoria">
                            Comprobantes internos
                        </span>

                        <h3>Consultar notas de venta</h3>

                        <p>
                            Consulta, descarga e imprime las notas
                            generadas después de aprobar los pagos.
                        </p>

                        <div class="accion-inferior">

                            <span>Ver historial</span>
                            <i class="bi bi-arrow-right"></i>

                        </div>

                    </div>

                </a>

            </div>

        </section>

        <!-- ÚLTIMAS NOTAS -->

        <section class="ultimas-notas-panel">

            <div class="ultimas-notas-cabecera">

                <div>
                    <span>Actividad reciente</span>
                    <h2>Últimas notas de venta</h2>
                </div>

                <a th:href="@{/caja/notas-venta}">
                    Ver todas
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

            <div
                    class="ultimas-notas-vacio"
                    th:if="${ultimasNotas == null or ultimasNotas.isEmpty()}"
            >
                <i class="bi bi-receipt"></i>

                <p>
                    Todavía no existen notas de venta registradas.
                </p>
            </div>

            <div
                    class="ultimas-notas-tabla-contenedor"
                    th:if="${ultimasNotas != null and !ultimasNotas.isEmpty()}"
            >

                <table class="ultimas-notas-tabla">

                    <thead>
                    <tr>
                        <th>Nota</th>
                        <th>Pedido</th>
                        <th>Cliente</th>
                        <th>Pago</th>
                        <th>Total</th>
                        <th>Fecha</th>
                        <th>PDF</th>
                    </tr>
                    </thead>

                    <tbody>

                    <tr th:each="nota : ${ultimasNotas}">

                        <td>
                            <strong
                                    class="ultima-nota-numero"
                                    th:text="${numerosUltimasNotas[nota.idNota]}"
                            >
                                NV01-000001
                            </strong>
                        </td>

                        <td>
                            <span
                                    th:if="${nota.pago != null
                                        and nota.pago.pedido != null}"
                                    th:text="${nota.pago.pedido.codigoPedido}"
                            >
                                PED-2026-000001
                            </span>

                            <span
                                    th:unless="${nota.pago != null
                                        and nota.pago.pedido != null}"
                            >
                                -
                            </span>
                        </td>

                        <td>
                            <span th:text="${nota.clienteNombre}">
                                Cliente
                            </span>
                        </td>

                        <td>
                            <span
                                    class="ultima-nota-metodo"
                                    th:text="${nota.pago.metodoPago}"
                            >
                                YAPE
                            </span>
                        </td>

                        <td>
                            <strong th:text="'S/ ' + ${nota.total}">
                                S/ 0
                            </strong>
                        </td>

                        <td>
                            <span
                                    th:text="${#temporals.format(
                                        nota.fechaEmision,
                                        'dd/MM/yyyy HH:mm'
                                    )}"
                            >
                                Fecha
                            </span>
                        </td>

                        <td>
                            <a
                                    th:href="@{/caja/notas-venta/{id}/pdf(
                                        id=${nota.idNota}
                                    )}"
                                    target="_blank"
                                    class="ultima-nota-pdf"
                                    title="Visualizar PDF"
                            >
                                <i class="bi bi-file-earmark-pdf"></i>
                            </a>
                        </td>

                    </tr>

                    </tbody>

                </table>

            </div>

        </section>

        <section class="caja-ayuda">

            <div class="ayuda-icono">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>
                <strong>Verificación segura</strong>

                <p>
                    Antes de aprobar un pago, verifica que el monto,
                    medio de pago y comprobante correspondan al pedido
                    o reserva seleccionada.
                </p>
            </div>

        </section>

    </main>

</div>

<script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

<script
        src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"
></script>

<script th:inline="javascript">
    const etiquetasVentas =
        /*[[${etiquetasVentas}]]*/ [];

    const montosVentas =
        /*[[${montosVentas}]]*/ [];

    const etiquetasMetodos =
        /*[[${etiquetasMetodos}]]*/ [];

    const cantidadesMetodos =
        /*[[${cantidadesMetodos}]]*/ [];

    const lienzoVentas =
        document.getElementById("graficoVentas");

    if (lienzoVentas) {
        new Chart(lienzoVentas, {
            type: "line",

            data: {
                labels: etiquetasVentas,

                datasets: [{
                    label: "Ventas",

                    data: montosVentas,

                    borderColor: "#8c2f1b",

                    backgroundColor:
                        "rgba(140, 47, 27, 0.12)",

                    borderWidth: 3,

                    pointBackgroundColor: "#d4a017",

                    pointBorderColor: "#ffffff",

                    pointBorderWidth: 2,

                    pointRadius: 5,

                    pointHoverRadius: 6,

                    tension: 0.35,

                    fill: true
                }]
            },

            options: {
                responsive: true,

                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    },

                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return "S/ " + context.parsed.y;
                            }
                        }
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0,

                            callback: function(value) {
                                return "S/ " + value;
                            }
                        },

                        grid: {
                            color: "rgba(59, 42, 34, 0.08)"
                        }
                    },

                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    }

    const lienzoMetodos =
        document.getElementById("graficoMetodos");

    if (lienzoMetodos) {
        new Chart(lienzoMetodos, {
            type: "doughnut",

            data: {
                labels: etiquetasMetodos,

                datasets: [{
                    data: cantidadesMetodos,

                    backgroundColor: [
                        "#8c2f1b",
                        "#d4a017",
                        "#387b91",
                        "#72538c",
                        "#278052"
                    ],

                    borderColor: "#ffffff",

                    borderWidth: 4,

                    hoverOffset: 7
                }]
            },

            options: {
                responsive: true,

                maintainAspectRatio: false,

                cutout: "63%",

                plugins: {
                    legend: {
                        position: "bottom",

                        labels: {
                            usePointStyle: true,
                            boxWidth: 9,
                            padding: 18
                        }
                    }
                }
            }
        });
    }
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/caja/notas-venta.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo} + ' - El Rinconcito Ayacuchano'">
        Notas de venta
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    <link th:href="@{/css/estilos.css}"
          rel="stylesheet">

    <link th:href="@{/css/caja.css(v=2)}"
          rel="stylesheet">

    <link th:href="@{/css/notas-venta.css(v=3)}"
          rel="stylesheet">
</head>

<body class="caja-body">

<div class="caja-layout">

    <aside th:replace="~{fragments/caja-sidebar :: sidebar('notas')}"></aside>

    <main class="caja-principal notas-principal">

        <header class="caja-encabezado notas-encabezado">

            <div>
                <span class="encabezado-etiqueta">
                    Comprobantes internos
                </span>

                <h1>Notas de venta</h1>

                <p>
                    Consulta, descarga e imprime las notas
                    generadas después de aprobar los pagos.
                </p>
            </div>
        </header>

        <!-- RESUMEN -->
        <section class="notas-resumen">

            <article class="nota-resumen-card">

                <div class="nota-resumen-icono resumen-total">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>

                <div>
                    <span>Total de notas</span>

                    <strong th:text="${totalNotas}">
                        0
                    </strong>
                </div>
            </article>

            <article class="nota-resumen-card">

                <div class="nota-resumen-icono resumen-emitidas">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <span>Notas emitidas</span>

                    <strong th:text="${notasEmitidas}">
                        0
                    </strong>
                </div>
            </article>

            <article class="nota-resumen-card">

                <div class="nota-resumen-icono resumen-anuladas">
                    <i class="bi bi-x-circle-fill"></i>
                </div>

                <div>
                    <span>Notas anuladas</span>

                    <strong th:text="${notasAnuladas}">
                        0
                    </strong>
                </div>
            </article>

            <article class="nota-resumen-card">

                <div class="nota-resumen-icono resumen-ventas">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <span>Total vendido</span>

                    <strong th:text="'S/ ' + ${totalVendido}">
                        S/ 0
                    </strong>
                </div>
            </article>
        </section>

        <!-- PANEL -->
        <section class="notas-panel">

            <div class="notas-panel-cabecera">

                <div>
                    <h2>Historial de notas</h2>

                    <p>
                        Busca una nota por número, pedido, reserva,
                        cliente o DNI.
                    </p>
                </div>

                <form th:action="@{/caja/notas-venta}"
                      method="get"
                      class="notas-buscador">

                    <div class="notas-campo-busqueda">

                        <i class="bi bi-search"></i>

                        <input type="search"
                               name="buscar"
                               th:value="${buscar}"
                               placeholder="Buscar nota, operación, cliente o DNI"
                               autocomplete="off">
                    </div>

                    <button type="submit">
                        Buscar
                    </button>

                    <a th:if="${buscar != null and !buscar.isBlank()}"
                       th:href="@{/caja/notas-venta}"
                       class="notas-limpiar"
                       title="Limpiar búsqueda">

                        <i class="bi bi-x-lg"></i>
                    </a>
                </form>
            </div>

            <!-- SIN RESULTADOS -->
            <div th:if="${notas == null or notas.isEmpty()}"
                 class="notas-vacio">

                <div class="notas-vacio-icono">
                    <i class="bi bi-receipt"></i>
                </div>

                <h3>No se encontraron notas de venta</h3>

                <p th:if="${buscar == null or buscar.isBlank()}">
                    Las notas aparecerán aquí cuando Caja apruebe
                    los pagos de pedidos o reservas.
                </p>

                <p th:if="${buscar != null and !buscar.isBlank()}">
                    No existen resultados para la búsqueda realizada.
                </p>
            </div>

            <!-- TABLA -->
            <div class="notas-tabla-contenedor"
                 th:if="${notas != null and !notas.isEmpty()}">

                <table class="notas-tabla">

                    <thead>
                    <tr>
                        <th>Nota</th>
                        <th>Operación</th>
                        <th>Cliente</th>
                        <th>Pago</th>
                        <th>Total</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                    </thead>

                    <tbody>

                    <tr th:each="nota : ${notas}">

                        <!-- NÚMERO DE NOTA -->
                        <td>

                            <strong class="nota-numero"
                                    th:text="${numerosNotas[nota.idNota]}">
                                NV01-000001
                            </strong>
                        </td>

                        <!-- PEDIDO O RESERVA -->
                        <td>

                            <!-- PEDIDO -->
                            <div class="nota-cliente"
                                 th:if="${nota.pago != null
                                     and nota.pago.pedido != null}">

                                <strong class="nota-pedido"
                                        th:text="${nota.pago.pedido.codigoPedido}">
                                    PED-2026-000001
                                </strong>

                                <span th:text="${nota.pago.pedido.tipoPedido != null
                                        and nota.pago.pedido.tipoPedido.name() == 'RECOJO_LOCAL'
                                        ? 'Recojo en local'
                                        : nota.pago.pedido.tipoPedido != null
                                            ? nota.pago.pedido.tipoPedido
                                            : 'Pedido'}">
                                    Delivery
                                </span>
                            </div>

                            <!-- RESERVA -->
                            <div class="nota-cliente"
                                 th:if="${nota.pago != null
                                     and nota.pago.reserva != null}">

                                <strong class="nota-pedido"
                                        th:text="${nota.pago.reserva.codigoReserva}">
                                    RES-2026-000001
                                </strong>

                                <span>
                                    Reserva
                                </span>
                            </div>

                            <!-- OPERACIÓN NO IDENTIFICADA -->
                            <div class="nota-cliente"
                                 th:if="${nota.pago == null
                                     or (nota.pago.pedido == null
                                     and nota.pago.reserva == null)}">

                                <strong class="nota-pedido">
                                    Sin operación
                                </strong>
                            </div>
                        </td>

                        <!-- CLIENTE -->
                        <td>

                            <div class="nota-cliente">

                                <strong th:text="${nota.clienteNombre}">
                                    Cliente
                                </strong>

                                <span th:text="${nota.clienteDocumento != null
                                        and !nota.clienteDocumento.isBlank()
                                        ? 'DNI: ' + nota.clienteDocumento
                                        : 'Sin documento'}">
                                    DNI
                                </span>
                            </div>
                        </td>

                        <!-- MÉTODO DE PAGO -->
                        <td>

                            <span class="nota-metodo"
                                  th:if="${nota.pago != null}"
                                  th:text="${nota.pago.metodoPago}">
                                YAPE
                            </span>

                            <span class="nota-metodo"
                                  th:if="${nota.pago == null}">
                                Sin pago
                            </span>
                        </td>

                        <!-- TOTAL -->
                        <td>

                            <strong class="nota-monto"
                                    th:text="'S/ ' + ${nota.total}">
                                S/ 0
                            </strong>
                        </td>

                        <!-- FECHA -->
                        <td>

                            <span class="nota-fecha"
                                  th:if="${nota.fechaEmision != null}"
                                  th:text="${#temporals.format(
                                      nota.fechaEmision,
                                      'dd/MM/yyyy HH:mm'
                                  )}">
                                08/10/2026 12:00
                            </span>

                            <span class="nota-fecha"
                                  th:if="${nota.fechaEmision == null}">
                                Sin fecha
                            </span>
                        </td>

                        <!-- ESTADO -->
                        <td>

                            <span class="nota-estado"
                                  th:if="${nota.estado != null}"
                                  th:classappend="${nota.estado.name() == 'EMITIDA'}
                                      ? ' nota-emitida'
                                      : ' nota-anulada'">

                                <i th:class="${nota.estado.name() == 'EMITIDA'}
                                        ? 'bi bi-check-circle-fill'
                                        : 'bi bi-x-circle-fill'">
                                </i>

                                <span th:text="${nota.estado}">
                                    EMITIDA
                                </span>
                            </span>

                            <span class="nota-estado"
                                  th:if="${nota.estado == null}">
                                Sin estado
                            </span>
                        </td>

                        <!-- ACCIONES -->
                        <td>

                            <div class="nota-acciones">

                                <!-- VISUALIZAR -->
                                <a th:href="@{/caja/notas-venta/{id}/pdf(id=${nota.idNota})}"
                                   target="_blank"
                                   rel="noopener"
                                   class="nota-accion nota-ver"
                                   title="Visualizar PDF">

                                    <i class="bi bi-eye"></i>
                                </a>

                                <!-- DESCARGAR -->
                                <a th:href="@{/caja/notas-venta/{id}/pdf(
                                        id=${nota.idNota},
                                        descargar=true
                                   )}"
                                   class="nota-accion nota-descargar"
                                   title="Descargar PDF">

                                    <i class="bi bi-download"></i>
                                </a>

                                <!-- IMPRIMIR -->
                                <a th:href="@{/caja/notas-venta/{id}/pdf(id=${nota.idNota})}"
                                   target="_blank"
                                   rel="noopener"
                                   class="nota-accion nota-imprimir"
                                   title="Abrir para imprimir">

                                    <i class="bi bi-printer"></i>
                                </a>
                            </div>
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/caja/pedidos-pendientes.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo} + ' - El Rinconcito Ayacuchano'">
        Pagos de pedidos
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    <link th:href="@{/css/estilos.css}"
          rel="stylesheet">

    <link th:href="@{/css/caja.css(v=3)}"
          rel="stylesheet">

    <link th:href="@{/css/caja-validaciones.css(v=1)}"
          rel="stylesheet">
</head>

<body class="caja-body">

<div class="caja-layout">

    <aside th:replace="~{fragments/caja-sidebar :: sidebar('pedidos')}"></aside>

    <main class="caja-principal">

        <header class="caja-encabezado validacion-encabezado">

            <div>
                <span class="encabezado-etiqueta">
                    Pedidos online
                </span>

                <h1>Pagos de pedidos</h1>

                <p>
                    Revisa la modalidad, los productos, los datos del cliente
                    y la evidencia antes de aprobar o rechazar el pago.
                </p>
            </div>
        </header>

        <!-- MENSAJE DE ÉXITO -->
        <div th:if="${exito}"
             class="validacion-alerta alerta-exito">

            <i class="bi bi-check-circle-fill"></i>
            <span th:text="${exito}"></span>
        </div>

        <!-- MENSAJE DE ERROR -->
        <div th:if="${error}"
             class="validacion-alerta alerta-error">

            <i class="bi bi-exclamation-circle-fill"></i>
            <span th:text="${error}"></span>
        </div>

        <section class="validacion-panel">

            <div class="validacion-panel-cabecera">

                <div>
                    <h2>Pedidos pendientes de validación</h2>

                    <p>
                        Pagos enviados por los clientes mediante
                        Yape, Plin o transferencia.
                    </p>
                </div>

                <div class="validacion-contador">

                    <i class="bi bi-hourglass-split"></i>

                    <div>
                        <strong th:text="${pendientes != null
                                ? pendientes.size()
                                : 0}">
                            0
                        </strong>

                        <span>Pendientes</span>
                    </div>
                </div>
            </div>

            <!-- SIN PAGOS PENDIENTES -->
            <div th:if="${pendientes == null or pendientes.isEmpty()}"
                 class="validacion-vacio">

                <div class="validacion-vacio-icono">
                    <i class="bi bi-bag-check"></i>
                </div>

                <h3>No hay pagos pendientes</h3>

                <p>
                    Los pagos de pedidos que necesiten validación
                    aparecerán en esta sección.
                </p>
            </div>

            <!-- TABLA -->
            <div class="validacion-tabla-contenedor"
                 th:if="${pendientes != null and !pendientes.isEmpty()}">

                <table class="validacion-tabla">

                    <thead>
                    <tr>
                        <th>Pedido y entrega</th>
                        <th>Productos</th>
                        <th>Total</th>
                        <th>Medio de pago</th>
                        <th>Evidencia</th>
                        <th>Decisión</th>
                    </tr>
                    </thead>

                    <tbody>

                    <tr th:each="pago : ${pendientes}">

                        <!-- PEDIDO, CLIENTE Y MODALIDAD -->
                        <td>

                            <div class="pedido-datos">

                                <strong class="codigo-registro"
                                        th:text="${pago.pedido.codigoPedido}">
                                    PED-2026-000001
                                </strong>

                                <!-- MODALIDAD -->
                                <span class="pago-metodo"
                                      th:text="${pago.pedido.tipoPedido.name() == 'RECOJO_LOCAL'
                                          ? 'RECOJO EN LOCAL'
                                          : pago.pedido.tipoPedido.name()}">
                                    DELIVERY
                                </span>

                                <!-- CLIENTE -->
                                <span class="cliente-nombre"
                                      th:text="${pago.pedido.cliente.nombres
                                          + ' '
                                          + pago.pedido.cliente.apellidos}">
                                    Cliente
                                </span>

                                <span class="dato-secundario"
                                      th:text="'DNI: '
                                          + ${pago.pedido.cliente.dni}
                                          + ' · Tel: '
                                          + ${pago.pedido.cliente.telefono}">
                                    DNI y teléfono
                                </span>

                                <!-- DIRECCIÓN PARA DELIVERY -->
                                <div class="direccion-entrega"
                                     th:if="${pago.pedido.tipoPedido.name() == 'DELIVERY'
                                         and pago.pedido.direccion != null}">

                                    <i class="bi bi-geo-alt-fill"></i>

                                    <span th:text="${pago.pedido.direccion.direccion
                                            + ' - '
                                            + pago.pedido.direccion.distrito}">
                                        Dirección
                                    </span>
                                </div>

                                <!-- REFERENCIA PARA DELIVERY -->
                                <span class="referencia-entrega"
                                      th:if="${pago.pedido.tipoPedido.name() == 'DELIVERY'
                                          and pago.pedido.direccion != null
                                          and pago.pedido.direccion.referencia != null
                                          and !pago.pedido.direccion.referencia.isBlank()}"
                                      th:text="'Referencia: '
                                          + ${pago.pedido.direccion.referencia}">
                                    Referencia
                                </span>

                                <!-- RECOJO EN LOCAL -->
                                <div class="direccion-entrega"
                                     th:if="${pago.pedido.tipoPedido.name() == 'RECOJO_LOCAL'}">

                                    <i class="bi bi-shop"></i>

                                    <span>
                                        El cliente recogerá el pedido en el restaurante.
                                    </span>
                                </div>

                                <!-- PEDIDO PRESENCIAL -->
                                <div class="direccion-entrega"
                                     th:if="${pago.pedido.tipoPedido.name() == 'PRESENCIAL'}">

                                    <i class="bi bi-table"></i>

                                    <span>
                                        Pedido para atención presencial.
                                    </span>
                                </div>
                            </div>
                        </td>

                        <!-- PRODUCTOS -->
                        <td>

                            <ul class="productos-lista"
                                th:if="${detallesPorPago[pago.idPago] != null}">

                                <li th:each="detalle : ${detallesPorPago[pago.idPago]}">

                                    <span class="producto-nombre"
                                          th:text="${detalle.producto.nombre}">
                                        Producto
                                    </span>

                                    <span class="producto-cantidad"
                                          th:text="'x' + ${detalle.cantidad}">
                                        x1
                                    </span>

                                    <strong th:text="'S/ ' + ${detalle.subtotal}">
                                        S/ 0
                                    </strong>
                                </li>
                            </ul>

                            <span class="dato-secundario"
                                  th:if="${detallesPorPago[pago.idPago] == null
                                      or detallesPorPago[pago.idPago].isEmpty()}">
                                Sin productos registrados
                            </span>
                        </td>

                        <!-- TOTAL -->
                        <td>

                            <strong class="pago-monto"
                                    th:text="'S/ ' + ${pago.monto}">
                                S/ 0
                            </strong>
                        </td>

                        <!-- MEDIO DE PAGO -->
                        <td>

                            <span class="pago-metodo"
                                  th:text="${pago.metodoPago}">
                                YAPE
                            </span>

                            <span class="pago-operacion"
                                  th:text="${pago.numeroOperacion != null
                                      and !pago.numeroOperacion.isBlank()
                                      ? pago.numeroOperacion
                                      : 'Sin número de operación'}">
                                Operación
                            </span>
                        </td>

                        <!-- EVIDENCIA -->
                        <td>

                            <a th:href="@{/caja/evidencias-pedido/{id}(id=${pago.idPago})}"
                               target="_blank"
                               rel="noopener"
                               class="boton-evidencia">

                                <i class="bi bi-image"></i>
                                Abrir captura
                            </a>
                        </td>

                        <!-- ACCIONES -->
                        <td>

                            <div class="acciones-validacion">

                                <!-- APROBAR -->
                                <form th:action="@{/caja/pedidos-pendientes/{id}/aprobar(id=${pago.idPago})}"
                                      method="post">

                                    <input th:if="${_csrf != null}"
                                           type="hidden"
                                           th:name="${_csrf.parameterName}"
                                           th:value="${_csrf.token}">

                                    <button type="submit"
                                            class="boton-aprobar">

                                        <i class="bi bi-check-lg"></i>
                                        Aprobar
                                    </button>
                                </form>

                                <!-- RECHAZAR -->
                                <form th:action="@{/caja/pedidos-pendientes/{id}/rechazar(id=${pago.idPago})}"
                                      method="post"
                                      class="form-rechazo">

                                    <input th:if="${_csrf != null}"
                                           type="hidden"
                                           th:name="${_csrf.parameterName}"
                                           th:value="${_csrf.token}">

                                    <input type="text"
                                           name="motivo"
                                           placeholder="Motivo del rechazo"
                                           required
                                           maxlength="300">

                                    <button type="submit"
                                            class="boton-rechazar">

                                        <i class="bi bi-x-lg"></i>
                                        Rechazar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/caja/pedidos-presenciales.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Cobros presenciales
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap"
          rel="stylesheet">

    <link th:href="@{/css/caja.css}"
          rel="stylesheet">

    <link th:href="@{/css/caja-presenciales.css}"
          rel="stylesheet">

</head>

<body class="caja-body">

<div class="caja-layout">

    <aside th:replace="~{fragments/caja-sidebar
        :: sidebar('presenciales')}">
    </aside>

    <main class="caja-contenido">

        <header class="presenciales-encabezado">

            <div>

                <p class="presenciales-etiqueta">
                    ATENCIÓN EN MESA
                </p>

                <h1>Cobros presenciales</h1>

                <p>
                    Registra los pagos enviados por los meseros,
                    finaliza el pedido y libera la mesa.
                </p>

            </div>

            <a th:href="@{/caja/dashboard}"
               class="btn-volver-caja">

                <i class="bi bi-arrow-left"></i>
                Panel de Caja
            </a>

        </header>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <section class="presenciales-resumen">

            <div class="presenciales-resumen-icono">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div class="presenciales-resumen-texto">

                <strong>Pedidos esperando cobro</strong>

                <span>
                    Verifica la mesa, los productos y el total
                    antes de registrar el pago.
                </span>

            </div>

            <div class="presenciales-resumen-total">

                <strong th:text="${#lists.size(pedidos)}">
                    0
                </strong>

                <span>Pendientes</span>

            </div>

        </section>

        <section th:if="${#lists.isEmpty(pedidos)}"
                 class="presenciales-vacio">

            <i class="bi bi-check-circle"></i>

            <h2>No hay cobros presenciales pendientes</h2>

            <p>
                Los pedidos enviados a cobro por los meseros
                aparecerán en esta sección.
            </p>

            <a th:href="@{/caja/dashboard}"
               class="btn-volver-inicio">

                <i class="bi bi-arrow-left"></i>
                Volver al panel
            </a>

        </section>

        <div th:unless="${#lists.isEmpty(pedidos)}"
             class="cobros-presenciales-grid">

            <article th:each="pedido : ${pedidos}"
                     class="pedido-presencial-card">

                <header class="pedido-presencial-cabecera">

                    <div>

                        <span class="pedido-presencial-etiqueta">
                            Mesa
                        </span>

                        <strong class="pedido-presencial-mesa"
                                th:text="${pedido.mesa != null
                                    ? pedido.mesa.numero
                                    : '—'}">
                            1
                        </strong>

                    </div>

                    <span class="pedido-presencial-estado">

                        <i class="bi bi-hourglass-split"></i>
                        Pendiente de cobro
                    </span>

                </header>

                <div class="pedido-presencial-datos">

                    <div class="pedido-presencial-dato">

                        <span>Pedido</span>

                        <strong th:text="${pedido.codigoPedido}">
                            PED-2026-000001
                        </strong>

                    </div>

                    <div class="pedido-presencial-dato">

                        <span>Piso</span>

                        <strong th:text="${pedido.mesa != null
                            and pedido.mesa.piso != null
                            ? pedido.mesa.piso.nombre
                            : '—'}">
                            Piso 1
                        </strong>

                    </div>

                    <div class="pedido-presencial-dato">

                        <span>Mesero</span>

                        <strong th:if="${pedido.mesero != null}"
                                th:text="${pedido.mesero.nombres
                                    + ' '
                                    + pedido.mesero.apellidos}">
                            Mesero
                        </strong>

                        <strong th:unless="${pedido.mesero != null}">
                            —
                        </strong>

                    </div>

                    <div class="pedido-presencial-dato">

                        <span>Registrado</span>

                        <strong th:text="${pedido.fechaRegistro != null
                            ? #temporals.format(
                                pedido.fechaRegistro,
                                'dd/MM/yyyy HH:mm'
                              )
                            : '—'}">
                            10/10/2026 12:00
                        </strong>

                    </div>

                </div>

                <section class="pedido-presencial-productos">

                    <h2>

                        <i class="bi bi-receipt"></i>
                        Productos consumidos
                    </h2>

                    <div th:with="detalles=${detallesPorPedido[pedido.idPedido]}">

                        <p th:if="${detalles == null
                            or #lists.isEmpty(detalles)}"
                           class="pedido-sin-productos">

                            No hay productos registrados.
                        </p>

                        <ul th:unless="${detalles == null
                            or #lists.isEmpty(detalles)}">

                            <li th:each="detalle : ${detalles}">

                                <span class="producto-cantidad"
                                      th:text="${detalle.cantidad + 'x'}">
                                    1x
                                </span>

                                <div class="producto-informacion">

                                    <strong th:text="${detalle.producto != null
                                        ? detalle.producto.nombre
                                        : 'Producto'}">
                                        Producto
                                    </strong>

                                    <small th:if="${detalle.observaciones != null
                                        and !detalle.observaciones.isBlank()}"
                                           th:text="${detalle.observaciones}">
                                        Sin cebolla
                                    </small>

                                </div>

                                <span class="producto-subtotal"
                                      th:text="'S/ ' + ${detalle.subtotal}">
                                    S/ 0
                                </span>

                            </li>

                        </ul>

                    </div>

                </section>

                <div th:if="${pedido.observaciones != null
                    and !pedido.observaciones.isBlank()}"
                     class="pedido-presencial-observacion">

                    <strong>Observaciones</strong>

                    <p th:text="${pedido.observaciones}">
                        Observaciones del pedido.
                    </p>

                </div>

                <div class="pedido-presencial-total">

                    <span>Total por cobrar</span>

                    <strong th:text="'S/ ' + ${pedido.total}">
                        S/ 0
                    </strong>

                </div>

                <form th:action="@{/caja/pedidos-presenciales/{idPedido}/cobrar(
                            idPedido=${pedido.idPedido}
                      )}"
                      method="post"
                      class="formulario-cobro-presencial"
                      data-formulario-cobro>

                    <input type="hidden"
                           th:name="${_csrf.parameterName}"
                           th:value="${_csrf.token}">

                    <div class="campo-cobro">

                        <label th:for="'metodoPago-' + ${pedido.idPedido}">
                            Método de pago
                            <span>*</span>
                        </label>

                        <select th:id="'metodoPago-' + ${pedido.idPedido}"
                                name="metodoPago"
                                class="form-select metodo-pago-presencial"
                                required>

                            <option value="">
                                Selecciona un método
                            </option>

                            <option value="EFECTIVO">
                                Efectivo
                            </option>

                            <option value="YAPE">
                                Yape
                            </option>

                            <option value="PLIN">
                                Plin
                            </option>

                            <option value="TRANSFERENCIA">
                                Transferencia
                            </option>

                        </select>

                    </div>

                    <div class="campo-cobro campo-numero-operacion"
                         hidden>

                        <label th:for="'numeroOperacion-' + ${pedido.idPedido}">
                            Número de operación
                            <span>*</span>
                        </label>

                        <input type="text"
                               th:id="'numeroOperacion-' + ${pedido.idPedido}"
                               name="numeroOperacion"
                               class="form-control numero-operacion-presencial"
                               maxlength="50"
                               autocomplete="off"
                               placeholder="Ingresa el número de operación">

                        <small>
                            Obligatorio para Yape, Plin o transferencia.
                        </small>

                    </div>

                    <div class="cobro-presencial-informacion">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Al confirmar, el pedido finalizará,
                            se emitirá la nota de venta y la mesa
                            quedará disponible.
                        </span>

                    </div>

                    <button type="submit"
                            class="btn-confirmar-cobro">

                        <i class="bi bi-check-circle"></i>
                        Confirmar pago
                    </button>

                </form>

            </article>

        </div>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<script>
    document.addEventListener(
        "DOMContentLoaded",
        function () {
            const formularios =
                document.querySelectorAll(
                    "[data-formulario-cobro]"
                );

            formularios.forEach(function (formulario) {
                const metodoPago =
                    formulario.querySelector(
                        ".metodo-pago-presencial"
                    );

                const contenedorOperacion =
                    formulario.querySelector(
                        ".campo-numero-operacion"
                    );

                const numeroOperacion =
                    formulario.querySelector(
                        ".numero-operacion-presencial"
                    );

                const boton =
                    formulario.querySelector(
                        ".btn-confirmar-cobro"
                    );

                function actualizarNumeroOperacion() {
                    const metodo =
                        metodoPago.value;

                    const requiereOperacion =
                        metodo === "YAPE"
                        || metodo === "PLIN"
                        || metodo === "TRANSFERENCIA";

                    contenedorOperacion.hidden =
                        !requiereOperacion;

                    numeroOperacion.required =
                        requiereOperacion;

                    if (!requiereOperacion) {
                        numeroOperacion.value = "";
                    }
                }

                metodoPago.addEventListener(
                    "change",
                    actualizarNumeroOperacion
                );

                formulario.addEventListener(
                    "submit",
                    function (event) {
                        actualizarNumeroOperacion();

                        if (!formulario.checkValidity()) {
                            event.preventDefault();
                            formulario.reportValidity();
                            return;
                        }

                        const metodoSeleccionado =
                            metodoPago.options[
                                metodoPago.selectedIndex
                            ].text;

                        const confirmar =
                            window.confirm(
                                "¿Confirmas el pago mediante "
                                + metodoSeleccionado
                                + "?\n\n"
                                + "El pedido finalizará y la mesa "
                                + "quedará disponible."
                            );

                        if (!confirmar) {
                            event.preventDefault();
                            return;
                        }

                        boton.disabled = true;

                        boton.innerHTML =
                            '<span class="spinner-border '
                            + 'spinner-border-sm" '
                            + 'aria-hidden="true"></span> '
                            + 'Procesando...';
                    }
                );

                actualizarNumeroOperacion();
            });
        }
    );
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/caja/reservas-pendientes.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
    >

    <title th:text="${titulo} + ' - El Rinconcito Ayacuchano'">
        Pagos de reservas
    </title>

    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
    >

    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
            rel="stylesheet"
    >

    <link
            href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Nunito:wght@400;600;700;800&display=swap"
            rel="stylesheet"
    >

    <link
            th:href="@{/css/estilos.css}"
            rel="stylesheet"
    >

    <link
            th:href="@{/css/caja.css(v=3)}"
            rel="stylesheet"
    >

    <link
            th:href="@{/css/caja-validaciones.css(v=1)}"
            rel="stylesheet"
    >
</head>

<body class="caja-body">

<div class="caja-layout">

    <aside
            th:replace="~{fragments/caja-sidebar :: sidebar('reservas')}"
    ></aside>

    <main class="caja-principal">

        <header class="caja-encabezado validacion-encabezado">

            <div>
                <span class="encabezado-etiqueta">
                    Reservas con pago
                </span>

                <h1>Pagos de reservas</h1>

                <p>
                    Verifica la evidencia del pago antes de confirmar
                    la reserva y asignar una mesa disponible.
                </p>
            </div>
        </header>

        <div
                th:if="${exito}"
                class="validacion-alerta alerta-exito"
        >
            <i class="bi bi-check-circle-fill"></i>
            <span th:text="${exito}"></span>
        </div>

        <div
                th:if="${error}"
                class="validacion-alerta alerta-error"
        >
            <i class="bi bi-exclamation-circle-fill"></i>
            <span th:text="${error}"></span>
        </div>

        <section class="validacion-panel">

            <div class="validacion-panel-cabecera">

                <div>
                    <h2>Reservas pendientes de validación</h2>

                    <p>
                        Revisa la fecha, el evento, el cliente y la
                        captura antes de aprobar el pago.
                    </p>
                </div>

                <div class="validacion-contador contador-reservas">

                    <i class="bi bi-calendar2-check"></i>

                    <div>
                        <strong
                                th:text="${pendientes != null
                                    ? pendientes.size()
                                    : 0}"
                        >
                            0
                        </strong>

                        <span>Pendientes</span>
                    </div>

                </div>

            </div>

            <div
                    th:if="${pendientes == null or pendientes.isEmpty()}"
                    class="validacion-vacio"
            >
                <div class="validacion-vacio-icono">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <h3>No hay pagos pendientes</h3>

                <p>
                    Los pagos de reservas que necesiten validación
                    aparecerán en esta sección.
                </p>
            </div>

            <div
                    class="validacion-tabla-contenedor"
                    th:if="${pendientes != null and !pendientes.isEmpty()}"
            >

                <table class="validacion-tabla tabla-reservas">

                    <thead>
                    <tr>
                        <th>Reserva</th>
                        <th>Evento y cliente</th>
                        <th>Monto</th>
                        <th>Medio de pago</th>
                        <th>Evidencia</th>
                        <th>Decisión</th>
                    </tr>
                    </thead>

                    <tbody>

                    <tr th:each="pago : ${pendientes}">

                        <td>
                            <div class="reserva-datos">

                                <strong
                                        class="codigo-registro"
                                        th:text="${pago.reserva.codigoReserva}"
                                >
                                    RES-2026-000001
                                </strong>

                                <div class="reserva-fecha">

                                    <i class="bi bi-calendar3"></i>

                                    <span
                                            th:text="${#temporals.format(
                                                pago.reserva.fechaReserva,
                                                'dd/MM/yyyy'
                                            )}"
                                    >
                                        Fecha
                                    </span>

                                    <span>·</span>

                                    <span
                                            th:text="${#temporals.format(
                                                pago.reserva.horaInicio,
                                                'HH:mm'
                                            )}"
                                    >
                                        Hora
                                    </span>

                                </div>

                                <span
                                        class="dato-secundario"
                                        th:if="${pago.reserva.pisoSolicitado != null}"
                                        th:text="${pago.reserva.pisoSolicitado.nombre
                                            + ' · '
                                            + pago.reserva.numeroPersonas
                                            + ' personas'}"
                                >
                                    Piso y personas
                                </span>

                            </div>
                        </td>

                        <td>
                            <div class="evento-cliente">

                                <strong
                                        th:if="${pago.reserva.evento != null}"
                                        th:text="${pago.reserva.evento.titulo}"
                                >
                                    Evento
                                </strong>

                                <strong
                                        th:unless="${pago.reserva.evento != null}"
                                        class="sin-evento"
                                >
                                    Sin evento asociado
                                </strong>

                                <span
                                        th:text="${pago.reserva.cliente.nombres
                                            + ' '
                                            + pago.reserva.cliente.apellidos}"
                                >
                                    Cliente
                                </span>

                            </div>
                        </td>

                        <td>
                            <strong
                                    class="pago-monto"
                                    th:text="'S/ ' + ${pago.monto}"
                            >
                                S/ 0
                            </strong>
                        </td>

                        <td>
                            <span
                                    class="pago-metodo"
                                    th:text="${pago.metodoPago}"
                            >
                                YAPE
                            </span>

                            <span
                                    class="pago-operacion"
                                    th:text="${pago.numeroOperacion != null
                                        and !pago.numeroOperacion.isBlank()
                                        ? pago.numeroOperacion
                                        : 'Sin número de operación'}"
                            >
                                Operación
                            </span>
                        </td>

                        <td>
                            <a
                                    th:href="@{/caja/evidencias/{id}(
                                        id=${pago.idPago}
                                    )}"
                                    target="_blank"
                                    class="boton-evidencia"
                            >
                                <i class="bi bi-image"></i>
                                Abrir captura
                            </a>
                        </td>

                        <td>
                            <div class="acciones-validacion">

                                <form
                                        th:action="@{/caja/reservas-pendientes/{id}/aprobar(
                                            id=${pago.idPago}
                                        )}"
                                        method="post"
                                >
                                    <input
                                            th:if="${_csrf != null}"
                                            type="hidden"
                                            th:name="${_csrf.parameterName}"
                                            th:value="${_csrf.token}"
                                    >

                                    <button
                                            type="submit"
                                            class="boton-aprobar"
                                    >
                                        <i class="bi bi-check-lg"></i>
                                        Aprobar
                                    </button>
                                </form>

                                <form
                                        th:action="@{/caja/reservas-pendientes/{id}/rechazar(
                                            id=${pago.idPago}
                                        )}"
                                        method="post"
                                        class="form-rechazo"
                                >
                                    <input
                                            th:if="${_csrf != null}"
                                            type="hidden"
                                            th:name="${_csrf.parameterName}"
                                            th:value="${_csrf.token}"
                                    >

                                    <input
                                            type="text"
                                            name="motivo"
                                            placeholder="Motivo del rechazo"
                                            required
                                            maxlength="300"
                                    >

                                    <button
                                            type="submit"
                                            class="boton-rechazar"
                                    >
                                        <i class="bi bi-x-lg"></i>
                                        Rechazar
                                    </button>
                                </form>

                            </div>
                        </td>

                    </tr>

                    </tbody>

                </table>

            </div>

        </section>

    </main>

</div>

<script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/mesero/comanda.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo + ' - El Rinconcito'}">
        Comanda de cocina
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">
	<link th:href="@{/css/mesero-comanda.css}"
		  rel="stylesheet">
</head>

<body>

<div class="comanda-acciones">

    <a th:href="@{/mesero/pedidos}"
       class="btn-volver">

        <i class="bi bi-arrow-left"></i>
        Volver
    </a>

    <button type="button"
            class="btn-imprimir"
            onclick="window.print()">

        <i class="bi bi-printer"></i>
        Imprimir comanda
    </button>

</div>

<main class="comanda">

    <header class="comanda-encabezado">

        <h1>Comanda de cocina</h1>

        <p>El Rinconcito Ayacuchano Campestre</p>

    </header>

    <section class="comanda-identificacion">

        <div class="comanda-mesa">

            <span>Mesa</span>

            <strong th:text="${pedido.mesa != null ? pedido.mesa.numero : '—'}">
                1
            </strong>

        </div>

        <div class="comanda-dato">

            <span>Piso:</span>

            <span th:text="${pedido.mesa != null and pedido.mesa.piso != null ? pedido.mesa.piso.nombre : 'Sin piso'}">
                Piso 1
            </span>

        </div>

        <div class="comanda-dato">

            <span>Pedido:</span>

            <span th:text="${pedido.codigoPedido}">
                PED-000001
            </span>

        </div>

        <div class="comanda-dato">

            <span>Mesero:</span>

            <span th:text="${pedido.mesero != null ? pedido.mesero.nombres + ' ' + pedido.mesero.apellidos : 'Sin asignar'}">
                Mesero
            </span>

        </div>

        <div class="comanda-dato">

            <span>Fecha:</span>

            <span th:text="${pedido.fechaRegistro != null ? #temporals.format(pedido.fechaRegistro, 'dd/MM/yyyy HH:mm') : '—'}">
                10/10/2026 12:00
            </span>

        </div>

    </section>

    <section class="comanda-productos">

        <h2>Productos solicitados</h2>

        <div th:if="${detalles == null or #lists.isEmpty(detalles)}"
             class="sin-productos">

            No hay productos registrados en este pedido.

        </div>

        <article th:each="detalle : ${detalles}"
                 class="producto-comanda">

            <div class="producto-principal">

                <div class="producto-cantidad"
                     th:text="${detalle.cantidad + 'x'}">
                    2x
                </div>

                <div class="producto-nombre"
                     th:text="${detalle.producto != null ? detalle.producto.nombre : 'Producto'}">
                    Producto
                </div>

            </div>

            <div th:if="${detalle.observaciones != null and !#strings.isEmpty(detalle.observaciones)}"
                 class="producto-observacion">

                <i class="bi bi-exclamation-circle"></i>

                <span th:text="${detalle.observaciones}">
                    Sin cebolla
                </span>

            </div>

        </article>

    </section>

    <section th:if="${pedido.observaciones != null and !#strings.isEmpty(pedido.observaciones)}"
             class="pedido-observaciones">

        <h3>Observaciones generales</h3>

        <p th:text="${pedido.observaciones}">
            Indicaciones generales del pedido.
        </p>

    </section>

    <footer class="comanda-pie">

        <p>
            Impreso:
            <span id="fechaImpresion"></span>
        </p>

    </footer>

</main>

<script>
    document.addEventListener(
        "DOMContentLoaded",
        function () {
            const ahora = new Date();

            const fecha =
                ahora.toLocaleDateString("es-PE")
                + " "
                + ahora.toLocaleTimeString(
                    "es-PE",
                    {
                        hour: "2-digit",
                        minute: "2-digit"
                    }
                );

            document.getElementById(
                "fechaImpresion"
            ).textContent = fecha;
        }
    );
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/mesero/historial.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo + ' - El Rinconcito Ayacuchano'}">
        Historial de atenciones
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    <link th:href="@{/css/mesero-mesas.css}"
          rel="stylesheet">

    <link th:href="@{/css/mesero-historial.css}"
          rel="stylesheet">
</head>

<body>

<div class="mesero-layout">

    <aside th:replace="~{fragments/mesero-sidebar
        :: sidebar('historial')}">
    </aside>

    <main class="mesero-contenido historial-contenido">

        <header class="historial-encabezado">

            <div>
                <p class="historial-etiqueta">
                    ATENCIONES REALIZADAS
                </p>

                <h1>Historial de pedidos</h1>

                <p>
                    Consulta los pedidos presenciales que finalizaste
                    o que fueron cancelados.
                </p>
            </div>

            <div class="historial-usuario">

                <i class="bi bi-person-circle"></i>

                <span sec:authentication="name">
                    mesero
                </span>

            </div>

        </header>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <section class="historial-resumen">

            <article class="resumen-tarjeta resumen-finalizados">

                <div class="resumen-icono">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div>
                    <span>Finalizados</span>

                    <strong th:text="${totalFinalizados}">
                        0
                    </strong>
                </div>

            </article>

            <article class="resumen-tarjeta resumen-cancelados">

                <div class="resumen-icono">
                    <i class="bi bi-x-circle"></i>
                </div>

                <div>
                    <span>Cancelados</span>

                    <strong th:text="${totalCancelados}">
                        0
                    </strong>
                </div>

            </article>

            <article class="resumen-tarjeta resumen-ventas">

                <div class="resumen-icono">
                    <i class="bi bi-cash-coin"></i>
                </div>

                <div>
                    <span>Total atendido</span>

                    <strong th:text="'S/ ' + ${totalVentas}">
                        S/ 0
                    </strong>
                </div>

            </article>

        </section>

        <section th:if="${#lists.isEmpty(pedidos)}"
                 class="historial-vacio">

            <i class="bi bi-clock-history"></i>

            <h2>Aún no tienes atenciones terminadas</h2>

            <p>
                Los pedidos finalizados o cancelados aparecerán
                automáticamente en esta sección.
            </p>

            <a th:href="@{/mesero/pedidos}"
               class="btn-ver-activos">

                <i class="bi bi-receipt"></i>
                Ver pedidos activos
            </a>

        </section>

        <section th:unless="${#lists.isEmpty(pedidos)}"
                 class="historial-lista">

            <article th:each="pedido : ${pedidos}"
                     class="historial-pedido"
                     th:classappend="${pedido.estado.name() == 'CANCELADO'}
                         ? ' pedido-cancelado'
                         : ' pedido-finalizado'">

                <div class="historial-pedido-cabecera">

                    <div>

                        <span class="pedido-codigo-etiqueta">
                            PEDIDO
                        </span>

                        <strong class="pedido-codigo"
                                th:text="${pedido.codigoPedido}">
                            PED-2026-000001
                        </strong>

                    </div>

                    <span class="pedido-estado"
                          th:classappend="${pedido.estado.name() == 'CANCELADO'}
                              ? ' estado-cancelado'
                              : ' estado-finalizado'"
                          th:text="${pedido.estado.name() == 'CANCELADO'}
                              ? 'CANCELADO'
                              : 'FINALIZADO'">

                        FINALIZADO
                    </span>

                </div>

                <div class="historial-pedido-datos">

                    <div class="pedido-dato">

                        <span>
                            <i class="bi bi-building"></i>
                            Ubicación
                        </span>

                        <strong th:if="${pedido.mesa != null}"
                                th:text="${(pedido.mesa.piso != null
                                    ? pedido.mesa.piso.nombre + ' · '
                                    : '') + 'Mesa ' + pedido.mesa.numero}">

                            Piso 1 · Mesa 1
                        </strong>

                        <strong th:unless="${pedido.mesa != null}">
                            Sin mesa
                        </strong>

                    </div>

                    <div class="pedido-dato">

                        <span>
                            <i class="bi bi-calendar3"></i>
                            Registrado
                        </span>

                        <strong th:text="${pedido.fechaRegistro != null
                            ? #temporals.format(
                                pedido.fechaRegistro,
                                'dd/MM/yyyy HH:mm'
                              )
                            : '—'}">

                            10/10/2026 10:30
                        </strong>

                    </div>

                    <div class="pedido-dato">

                        <span>
                            <i class="bi bi-clock-history"></i>
                            Actualizado
                        </span>

                        <strong th:text="${pedido.fechaActualizacion != null
                            ? #temporals.format(
                                pedido.fechaActualizacion,
                                'dd/MM/yyyy HH:mm'
                              )
                            : '—'}">

                            10/10/2026 11:30
                        </strong>

                    </div>

                </div>

                <div class="historial-productos">

                    <h3>Productos del pedido</h3>

                    <ul th:with="detalles=${detallesPorPedido[pedido.idPedido]}">

                        <li th:if="${#lists.isEmpty(detalles)}"
                            class="sin-productos">

                            No hay productos registrados.
                        </li>

                        <li th:each="detalle : ${detalles}">

                            <span class="producto-cantidad"
                                  th:text="${detalle.cantidad + 'x'}">
                                1x
                            </span>

                            <div class="producto-informacion">

                                <strong th:text="${detalle.producto != null
                                    ? detalle.producto.nombre
                                    : 'Producto'}">

                                    Producto
                                </strong>

                                <small th:if="${detalle.observaciones != null
                                    and !detalle.observaciones.isBlank()}"
                                       th:text="${detalle.observaciones}">

                                    Sin cebolla
                                </small>

                            </div>

                            <span class="producto-subtotal"
                                  th:text="'S/ ' + ${detalle.subtotal}">
                                S/ 0
                            </span>

                        </li>

                    </ul>

                </div>

                <div th:if="${pedido.observaciones != null
                    and !pedido.observaciones.isBlank()}"
                     class="pedido-observacion">

                    <strong>Observaciones</strong>

                    <p th:text="${pedido.observaciones}">
                        Observaciones del pedido.
                    </p>

                </div>

                <div class="historial-pedido-pie">

                    <div class="pedido-total">

                        <span>Total</span>

                        <strong th:text="'S/ ' + ${pedido.total}">
                            S/ 0
                        </strong>

                    </div>

                    <a th:href="@{/mesero/pedidos/{idPedido}/comanda(
                            idPedido=${pedido.idPedido}
                       )}"
                       class="btn-ver-comanda">

                        <i class="bi bi-printer"></i>
                        Ver comanda
                    </a>

                </div>

            </article>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/mesero/mesas.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo+ ' - El Rinconcito Ayacuchano'}">Control de mesas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Nunito:wght@400;600;700&display=swap"rel="stylesheet">
    <link th:href="@{/css/estilos.css}"rel="stylesheet">
    <link th:href="@{/css/mesero-mesas.css}"rel="stylesheet">
</head>
<body>
<div class="mesero-layout">
    <aside th:replace="~{fragments/mesero-sidebar :: sidebar('mesas')}"></aside>
    <div id="meseroSidebarFondo"
         class="mesero-sidebar-fondo"
         onclick="cerrarSidebarMesero()">
    </div>
    <div class="mesero-area">

        <header class="mesero-barra-movil">

            <button type="button"
                    class="mesero-menu-boton"
                    aria-label="Abrir menú"
                    onclick="abrirSidebarMesero()">

                <i class="bi bi-list"></i>

            </button>

            <a th:href="@{/mesero/mesas}"
               class="mesero-barra-marca">

                <span class="mesero-barra-logo">
                    <i class="bi bi-cup-hot-fill"></i>
                </span>

                <span>
                    <strong>El Rinconcito</strong>
                    <small>Panel del mesero</small>
                </span>
            </a>

        </header>

        <main class="mesero-contenido">

            <section class="mesero-encabezado">

                <div>

                    <p class="mesero-etiqueta">
                        OPERACIÓN DEL RESTAURANTE
                    </p>

                    <h1>Control de mesas</h1>

                    <p class="mesero-fecha">

                        <i class="bi bi-calendar3"></i>

                        <span th:text="${fechaActual}">
                            Jueves 9 de octubre de 2026
                        </span>

                    </p>

                </div>
            </section>

            <div th:if="${exito}"
                 class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>

                <span th:text="${exito}">
                    Operación realizada correctamente.
                </span>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>

            </div>

            <div th:if="${error}"
                 class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <span th:text="${error}">
                    Ocurrió un error.
                </span>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>

            </div>

            <section class="mesero-leyenda">

                <div class="leyenda-elemento">

                    <span class="leyenda-color disponible"></span>
                    Disponible

                </div>

                <div class="leyenda-elemento">

                    <span class="leyenda-color ocupada"></span>
                    Ocupada

                </div>

                <div class="leyenda-elemento">

                    <span class="leyenda-color reservada"></span>
                    Reservada

                </div>

                <div class="leyenda-elemento">

                    <span class="leyenda-color inactiva"></span>
                    Inactiva

                </div>

            </section>

            <div th:if="${pisos == null or pisos.isEmpty()}"
                 class="mesero-sin-mesas">

                <i class="bi bi-grid-3x3-gap"></i>

                <h2>No hay mesas registradas</h2>

                <p>
                    El administrador debe registrar los pisos
                    y las mesas del restaurante.
                </p>

            </div>

            <section th:each="pisoDTO : ${pisos}"
                     class="piso-seccion">

                <header class="piso-encabezado">

                    <div class="piso-titulo">

                        <span class="piso-icono">
                            <i class="bi bi-building"></i>
                        </span>

                        <div>

                            <h2 th:text="${pisoDTO.piso.nombre}">
                                Primer piso
                            </h2>

                            <p th:if="${pisoDTO.piso.descripcion != null
                                    and !pisoDTO.piso.descripcion.isBlank()}"
                               th:text="${pisoDTO.piso.descripcion}">
                                Salón principal
                            </p>

                        </div>

                    </div>

                    <span class="piso-total"
                          th:text="${pisoDTO.mesas.size()
                                + (pisoDTO.mesas.size() == 1
                                ? ' mesa'
                                : ' mesas')}">
                        10 mesas
                    </span>

                </header>

                <div th:if="${pisoDTO.mesas.isEmpty()}"
                     class="piso-sin-mesas">

                    No existen mesas registradas en este piso.

                </div>

                <div th:if="${!pisoDTO.mesas.isEmpty()}"
                     class="mesas-grid">

                    <article th:each="item : ${pisoDTO.mesas}"
                             class="mesa-tarjeta"
                             th:classappend="${'mesa-'
                                    + #strings.toLowerCase(
                                        item.estadoVisual
                                    )}">

                        <div class="mesa-cabecera">

                            <div class="mesa-numero">

                                <span>Mesa</span>

                                <strong th:text="${item.mesa.numero}">
                                    1
                                </strong>

                            </div>

                            <span class="mesa-estado"
                                  th:text="${item.estadoVisual}">
                                DISPONIBLE
                            </span>

                        </div>

                        <div class="mesa-informacion">

                            <div class="mesa-capacidad">

                                <i class="bi bi-people-fill"></i>

                                <span th:text="${item.mesa.capacidad
                                        + (item.mesa.capacidad == 1
                                        ? ' persona'
                                        : ' personas')}">
                                    4 personas
                                </span>

                            </div>

                        </div>

                        <div th:if="${item.reserva != null}"
                             class="reserva-mesa">

                            <div class="reserva-mesa-titulo">

                                <i class="bi bi-calendar-check"></i>

                                <strong>Reserva del día</strong>

                            </div>

                            <p class="reserva-codigo"
                               th:text="${item.reserva.codigoReserva}">
                                RES-2026-000001
                            </p>

                            <p th:if="${item.reserva.cliente != null}"
                               class="reserva-cliente">

                                <i class="bi bi-person"></i>

                                <span th:text="${item.reserva.cliente.nombres
                                        + ' '
                                        + item.reserva.cliente.apellidos}">
                                    Nombre del cliente
                                </span>

                            </p>

                            <div class="reserva-datos">

                                <span>

                                    <i class="bi bi-clock"></i>

                                    <span th:text="${#temporals.format(
                                            item.reserva.horaInicio,
                                            'HH:mm'
                                        )
                                        + ' - '
                                        + #temporals.format(
                                            item.reserva.horaFin,
                                            'HH:mm'
                                        )}">
                                        12:00 - 14:00
                                    </span>

                                </span>

                                <span>

                                    <i class="bi bi-people"></i>

                                    <span th:text="${item.reserva.numeroPersonas}">
                                        4
                                    </span>

                                </span>

                            </div>

                            <p th:if="${item.reserva.evento != null}"
                               class="reserva-evento">

                                <i class="bi bi-music-note-beamed"></i>

                                <span th:text="${item.reserva.evento.titulo}">
                                    Evento
                                </span>

                            </p>

                            <span class="reserva-estado"
                                  th:text="${#strings.replace(
                                        item.reserva.estado.name(),
                                        '_',
                                        ' '
                                  )}">
                                CONFIRMADA
                            </span>

                        </div>

                        <div class="mesa-acciones">

                            <form th:if="${item.estadoVisual
                                    == 'DISPONIBLE'}"
                                  th:action="@{/mesero/mesas/{id}/ocupar(
                                        id=${item.mesa.idMesa}
                                  )}"
                                  method="post">

                                <input type="hidden"
                                       th:name="${_csrf.parameterName}"
                                       th:value="${_csrf.token}">

                                <button type="submit"
                                        class="btn-mesa btn-ocupar"
                                        onclick="return confirm(
                                            '¿Marcar esta mesa como ocupada?'
                                        );">

                                    <i class="bi bi-person-fill-add"></i>
                                    Ocupar mesa

                                </button>

                            </form>

                            <form th:if="${item.estadoVisual
                                    == 'OCUPADA'
                                    and item.reserva == null}"
                                  th:action="@{/mesero/mesas/{id}/liberar(
                                        id=${item.mesa.idMesa}
                                  )}"
                                  method="post">

                                <input type="hidden"
                                       th:name="${_csrf.parameterName}"
                                       th:value="${_csrf.token}">

                                <button type="submit"
                                        class="btn-mesa btn-liberar"
                                        onclick="return confirm(
                                            '¿Confirmas que la mesa está libre?'
                                        );">

                                    <i class="bi bi-check-circle"></i>
                                    Liberar mesa

                                </button>

                            </form>

                            <form th:if="${item.reserva != null
                                    and item.reserva.estado.name()
                                    == 'CONFIRMADA'}"
                                  th:action="@{/mesero/reservas/{id}/llegada(
                                        id=${item.reserva.idReserva}
                                  )}"
                                  method="post">

                                <input type="hidden"
                                       th:name="${_csrf.parameterName}"
                                       th:value="${_csrf.token}">

                                <button type="submit"
                                        class="btn-mesa btn-llegada">

                                    <i class="bi bi-person-check"></i>
                                    Registrar llegada

                                </button>

                            </form>

                            <form th:if="${item.reserva != null
                                    and item.reserva.estado.name()
                                    == 'CLIENTE_LLEGO'}"
                                  th:action="@{/mesero/reservas/{id}/iniciar(
                                        id=${item.reserva.idReserva}
                                  )}"
                                  method="post">

                                <input type="hidden"
                                       th:name="${_csrf.parameterName}"
                                       th:value="${_csrf.token}">

                                <button type="submit"
                                        class="btn-mesa btn-iniciar">

                                    <i class="bi bi-play-circle"></i>
                                    Iniciar atención

                                </button>

                            </form>

                            <form th:if="${item.reserva != null
                                    and (
                                        item.reserva.estado.name()
                                        == 'CLIENTE_LLEGO'
                                        or item.reserva.estado.name()
                                        == 'EN_ATENCION'
                                    )}"
                                  th:action="@{/mesero/reservas/{id}/finalizar(
                                        id=${item.reserva.idReserva}
                                  )}"
                                  method="post">

                                <input type="hidden"
                                       th:name="${_csrf.parameterName}"
                                       th:value="${_csrf.token}">

                                <button type="submit"
                                        class="btn-mesa btn-finalizar"
                                        onclick="return confirm(
                                            '¿Finalizar la atención y liberar la mesa?'
                                        );">

                                    <i class="bi bi-check2-circle"></i>
                                    Finalizar atención

                                </button>

                            </form>

                            <p th:if="${item.estadoVisual
                                    == 'INACTIVA'}"
                               class="mesa-sin-acciones">

                                <i class="bi bi-slash-circle"></i>
                                Mesa fuera de servicio

                            </p>

                        </div>

                    </article>

                </div>

            </section>

        </main>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<script>
    function abrirSidebarMesero() {
        const sidebar =
            document.getElementById("meseroSidebar");

        const fondo =
            document.getElementById(
                "meseroSidebarFondo"
            );

        if (sidebar) {
            sidebar.classList.add("abierto");
        }

        if (fondo) {
            fondo.classList.add("visible");
        }

        document.body.classList.add(
            "sidebar-mesero-abierto"
        );
    }

    function cerrarSidebarMesero() {
        const sidebar =
            document.getElementById("meseroSidebar");

        const fondo =
            document.getElementById(
                "meseroSidebarFondo"
            );

        if (sidebar) {
            sidebar.classList.remove("abierto");
        }

        if (fondo) {
            fondo.classList.remove("visible");
        }

        document.body.classList.remove(
            "sidebar-mesero-abierto"
        );
    }

    document.addEventListener(
        "keydown",
        function (evento) {
            if (evento.key === "Escape") {
                cerrarSidebarMesero();
            }
        }
    );

    window.addEventListener(
        "resize",
        function () {
            if (window.innerWidth > 900) {
                cerrarSidebarMesero();
            }
        }
    );
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/mesero/pedido-agregar-form.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo + ' - El Rinconcito Ayacuchano'}">
        Agregar productos
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap"
          rel="stylesheet">

    <link th:href="@{/css/mesero-mesas.css}"
          rel="stylesheet">

    <link th:href="@{/css/mesero-pedidos.css}"
          rel="stylesheet">
</head>

<body>

<div class="mesero-layout">

    <aside th:replace="~{fragments/mesero-sidebar
            :: sidebar('pedidos')}">
    </aside>

    <div class="mesero-pagina">

        <main class="mesero-contenido">

            <header class="pedido-encabezado">

                <div>
                    <p class="pedido-etiqueta">
                        PEDIDO EN ATENCIÓN
                    </p>

                    <h1>Agregar productos</h1>

                    <p>
                        Selecciona los productos adicionales
                        solicitados por el cliente.
                    </p>
                </div>

                <div class="pedido-usuario">

                    <i class="bi bi-person-circle"></i>

                    <span sec:authentication="name">
                        mesero
                    </span>

                </div>

            </header>

            <div th:if="${error}"
                 class="alert alert-danger"
                 th:text="${error}">
            </div>

            <div th:if="${pedido == null}"
                 class="alert alert-danger">

                No se encontró el pedido que deseas modificar.
            </div>

            <form th:if="${pedido != null}"
                  th:action="@{/mesero/pedidos/{idPedido}/agregar(
                        idPedido=${pedido.idPedido}
                  )}"
                  th:object="${pedidoForm}"
                  method="post"
                  class="pedido-formulario"
                  id="agregarProductosForm">

                <input type="hidden"
                       th:name="${_csrf.parameterName}"
                       th:value="${_csrf.token}">

                <input type="hidden"
                       th:field="*{idMesa}">

                <section class="pedido-seccion">

                    <div class="pedido-seccion-encabezado">

                        <div class="pedido-seccion-icono">
                            <i class="bi bi-receipt"></i>
                        </div>

                        <div>
                            <h2>Pedido actual</h2>

                            <p>
                                Información de la mesa y del pedido
                                que será actualizado.
                            </p>
                        </div>

                    </div>

                    <div class="row g-3">

                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Código del pedido
                            </label>

                            <div class="form-control bg-light"
                                 th:text="${pedido.codigoPedido}">
                                PED-2026-000001
                            </div>

                        </div>

                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Piso
                            </label>

                            <div class="form-control bg-light"
                                 th:text="${pedido.mesa != null
                                    and pedido.mesa.piso != null
                                    ? pedido.mesa.piso.nombre
                                    : 'Sin piso'}">
                                Piso 1
                            </div>

                        </div>

                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Mesa
                            </label>

                            <div class="form-control bg-light"
                                 th:text="${pedido.mesa != null
                                    ? 'Mesa ' + pedido.mesa.numero
                                    : 'Sin mesa'}">
                                Mesa 1
                            </div>

                        </div>

                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Total actual
                            </label>

                            <div class="form-control bg-light fw-bold"
                                 th:text="${'S/ ' + pedido.total}">
                                S/ 0
                            </div>

                        </div>

                    </div>

                </section>

                <section class="pedido-seccion">

                    <div class="pedido-seccion-encabezado productos-encabezado">

                        <div class="d-flex align-items-start gap-3">

                            <div class="pedido-seccion-icono">
                                <i class="bi bi-journal-plus"></i>
                            </div>

                            <div>
                                <h2>Productos adicionales</h2>

                                <p>
                                    Indica solamente las nuevas cantidades
                                    que deseas agregar al pedido.
                                </p>
                            </div>

                        </div>

                        <div class="producto-buscador">

                            <i class="bi bi-search"></i>

                            <input type="search"
                                   id="buscarProducto"
                                   placeholder="Buscar producto"
                                   autocomplete="off">

                        </div>

                    </div>

                    <div th:if="${productos == null
                            or #lists.isEmpty(productos)}"
                         class="pedido-vacio">

                        <i class="bi bi-basket"></i>

                        <strong>
                            No hay productos disponibles
                        </strong>

                        <span>
                            Actualmente no existen productos que
                            puedan agregarse al pedido.
                        </span>

                    </div>

                    <div th:if="${productos != null
                            and !#lists.isEmpty(productos)}"
                         class="productos-grid"
                         id="productosGrid">

                        <div th:each="producto, estado : ${productos}"
                             class="producto-contenedor">

                            <article th:if="${producto != null}"
                                     class="producto-pedido"
                                     th:attr="
                                        data-nombre=${#strings.toLowerCase(
                                            producto.nombre != null
                                            ? producto.nombre
                                            : ''
                                        )},
                                        data-precio=${producto.precio != null
                                            ? producto.precio
                                            : 0}
                                     ">

                                <input type="hidden"
                                       th:field="*{items[__${estado.index}__].idProducto}">

                                <div class="producto-imagen">

                                    <img th:if="${producto.imagen != null
                                            and !#strings.isEmpty(producto.imagen)}"
                                         th:src="${producto.imagen}"
                                         th:alt="${producto.nombre != null
                                            ? producto.nombre
                                            : 'Producto'}"
                                         onerror="this.style.display='none';
                                         this.nextElementSibling.style.display='flex';">

                                    <div class="producto-sin-imagen"
                                         th:style="${producto.imagen != null
                                            and !#strings.isEmpty(producto.imagen)}
                                            ? 'display:none;'
                                            : 'display:flex;'">

                                        <i class="bi bi-image"></i>
                                    </div>

                                </div>

                                <div class="producto-informacion">

                                    <div class="producto-cabecera">

                                        <div>

                                            <span class="producto-categoria"
                                                  th:text="${producto.categoria != null
                                                    and producto.categoria.nombre != null
                                                    ? producto.categoria.nombre
                                                    : 'Sin categoría'}">
                                                Categoría
                                            </span>

                                            <h3 th:text="${producto.nombre != null
                                                    ? producto.nombre
                                                    : 'Producto sin nombre'}">
                                                Producto
                                            </h3>

                                        </div>

                                        <strong class="producto-precio"
                                                th:text="${'S/ '
                                                    + (producto.precio != null
                                                    ? producto.precio
                                                    : 0)}">
                                            S/ 0
                                        </strong>

                                    </div>

                                    <p th:if="${producto.descripcion != null
                                            and !#strings.isEmpty(producto.descripcion)}"
                                       class="producto-descripcion"
                                       th:text="${producto.descripcion}">
                                        Descripción
                                    </p>

                                    <div class="producto-controles">

                                        <div class="cantidad-control">

                                            <button type="button"
                                                    class="cantidad-boton"
                                                    onclick="cambiarCantidad(this, -1)"
                                                    aria-label="Disminuir cantidad">

                                                <i class="bi bi-dash-lg"></i>
                                            </button>

                                            <input type="number"
                                                   th:field="*{items[__${estado.index}__].cantidad}"
                                                   class="cantidad-input"
                                                   min="0"
                                                   max="30"
                                                   step="1"
                                                   oninput="actualizarAdicion()"
                                                   onchange="normalizarCantidad(this)">

                                            <button type="button"
                                                    class="cantidad-boton"
                                                    onclick="cambiarCantidad(this, 1)"
                                                    aria-label="Aumentar cantidad">

                                                <i class="bi bi-plus-lg"></i>
                                            </button>

                                        </div>

                                        <button type="button"
                                                class="btn-observacion"
                                                th:attr="data-bs-target=${'#observacionProducto'
                                                    + estado.index}"
                                                data-bs-toggle="collapse">

                                            <i class="bi bi-chat-left-text"></i>
                                            Indicaciones
                                        </button>

                                    </div>

                                    <div class="collapse producto-observacion"
                                         th:id="${'observacionProducto'
                                            + estado.index}">

                                        <label th:for="${'campoObservacion'
                                                + estado.index}">
                                            Indicaciones del producto
                                        </label>

                                        <input type="text"
                                               th:id="${'campoObservacion'
                                                    + estado.index}"
                                               th:field="*{items[__${estado.index}__].observaciones}"
                                               maxlength="200"
                                               placeholder="Ej.: sin cebolla, poco picante">

                                    </div>

                                </div>

                            </article>

                        </div>

                    </div>

                    <div id="sinResultados"
                         class="pedido-vacio d-none">

                        <i class="bi bi-search"></i>

                        <strong>
                            No se encontraron productos
                        </strong>

                        <span>
                            Intenta escribir otro nombre.
                        </span>

                    </div>

                </section>

                <section class="pedido-seccion">

                    <div class="pedido-seccion-encabezado">

                        <div class="pedido-seccion-icono">
                            <i class="bi bi-card-text"></i>
                        </div>

                        <div>
                            <h2>Nueva observación general</h2>

                            <p>
                                Esta observación se agregará a las
                                indicaciones generales existentes.
                            </p>
                        </div>

                    </div>

                    <label for="observaciones"
                           class="form-label">
                        Observación adicional
                    </label>

                    <textarea id="observaciones"
                              th:field="*{observaciones}"
                              class="form-control"
                              rows="3"
                              maxlength="300"
                              placeholder="Ej.: servir estos productos después de las entradas"></textarea>

                    <div class="form-text">
                        Este campo es opcional.
                    </div>

                </section>

                <section class="pedido-resumen">

                    <div class="pedido-resumen-informacion">

                        <span>Nuevas unidades</span>

                        <strong id="cantidadProductos">
                            0
                        </strong>

                    </div>

                    <div class="pedido-resumen-total">

                        <span>Monto adicional</span>

                        <strong id="totalPedido">
                            S/ 0
                        </strong>

                    </div>

                    <div class="pedido-acciones">

                        <a th:href="@{/mesero/pedidos}"
                           class="btn-cancelar-pedido">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn-guardar-pedido"
                                id="btnAgregarProductos">

                            <i class="bi bi-plus-circle"></i>
                            Agregar al pedido
                        </button>

                    </div>

                </section>

            </form>

        </main>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<script>
    document.addEventListener(
        "DOMContentLoaded",
        function () {
            const buscador =
                document.getElementById(
                    "buscarProducto"
                );

            if (buscador) {
                buscador.addEventListener(
                    "input",
                    filtrarProductos
                );
            }

            document.querySelectorAll(
                ".cantidad-input"
            ).forEach(function (campo) {
                normalizarCantidad(campo);
            });

            actualizarAdicion();
        }
    );

    function cambiarCantidad(
        boton,
        cambio
    ) {
        const control =
            boton.closest(
                ".cantidad-control"
            );

        const campo =
            control.querySelector(
                ".cantidad-input"
            );

        let cantidad =
            parseInt(campo.value, 10);

        if (Number.isNaN(cantidad)) {
            cantidad = 0;
        }

        cantidad += cambio;

        if (cantidad < 0) {
            cantidad = 0;
        }

        if (cantidad > 30) {
            cantidad = 30;
        }

        campo.value = cantidad;

        campo.dispatchEvent(
            new Event(
                "input",
                {
                    bubbles: true
                }
            )
        );
    }

    function normalizarCantidad(campo) {
        let cantidad =
            parseInt(campo.value, 10);

        if (
            Number.isNaN(cantidad)
            || cantidad < 0
        ) {
            cantidad = 0;
        }

        if (cantidad > 30) {
            cantidad = 30;
        }

        campo.value = cantidad;

        actualizarAdicion();
    }

    function actualizarAdicion() {
        const productos =
            document.querySelectorAll(
                ".producto-pedido"
            );

        let cantidadTotal = 0;
        let montoTotal = 0;

        productos.forEach(function (producto) {
            const campo =
                producto.querySelector(
                    ".cantidad-input"
                );

            let cantidad =
                parseInt(
                    campo.value,
                    10
                );

            if (
                Number.isNaN(cantidad)
                || cantidad < 0
            ) {
                cantidad = 0;
            }

            const precio =
                parseInt(
                    producto.dataset.precio || "0",
                    10
                );

            cantidadTotal += cantidad;
            montoTotal += cantidad * precio;

            producto.classList.toggle(
                "producto-seleccionado",
                cantidad > 0
            );
        });

        const cantidadProductos =
            document.getElementById(
                "cantidadProductos"
            );

        const totalPedido =
            document.getElementById(
                "totalPedido"
            );

        if (cantidadProductos) {
            cantidadProductos.textContent =
                cantidadTotal;
        }

        if (totalPedido) {
            totalPedido.textContent =
                "S/ " + montoTotal;
        }
    }

    function filtrarProductos() {
        const texto =
            document.getElementById(
                "buscarProducto"
            ).value.trim().toLowerCase();

        const productos =
            document.querySelectorAll(
                ".producto-pedido"
            );

        let visibles = 0;

        productos.forEach(function (producto) {
            const nombre =
                producto.dataset.nombre || "";

            const coincide =
                nombre.includes(texto);

            const contenedor =
                producto.closest(
                    ".producto-contenedor"
                );

            contenedor.classList.toggle(
                "d-none",
                !coincide
            );

            if (coincide) {
                visibles++;
            }
        });

        const sinResultados =
            document.getElementById(
                "sinResultados"
            );

        if (sinResultados) {
            sinResultados.classList.toggle(
                "d-none",
                visibles !== 0
            );
        }
    }

    document.getElementById(
        "agregarProductosForm"
    )?.addEventListener(
        "submit",
        function (event) {
            const cantidades =
                document.querySelectorAll(
                    ".cantidad-input"
                );

            const tieneProductos =
                Array.from(cantidades)
                    .some(function (campo) {
                        return parseInt(
                            campo.value,
                            10
                        ) > 0;
                    });

            if (!tieneProductos) {
                event.preventDefault();

                alert(
                    "Debes seleccionar al menos un producto."
                );

                return;
            }

            const boton =
                document.getElementById(
                    "btnAgregarProductos"
                );

            boton.disabled = true;

            boton.innerHTML =
                '<span class="spinner-border '
                + 'spinner-border-sm me-2"></span>'
                + 'Agregando...';
        }
    );
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/mesero/pedido-form.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo
            + ' - El Rinconcito Ayacuchano'}">
        Nuevo pedido presencial
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap"
          rel="stylesheet">

    <link th:href="@{/css/mesero-mesas.css}"
          rel="stylesheet">

    <link th:href="@{/css/mesero-pedidos.css}"
          rel="stylesheet">
</head>

<body>

