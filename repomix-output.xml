        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.experiencia-tarjeta:hover {
    border-color: rgba(198, 154, 53, 0.68);
    box-shadow: 0 9px 21px rgba(46, 33, 28, 0.08);
    transform: translateY(-3px);
}

.experiencia-icono {
    width: 40px;
    height: 40px;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    border-radius: 50%;
    background-color: rgba(198, 154, 53, 0.13);
    color: var(--oliva);
    font-size: 1rem;
}

.experiencia-contenido {
    min-width: 0;
}

.experiencia-contenido h3 {
    margin: 0;
    color: var(--cafe);
    font-family: "Playfair Display", serif;
    font-size: 0.9rem;
    font-weight: 700;
}

.experiencia-contenido p {
    min-height: 38px;
    margin: 0.3rem 0 0.48rem;
    color: var(--texto-suave);
    font-size: 0.61rem;
    line-height: 1.42;
}

.experiencia-contenido a {
    padding-bottom: 0.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    border-bottom: 1px solid var(--dorado);
    color: var(--oliva-oscuro);
    font-size: 0.59rem;
    font-weight: 800;
    text-decoration: none;
}

.experiencia-contenido a i {
    transition: transform 0.2s ease;
}

.experiencia-contenido a:hover {
    color: var(--vino);
}

.experiencia-contenido a:hover i {
    transform: translateX(3px);
}

/* Carrito */

.carrito-flotante {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 1080;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--crema);
    border-radius: 50%;
    background-color: var(--vino);
    color: var(--blanco);
    box-shadow: 0 7px 19px rgba(46, 33, 28, 0.28);
    text-decoration: none;
    transition:
        transform 0.2s ease,
        background-color 0.2s ease;
}

.carrito-flotante i {
    font-size: 1.13rem;
    line-height: 1;
}

.carrito-flotante:hover {
    background-color: var(--vino-claro);
    color: var(--blanco);
    transform: translateY(-3px);
}

.carrito-contador {
    position: absolute;
    top: -5px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--crema);
    border-radius: 20px;
    background-color: var(--dorado);
    color: var(--cafe);
    font-size: 0.52rem;
    font-weight: 800;
}

/* Responsive */

@media (max-width: 1199.98px) {
    .inicio-hero {
        min-height: 430px;
    }

    .hero-informacion h1 {
        font-size: clamp(2rem, 4vw, 2.85rem);
    }

    .hero-carrusel-contenedor,
    #carruselPlatos {
        height: 320px;
        min-height: 320px;
