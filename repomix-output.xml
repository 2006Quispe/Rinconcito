}

@media (max-width: 767.98px) {
    .hero-contenedor {
        padding-top: 1.8rem;
    }

    .hero-informacion h1 {
        font-size: clamp(1.75rem, 8vw, 2.35rem);
    }

    .hero-descripcion {
        font-size: 0.72rem;
    }

    .hero-beneficios {
        display: none;
    }

    .hero-carrusel-contenedor,
    #carruselPlatos {
        height: 280px;
        min-height: 280px;
    }

    .plato-flotante {
        width: min(82%, 350px);
        max-height: 205px;
    }

    .plato-destello {
        width: 220px;
        height: 220px;
    }

    .plato-sombra {
        right: 25%;
        bottom: 55px;
        left: 25%;
    }

    .experiencia-inicio {
        padding: 2rem 0 2.4rem;
    }

    .experiencia-tarjeta {
        min-height: 115px;
    }

    .experiencia-contenido p {
        min-height: auto;
    }
}

@media (max-width: 575.98px) {
    .marca-publica {
        align-items: flex-start;
    }

    .marca-nombre {
        max-width: 215px;
        font-size: 0.84rem;
    }

    .marca-publica small {
        margin-top: 0.23rem;
        font-size: 0.39rem;
    }

    .hero-etiqueta {
        font-size: 0.48rem;
        line-height: 1.5;
    }

    .hero-informacion h1 {
        font-size: clamp(1.65rem, 9vw, 2.1rem);
    }

    .hero-acciones {
        align-items: stretch;
        flex-direction: column;
    }

    .btn-hero-principal,
    .btn-hero-secundario {
        width: 100%;
        min-height: 37px;
    }

    .btn-hero-secundario {
        justify-content: center;
        border: 1px solid rgba(233, 216, 192, 0.38);
        border-radius: 7px;
    }

    .hero-carrusel-contenedor,
    #carruselPlatos {
        height: 245px;
        min-height: 245px;
    }

    .plato-flotante {
        width: 80%;
        max-height: 175px;
    }

    .plato-destello {
        width: 185px;
        height: 185px;
    }

    .plato-destello::before {
        inset: 25px;
    }

    .plato-destello::after {
        inset: 52px;
    }

    .plato-sombra {
        right: 28%;
        bottom: 48px;
        left: 28%;
        height: 18px;
    }

    .plato-etiqueta {
        bottom: 19px;
        min-width: 145px;
        padding: 0.34rem 0.58rem;
    }

    #carruselPlatos .carousel-control-prev,
    #carruselPlatos .carousel-control-next {
        width: 34px;
    }

    .control-carrusel {
        width: 28px;
        height: 28px;
    }

    .reservas-disponibles {
        bottom: -2rem;
        min-width: min(245px, calc(100% - 1rem));
    }

    .experiencia-inicio {
        padding-top: 3.2rem;
    }

    .experiencia-tarjeta {
        padding: 0.85rem;
    }

    .experiencia-icono {
        width: 36px;
        height: 36px;
        font-size: 0.9rem;
    }

    .carrito-flotante {
        right: 14px;
        bottom: 14px;
        width: 45px;
        height: 45px;
    }

    .carrito-flotante i {
        font-size: 1.05rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    .plato-flotante,
    .plato-sombra {
        animation: none;
    }

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}
