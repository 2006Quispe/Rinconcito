<file path="src/main/resources/static/css/admin-pisos-mesas.css">
/* Variables */

:root {
    --pm-rojo: #8c2f1b;
    --pm-rojo-oscuro: #692114;
    --pm-dorado: #d4a017;
    --pm-dorado-suave: #f5e6c8;
    --pm-verde: #2f7d4a;
    --pm-verde-suave: #eaf6ee;
    --pm-naranja: #c66a18;
    --pm-naranja-suave: #fff2e4;
    --pm-azul: #2d6f9f;
    --pm-azul-suave: #eaf3fa;
    --pm-gris: #687078;
    --pm-gris-suave: #f3f4f5;
    --pm-texto: #332923;
    --pm-texto-suave: #716a65;
    --pm-borde: #e6dfda;
    --pm-fondo: #f8f6f3;
    --pm-blanco: #ffffff;
    --pm-sombra: 0 8px 24px rgba(59, 42, 34, 0.08);
}

/* Contenido */

.pisos-mesas-contenido {
    min-width: 0;
    padding: 28px;
    background-color: var(--pm-fondo);
}

.pisos-mesas-encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
}

.pisos-mesas-etiqueta {
    margin: 0 0 5px;
    color: var(--pm-rojo);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

.pisos-mesas-encabezado h1 {
    margin: 0;
    color: var(--pm-texto);
    font-size: 26px;
    font-weight: 800;
}

.pisos-mesas-encabezado > div > p:last-child {
    max-width: 650px;
    margin: 7px 0 0;
    color: var(--pm-texto-suave);
    font-size: 13px;
    line-height: 1.6;
}

.encabezado-acciones {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 10px;
}

.btn-principal,
.btn-secundario {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 9px 16px;
    border: 1px solid transparent;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: 0.2s ease;
}

.btn-principal {
    background-color: var(--pm-rojo);
    color: var(--pm-blanco);
}

.btn-principal:hover {
    background-color: var(--pm-rojo-oscuro);
    color: var(--pm-blanco);
    transform: translateY(-1px);
}

.btn-secundario {
    border-color: var(--pm-borde);
    background-color: var(--pm-blanco);
    color: var(--pm-texto);
}

.btn-secundario:hover {
    border-color: var(--pm-rojo);
    color: var(--pm-rojo);
}

.btn-principal i,
.btn-secundario i {
    margin-right: 7px;
}

/* Alertas */

.pisos-mesas-contenido .alert {
    margin-bottom: 20px;
    border: 0;
    border-radius: 10px;
    font-size: 13px;
    box-shadow: 0 4px 14px rgba(59, 42, 34, 0.05);
}

/* Secciones */

.pisos-seccion,
.mesas-seccion {
    margin-bottom: 24px;
    padding: 22px;
    border: 1px solid var(--pm-borde);
    border-radius: 14px;
    background-color: var(--pm-blanco);
    box-shadow: var(--pm-sombra);
}

.seccion-titulo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
}

.seccion-titulo h2 {
    margin: 0;
    color: var(--pm-texto);
    font-size: 18px;
    font-weight: 800;
}

.seccion-titulo p {
    margin: 5px 0 0;
    color: var(--pm-texto-suave);
    font-size: 12px;
}

.enlace-ver-todos {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 8px 12px;
    border: 1px solid var(--pm-borde);
    border-radius: 8px;
    color: var(--pm-texto-suave);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
}

.enlace-ver-todos i {
    margin-right: 6px;
}

.enlace-ver-todos:hover,
.enlace-ver-todos.enlace-activo {
    border-color: var(--pm-rojo);
    background-color: #fff7f4;
    color: var(--pm-rojo);
}

.filtro-indicador {
    display: inline-flex;
    margin-left: 7px;
    padding: 4px 8px;
    border-radius: 20px;
    background-color: var(--pm-dorado-suave);
    color: #72540a;
    font-size: 10px;
    font-weight: 800;
    vertical-align: middle;
}

/* Pisos */

.pisos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
}

.piso-tarjeta {
    min-width: 0;
    padding: 17px;
    border: 1px solid var(--pm-borde);
    border-radius: 12px;
    background-color: var(--pm-blanco);
    transition: 0.2s ease;
}

.piso-tarjeta:hover {
    border-color: #d2bbb2;
    box-shadow: 0 8px 20px rgba(59, 42, 34, 0.08);
    transform: translateY(-2px);
}

.piso-tarjeta.piso-tarjeta-activa {
    border-color: var(--pm-rojo);
    background-color: #fffaf8;
    box-shadow: 0 0 0 2px rgba(140, 47, 27, 0.08);
}

.piso-tarjeta-superior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 13px;
}

.piso-icono {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 10px;
    background-color: var(--pm-dorado-suave);
    color: var(--pm-rojo);
    font-size: 17px;
}

.estado-piso {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 800;
}

.estado-piso.estado-activo {
    background-color: var(--pm-verde-suave);
    color: var(--pm-verde);
}

.estado-piso.estado-inactivo {
    background-color: var(--pm-gris-suave);
    color: var(--pm-gris);
}

.piso-informacion h3 {
    overflow: hidden;
    margin: 0 0 5px;
    color: var(--pm-texto);
    font-size: 16px;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.piso-informacion p {
    display: -webkit-box;
    min-height: 38px;
    overflow: hidden;
    margin: 0;
    color: var(--pm-texto-suave);
    font-size: 12px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.piso-estadisticas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 15px 0;
    padding: 12px 0;
    border-top: 1px solid var(--pm-borde);
    border-bottom: 1px solid var(--pm-borde);
}

.piso-estadisticas > div {
    min-width: 0;
    padding: 0 5px;
    text-align: center;
}

.piso-estadisticas > div + div {
    border-left: 1px solid var(--pm-borde);
}

.piso-estadisticas strong {
    display: block;
    color: var(--pm-texto);
    font-size: 15px;
    font-weight: 800;
}

.piso-estadisticas span {
    display: block;
    overflow: hidden;
    margin-top: 3px;
    color: var(--pm-texto-suave);
    font-size: 8px;
    text-overflow: ellipsis;
}

.texto-disponible {
    color: var(--pm-verde) !important;
}

.texto-ocupada {
    color: var(--pm-naranja) !important;
}

.texto-reservada {
    color: var(--pm-azul) !important;
}

.piso-acciones {
    display: flex;
    align-items: center;
    gap: 7px;
}

.piso-acciones form {
    margin: 0;
}

.btn-ver-mesas {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-height: 35px;
    padding: 7px 10px;
    border-radius: 8px;
    background-color: var(--pm-rojo);
    color: var(--pm-blanco);
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
}

.btn-ver-mesas i {
    margin-right: 6px;
}

.btn-ver-mesas:hover {
    background-color: var(--pm-rojo-oscuro);
    color: var(--pm-blanco);
}

.btn-icono {
    display: inline-grid;
    width: 35px;
    height: 35px;
    padding: 0;
    place-items: center;
    border: 1px solid var(--pm-borde);
    border-radius: 8px;
    background-color: var(--pm-blanco);
    color: var(--pm-texto-suave);
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
}

.btn-icono:hover {
    border-color: var(--pm-rojo);
    color: var(--pm-rojo);
}

.btn-icono.btn-desactivar:hover {
    border-color: #bb401f;
    background-color: #fff1ec;
    color: #a33217;
}

.btn-icono.btn-activar:hover {
    border-color: var(--pm-verde);
    background-color: var(--pm-verde-suave);
    color: var(--pm-verde);
}

/* Tabla de mesas */

.tabla-contenedor {
    overflow: hidden;
    border: 1px solid var(--pm-borde);
    border-radius: 11px;
}

.tabla-mesas {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
}

.tabla-mesas thead {
    background-color: #f7f1e8;
}

.tabla-mesas th {
    padding: 12px 15px;
    border-bottom: 1px solid var(--pm-borde);
    color: #574b44;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.4px;
    text-align: left;
    text-transform: uppercase;
}

.tabla-mesas td {
    padding: 13px 15px;
    border-bottom: 1px solid #eee9e5;
    color: var(--pm-texto);
    font-size: 12px;
    vertical-align: middle;
}

.tabla-mesas tbody tr:last-child td {
    border-bottom: 0;
}

.tabla-mesas tbody tr:hover {
    background-color: #fffdfa;
}

.columna-acciones {
    width: 225px;
    text-align: right !important;
}

.mesa-identidad {
    display: flex;
    align-items: center;
    gap: 10px;
}

.mesa-numero-icono {
    display: grid;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 9px;
    background-color: var(--pm-dorado-suave);
    color: var(--pm-rojo);
    font-size: 15px;
}

.mesa-identidad strong {
    display: block;
    color: var(--pm-texto);
    font-size: 12px;
}

.mesa-identidad span {
    display: block;
    margin-top: 2px;
    color: var(--pm-texto-suave);
    font-size: 10px;
}

.mesa-piso,
.mesa-capacidad {
    display: inline-flex;
    align-items: center;
    color: var(--pm-texto-suave);
}

.mesa-piso i,
.mesa-capacidad i {
    margin-right: 7px;
    color: var(--pm-rojo);
}

.estado-mesa {
    display: inline-flex;
    align-items: center;
    padding: 6px 9px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 800;
}

.estado-mesa i {
    margin-right: 6px;
    font-size: 6px;
}

.estado-disponible {
    background-color: var(--pm-verde-suave);
    color: var(--pm-verde);
}

.estado-ocupada {
    background-color: var(--pm-naranja-suave);
    color: var(--pm-naranja);
}

.estado-reservada {
    background-color: var(--pm-azul-suave);
    color: var(--pm-azul);
}

.estado-inactiva {
    background-color: var(--pm-gris-suave);
    color: var(--pm-gris);
}

.mesa-acciones {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
}

.mesa-acciones form {
    margin: 0;
}

.btn-tabla {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    justify-content: center;
    padding: 6px 10px;
    border: 1px solid var(--pm-borde);
    border-radius: 7px;
    background-color: var(--pm-blanco);
    color: var(--pm-texto-suave);
    font-size: 10px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
}

.btn-tabla i {
    margin-right: 5px;
}

.btn-tabla.btn-editar:hover {
    border-color: var(--pm-azul);
    background-color: var(--pm-azul-suave);
    color: var(--pm-azul);
}

.btn-tabla.btn-inactivar:hover {
    border-color: var(--pm-rojo);
    background-color: #fff1ec;
    color: var(--pm-rojo);
}

.btn-tabla.btn-habilitar:hover {
    border-color: var(--pm-verde);
    background-color: var(--pm-verde-suave);
    color: var(--pm-verde);
}

.mesa-control-mozo {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: var(--pm-texto-suave);
    font-size: 10px;
    font-weight: 700;
}

.mesa-control-mozo i {
    margin-right: 6px;
    color: var(--pm-rojo);
}

/* Estado vacío */

.estado-vacio {
    padding: 38px 20px;
    border: 1px dashed #d9cec7;
    border-radius: 12px;
    background-color: #fdfbf9;
    text-align: center;
}

.estado-vacio-icono {
    display: grid;
    width: 48px;
    height: 48px;
    margin: 0 auto 12px;
    place-items: center;
    border-radius: 50%;
    background-color: var(--pm-dorado-suave);
    color: var(--pm-rojo);
    font-size: 20px;
}

.estado-vacio h3 {
    margin: 0 0 6px;
    color: var(--pm-texto);
    font-size: 16px;
    font-weight: 800;
}

.estado-vacio p {
    margin: 0 0 16px;
    color: var(--pm-texto-suave);
    font-size: 12px;
}

.estado-vacio-mesas {
    padding-top: 32px;
    padding-bottom: 32px;
}

.btn-nueva-mesa {
    min-height: 36px;
    padding: 7px 13px;
    font-size: 11px;
}

/* Formularios */

.piso-mesa-form-contenido {
    padding: 28px;
    background-color: var(--pm-fondo);
}

.formulario-encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
}

.formulario-encabezado h1 {
    margin: 0;
    color: var(--pm-texto);
    font-size: 25px;
    font-weight: 800;
}

.formulario-encabezado p {
    margin: 6px 0 0;
    color: var(--pm-texto-suave);
    font-size: 13px;
}

.formulario-panel {
    max-width: 820px;
    padding: 24px;
    border: 1px solid var(--pm-borde);
    border-radius: 14px;
    background-color: var(--pm-blanco);
    box-shadow: var(--pm-sombra);
}

.formulario-seccion-titulo {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--pm-borde);
}

.formulario-seccion-icono {
    display: grid;
    width: 39px;
    height: 39px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 10px;
    background-color: var(--pm-dorado-suave);
    color: var(--pm-rojo);
    font-size: 17px;
}

.formulario-seccion-titulo h2 {
    margin: 0;
    color: var(--pm-texto);
    font-size: 17px;
    font-weight: 800;
}

.formulario-seccion-titulo p {
    margin: 3px 0 0;
    color: var(--pm-texto-suave);
    font-size: 11px;
}

.formulario-panel .form-label {
    margin-bottom: 6px;
    color: var(--pm-texto);
    font-size: 11px;
    font-weight: 800;
}

.formulario-panel .form-label span {
    color: var(--pm-rojo);
}

.formulario-panel .form-control,
.formulario-panel .form-select {
    min-height: 42px;
    border-color: var(--pm-borde);
    border-radius: 8px;
    color: var(--pm-texto);
    font-size: 12px;
    box-shadow: none;
}

.formulario-panel textarea.form-control {
    min-height: 105px;
    resize: vertical;
}

.formulario-panel .form-control:focus,
.formulario-panel .form-select:focus {
    border-color: var(--pm-rojo);
    box-shadow: 0 0 0 3px rgba(140, 47, 27, 0.1);
}

.formulario-panel .form-text {
    color: var(--pm-texto-suave);
    font-size: 10px;
}

.formulario-acciones {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--pm-borde);
}

.btn-cancelar {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 9px 17px;
    border: 1px solid var(--pm-borde);
    border-radius: 8px;
    background-color: var(--pm-blanco);
    color: var(--pm-texto-suave);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
}

.btn-cancelar:hover {
    border-color: var(--pm-texto-suave);
    color: var(--pm-texto);
}

.btn-guardar {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 9px 18px;
    border: 0;
    border-radius: 8px;
    background-color: var(--pm-rojo);
    color: var(--pm-blanco);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
}

.btn-guardar i {
    margin-right: 7px;
}

.btn-guardar:hover {
    background-color: var(--pm-rojo-oscuro);
}

/* Adaptación */

@media (max-width: 1200px) {
    .pisos-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 850px) {
    .pisos-mesas-contenido,
    .piso-mesa-form-contenido {
        padding: 20px;
    }

    .pisos-mesas-encabezado,
    .formulario-encabezado {
        flex-direction: column;
    }

    .encabezado-acciones {
        width: 100%;
    }

    .encabezado-acciones .btn-principal,
    .encabezado-acciones .btn-secundario {
        flex: 1;
    }

    .pisos-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .pisos-mesas-contenido,
    .piso-mesa-form-contenido {
        padding: 15px;
    }

    .pisos-mesas-encabezado h1,
    .formulario-encabezado h1 {
        font-size: 22px;
    }

    .pisos-seccion,
    .mesas-seccion,
    .formulario-panel {
        padding: 16px;
        border-radius: 11px;
    }

    .seccion-titulo {
        align-items: flex-start;
        flex-direction: column;
    }

    .enlace-ver-todos,
    .btn-nueva-mesa {
        width: 100%;
    }

    .encabezado-acciones {
        align-items: stretch;
        flex-direction: column;
    }

    .piso-estadisticas {
        grid-template-columns: repeat(2, 1fr);
        row-gap: 12px;
    }

    .piso-estadisticas > div:nth-child(3) {
        border-left: 0;
    }

    .piso-estadisticas > div:nth-child(3),
    .piso-estadisticas > div:nth-child(4) {
        padding-top: 10px;
        border-top: 1px solid var(--pm-borde);
    }

    .formulario-acciones {
        align-items: stretch;
        flex-direction: column-reverse;
    }

    .btn-cancelar,
    .btn-guardar {
        width: 100%;
    }
}
