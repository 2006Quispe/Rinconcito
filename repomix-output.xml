    overflow: hidden;
    color: inherit;
    font-size: 0.62rem;
    opacity: 0.72;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mesero-sidebar-inferior {
    padding: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
}

.mesero-sidebar-usuario {
    padding: 0.35rem 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
}

.mesero-sidebar-avatar {
    width: 36px;
    height: 36px;
    display: grid;
    flex: 0 0 36px;
    place-items: center;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.16);
    color: var(--mesero-blanco);
}

.mesero-sidebar-usuario-datos {
    min-width: 0;
}

.mesero-sidebar-usuario-datos strong {
    display: block;
    overflow: hidden;
    color: var(--mesero-blanco);
    font-size: 0.69rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mesero-sidebar-usuario-datos small {
    display: block;
    margin-top: 0.1rem;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
}

.mesero-sidebar-logout {
    margin-top: 0.55rem;
}

.mesero-sidebar-salir {
    width: 100%;
    min-height: 37px;
    padding: 0.5rem 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 9px;
