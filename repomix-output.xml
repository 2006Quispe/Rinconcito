<file path="src/main/resources/templates/paginas/admin/eventos/formulario.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}">
        Evento
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700&amp;display=swap"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar :: sidebar('eventos')}">
    </aside>

    <main class="admin-contenido">

        <header class="admin-encabezado">

            <div>
                <span class="admin-etiqueta">
                    EVENTOS
                </span>

                <h1 th:text="${titulo}">
                    Nuevo evento
                </h1>

                <p>
                    Completa la programación y el precio
                    de entrada del evento.
                </p>
            </div>

            <a th:href="@{/admin/eventos}"
               class="admin-boton-secundario">

                <i class="bi bi-arrow-left"></i>
                Volver

            </a>

        </header>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <form th:action="@{/admin/eventos/guardar}"
              th:object="${evento}"
              method="post"
              class="admin-formulario">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

            <input type="hidden"
                   th:field="*{idEvento}">

            <div class="admin-formulario-cabecera">

                <div class="admin-tarjeta-icono morado">
                    <i class="bi bi-music-note-beamed"></i>
                </div>

                <div>
                    <h2>Información del evento</h2>
                    <p>
                        Los datos se mostrarán en la página pública.
                    </p>
                </div>

            </div>

            <div class="row g-4">

                <div class="col-12">

                    <label class="form-label">
                        Título del evento
                    </label>

                    <input type="text"
                           th:field="*{titulo}"
                           class="form-control"
                           maxlength="100"
                           required
                           placeholder="Ejemplo: Noche de música ayacuchana">

                </div>

                <div class="col-12">

                    <label class="form-label">
                        Descripción
                    </label>

                    <textarea th:field="*{descripcion}"
                              class="form-control"
                              maxlength="500"
                              rows="4"
                              placeholder="Describe la presentación y los artistas invitados"></textarea>

                </div>

                <div class="col-md-4">

                    <label class="form-label">
                        Fecha
                    </label>

                    <input type="date"
                           th:field="*{fecha}"
                           class="form-control"
                           required>

                </div>

                <div class="col-md-4">

                    <label class="form-label">
                        Hora de inicio
                    </label>

                    <input type="time"
                           th:field="*{horaInicio}"
                           class="form-control"
                           required>

                </div>

                <div class="col-md-4">

                    <label class="form-label">
                        Hora de finalización
                    </label>

                    <input type="time"
                           th:field="*{horaFin}"
                           class="form-control">

                </div>

                <div class="col-12">

                    <label class="form-label">
                        Ruta o enlace de la imagen
                    </label>

                    <input type="text"
                           th:field="*{imagen}"
                           class="form-control"
                           maxlength="255"
                           placeholder="/img/eventos/evento.jpg">

                    <div class="form-text">
                        Más adelante agregaremos la carga directa
                        de imágenes desde la computadora.
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="admin-opcion-pago">

                        <input type="checkbox"
                               th:field="*{requierePago}"
                               id="requierePago">

                        <label for="requierePago">
                            <strong>Evento con entrada pagada</strong>
                            <span>
                                Se cobrará por cada persona de la reserva.
                            </span>
                        </label>

                    </div>

                </div>

                <div class="col-md-3">

                    <label class="form-label">
                        Precio por persona
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            S/
                        </span>

                        <input type="number"
                               th:field="*{precioEntrada}"
                               class="form-control"
                               min="0"
                               step="1">

                    </div>

                </div>

                <div class="col-md-3">

                    <label class="form-label">
                        Estado
                    </label>

                    <select th:field="*{estado}"
                            class="form-select"
                            required>

                        <option th:each="estado : ${estados}"
                                th:value="${estado}"
                                th:text="${estado}">
                        </option>

                    </select>

                </div>

            </div>

            <div class="admin-formulario-acciones">

                <a th:href="@{/admin/eventos}"
                   class="admin-boton-secundario">
                    Cancelar
                </a>

                <button type="submit"
                        class="admin-boton-principal">

                    <i class="bi bi-check-lg"></i>
                    Guardar evento

                </button>

            </div>

        </form>

    </main>

</div>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/eventos/lista.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Gestión de eventos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&amp;family=Nunito:wght@400;600;700&amp;display=swap"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar :: sidebar('eventos')}">
    </aside>

    <main class="admin-contenido">

        <header class="admin-encabezado">

            <div>
                <span class="admin-etiqueta">
                    PROGRAMACIÓN
                </span>

                <h1>Gestión de eventos</h1>

                <p>
                    Administra las presentaciones,
                    horarios y precios de entrada.
                </p>
            </div>

            <a th:href="@{/admin/eventos/nuevo}"
               class="admin-boton-principal">

                <i class="bi bi-plus-lg"></i>
                Nuevo evento

            </a>

        </header>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <section class="admin-tabla-contenedor">

            <div class="admin-tabla-titulo">
                <div>
                    <h2>Eventos registrados</h2>

                    <p>
                        Los eventos activos aparecerán
                        en la página pública.
                    </p>
                </div>

                <span class="admin-contador"
                      th:text="${eventos != null ? eventos.size() : 0} + ' eventos'">
                    0 eventos
                </span>
            </div>

            <div th:if="${eventos == null or eventos.isEmpty()}"
                 class="admin-vacio">

                <i class="bi bi-calendar-event"></i>

                <h3>No hay eventos registrados</h3>

                <p>
                    Registra el primer evento del restaurante.
                </p>

                <a th:href="@{/admin/eventos/nuevo}"
                   class="admin-boton-principal">

                    Crear evento

                </a>
            </div>

            <div class="table-responsive"
                 th:if="${eventos != null and !eventos.isEmpty()}">

                <table class="table admin-tabla">

                    <thead>
                    <tr>
                        <th>Evento</th>
                        <th>Fecha y horario</th>
                        <th>Entrada</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                    </thead>

                    <tbody>

                    <tr th:each="evento : ${eventos}">

                        <td>
                            <div class="evento-info">

                                <div class="evento-miniatura">

                                    <img th:if="${evento.imagen != null and !evento.imagen.isBlank()}"
                                         th:src="${evento.imagen}"
                                         alt="Evento">

                                    <i th:unless="${evento.imagen != null and !evento.imagen.isBlank()}"
                                       class="bi bi-music-note-beamed">
                                    </i>

                                </div>

                                <div>
                                    <strong th:text="${evento.titulo}">
                                        Evento
                                    </strong>

                                    <span th:text="${evento.descripcion != null
                                                    ? evento.descripcion
                                                    : 'Sin descripción'}">
                                    </span>
                                </div>

                            </div>
                        </td>

                        <td>
                            <strong th:text="${#temporals.format(evento.fecha, 'dd/MM/yyyy')}">
                                01/01/2026
                            </strong>

                            <span class="d-block text-muted small"
                                  th:text="${#temporals.format(evento.horaInicio, 'HH:mm')
                                           + (evento.horaFin != null
                                           ? ' - ' + #temporals.format(evento.horaFin, 'HH:mm')
                                           : '')}">
                            </span>
                        </td>

                        <td>
                            <span th:if="${evento.requierePago}"
                                  class="evento-precio"
                                  th:text="'S/ ' + ${evento.precioEntrada}">
                                S/ 30
                            </span>

                            <span th:unless="${evento.requierePago}"
                                  class="evento-gratis">
                                Entrada libre
                            </span>
                        </td>

                        <td>
                            <span class="admin-estado"
                                  th:classappend="${evento.estado.name() == 'ACTIVO'}
                                                  ? ' activo'
                                                  : (${evento.estado.name() == 'CANCELADO'}
                                                  ? ' cancelado'
                                                  : ' inactivo')"
                                  th:text="${evento.estado}">
                                ACTIVO
                            </span>
                        </td>

                        <td>
                            <div class="admin-acciones">

                                <a th:href="@{/admin/eventos/{id}/editar(id=${evento.idEvento})}"
                                   class="admin-boton-icono"
                                   title="Editar">

                                    <i class="bi bi-pencil"></i>

                                </a>

                                <form th:if="${evento.estado.name() != 'INACTIVO'}"
                                      th:action="@{/admin/eventos/{id}/estado(id=${evento.idEvento})}"
                                      method="post">

                                    <input type="hidden"
                                           th:name="${_csrf.parameterName}"
                                           th:value="${_csrf.token}">

                                    <input type="hidden"
                                           name="estado"
                                           value="INACTIVO">

                                    <button type="submit"
                                            class="admin-boton-icono advertencia"
                                            title="Desactivar">

                                        <i class="bi bi-pause-circle"></i>

                                    </button>
                                </form>

                                <form th:if="${evento.estado.name() == 'INACTIVO'}"
                                      th:action="@{/admin/eventos/{id}/estado(id=${evento.idEvento})}"
                                      method="post">

                                    <input type="hidden"
                                           th:name="${_csrf.parameterName}"
                                           th:value="${_csrf.token}">

                                    <input type="hidden"
                                           name="estado"
                                           value="ACTIVO">

                                    <button type="submit"
                                            class="admin-boton-icono exito"
                                            title="Activar">

                                        <i class="bi bi-play-circle"></i>

                                    </button>
                                </form>

                            </div>
                        </td>

                    </tr>

                    </tbody>

                </table>

            </div>

        </section>

    </main>

</div>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/carta.html">
<!DOCTYPE html>
<html lang="es"xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo}+ ' - El Rinconcito Ayacuchano'">Gestión de carta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"rel="stylesheet">
    <link th:href="@{/css/admin.css}"rel="stylesheet">
    <link th:href="@{/css/admin-carta.css}"rel="stylesheet">
</head>
<body>
<div class="admin-layout">
    <aside th:replace="~{fragments/admin-sidebar :: sidebar('carta')}"></aside>
    <main class="admin-contenido carta-admin-contenido">
        <header class="carta-encabezado">

            <div>
                <p class="carta-etiqueta">ADMINISTRACIÓN</p>
                <h1>Carta y productos</h1>
                <p>
                    Gestiona los platos, bebidas, precios,
                    imágenes y disponibilidad de la carta.
                </p>
            </div>

            <div class="carta-acciones-principales">

                <a th:href="@{/carta}"
                   target="_blank"
                   rel="noopener"
                   class="btn-carta-secundario">

                    <i class="bi bi-box-arrow-up-right"></i>
                    Ver carta pública
                </a>

                <a th:href="@{/admin/categorias}"
                   class="btn-carta-secundario">

                    <i class="bi bi-tags"></i>
                    Categorías
                </a>

                <a th:href="@{/admin/carta/nuevo}"
                   class="btn-carta-principal">

                    <i class="bi bi-plus-lg"></i>
                    Nuevo producto
                </a>

            </div>

        </header>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <section class="carta-panel">

            <div class="carta-panel-encabezado">

                <div>
                    <h2>Productos registrados</h2>

                    <p>
                        Actualiza la información o cambia la
                        disponibilidad de los productos.
                    </p>
                </div>

                <span class="productos-contador"
                      th:text="${productos != null
                          ? productos.size() + ' productos'
                          : '0 productos'}">
                    0 productos
                </span>

            </div>

            <div th:if="${productos == null
                or productos.isEmpty()}"
                 class="carta-vacia">

                <div class="carta-vacia-icono">
                    <i class="bi bi-journal-richtext"></i>
                </div>

                <h3>No hay productos registrados</h3>

                <p>
                    Registra el primer producto para comenzar
                    a construir la carta.
                </p>

                <a th:href="@{/admin/carta/nuevo}"
                   class="btn-carta-principal">

                    <i class="bi bi-plus-lg"></i>
                    Registrar producto
                </a>

            </div>

            <div class="carta-tabla-contenedor"
                 th:if="${productos != null
                    and !productos.isEmpty()}">

                <div class="table-responsive">

                    <table class="carta-tabla">

                        <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Precio</th>
                            <th>Disponibilidad</th>
                            <th>Estado</th>
                            <th class="columna-acciones">
                                Acciones
                            </th>
                        </tr>
                        </thead>

                        <tbody>

                        <tr th:each="producto : ${productos}"
                            th:classappend="${producto.estado.name()
                                == 'INACTIVO'}
                                ? ' producto-inactivo'
                                : ''">

                            <td>

                                <div class="producto-identidad">

                                    <div class="producto-imagen">

                                        <img th:if="${producto.imagen != null
                                            and !#strings.isEmpty(
                                                producto.imagen
                                            )}"
                                             th:src="${producto.imagen}"
                                             th:alt="${producto.nombre}"
                                             onerror="this.style.display='none';
                                                 this.nextElementSibling.style.display='grid';">

                                        <div class="producto-sin-imagen"
                                             th:style="${producto.imagen != null
                                                 and !#strings.isEmpty(
                                                     producto.imagen
                                                 )}
                                                 ? 'display:none'
                                                 : 'display:grid'">

                                            <i class="bi bi-image"></i>

                                        </div>

                                    </div>

                                    <div class="producto-datos">

                                        <strong th:text="${producto.nombre}">
                                            Nombre del producto
                                        </strong>

                                        <span th:text="${producto.descripcion != null
                                            and !producto.descripcion.isBlank()}
                                            ? producto.descripcion
                                            : 'Sin descripción registrada.'">
                                            Descripción
                                        </span>

                                    </div>

                                </div>

                            </td>

                            <td>

                                <span class="producto-categoria"
                                      th:text="${producto.categoria != null
                                          ? producto.categoria.nombre
                                          : 'Sin categoría'}">
                                    Categoría
                                </span>

                            </td>

                            <td>

                                <strong class="producto-precio"
                                        th:text="'S/ '
                                            + ${producto.precio}">
                                    S/ 0
                                </strong>

                            </td>

                            <td>

                                <span class="producto-disponibilidad"
                                      th:classappend="${producto.disponible}
                                          ? ' disponibilidad-si'
                                          : ' disponibilidad-no'">

                                    <i class="bi bi-circle-fill"></i>

                                    <span th:text="${producto.disponible}
                                        ? 'Disponible'
                                        : 'Agotado'">
                                        Disponible
                                    </span>

                                </span>

                            </td>

                            <td>

                                <span class="producto-estado"
                                      th:classappend="${producto.estado.name()
                                          == 'ACTIVO'}
                                          ? ' estado-activo'
                                          : ' estado-inactivo'">

                                    <span th:text="${producto.estado.name()
                                        == 'ACTIVO'}
                                        ? 'Activo'
                                        : 'Inactivo'">
                                        Activo
                                    </span>

                                </span>

                            </td>

                            <td>

                                <div class="producto-acciones">

                                    <a th:href="@{/admin/carta/{id}/editar(
                                            id=${producto.idProducto}
                                       )}"
                                       class="btn-producto-accion btn-editar"
                                       title="Editar producto">

                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>

                                    <form th:action="@{/admin/carta/{id}/disponibilidad(
                                            id=${producto.idProducto}
                                          )}"
                                          method="post">

                                        <input type="hidden"
                                               th:name="${_csrf.parameterName}"
                                               th:value="${_csrf.token}">

                                        <input type="hidden"
                                               name="disponible"
                                               th:value="${!producto.disponible}">

                                        <button type="submit"
                                                class="btn-producto-accion"
                                                th:classappend="${producto.disponible}
                                                    ? ' btn-agotar'
                                                    : ' btn-disponible'">

                                            <i th:class="${producto.disponible}
                                                ? 'bi bi-x-circle'
                                                : 'bi bi-check-circle'">
                                            </i>

                                            <span th:text="${producto.disponible}
                                                ? 'Agotar'
                                                : 'Disponible'">
                                                Agotar
                                            </span>

                                        </button>

                                    </form>

                                    <form th:action="@{/admin/carta/{id}/estado(
                                            id=${producto.idProducto}
                                          )}"
                                          method="post">

                                        <input type="hidden"
                                               th:name="${_csrf.parameterName}"
                                               th:value="${_csrf.token}">

                                        <input type="hidden"
                                               name="estado"
                                               th:value="${producto.estado.name()
                                                   == 'ACTIVO'}
                                                   ? 'INACTIVO'
                                                   : 'ACTIVO'">

                                        <button type="submit"
                                                class="btn-producto-accion"
                                                th:classappend="${producto.estado.name()
                                                    == 'ACTIVO'}
                                                    ? ' btn-desactivar'
                                                    : ' btn-activar'"
                                                onclick="return confirm(
                                                    '¿Deseas cambiar el estado de este producto?'
                                                );">

                                            <i th:class="${producto.estado.name()
                                                == 'ACTIVO'}
                                                ? 'bi bi-pause-circle'
                                                : 'bi bi-play-circle'">
                                            </i>

                                            <span th:text="${producto.estado.name()
                                                == 'ACTIVO'}
                                                ? 'Desactivar'
                                                : 'Activar'">
                                                Desactivar
                                            </span>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/categoria-form.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Categoría
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

    <link th:href="@{/css/admin-categorias.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar
        :: sidebar('categorias')}">
    </aside>

    <main class="admin-contenido categoria-form-contenido">

        <header class="categoria-form-encabezado">

            <div>
                <p class="categoria-form-etiqueta">
                    GESTIÓN DE CARTA
                </p>

                <h1 th:text="${titulo}">
                    Categoría
                </h1>

                <p>
                    Registra la información necesaria
                    para organizar los productos de la carta.
                </p>
            </div>

            <a th:href="@{/admin/categorias}"
               class="btn-volver-categorias">

                <i class="bi bi-arrow-left"></i>
                Volver a categorías
            </a>

        </header>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <form th:action="@{/admin/categorias/guardar}"
              method="post"
              class="categoria-formulario">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

            <input type="hidden"
                   name="idCategoria"
                   th:value="${categoria.idCategoria}">

            <section class="categoria-form-seccion">

                <div class="categoria-form-seccion-titulo">

                    <div class="categoria-form-icono">
                        <i class="bi bi-tag"></i>
                    </div>

                    <div>
                        <h2>Información de la categoría</h2>

                        <p>
                            Estos datos permitirán identificar
                            la categoría dentro de la carta.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-12">

                        <label for="nombre"
                               class="form-label">
                            Nombre de la categoría
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="nombre"
                               name="nombre"
                               class="form-control"
                               maxlength="60"
                               required
                               placeholder="Ejemplo: Comidas típicas"
                               th:value="${categoria.nombre}">

                        <div class="form-text">
                            Debe ser único y tener como máximo
                            60 caracteres.
                        </div>

                    </div>

                    <div class="col-12">

                        <label for="descripcion"
                               class="form-label">
                            Descripción
                        </label>

                        <textarea id="descripcion"
                                  name="descripcion"
                                  class="form-control"
                                  rows="4"
                                  maxlength="200"
                                  placeholder="Describe brevemente la categoría"
                                  th:text="${categoria.descripcion}">
                        </textarea>

                        <div class="form-text">
                            Máximo 200 caracteres.
                        </div>

                    </div>

                    <div class="col-12">

                        <label for="estado"
                               class="form-label">
                            Estado
                        </label>

                        <select id="estado"
                                name="estado"
                                class="form-select">

                            <option th:each="estadoCategoria : ${estados}"
                                    th:value="${estadoCategoria}"
                                    th:text="${estadoCategoria.name()
                                        == 'ACTIVO'
                                        ? 'Activo'
                                        : 'Inactivo'}"
                                    th:selected="${categoria.estado
                                        == estadoCategoria
                                        or (categoria.estado == null
                                        and estadoCategoria.name()
                                        == 'ACTIVO')}">
                            </option>

                        </select>

                        <div class="categoria-estado-informacion">

                            <i class="bi bi-info-circle"></i>

                            <span>
                                Una categoría inactiva no debe
                                mostrarse en la carta pública.
                            </span>

                        </div>

                    </div>

                </div>

            </section>

            <div class="categoria-form-acciones">

                <a th:href="@{/admin/categorias}"
                   class="btn-cancelar-categoria">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-guardar-categoria">

                    <i class="bi bi-floppy"></i>
                    Guardar categoría
                </button>

            </div>

        </form>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/categorias.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Categorías
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

    <link th:href="@{/css/admin-categorias.css}"
          rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar
        :: sidebar('categorias')}">
    </aside>

    <main class="admin-contenido categorias-contenido">

        <header class="categorias-encabezado">

            <div>
                <p class="categorias-etiqueta">
                    GESTIÓN DE CARTA
                </p>

                <h1>Categorías</h1>

                <p>
                    Organiza los productos de la carta
                    mediante categorías.
                </p>
            </div>

            <div class="categorias-acciones-principales">

                <a th:href="@{/admin/carta}"
                   class="btn-categoria-secundario">

                    <i class="bi bi-journal-richtext"></i>
                    Ver productos
                </a>

                <a th:href="@{/admin/categorias/nueva}"
                   class="btn-categoria-principal">

                    <i class="bi bi-plus-lg"></i>
                    Nueva categoría
                </a>

            </div>

        </header>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <section class="categorias-panel">

            <div class="categorias-panel-encabezado">

                <div>
                    <h2>Categorías registradas</h2>

                    <p>
                        Edita la información o cambia
                        el estado de cada categoría.
                    </p>
                </div>

                <span class="categorias-contador"
                      th:text="${categorias != null
                          ? categorias.size() + ' categorías'
                          : '0 categorías'}">
                    0 categorías
                </span>

            </div>

            <div th:if="${categorias == null
                or categorias.isEmpty()}"
                 class="categorias-vacias">

                <div class="categorias-vacias-icono">
                    <i class="bi bi-tags"></i>
                </div>

                <h3>No hay categorías registradas</h3>

                <p>
                    Registra una categoría para comenzar
                    a organizar los productos.
                </p>

                <a th:href="@{/admin/categorias/nueva}"
                   class="btn-categoria-principal">

                    <i class="bi bi-plus-lg"></i>
                    Registrar categoría
                </a>

            </div>

            <div class="categorias-tabla-contenedor"
                 th:if="${categorias != null
                    and !categorias.isEmpty()}">

                <div class="table-responsive">

                    <table class="categorias-tabla">

                        <thead>
                        <tr>
                            <th>Categoría</th>
                            <th>Descripción</th>
                            <th>Estado</th>

                            <th class="columna-acciones">
                                Acciones
                            </th>
                        </tr>
                        </thead>

                        <tbody>

                        <tr th:each="categoria : ${categorias}"
                            th:classappend="${categoria.estado.name()
                                == 'INACTIVO'}
                                ? ' categoria-inactiva'
                                : ''">

                            <td>

                                <div class="categoria-identidad">

                                    <div class="categoria-icono">
                                        <i class="bi bi-tag"></i>
                                    </div>

                                    <strong th:text="${categoria.nombre}">
                                        Nombre
                                    </strong>

                                </div>

                            </td>

                            <td>

                                <span class="categoria-descripcion"
                                      th:text="${categoria.descripcion != null
                                          and !categoria.descripcion.isBlank()}
                                          ? categoria.descripcion
                                          : 'Sin descripción registrada.'">
                                    Descripción
                                </span>

                            </td>

                            <td>

                                <span class="categoria-estado"
                                      th:classappend="${categoria.estado.name()
                                          == 'ACTIVO'}
                                          ? ' estado-activo'
                                          : ' estado-inactivo'">

                                    <span th:text="${categoria.estado.name()
                                        == 'ACTIVO'}
                                        ? 'Activo'
                                        : 'Inactivo'">
                                        Activo
                                    </span>

                                </span>

                            </td>

                            <td>

                                <div class="categoria-acciones">

                                    <a th:href="@{/admin/categorias/{id}/editar(
                                            id=${categoria.idCategoria}
                                       )}"
                                       class="btn-categoria-accion btn-editar"
                                       title="Editar categoría">

                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>

                                    <form th:action="@{/admin/categorias/{id}/estado(
                                            id=${categoria.idCategoria}
                                          )}"
                                          method="post">

                                        <input type="hidden"
                                               th:name="${_csrf.parameterName}"
                                               th:value="${_csrf.token}">

                                        <input type="hidden"
                                               name="estado"
                                               th:value="${categoria.estado.name()
                                                   == 'ACTIVO'}
                                                   ? 'INACTIVO'
                                                   : 'ACTIVO'">

                                        <button type="submit"
                                                class="btn-categoria-accion"
                                                th:classappend="${categoria.estado.name()
                                                    == 'ACTIVO'}
                                                    ? ' btn-desactivar'
                                                    : ' btn-activar'"
                                                onclick="return confirm(
                                                    '¿Deseas cambiar el estado de esta categoría?'
                                                );">

                                            <i th:class="${categoria.estado.name()
                                                == 'ACTIVO'}
                                                ? 'bi bi-pause-circle'
                                                : 'bi bi-play-circle'">
                                            </i>

                                            <span th:text="${categoria.estado.name()
                                                == 'ACTIVO'}
                                                ? 'Desactivar'
                                                : 'Activar'">
                                                Desactivar
                                            </span>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
</file>

<file path="src/main/resources/templates/paginas/admin/configuracion.html">
<!DOCTYPE html>
<html lang="es"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title th:text="${titulo}
        + ' - El Rinconcito Ayacuchano'">
        Configuración
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link th:href="@{/css/admin.css}"
          rel="stylesheet">

	<link th:href="@{/css/admin-configuracion.css}"
		  rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <aside th:replace="~{fragments/admin-sidebar
        :: sidebar('configuracion')}">
    </aside>

    <main class="admin-contenido configuracion-contenido">

        <header class="configuracion-encabezado">

            <div>
                <p class="configuracion-etiqueta">
                    ADMINISTRACIÓN
                </p>

                <h1>Configuración del restaurante</h1>

                <p>
                    Actualiza los datos públicos, medios de contacto
                    y métodos de pago.
                </p>
            </div>
        </header>

        <div th:if="${exito}"
             class="alert alert-success"
             th:text="${exito}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>

        <form th:action="@{/admin/configuracion/guardar}"
              th:object="${configuracionForm}"
              method="post"
              enctype="multipart/form-data"
              class="configuracion-formulario">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

            <input type="hidden"
                   th:field="*{idConfiguracion}">

            <input type="hidden"
                   th:field="*{qrYapeActual}">

            <input type="hidden"
                   th:field="*{qrPlinActual}">

            <!-- DATOS GENERALES -->
            <section class="configuracion-seccion">

                <div class="seccion-encabezado">

                    <div class="seccion-icono">
                        <i class="bi bi-shop"></i>
                    </div>

                    <div>
                        <h2>Datos generales</h2>

                        <p>
                            Información principal que se mostrará
                            en el sitio web.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-12">

                        <label for="nombre"
                               class="form-label">
                            Nombre del restaurante
                            <span>*</span>
                        </label>

                        <input type="text"
                               id="nombre"
                               th:field="*{nombre}"
                               class="form-control"
                               maxlength="150"
                               placeholder="El Rinconcito Ayacuchano Campestre"
                               required>

                    </div>

                    <div class="col-lg-8">

                        <label for="direccion"
                               class="form-label">
                            Dirección
                            <span>*</span>
                        </label>

                        <input type="text"
                               id="direccion"
                               th:field="*{direccion}"
                               class="form-control"
                               maxlength="200"
                               placeholder="Dirección del restaurante"
                               required>

                    </div>

                    <div class="col-lg-4">

                        <label for="referencia"
                               class="form-label">
                            Referencia
                        </label>

                        <input type="text"
                               id="referencia"
                               th:field="*{referencia}"
                               class="form-control"
                               maxlength="200"
                               placeholder="Frente a...">

                    </div>

                </div>

            </section>

            <!-- CONTACTO -->
            <section class="configuracion-seccion">

                <div class="seccion-encabezado">

                    <div class="seccion-icono">
                        <i class="bi bi-telephone"></i>
                    </div>

                    <div>
                        <h2>Contacto</h2>

                        <p>
                            Datos que aparecerán principalmente
                            en el pie de página.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">

                        <label for="telefono"
                               class="form-label">
                            Teléfono
                        </label>

                        <input type="tel"
                               id="telefono"
                               th:field="*{telefono}"
                               class="form-control"
                               inputmode="numeric"
                               maxlength="9"
                               pattern="[0-9]{9}"
                               placeholder="999999999">

                    </div>

                    <div class="col-lg-4 col-md-6">

                        <label for="whatsapp"
                               class="form-label">
                            WhatsApp
                        </label>

                        <input type="tel"
                               id="whatsapp"
                               th:field="*{whatsapp}"
                               class="form-control"
                               inputmode="numeric"
                               maxlength="9"
                               pattern="[0-9]{9}"
                               placeholder="999999999">

                    </div>

                    <div class="col-lg-4">

                        <label for="correo"
                               class="form-label">
                            Correo electrónico
                        </label>

                        <input type="email"
                               id="correo"
                               th:field="*{correo}"
                               class="form-control"
                               maxlength="120"
                               placeholder="contacto@rinconcito.pe">

                    </div>

                </div>

            </section>

            <!-- REDES -->
            <section class="configuracion-seccion">

                <div class="seccion-encabezado">

                    <div class="seccion-icono">
                        <i class="bi bi-share"></i>
                    </div>

                    <div>
                        <h2>Redes y ubicación</h2>

                        <p>
                            Enlaces públicos del restaurante.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-lg-6">

                        <label for="urlFacebook"
                               class="form-label">
                            Facebook
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-facebook"></i>
                            </span>

                            <input type="url"
                                   id="urlFacebook"
                                   th:field="*{urlFacebook}"
                                   class="form-control"
                                   maxlength="255"
                                   placeholder="https://facebook.com/...">

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <label for="urlInstagram"
                               class="form-label">
                            Instagram
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-instagram"></i>
                            </span>

                            <input type="url"
                                   id="urlInstagram"
                                   th:field="*{urlInstagram}"
                                   class="form-control"
                                   maxlength="255"
                                   placeholder="https://instagram.com/...">

                        </div>

                    </div>

                    <div class="col-12">

                        <label for="urlGoogleMaps"
                               class="form-label">
                            Enlace de Google Maps
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-geo-alt"></i>
                            </span>

                            <input type="url"
                                   id="urlGoogleMaps"
                                   th:field="*{urlGoogleMaps}"
                                   class="form-control"
                                   maxlength="500"
                                   placeholder="https://maps.google.com/...">

                        </div>

                    </div>

                </div>

            </section>

            <!-- MEDIOS DE PAGO -->
            <section class="configuracion-seccion">

                <div class="seccion-encabezado">

                    <div class="seccion-icono">
                        <i class="bi bi-wallet2"></i>
                    </div>

                    <div>
                        <h2>Medios de pago</h2>

                        <p>
                            Datos que verá el cliente al pagar
                            pedidos y reservas.
                        </p>
                    </div>

                </div>

                <div class="metodos-pago-grid">

                    <!-- YAPE -->
                    <article class="metodo-configuracion">

                        <div class="metodo-titulo">
                            <div class="metodo-marca yape-marca">
                                Y
                            </div>

                            <div>
                                <h3>Yape</h3>
                                <p>Número, titular y código QR.</p>
                            </div>
                        </div>

                        <div class="mb-3">

                            <label for="numeroYape"
                                   class="form-label">
                                Número de Yape
                            </label>

                            <input type="tel"
                                   id="numeroYape"
                                   th:field="*{numeroYape}"
                                   class="form-control"
                                   inputmode="numeric"
                                   maxlength="9"
                                   pattern="[0-9]{9}"
                                   placeholder="999999999">

                        </div>

                        <div class="mb-3">

                            <label for="titularYape"
                                   class="form-label">
                                Titular
                            </label>

                            <input type="text"
                                   id="titularYape"
                                   th:field="*{titularYape}"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="Nombre del titular">

                        </div>

                        <div class="qr-configuracion">

                            <div th:if="*{qrYapeActual != null
                                and !qrYapeActual.isBlank()}"
                                 class="qr-vista">

                                <img th:src="@{/configuracion/qr/yape(
                                        v=*{qrYapeActual}
                                     )}"
                                     alt="Código QR de Yape">

                                <button type="submit"
                                        form="eliminarQrYapeForm"
                                        class="btn-eliminar-qr"
                                        onclick="return confirm(
                                            '¿Deseas eliminar el QR de Yape?'
                                        );">

                                    <i class="bi bi-trash"></i>
                                    Eliminar QR
                                </button>

                            </div>

                            <div th:unless="*{qrYapeActual != null
                                and !qrYapeActual.isBlank()}"
                                 class="qr-sin-imagen">

                                <i class="bi bi-qr-code"></i>
                                <span>Sin código QR</span>

                            </div>

                            <label for="archivoQrYape"
                                   class="form-label mt-3">
                                Seleccionar nuevo QR
                            </label>

                            <input type="file"
                                   id="archivoQrYape"
                                   name="archivoQrYape"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">

                            <div class="form-text">
                                JPG, PNG o WEBP. Máximo 3 MB.
                            </div>

                        </div>

                    </article>

                    <!-- PLIN -->
                    <article class="metodo-configuracion">

                        <div class="metodo-titulo">
                            <div class="metodo-marca plin-marca">
                                P
                            </div>

                            <div>
                                <h3>Plin</h3>
                                <p>Número, titular y código QR.</p>
                            </div>
                        </div>

                        <div class="mb-3">

                            <label for="numeroPlin"
                                   class="form-label">
                                Número de Plin
                            </label>

                            <input type="tel"
                                   id="numeroPlin"
                                   th:field="*{numeroPlin}"
                                   class="form-control"
                                   inputmode="numeric"
                                   maxlength="9"
                                   pattern="[0-9]{9}"
                                   placeholder="999999999">

                        </div>

                        <div class="mb-3">

                            <label for="titularPlin"
                                   class="form-label">
                                Titular
                            </label>

                            <input type="text"
                                   id="titularPlin"
                                   th:field="*{titularPlin}"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="Nombre del titular">

                        </div>

                        <div class="qr-configuracion">

                            <div th:if="*{qrPlinActual != null
                                and !qrPlinActual.isBlank()}"
                                 class="qr-vista">

                                <img th:src="@{/configuracion/qr/plin(
                                        v=*{qrPlinActual}
                                     )}"
                                     alt="Código QR de Plin">

                                <button type="submit"
                                        form="eliminarQrPlinForm"
                                        class="btn-eliminar-qr"
                                        onclick="return confirm(
                                            '¿Deseas eliminar el QR de Plin?'
                                        );">

                                    <i class="bi bi-trash"></i>
                                    Eliminar QR
                                </button>

                            </div>

                            <div th:unless="*{qrPlinActual != null
                                and !qrPlinActual.isBlank()}"
                                 class="qr-sin-imagen">

                                <i class="bi bi-qr-code"></i>
                                <span>Sin código QR</span>

                            </div>

                            <label for="archivoQrPlin"
                                   class="form-label mt-3">
                                Seleccionar nuevo QR
                            </label>

                            <input type="file"
                                   id="archivoQrPlin"
                                   name="archivoQrPlin"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">

                            <div class="form-text">
                                JPG, PNG o WEBP. Máximo 3 MB.
                            </div>

                        </div>

                    </article>

                </div>

            </section>

            <!-- TRANSFERENCIA -->
            <section class="configuracion-seccion">

                <div class="seccion-encabezado">

                    <div class="seccion-icono">
                        <i class="bi bi-bank"></i>
                    </div>

                    <div>
                        <h2>Transferencia bancaria</h2>

                        <p>
                            Información bancaria mostrada
                            al seleccionar transferencia.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-lg-6">

                        <label for="bancoTransferencia"
                               class="form-label">
                            Banco
                        </label>

                        <input type="text"
                               id="bancoTransferencia"
                               th:field="*{bancoTransferencia}"
                               class="form-control"
                               maxlength="100"
                               placeholder="Nombre del banco">

                    </div>

                    <div class="col-lg-6">

                        <label for="titularTransferencia"
                               class="form-label">
                            Titular de la cuenta
                        </label>

                        <input type="text"
                               id="titularTransferencia"
                               th:field="*{titularTransferencia}"
                               class="form-control"
                               maxlength="150"
                               placeholder="Nombre del titular">

                    </div>

                    <div class="col-lg-6">

                        <label for="numeroCuentaTransferencia"
                               class="form-label">
                            Número de cuenta
                        </label>

                        <input type="text"
                               id="numeroCuentaTransferencia"
                               th:field="*{numeroCuentaTransferencia}"
                               class="form-control"
                               maxlength="50"
                               placeholder="Número de cuenta">

                    </div>

                    <div class="col-lg-6">

                        <label for="cciTransferencia"
                               class="form-label">
                            Código CCI
                        </label>

                        <input type="text"
                               id="cciTransferencia"
                               th:field="*{cciTransferencia}"
                               class="form-control"
                               inputmode="numeric"
                               maxlength="20"
                               pattern="[0-9]{20}"
                               placeholder="20 dígitos">

                    </div>

                </div>

            </section>

            <div class="configuracion-acciones">

                <a th:href="@{/admin/dashboard}"
                   class="btn-cancelar-configuracion">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-guardar-configuracion">

                    <i class="bi bi-floppy"></i>
                    Guardar configuración
                </button>

            </div>

        </form>

        <!-- Formularios externos para evitar formularios anidados -->

        <form id="eliminarQrYapeForm"
              th:action="@{/admin/configuracion/qr/yape/eliminar}"
              method="post">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

        </form>

        <form id="eliminarQrPlinForm"
              th:action="@{/admin/configuracion/qr/plin/eliminar}"
              method="post">

            <input type="hidden"
                   th:name="${_csrf.parameterName}"
                   th:value="${_csrf.token}">

        </form>
		<!-- HORARIOS DE ATENCIÓN -->

		<form th:action="@{/admin/configuracion/horarios/guardar}"
		      th:object="${horarioForm}"
		      method="post"
		      class="configuracion-seccion horario-formulario">

		    <input type="hidden"
		           th:name="${_csrf.parameterName}"
		           th:value="${_csrf.token}">

		    <div class="seccion-encabezado">

		        <div class="seccion-icono">
		            <i class="bi bi-clock-history"></i>
		        </div>

		        <div>
		            <h2>Horarios de atención</h2>

		            <p>
		                Configura los días y las horas en que
		                el restaurante acepta reservas.
		            </p>
		        </div>

		    </div>

		    <div class="horarios-lista">

		        <article th:each="horario, estado : *{horarios}"
		                 class="horario-dia"
		                 th:attr="data-indice=${estado.index}">

		            <input type="hidden"
		                   th:field="*{horarios[__${estado.index}__].idHorario}">

		            <input type="hidden"
		                   th:field="*{horarios[__${estado.index}__].diaSemana}">

		            <div class="horario-dia-nombre">

		                <div class="horario-dia-icono">
		                    <i class="bi bi-calendar3"></i>
		                </div>

		                <div>

		                    <strong th:switch="${horario.diaSemana.name()}">

		                        <span th:case="'LUNES'">Lunes</span>
		                        <span th:case="'MARTES'">Martes</span>
		                        <span th:case="'MIERCOLES'">Miércoles</span>
		                        <span th:case="'JUEVES'">Jueves</span>
		                        <span th:case="'VIERNES'">Viernes</span>
		                        <span th:case="'SABADO'">Sábado</span>
		                        <span th:case="'DOMINGO'">Domingo</span>

		                    </strong>

		                    <span class="horario-estado-texto"
		                          th:text="${horario.abierto
		                              ? 'Abierto'
		                              : 'Cerrado'}">
		                        Abierto
		                    </span>

		                </div>

		            </div>

		            <div class="horario-interruptor">

		                <label class="switch-horario">

		                    <input type="checkbox"
		                           class="checkbox-abierto"
		                           th:field="*{horarios[__${estado.index}__].abierto}">

		                    <span class="switch-deslizador"></span>

		                </label>

		            </div>

		            <div class="horario-horas">

		                <div class="horario-campo">

		                    <label th:for="'horaApertura'
		                        + ${estado.index}">
		                        Apertura
		                    </label>

		                    <input type="time"
		                           th:id="'horaApertura'
		                               + ${estado.index}"
		                           class="form-control campo-hora"
		                           th:field="*{horarios[__${estado.index}__].horaApertura}"
		                           step="900">

		                </div>

		                <span class="horario-separador">
		                    a
		                </span>

		                <div class="horario-campo">

		                    <label th:for="'horaCierre'
		                        + ${estado.index}">
		                        Cierre
		                    </label>

		                    <input type="time"
		                           th:id="'horaCierre'
		                               + ${estado.index}"
		                           class="form-control campo-hora"
		                           th:field="*{horarios[__${estado.index}__].horaCierre}"
		                           step="900">

		                </div>

		            </div>

		        </article>

		    </div>

		    <div class="horario-informacion">

		        <i class="bi bi-info-circle"></i>

		        <span>
		            Las reservas solo podrán registrarse dentro
		            de los horarios configurados como abiertos.
		        </span>

		    </div>

		    <div class="horario-acciones">

		        <button type="submit"
		                class="btn-guardar-configuracion">

		            <i class="bi bi-clock"></i>
		            Guardar horarios
		        </button>

		    </div>

		</form>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const filas = document.querySelectorAll(".horario-dia");

        filas.forEach(function (fila) {
            const checkbox =
                fila.querySelector(".checkbox-abierto");

            const camposHora =
                fila.querySelectorAll(".campo-hora");

            const textoEstado =
                fila.querySelector(".horario-estado-texto");

            function actualizarEstado() {
                const abierto = checkbox.checked;

                camposHora.forEach(function (campo) {
                    campo.disabled = !abierto;
                    campo.required = abierto;
                });

                textoEstado.textContent =
                    abierto ? "Abierto" : "Cerrado";

                fila.classList.toggle(
                    "horario-cerrado",
                    !abierto
                );
            }

            checkbox.addEventListener(
                "change",
                actualizarEstado
            );

            actualizarEstado();
        });
    });
</script>
</body>
</html>
</file>

