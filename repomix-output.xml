                fuenteNormal
        );

        lienzo.texto(
                "Estado: " + nota.getEstado(),
                390,
                lienzo.y,
                10,
                fuenteNegrita
        );

        lienzo.y -= 22;
    }

    private void dibujarDatosCliente(
            LienzoPdf lienzo,
            NotaVenta nota
    ) throws IOException {

        Pago pago = nota.getPago();

        Usuario cliente;
        String codigo;
        String tipo;

        if (pago.getPedido() != null) {

            Pedido pedido = pago.getPedido();

            cliente = pedido.getCliente();

            codigo =
                    valor(
                            pedido.getCodigoPedido(),
                            "-"
                    );

            tipo = nombreModalidad(pedido);

        } else {

            Reserva reserva = pago.getReserva();

            cliente = reserva.getCliente();

            codigo =
                    valor(
                            reserva.getCodigoReserva(),
                            "-"
                    );

            tipo = "RESERVA";
        }

        lienzo.tituloSeccion(
                "DATOS DEL CLIENTE"
        );

        lienzo.texto(
                "Cliente: "
                        + valor(
                        nota.getClienteNombre(),
                        "Cliente"
                ),
                MARGEN,
                lienzo.y,
                10,
                fuenteNormal
        );

        lienzo.y -= 16;

        lienzo.texto(
                "DNI: "
                        + valor(
                        nota.getClienteDocumento(),
                        "No registrado"
                ),
                MARGEN,
                lienzo.y,
                10,
                fuenteNormal
        );

        String telefonoCliente =
                cliente != null
                        ? valor(cliente.getTelefono(), "-")
                        : "-";

        lienzo.texto(
                "Teléfono: " + telefonoCliente,
                300,
                lienzo.y,
                10,
                fuenteNormal
        );

        lienzo.y -= 16;

        String etiquetaCodigo =
                pago.getPedido() != null
                        ? "Código de pedido: "
                        : "Código de reserva: ";

        lienzo.texto(
                etiquetaCodigo + codigo,
                MARGEN,
                lienzo.y,
                10,
                fuenteNegrita
        );

        lienzo.texto(
                "Tipo: " + tipo,
                350,
                lienzo.y,
                10,
                fuenteNormal
        );

        lienzo.y -= 22;
    }

    private void dibujarDatosEntrega(
            LienzoPdf lienzo,
            Pedido pedido
    ) throws IOException {

        lienzo.asegurarEspacio(105);

        lienzo.tituloSeccion(
                "MODALIDAD DE ENTREGA"
