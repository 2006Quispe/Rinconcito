}

.btn-ocupar {
    background-color: var(--mesero-verde);
    color: var(--mesero-blanco);
}

.btn-liberar {
    border: 1px solid var(--mesero-verde);
    background-color: var(--mesero-blanco);
    color: var(--mesero-verde);
}

.btn-llegada {
    background-color: var(--mesero-naranja);
    color: var(--mesero-blanco);
}

.btn-iniciar {
    background-color: var(--mesero-vino);
    color: var(--mesero-blanco);
}

.btn-finalizar {
    background-color: var(--mesero-cafe);
    color: var(--mesero-blanco);
}

.mesa-sin-acciones {
    margin: 0;
    padding: 0.52rem;
    border-radius: 7px;
    background-color: #e2e4e6;
    color: var(--mesero-gris);
    text-align: center;
    font-size: 0.68rem;
    font-weight: 700;
}

.mesero-sin-mesas,
.piso-sin-mesas {
    padding: 2rem 1rem;
    border: 1px dashed var(--mesero-borde);
    border-radius: 12px;
    background-color: var(--mesero-blanco);
    color: var(--mesero-texto-suave);
    text-align: center;
}

.mesero-sin-mesas i {
    color: var(--mesero-vino);
    font-size: 2rem;
}

.mesero-sin-mesas h2 {
    margin: 0.7rem 0 0.25rem;
    color: var(--mesero-cafe);
    font-family: "Merriweather", serif;
    font-size: 1rem;
}

.mesero-sin-mesas p {
    margin: 0;
    font-size: 0.76rem;
}

.piso-sin-mesas {
    padding: 1rem;
    font-size: 0.76rem;
}

@media (max-width: 1100px) {
    .mesero-contenido {
        width: min(100% - 1.5rem, 1580px);
    }

    .mesas-grid {
        grid-template-columns: repeat(
            auto-fit,
            minmax(210px, 1fr)
        );
    }
}

@media (max-width: 900px) {
    .mesero-sidebar {
        width: min(
            var(--mesero-sidebar-ancho),
            calc(100% - 48px)
        );
        transform: translateX(-105%);
        transition: transform 0.25s ease;
    }

    .mesero-sidebar.abierto {
        transform: translateX(0);
    }

    .mesero-sidebar-cerrar {
        display: grid;
    }

    .mesero-sidebar-fondo {
        display: block;
        pointer-events: none;
    }

    .mesero-sidebar-fondo.visible {
        pointer-events: auto;
    }

    .mesero-area {
        margin-left: 0;
    }

    .mesero-barra-movil {
        position: sticky;
        top: 0;
        z-index: 1030;
        min-height: 60px;
        padding: 0.55rem 0.8rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.7rem;
        background-color: var(--mesero-vino);
        box-shadow: 0 3px 12px rgba(59, 42, 34, 0.18);
    }

    .mesero-menu-boton,
    .mesero-recargar-movil {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.32);
        border-radius: 9px;
        background-color: transparent;
        color: var(--mesero-blanco);
        font-size: 1.1rem;
        text-decoration: none;
    }

    .mesero-menu-boton:hover,
    .mesero-recargar-movil:hover {
        background-color: rgba(255, 255, 255, 0.12);
        color: var(--mesero-blanco);
    }

    .mesero-barra-marca {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--mesero-blanco);
        text-decoration: none;
    }

    .mesero-barra-marca:hover {
        color: var(--mesero-blanco);
    }

    .mesero-barra-logo {
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background-color: var(--mesero-dorado);
        color: var(--mesero-cafe);
    }

    .mesero-barra-marca strong {
        display: block;
        overflow: hidden;
        font-family: "Merriweather", serif;
        font-size: 0.82rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mesero-barra-marca small {
        display: block;
        color: rgba(255, 255, 255, 0.68);
        font-size: 0.6rem;
    }

    .mesero-contenido {
        width: min(100% - 1rem, 1580px);
        padding-top: 1rem;
    }
}

@media (max-width: 650px) {
    body {
        font-size: 0.86rem;
    }

    .mesero-encabezado {
        align-items: stretch;
        flex-direction: column;
    }

    .btn-actualizar-mesas {
        display: none;
    }

    .mesero-leyenda {
        gap: 0.65rem 0.9rem;
    }

    .piso-seccion {
        padding: 0.78rem;
    }

    .piso-encabezado {
        align-items: flex-start;
    }

    .mesas-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 390px) {
    .mesero-barra-marca small {
        display: none;
    }

    .piso-total {
        display: none;
    }
}
