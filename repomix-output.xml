}

.cobro-presencial-informacion {
    margin: 0.72rem 0;
    padding: 0.58rem 0.62rem;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    border-radius: 8px;
    background-color: var(--caja-azul-claro, #e9f5f8);
    color: #315f70;
    font-size: 0.59rem;
    line-height: 1.4;
}

.cobro-presencial-informacion i {
    flex-shrink: 0;
    margin-top: 0.03rem;
}

.btn-confirmar-cobro {
    width: 100%;
    min-height: 39px;
    padding: 0.52rem 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 0;
    border-radius: 8px;
    background-color: var(--caja-verde, #278052);
    color: #ffffff;
    font-size: 0.67rem;
    font-weight: 800;
    cursor: pointer;
    transition:
        background-color 0.2s ease,
        transform 0.2s ease;
}

.btn-confirmar-cobro:hover {
    background-color: #1f6943;
    transform: translateY(-1px);
}

.btn-confirmar-cobro:focus {
    outline: 3px solid rgba(39, 128, 82, 0.2);
    outline-offset: 2px;
}

.btn-confirmar-cobro:disabled {
    cursor: wait;
    opacity: 0.7;
    transform: none;
}

.presenciales-vacio {
    width: 100%;
    padding: 3rem 1rem;
    border: 1px dashed var(--caja-borde, #e7ddd2);
    border-radius: 14px;
    background-color: var(--caja-blanco, #ffffff);
    text-align: center;
}

.presenciales-vacio > i {
    width: 56px;
    height: 56px;
    margin: 0 auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background-color: var(--caja-verde-claro, #e8f6ee);
    color: var(--caja-verde, #278052);
    font-size: 1.5rem;
}

.presenciales-vacio h2 {
    margin: 0.8rem 0 0.28rem;
    color: var(--caja-texto, #3b2a22);
    font-family: "Merriweather", serif;
    font-size: 1rem;
}

.presenciales-vacio p {
    max-width: 460px;
    margin: 0 auto 1rem;
    color: var(--caja-texto-suave, #796a61);
    font-size: 0.72rem;
    line-height: 1.5;
}

@media (max-width: 1499px) {
    .cobros-presenciales-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 900px) {
    .presenciales-encabezado {
        align-items: stretch;
        flex-direction: column;
    }

    .btn-volver-caja {
        align-self: flex-start;
    }

    .cobros-presenciales-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 650px) {
    .presenciales-resumen {
        grid-template-columns: auto minmax(0, 1fr);
    }

    .presenciales-resumen-total {
        grid-column: 1 / -1;
        justify-self: start;
    }
}

@media (max-width: 480px) {
    .presenciales-encabezado h1 {
        font-size: 1.25rem;
    }

    .btn-volver-caja {
        width: 100%;
    }

    .presenciales-resumen {
        padding: 0.75rem;
    }

    .presenciales-resumen-icono {
        width: 38px;
        height: 38px;
    }

    .pedido-presencial-cabecera {
        flex-direction: column;
    }

    .pedido-presencial-dato {
        flex-direction: column;
        gap: 0.08rem;
    }

    .pedido-presencial-dato > strong {
        text-align: left;
    }

    .pedido-presencial-productos li {
        grid-template-columns: 25px minmax(0, 1fr);
    }

    .producto-subtotal {
        grid-column: 2;
    }
}
</file>

<file path="src/main/resources/static/css/caja-reportes.css">
/* =========================================================
   RESUMEN DE VENTAS
   ========================================================= */

.reporte-resumen {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 25px;
}

.reporte-resumen-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 21px;
    border: 1px solid var(--caja-borde);
    border-radius: 15px;
    background-color: var(--caja-blanco);
    box-shadow: 0 7px 20px rgba(59, 42, 34, 0.05);
}

.reporte-resumen-icono {
    display: grid;
    flex: 0 0 53px;
    width: 53px;
    height: 53px;
    place-items: center;
    border-radius: 14px;
    font-size: 23px;
}

.ventas-dia .reporte-resumen-icono {
    background-color: #fff3d2;
    color: #a57200;
}

.notas-dia .reporte-resumen-icono {
    background-color: var(--caja-verde-claro);
    color: var(--caja-verde);
}

.reporte-resumen-card span,
.reporte-resumen-card strong,
.reporte-resumen-card small {
    display: block;
}

.reporte-resumen-card span {
    color: var(--caja-texto-suave);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.reporte-resumen-card strong {
    margin: 2px 0;
    color: var(--caja-texto);
    font-size: 27px;
    line-height: 1.15;
}

.reporte-resumen-card small {
    color: var(--caja-texto-suave);
    font-size: 10px;
}


/* =========================================================
   GRÁFICOS
   ========================================================= */

.dashboard-graficos {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(320px, 1fr);
    gap: 20px;
    margin-bottom: 34px;
}

.grafico-card {
    min-width: 0;
    padding: 23px;
    border: 1px solid var(--caja-borde);
    border-radius: 17px;
    background-color: var(--caja-blanco);
    box-shadow: var(--caja-sombra);
}

.grafico-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 19px;
}

.grafico-cabecera span {
    display: block;
    color: var(--caja-rojo);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

.grafico-cabecera h2 {
    margin: 3px 0 0;
    color: var(--caja-texto);
    font-size: 18px;
    font-weight: 800;
}

.grafico-icono {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 11px;
    background-color: #fff0e6;
    color: var(--caja-rojo);
    font-size: 19px;
}

.grafico-icono.metodo {
    background-color: var(--caja-azul-claro);
    color: var(--caja-azul);
}

.grafico-contenedor {
    position: relative;
    height: 275px;
}

.grafico-circular {
    max-width: 400px;
    margin: auto;
}

.grafico-vacio {
    display: flex;
    height: 275px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    border-radius: 13px;
    background-color: #faf7f3;
    color: var(--caja-texto-suave);
    text-align: center;
}

.grafico-vacio i {
    color: #c6b5aa;
    font-size: 35px;
}

.grafico-vacio p {
    max-width: 310px;
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
}


/* =========================================================
   ACCIONES
   ========================================================= */

.acciones-caja-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.accion-notas {
    background-color: #fff1e8;
    color: var(--caja-rojo);
}


/* =========================================================
   ÚLTIMAS NOTAS
   ========================================================= */

.ultimas-notas-panel {
    overflow: hidden;
    margin-top: 28px;
    border: 1px solid var(--caja-borde);
    border-radius: 17px;
    background-color: var(--caja-blanco);
    box-shadow: var(--caja-sombra);
}

.ultimas-notas-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 21px 23px;
    border-bottom: 1px solid var(--caja-borde);
}

.ultimas-notas-cabecera span {
    display: block;
    color: var(--caja-rojo);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

.ultimas-notas-cabecera h2 {
    margin: 3px 0 0;
    color: var(--caja-texto);
    font-size: 18px;
    font-weight: 800;
}

.ultimas-notas-cabecera > a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--caja-rojo);
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
}

.ultimas-notas-cabecera > a:hover {
    color: var(--caja-rojo-oscuro);
}

.ultimas-notas-tabla-contenedor {
    overflow-x: auto;
}

.ultimas-notas-tabla {
    width: 100%;
    min-width: 850px;
    border-collapse: collapse;
}

.ultimas-notas-tabla th {
    padding: 13px 16px;
    background-color: #f7f0e6;
    color: #65534a;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-align: left;
    text-transform: uppercase;
}

.ultimas-notas-tabla td {
    padding: 15px 16px;
    border-bottom: 1px solid #eee6df;
    color: var(--caja-texto);
    font-size: 11px;
}

.ultimas-notas-tabla tbody tr:last-child td {
    border-bottom: 0;
}

.ultimas-notas-tabla tbody tr:hover {
    background-color: #fdfaf6;
}

.ultima-nota-numero {
    color: var(--caja-rojo);
    white-space: nowrap;
}

.ultima-nota-metodo {
    display: inline-flex;
    padding: 4px 8px;
    border-radius: 7px;
    background-color: var(--caja-azul-claro);
    color: var(--caja-azul);
    font-size: 9px;
    font-weight: 800;
}

.ultima-nota-pdf {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 8px;
    background-color: #fff0e6;
    color: var(--caja-rojo);
    font-size: 14px;
    text-decoration: none;
}

.ultima-nota-pdf:hover {
    background-color: var(--caja-rojo);
    color: var(--caja-blanco);
}

.ultimas-notas-vacio {
    display: flex;
    min-height: 150px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 9px;
    color: var(--caja-texto-suave);
}

.ultimas-notas-vacio i {
    color: #c6b5aa;
    font-size: 29px;
}

.ultimas-notas-vacio p {
    margin: 0;
    font-size: 12px;
}

/*
   RESPONSIVE
 */

@media (max-width: 1200px) {
    .dashboard-graficos {
        grid-template-columns: 1fr;
    }

    .acciones-caja-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 767px) {
    .reporte-resumen {
        grid-template-columns: 1fr;
    }

    .acciones-caja-grid {
        grid-template-columns: 1fr;
    }
}
</file>

<file path="src/main/resources/static/css/caja-validaciones.css">
/*
   VALIDACIÓN DE PAGOS DE PEDIDOS Y RESERVAS
*/

.validacion-encabezado {
    align-items: flex-start;
}

.validacion-volver {
    display: inline-flex;
    min-height: 43px;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--caja-borde);
    border-radius: 11px;
    background-color: var(--caja-blanco);
    color: var(--caja-texto);
    font-family: "Nunito", sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(59, 42, 34, 0.05);
    transition:
        border-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}

.validacion-volver:hover {
    border-color: var(--caja-rojo);
    color: var(--caja-rojo);
    transform: translateY(-1px);
}


/* =========================================================
   MENSAJES
   ========================================================= */

.validacion-alerta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding: 14px 17px;
    border: 1px solid;
    border-radius: 11px;
    font-size: 13px;
    font-weight: 700;
}

.alerta-exito {
    border-color: #bce1cb;
    background-color: var(--caja-verde-claro);
    color: var(--caja-verde);
}

.alerta-error {
    border-color: #f0c4bc;
    background-color: var(--caja-rojo-claro);
    color: #a83a2b;
}


/*
   PANEL
*/

.validacion-panel {
    overflow: hidden;
    border: 1px solid var(--caja-borde);
    border-radius: 17px;
    background-color: var(--caja-blanco);
    box-shadow: var(--caja-sombra);
}

.validacion-panel-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 22px 25px;
    border-bottom: 1px solid var(--caja-borde);
}

.validacion-panel-cabecera h2 {
    margin: 0;
    color: var(--caja-texto);
    font-size: 19px;
    font-weight: 800;
}

.validacion-panel-cabecera p {
    margin: 5px 0 0;
    color: var(--caja-texto-suave);
    font-size: 12px;
}

.validacion-contador {
    display: flex;
    min-width: 135px;
    align-items: center;
    gap: 11px;
    padding: 10px 13px;
    border-radius: 11px;
    background-color: #fff4d8;
    color: #956500;
}

.validacion-contador > i {
    font-size: 21px;
}

.validacion-contador strong,
.validacion-contador span {
    display: block;
}

.validacion-contador strong {
    color: var(--caja-texto);
    font-size: 20px;
    line-height: 1;
}

.validacion-contador span {
    margin-top: 2px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.contador-reservas {
    background-color: var(--caja-morado-claro);
    color: var(--caja-morado);
}


/*
   TABLA
*/

.validacion-tabla-contenedor {
    overflow-x: auto;
}

.validacion-tabla {
    width: 100%;
    min-width: 1250px;
    border-collapse: collapse;
}

.validacion-tabla thead {
    background-color: #f7f0e6;
}

.validacion-tabla th {
    padding: 14px 16px;
    color: #65534a;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
}

.validacion-tabla td {
    padding: 18px 16px;
    border-bottom: 1px solid #ede5dd;
    color: var(--caja-texto);
    font-size: 12px;
    vertical-align: top;
}

.validacion-tabla tbody tr {
    transition: background-color 0.2s ease;
}

.validacion-tabla tbody tr:hover {
    background-color: #fdfaf6;
}

.validacion-tabla tbody tr:last-child td {
    border-bottom: 0;
}


/*
   DATOS DEL PEDIDO Y RESERVA
*/

.pedido-datos,
.reserva-datos,
.evento-cliente {
    display: flex;
    min-width: 210px;
    flex-direction: column;
    gap: 4px;
}

.codigo-registro {
    color: var(--caja-rojo);
    font-size: 12px;
}

.cliente-nombre {
    font-weight: 800;
}

.dato-secundario,
.referencia-entrega {
    color: var(--caja-texto-suave);
    font-size: 10px;
}

.direccion-entrega,
.reserva-fecha {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    margin-top: 3px;
    color: var(--caja-texto-suave);
    font-size: 10px;
}

.direccion-entrega i,
.reserva-fecha i {
    color: var(--caja-rojo);
}

.evento-cliente strong {
    font-size: 12px;
}

.evento-cliente span {
    color: var(--caja-texto-suave);
    font-size: 11px;
}

.sin-evento {
    color: var(--caja-texto-suave);
}


/*
   PRODUCTOS
*/

.productos-lista {
    min-width: 240px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.productos-lista li {
    display: grid;
    grid-template-columns: minmax(100px, 1fr) auto auto;
    gap: 8px;
    padding: 6px 0;
    border-bottom: 1px solid #eee7e0;
    align-items: center;
}

.productos-lista li:first-child {
    padding-top: 0;
}

.productos-lista li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
}

.producto-nombre {
    font-size: 11px;
}

.producto-cantidad {
    color: var(--caja-texto-suave);
    font-size: 10px;
}

.productos-lista strong {
    font-size: 11px;
    white-space: nowrap;
}


/*
   PAGO Y EVIDENCIA
*/

.pago-monto {
    color: var(--caja-texto);
    font-size: 15px;
    white-space: nowrap;
}

.pago-metodo {
    display: inline-flex;
    padding: 5px 9px;
    border-radius: 7px;
    background-color: var(--caja-azul-claro);
    color: var(--caja-azul);
    font-size: 10px;
    font-weight: 800;
}

.pago-operacion {
    display: block;
    max-width: 160px;
    margin-top: 7px;
    color: var(--caja-texto-suave);
    font-size: 10px;
    word-break: break-word;
}

.boton-evidencia {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 11px;
    border: 1px solid #bcd2db;
    border-radius: 8px;
    background-color: var(--caja-blanco);
    color: var(--caja-azul);
    font-size: 10px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
}

.boton-evidencia:hover {
    border-color: var(--caja-azul);
    background-color: var(--caja-azul);
    color: var(--caja-blanco);
}


/*
   APROBAR Y RECHAZAR
*/

.acciones-validacion {
    display: grid;
    min-width: 245px;
    gap: 9px;
}

.acciones-validacion form {
    margin: 0;
}

.boton-aprobar,
.boton-rechazar {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;
    border-radius: 8px;
    color: var(--caja-blanco);
    font-family: "Nunito", sans-serif;
    font-size: 10px;
    font-weight: 800;
    cursor: pointer;
}

.boton-aprobar {
    width: 100%;
    background-color: var(--caja-verde);
}

.boton-aprobar:hover {
    background-color: #1f6742;
}

.form-rechazo {
    display: grid;
    grid-template-columns: minmax(130px, 1fr) auto;
}

.form-rechazo input {
    min-width: 0;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--caja-borde);
    border-right: 0;
    border-radius: 8px 0 0 8px;
    color: var(--caja-texto);
    font-family: "Nunito", sans-serif;
    font-size: 10px;
    outline: none;
}

.form-rechazo input:focus {
    border-color: var(--caja-rojo);
}

.boton-rechazar {
    padding: 0 12px;
    border-radius: 0 8px 8px 0;
    background-color: var(--caja-rojo);
}

.boton-rechazar:hover {
    background-color: var(--caja-rojo-oscuro);
}


/* =========================================================
   SIN RESULTADOS
   ========================================================= */

.validacion-vacio {
    padding: 70px 20px;
    text-align: center;
}

.validacion-vacio-icono {
    display: grid;
    width: 65px;
    height: 65px;
    margin: 0 auto 17px;
    place-items: center;
    border-radius: 18px;
    background-color: #f7f0e6;
    color: var(--caja-rojo);
    font-size: 28px;
}

.validacion-vacio h3 {
    margin: 0 0 7px;
    color: var(--caja-texto);
    font-size: 18px;
    font-weight: 800;
}

.validacion-vacio p {
    max-width: 480px;
    margin: auto;
    color: var(--caja-texto-suave);
    font-size: 12px;
}


/* 
   RESPONSIVE
 */

@media (max-width: 991px) {
    .validacion-panel-cabecera {
        align-items: stretch;
        flex-direction: column;
    }

    .validacion-contador {
        width: fit-content;
    }
}
</file>

<file path="src/main/resources/static/css/caja.css">
:root {
    --caja-rojo: #8c2f1b;
    --caja-rojo-oscuro: #682114;
    --caja-dorado: #d4a017;
    --caja-crema: #f7f2e9;
    --caja-blanco: #ffffff;
    --caja-texto: #3b2a22;
    --caja-texto-suave: #796a61;
    --caja-borde: #e7ddd2;
    --caja-verde: #278052;
    --caja-verde-claro: #e8f6ee;
    --caja-rojo-claro: #fff0ed;
    --caja-azul: #387b91;
    --caja-azul-claro: #e9f5f8;
    --caja-morado: #72538c;
    --caja-morado-claro: #f2edf7;
    --caja-sombra: 0 8px 22px rgba(59, 42, 34, 0.07);
}

* {
    box-sizing: border-box;
}

html {
    font-size: 14px;
}

body.caja-body {
    min-height: 100vh;
    margin: 0;
    color: var(--caja-texto);
    background-color: var(--caja-crema);
    font-family: "Nunito", sans-serif;
    font-size: 14px;
}

button,
input,
select,
textarea {
    font-family: inherit;
}

.caja-layout {
    display: grid;
    min-height: 100vh;
    grid-template-columns: 238px minmax(0, 1fr);
}

.caja-sidebar {
    position: sticky;
    top: 0;
    display: flex;
    width: 238px;
    height: 100vh;
    padding: 18px 14px 14px;
    overflow-x: hidden;
    overflow-y: auto;
    flex-direction: column;
    color: var(--caja-blanco);
    background: linear-gradient(
        180deg,
        #782616 0%,
        #5e1c11 100%
    );
}

.caja-sidebar::-webkit-scrollbar {
    width: 5px;
}

.caja-sidebar::-webkit-scrollbar-thumb {
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.25);
}

.sidebar-marca {
    display: flex;
    gap: 11px;
    padding: 0 7px 17px;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

.marca-icono {
    width: 42px;
    height: 42px;
    display: grid;
    flex: 0 0 42px;
    place-items: center;
    border-radius: 12px;
    background-color: var(--caja-dorado);
    color: var(--caja-texto);
    font-size: 19px;
}

.sidebar-marca strong {
    display: block;
    color: var(--caja-blanco);
    font-family: "Merriweather", serif;
    font-size: 15px;
}

.sidebar-marca span {
    display: block;
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
}

.sidebar-menu {
    display: grid;
    gap: 3px;
    margin-top: 14px;
}

.sidebar-enlace {
    position: relative;
    min-height: 39px;
    padding: 0 11px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 9px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition:
        color 0.2s ease,
        background-color 0.2s ease,
        transform 0.2s ease;
}

.sidebar-enlace > i {
    width: 18px;
    flex: 0 0 18px;
    font-size: 15px;
    text-align: center;
}

.sidebar-enlace > span:not(.menu-contador) {
    min-width: 0;
    flex: 1;
}

.sidebar-enlace:hover {
    color: var(--caja-blanco);
    background-color: rgba(255, 255, 255, 0.11);
    transform: translateX(2px);
}

.sidebar-enlace.activo {
    background-color: var(--caja-dorado);
    color: var(--caja-texto);
}

.sidebar-enlace.activo:hover {
    background-color: #e0ad22;
    color: var(--caja-texto);
}

.menu-contador {
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background-color: var(--caja-blanco);
    color: var(--caja-rojo);
    font-size: 9px;
    font-weight: 800;
}

.sidebar-pie {
    margin-top: auto;
}

.sidebar-usuario {
    padding: 14px 6px 10px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.caja-sidebar > .sidebar-usuario {
    margin-top: auto;
}

.usuario-avatar {
    width: 35px;
    height: 35px;
    display: grid;
    flex: 0 0 35px;
    place-items: center;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    color: var(--caja-blanco);
    font-size: 14px;
}

.usuario-informacion {
    min-width: 0;
}

.usuario-informacion strong {
    display: block;
    color: var(--caja-blanco);
    font-size: 12px;
}

.usuario-informacion span {
    display: block;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.66);
    font-size: 10px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sidebar-logout-form,
.sidebar-salir {
    width: 100%;
    margin: 3px 0 0;
}

.sidebar-cerrar-sesion,
.sidebar-salir button {
    width: 100%;
    min-height: 36px;
    padding: 7px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 9px;
    background-color: transparent;
    color: rgba(255, 255, 255, 0.88);
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    transition:
        color 0.2s ease,
        border-color 0.2s ease,
        background-color 0.2s ease;
}

.sidebar-cerrar-sesion:hover,
.sidebar-salir button:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background-color: rgba(255, 255, 255, 0.12);
    color: var(--caja-blanco);
}

.caja-principal,
.caja-contenido {
    min-width: 0;
    width: 100%;
    padding: 26px 32px 40px;
}

.caja-encabezado {
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.encabezado-etiqueta {
    display: block;
    margin-bottom: 4px;
    color: var(--caja-rojo);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.caja-encabezado h1 {
    margin: 0;
    color: var(--caja-texto);
    font-family: "Merriweather", serif;
    font-size: clamp(26px, 2.7vw, 32px);
    line-height: 1.2;
}

.caja-encabezado p {
    margin: 5px 0 0;
    color: var(--caja-texto-suave);
    font-size: 12px;
}

.encabezado-fecha {
    min-width: 220px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--caja-borde);
    border-radius: 11px;
    background-color: var(--caja-blanco);
    box-shadow: 0 5px 14px rgba(59, 42, 34, 0.04);
}

.encabezado-fecha > i {
    color: var(--caja-rojo);
    font-size: 18px;
}

.encabezado-fecha span {
    display: block;
    color: var(--caja-texto-suave);
    font-size: 9px;
}

.encabezado-fecha strong {
    display: block;
    color: var(--caja-texto);
    font-size: 10.5px;
}

.caja-estadisticas {
    margin-bottom: 24px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 11px;
}

.estadistica-card {
    min-width: 0;
    min-height: 76px;
    padding: 12px;
    display: flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--caja-borde);
    border-radius: 12px;
    background-color: var(--caja-blanco);
    box-shadow: 0 5px 14px rgba(59, 42, 34, 0.04);
}

.estadistica-icono {
    width: 38px;
    height: 38px;
    display: grid;
    flex: 0 0 38px;
    place-items: center;
    border-radius: 10px;
    font-size: 17px;
}

.estadistica-card span {
    display: block;
    overflow: hidden;
    color: var(--caja-texto-suave);
    font-size: 8.5px;
    font-weight: 800;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.estadistica-card strong {
    display: block;
    margin: 1px 0;
    color: var(--caja-texto);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.05;
}

.estadistica-card small {
    display: block;
    color: var(--caja-texto-suave);
    font-size: 8.5px;
}

.estadistica-pendiente .estadistica-icono {
    background-color: #fff3d6;
    color: #a36a00;
}

.estadistica-pedido .estadistica-icono {
    background-color: var(--caja-azul-claro);
    color: var(--caja-azul);
}

.estadistica-reserva .estadistica-icono {
    background-color: var(--caja-morado-claro);
    color: var(--caja-morado);
}

.estadistica-aprobado .estadistica-icono {
    background-color: var(--caja-verde-claro);
    color: var(--caja-verde);
}

.estadistica-rechazado .estadistica-icono {
    background-color: var(--caja-rojo-claro);
    color: var(--caja-rojo);
}

.caja-seccion {
    margin-top: 8px;
}

.seccion-titulo {
    margin-bottom: 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.seccion-titulo span {
    display: block;
    color: var(--caja-rojo);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.seccion-titulo h2 {
    margin: 2px 0 0;
    color: var(--caja-texto);
    font-family: "Merriweather", serif;
    font-size: 18px;
}

.acciones-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px;
}

.accion-card {
    min-width: 0;
    padding: 16px;
    display: flex;
    gap: 13px;
    border: 1px solid var(--caja-borde);
    border-radius: 13px;
    background-color: var(--caja-blanco);
    color: var(--caja-texto);
    text-decoration: none;
    box-shadow: var(--caja-sombra);
    transition:
        border-color 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.accion-card:hover {
    border-color: #ceb9aa;
    color: var(--caja-texto);
    transform: translateY(-2px);
    box-shadow: 0 11px 26px rgba(59, 42, 34, 0.1);
}

.accion-icono {
    width: 45px;
    height: 45px;
    display: grid;
    flex: 0 0 45px;
    place-items: center;
    border-radius: 11px;
    font-size: 19px;
}

.accion-pedidos {
    background-color: var(--caja-azul-claro);
    color: var(--caja-azul);
}

.accion-presenciales {
    background-color: #fff3d6;
    color: #9b6800;
}

.accion-reservas {
    background-color: var(--caja-morado-claro);
    color: var(--caja-morado);
}

.accion-notas {
    background-color: var(--caja-verde-claro);
    color: var(--caja-verde);
}

.accion-contenido {
    min-width: 0;
    flex: 1;
}

.accion-categoria {
    display: block;
    margin-bottom: 2px;
    color: var(--caja-rojo);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

.accion-contenido h3 {
    margin: 0 0 4px;
    color: var(--caja-texto);
    font-size: 14px;
    font-weight: 800;
}

.accion-contenido p {
    margin: 0;
    color: var(--caja-texto-suave);
    font-size: 10px;
    line-height: 1.45;
}

.accion-inferior {
    margin-top: 11px;
    padding-top: 9px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--caja-borde);
    color: var(--caja-texto-suave);
    font-size: 9px;
}

.accion-inferior strong {
    color: var(--caja-rojo);
    font-size: 12px;
}

.accion-inferior > i {
    color: var(--caja-rojo);
    font-size: 14px;
    transition: transform 0.2s ease;
}

.accion-card:hover .accion-inferior > i {
    transform: translateX(3px);
}

.caja-ayuda {
    margin-top: 17px;
    padding: 13px 15px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    border: 1px solid #ead9a7;
    border-radius: 11px;
    background-color: #fff8e5;
}

.ayuda-icono {
    width: 32px;
    height: 32px;
    display: grid;
    flex: 0 0 32px;
    place-items: center;
    border-radius: 8px;
    background-color: var(--caja-dorado);
    color: var(--caja-texto);
    font-size: 14px;
}

.caja-ayuda strong {
    display: block;
    color: var(--caja-texto);
    font-size: 11px;
}

.caja-ayuda p {
    margin: 2px 0 0;
    color: #74623c;
    font-size: 9.5px;
    line-height: 1.45;
}

.caja-boton {
    min-height: 36px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;
    border-radius: 8px;
    background-color: var(--caja-dorado);
    color: var(--caja-texto);
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
}

.caja-boton:hover {
    background-color: #e0ad22;
    color: var(--caja-texto);
}

.caja-boton-secundario {
    border: 1px solid var(--caja-borde);
    background-color: var(--caja-blanco);
    color: var(--caja-texto);
}

.alert {
    padding: 10px 13px;
    border-radius: 9px;
    font-size: 11px;
}

.caja-tabla-contenedor {
    overflow: hidden;
    border: 1px solid var(--caja-borde);
    border-radius: 14px;
    background-color: var(--caja-blanco);
    box-shadow: var(--caja-sombra);
}

.caja-tabla-cabecera {
    padding: 17px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    border-bottom: 1px solid var(--caja-borde);
}

.caja-tabla-cabecera h2 {
    margin: 0 0 3px;
    font-family: "Merriweather", serif;
    font-size: 16px;
}

.caja-tabla-cabecera p {
    margin: 0;
    color: var(--caja-texto-suave);
    font-size: 10px;
}

.caja-tabla {
    width: 100%;
    margin: 0;
    font-size: 10.5px;
}

.caja-tabla th {
    padding: 10px 12px;
    border-bottom: 1px solid var(--caja-borde);
    background-color: #fbf8f3;
    color: var(--caja-texto-suave);
    font-size: 8.5px;
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
}

.caja-tabla td {
    padding: 11px 12px;
    vertical-align: middle;
    border-color: var(--caja-borde);
}

.caja-vacio {
    padding: 50px 20px;
    text-align: center;
}

.caja-vacio > i {
    color: #c7ad9c;
    font-size: 36px;
}

.caja-vacio h3 {
    margin: 12px 0 5px;
    font-family: "Merriweather", serif;
    font-size: 15px;
}

.caja-vacio p {
    margin: 0;
    color: var(--caja-texto-suave);
    font-size: 10px;
}

.caja-formulario {
    padding: 20px;
    border: 1px solid var(--caja-borde);
    border-radius: 14px;
    background-color: var(--caja-blanco);
    box-shadow: var(--caja-sombra);
}

.caja-formulario .form-label {
    margin-bottom: 4px;
    font-size: 10.5px;
    font-weight: 800;
}

.caja-formulario .form-control,
.caja-formulario .form-select {
    min-height: 38px;
    border-color: var(--caja-borde);
    font-size: 10.5px;
}

.caja-formulario .form-control:focus,
.caja-formulario .form-select:focus {
    border-color: var(--caja-dorado);
    box-shadow: 0 0 0 0.15rem rgba(212, 160, 23, 0.14);
}

@media (max-width: 1200px) {
    .caja-estadisticas {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 991px) {
    .caja-layout {
        grid-template-columns: 74px minmax(0, 1fr);
    }

    .caja-sidebar {
        width: 74px;
        padding-right: 10px;
        padding-left: 10px;
    }

    .sidebar-marca {
        justify-content: center;
        padding-right: 0;
        padding-left: 0;
    }

    .sidebar-marca > div:last-child,
    .sidebar-enlace > span:not(.menu-contador),
    .sidebar-usuario .usuario-informacion {
        display: none;
    }

    .sidebar-enlace {
        justify-content: center;
        padding: 0;
    }

    .sidebar-enlace > i {
        width: auto;
        flex: initial;
    }

    .menu-contador {
        position: absolute;
        top: 2px;
        right: 2px;
        font-size: 8px;
    }

    .sidebar-usuario {
        justify-content: center;
    }

    .sidebar-cerrar-sesion,
    .sidebar-salir button {
        font-size: 0;
    }

    .sidebar-cerrar-sesion i,
    .sidebar-salir button i {
        font-size: 16px;
    }

    .caja-principal,
    .caja-contenido {
        padding: 24px 20px 38px;
    }

    .caja-encabezado {
        align-items: stretch;
        flex-direction: column;
    }

    .encabezado-fecha {
        min-width: 0;
    }
}

@media (max-width: 767px) {
    .caja-estadisticas {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .acciones-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 575px) {
    .caja-layout {
        display: block;
    }

    .caja-sidebar {
        position: static;
        width: 100%;
        height: auto;
        padding: 12px;
    }

    .sidebar-marca {
        justify-content: flex-start;
        padding: 0 0 10px;
    }

    .sidebar-marca > div:last-child {
        display: block;
    }

    .sidebar-menu {
        margin-top: 10px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 4px;
    }

    .sidebar-enlace {
        min-height: 53px;
        padding: 6px 3px;
        flex-direction: column;
        justify-content: center;
        gap: 2px;
        text-align: center;
    }

    .sidebar-enlace > span:not(.menu-contador) {
        display: block;
        flex: initial;
        font-size: 8px;
        line-height: 1.2;
    }

    .sidebar-enlace:hover {
        transform: none;
    }

    .menu-contador {
        display: none;
    }

    .sidebar-pie,
    .sidebar-usuario,
    .sidebar-logout-form,
    .sidebar-salir {
        display: none;
    }

    .caja-principal,
    .caja-contenido {
        padding: 20px 12px 35px;
    }

    .caja-encabezado h1 {
        font-size: 24px;
    }

    .caja-estadisticas {
        grid-template-columns: 1fr;
    }

    .accion-card {
        padding: 14px;
    }

    .accion-icono {
        width: 40px;
        height: 40px;
        flex-basis: 40px;
        font-size: 17px;
    }

    .caja-tabla-cabecera {
        align-items: flex-start;
        flex-direction: column;
    }
}
