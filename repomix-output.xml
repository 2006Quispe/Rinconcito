                fuenteNegrita
        );

        lienzo.y -= 18;

        if (esDelivery(pedido)) {

            if (pedido.getDireccion() != null) {

                String direccion =
                        valor(
                                pedido.getDireccion().getDireccion(),
                                "-"
                        );

                String distrito =
                        valor(
                                pedido.getDireccion().getDistrito(),
                                "-"
                        );

                lienzo.texto(
                        "Dirección: "
                                + recortar(
