    font-size: 0.78rem;
    line-height: 1.45;
}

.pedido-usuario {
    padding: 0.52rem 0.85rem;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.42rem;
    border: 1px solid var(--mesero-borde);
    border-radius: 24px;
    background-color: var(--mesero-blanco);
    color: var(--mesero-cafe);
    font-size: 0.72rem;
    font-weight: 800;
    box-shadow: 0 4px 14px rgba(59, 42, 34, 0.06);
}

.pedido-usuario i {
    color: var(--mesero-vino);
    font-size: 0.95rem;
}

.mesero-contenido {
