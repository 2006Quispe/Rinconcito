    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
}

.pedido-seccion-icono {
    width: 38px;
    height: 38px;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    border-radius: 10px;
    background-color: #f3e2d8;
    color: var(--mesero-vino);
    font-size: 0.95rem;
}

.pedido-seccion-encabezado h2 {
