<file path="src/main/resources/static/css/estilos.css">
:root {
    --vino: #741f18;
    --vino-claro: #913126;
    --vino-oscuro: #48130f;
    --terracota: #a94731;
    --cafe: #2e211c;
    --arena: #e9d8c0;
    --crema: #f3e9dc;
    --crema-claro: #faf5ee;
    --oliva: #667354;
    --oliva-oscuro: #4f5b40;
    --dorado: #c69a35;
    --blanco: #ffffff;
    --texto-suave: #745f55;
    --borde: rgba(116, 31, 24, 0.16);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background-color: var(--crema);
    color: var(--cafe);
    font-family: "Nunito", sans-serif;
}

/* Header público */

.header-publico {
    position: sticky;
    top: 0;
    z-index: 1100;
    min-height: 58px;
    padding: 0;
    background-color: var(--crema-claro);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 14px rgba(46, 33, 28, 0.16);
}

.header-publico .container {
    min-height: 58px;
}

.marca-publica {
    min-width: 0;
    padding: 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: var(--cafe) !important;
    line-height: 1;
    text-decoration: none;
}

.marca-nombre {
    max-width: 360px;
    overflow: hidden;
    font-family: "Playfair Display", serif;
    font-size: 1.03rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.marca-publica small {
    margin-top: 0.27rem;
    color: var(--vino);
    font-size: 0.43rem;
    font-weight: 800;
    letter-spacing: 0.3em;
}

.header-publico .nav-link {
    position: relative;
    margin: 0 0.04rem;
    padding: 0.5rem 0.55rem !important;
    color: var(--cafe);
    font-size: 0.68rem;
    font-weight: 700;
    transition:
        color 0.2s ease,
        background-color 0.2s ease;
}

.header-publico .nav-link::after {
    position: absolute;
    right: 0.55rem;
    bottom: 0.22rem;
    left: 0.55rem;
    height: 2px;
    content: "";
    background-color: var(--dorado);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
}

.header-publico .nav-link:hover,
.header-publico .nav-link:focus {
    color: var(--vino);
}

.header-publico .nav-link:hover::after,
.header-publico .nav-link:focus::after {
    transform: scaleX(1);
}

.header-publico .navbar-toggler {
    padding: 0.25rem 0.4rem;
    border-color: var(--cafe);
    box-shadow: none;
}

.header-publico .navbar-toggler-icon {
    width: 1.15rem;
    height: 1.15rem;
    filter: invert(1);
}

.btn-ingresar,
.btn-cuenta,
.btn-salir {
    min-height: 32px;
    padding: 0.36rem 0.62rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.32rem;
    border-radius: 7px;
    font-size: 0.62rem;
    font-weight: 800;
    transition: 0.2s ease;
}

.btn-ingresar,
.btn-cuenta {
    color: var(--vino);
    background-color: transparent;
    border: 1px solid var(--vino);
}

.btn-ingresar:hover,
.btn-cuenta:hover {
    color: var(--vino);
    background-color: var(--crema);
    border-color: var(--crema);
}

.btn-salir {
    color: var(--crema);
    background-color: transparent;
    border: 1px solid rgba(233, 216, 192, 0.55);
}

.btn-salir:hover {
    color: var(--vino);
    background-color: var(--crema);
    border-color: var(--crema);
}

/* Inicio */

.inicio-publico {
    overflow: hidden;
}

.inicio-hero {
    position: relative;
    min-height: 450px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: 
        linear-gradient(
            rgba(66, 18, 15, 0.25), 
            rgba(66, 18, 15, 0.25)
        ), 
        url('../img/fondo-inicio.png') center / cover no-repeat !important;
}

.inicio-hero::before {
    display: none !important;
}

.hero-luz-uno,
.hero-luz-dos {
    display: none !important;
}

.inicio-hero::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
        linear-gradient(
            90deg,
            rgba(24, 10, 8, 0.27),
            transparent 53%
        );
}

.hero-luz {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
}

.hero-luz-uno {
    top: -150px;
    right: 27%;
    width: 330px;
    height: 330px;
    background-color: rgba(216, 116, 76, 0.1);
}

.hero-luz-dos {
    right: -120px;
    bottom: -160px;
    width: 380px;
    height: 380px;
    background-color: rgba(198, 154, 53, 0.08);
}

.hero-contenedor {
    position: relative;
    z-index: 2;
    padding-top: 2.25rem;
    padding-bottom: 2.25rem;
}

.hero-informacion {
    max-width: 540px;
}

.hero-etiqueta {
    margin: 0 0 0.65rem;
    color: var(--dorado);
    font-size: 0.57rem;
    font-weight: 800;
    letter-spacing: 0.19em;
}

.hero-informacion h1 {
    margin: 0;
    color: var(--crema-claro);
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.025em;
}

.hero-informacion h1 span {
    display: block;
    color: var(--arena);
}

.hero-descripcion {
    max-width: 520px;
    margin: 0.85rem 0 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.78rem;
    line-height: 1.55;
}

.hero-acciones {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
}

.btn-hero-principal {
    min-height: 39px;
    padding: 0.55rem 0.82rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid var(--dorado);
    border-radius: 7px;
    background-color: var(--dorado);
    color: var(--cafe);
    font-size: 0.69rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 7px 17px rgba(23, 10, 7, 0.18);
    transition: 0.2s ease;
}

.btn-hero-principal:hover {
    border-color: #d7ad4d;
    background-color: #d7ad4d;
    color: var(--cafe);
    transform: translateY(-2px);
}

.btn-hero-secundario {
    min-height: 39px;
    padding: 0.5rem 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid var(--dorado);
    color: var(--crema);
    font-size: 0.69rem;
    font-weight: 700;
    text-decoration: none;
    transition: 0.2s ease;
}

.btn-hero-secundario:hover {
    color: var(--dorado);
    transform: translateX(3px);
}

.hero-beneficios {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.85rem;
}

.hero-beneficios div {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.57rem;
    font-weight: 600;
}

.hero-beneficios i {
    color: var(--dorado);
    font-size: 0.62rem;
}

/* Carrusel */

.hero-carrusel-contenedor {
    position: relative;
    height: 345px;
    min-height: 345px;
}

#carruselPlatos {
    height: 345px;
}

#carruselPlatos .carousel-inner,
#carruselPlatos .carousel-item {
    height: 100%;
}

.plato-presentacion {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.plato-destello {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 275px;
    height: 275px;
    border: 1px solid rgba(233, 216, 192, 0.13);
    border-radius: 50%;
    background:
        radial-gradient(
            circle,
            rgba(255, 241, 218, 0.13),
            rgba(255, 241, 218, 0.025) 55%,
            transparent 70%
        );
    transform: translate(-50%, -50%);
}

.plato-destello::before,
.plato-destello::after {
    position: absolute;
    inset: 30px;
    border: 1px solid rgba(198, 154, 53, 0.1);
    border-radius: 50%;
    content: "";
}

.plato-destello::after {
    inset: 65px;
}

.plato-flotante {
    position: relative;
    z-index: 3;
    width: min(86%, 455px);
    max-height: 270px;
    object-fit: contain;
    filter:
        drop-shadow(0 18px 18px rgba(22, 8, 6, 0.3))
        drop-shadow(0 4px 6px rgba(22, 8, 6, 0.2));
    animation: platoFlotante 3.4s ease-in-out infinite;
}

.plato-sombra {
    position: absolute;
    z-index: 1;
    right: 22%;
    bottom: 62px;
    left: 22%;
    height: 24px;
    border-radius: 50%;
    background-color: rgba(20, 8, 6, 0.35);
    filter: blur(11px);
    animation: sombraFlotante 3.4s ease-in-out infinite;
}

.plato-etiqueta {
    position: absolute;
    right: 50%;
    bottom: 21px;
    z-index: 5;
    min-width: 170px;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgba(198, 154, 53, 0.7);
    border-radius: 30px;
    background-color: rgba(38, 16, 12, 0.75);
    color: var(--crema);
    text-align: center;
    backdrop-filter: blur(8px);
    transform: translateX(50%);
}

.plato-etiqueta small {
    display: block;
    margin-bottom: 0.02rem;
    color: var(--dorado);
    font-size: 0.45rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.plato-etiqueta strong {
    display: block;
    font-size: 0.6rem;
}

#carruselPlatos .carousel-control-prev,
#carruselPlatos .carousel-control-next {
    z-index: 7;
    width: 42px;
    opacity: 1;
}

#carruselPlatos .carousel-control-prev {
    left: 0;
}

#carruselPlatos .carousel-control-next {
    right: 0;
}

.control-carrusel {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(198, 154, 53, 0.8);
    border-radius: 50%;
    background-color: rgba(58, 21, 15, 0.72);
    color: var(--crema);
    font-size: 0.69rem;
    backdrop-filter: blur(7px);
    transition: 0.2s ease;
}

.control-carrusel:hover {
    background-color: var(--dorado);
    color: var(--cafe);
}

#carruselPlatos .carousel-indicators {
    bottom: 0;
    z-index: 8;
    margin-bottom: 0;
}

#carruselPlatos .carousel-indicators button {
    width: 6px;
    height: 6px;
    margin: 0 3px;
    border: 0;
    border-radius: 50%;
    background-color: var(--crema);
    opacity: 0.5;
}

#carruselPlatos .carousel-indicators button.active {
    width: 18px;
    border-radius: 8px;
    background-color: var(--dorado);
    opacity: 1;
}

.reservas-disponibles {
    position: absolute;
    right: 0.4rem;
    bottom: -0.65rem;
    z-index: 10;
    min-width: 210px;
    padding: 0.55rem 0.65rem;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 26px;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(198, 154, 53, 0.3);
    border-radius: 9px;
    background-color: rgba(243, 233, 220, 0.96);
    box-shadow: 0 9px 22px rgba(34, 13, 9, 0.21);
    backdrop-filter: blur(10px);
}

.reservas-icono {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    background-color: rgba(198, 154, 53, 0.16);
    color: #9a721b;
    font-size: 0.8rem;
}

.reservas-disponibles strong,
.reservas-disponibles span {
    display: block;
}

.reservas-disponibles strong {
    color: var(--cafe);
    font-size: 0.58rem;
}

.reservas-disponibles span {
    margin-top: 0.03rem;
    color: var(--texto-suave);
    font-size: 0.51rem;
}

.reservas-disponibles > a {
    width: 25px;
    height: 25px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--vino);
    font-size: 0.65rem;
    text-decoration: none;
    transition: 0.2s ease;
}

.reservas-disponibles > a:hover {
    background-color: var(--vino);
    color: var(--crema);
}

@keyframes platoFlotante {
    0%,
    100% {
        transform: translateY(5px);
    }

    50% {
        transform: translateY(-9px);
    }
}

@keyframes sombraFlotante {
    0%,
    100% {
        opacity: 0.78;
        transform: scaleX(1);
    }

    50% {
        opacity: 0.42;
        transform: scaleX(0.84);
    }
}

/* Experiencia */

.experiencia-inicio {
    padding: 2.25rem 0 2.8rem;
    background-color: var(--crema);
}

.experiencia-encabezado {
    max-width: 600px;
    margin: 0 auto 1.25rem;
    text-align: center;
}

.experiencia-encabezado > p {
    margin: 0 0 0.25rem;
    color: var(--dorado);
    font-size: 0.53rem;
    font-weight: 800;
    letter-spacing: 0.17em;
}

.experiencia-encabezado h2 {
    margin: 0;
    color: var(--cafe);
    font-family: "Playfair Display", serif;
