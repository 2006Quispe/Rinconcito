                                        + " - "
                                        + distrito,
                                76
                        ),
                        MARGEN,
                        lienzo.y,
                        10,
                        fuenteNormal
                );

                lienzo.y -= 17;

                String referencia =
                        valor(
                                pedido.getDireccion().getReferencia(),
                                "Sin referencia"
                        );

                lienzo.texto(
                        "Referencia: "
                                + recortar(referencia, 75),
