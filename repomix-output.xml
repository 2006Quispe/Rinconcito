                    <div class="pedido-resumen-separador"></div>

                    <div class="pedido-resumen-total">

                        <span>Total de productos</span>

                        <strong th:text="'S/ ' + ${subtotal}">
                            S/ 0
                        </strong>
                    </div>

                    <div class="pedido-metodos-pago">

                        <span>Pago disponible mediante</span>

                        <div>
                            <strong class="pago-yape">
                                Yape
                            </strong>

                            <strong class="pago-plin">
                                Plin
                            </strong>

                            <strong class="pago-transferencia">
                                Transferencia
                            </strong>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </section>
</main>

<footer th:replace="~{fragments/footer :: footer}"></footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const formularioPedido =
            document.getElementById("formularioPedido");

        const tipoDelivery =
            document.getElementById("tipoDelivery");

        const tipoRecojo =
            document.getElementById("tipoRecojo");

        const seccionInformacionPersonal =
            document.getElementById("seccionInformacionPersonal");

        const seccionDireccion =
            document.getElementById("seccionDireccion");

        const camposDireccion =
            document.querySelectorAll(".campo-direccion");

        const avisoDelivery =
            document.getElementById("avisoDelivery");

        const avisoRecojo =
            document.getElementById("avisoRecojo");

        const resumenModalidad =
            document.getElementById("resumenModalidad");

        const filaServicio =
            document.getElementById("filaServicio");

        const clienteLogueado =
            formularioPedido &&
            formularioPedido.dataset.clienteLogueado === "true";

        function actualizarModalidad() {

            const esDelivery =
                tipoDelivery && tipoDelivery.checked;

            /*
             * La dirección solo aparece cuando el pedido
             * será enviado por delivery.
             */
            if (seccionDireccion) {
                seccionDireccion.style.display =
                    esDelivery ? "block" : "none";
            }

            /*
             * La información personal se mantiene visible para
             * invitados. Si el cliente inició sesión y selecciona
             * recojo, se oculta porque sus datos ya están registrados.
             */
            if (seccionInformacionPersonal) {
                seccionInformacionPersonal.style.display =
                    !esDelivery && clienteLogueado
                        ? "none"
                        : "block";
            }

            /*
             * Los campos de dirección solamente son obligatorios
             * para delivery.
             */
            camposDireccion.forEach(function (campo) {

                campo.required = esDelivery;

                if (!esDelivery) {
                    campo.setCustomValidity("");
                }
            });

            if (avisoDelivery) {
                avisoDelivery.style.display =
                    esDelivery ? "flex" : "none";
            }

            if (avisoRecojo) {
                avisoRecojo.style.display =
                    esDelivery ? "none" : "flex";
            }

            if (resumenModalidad) {
                resumenModalidad.textContent =
                    esDelivery
                        ? "Delivery"
                        : "Recojo en local";
            }

            if (filaServicio) {
                filaServicio.style.display =
                    esDelivery ? "flex" : "none";
            }
        }

        if (tipoDelivery) {
            tipoDelivery.addEventListener(
                "change",
                actualizarModalidad
            );
        }

        if (tipoRecojo) {
            tipoRecojo.addEventListener(
                "change",
                actualizarModalidad
            );
        }

        actualizarModalidad();
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const camposSoloLetras = [
            document.getElementById("nombres"),
            document.getElementById("apellidos"),
            document.getElementById("distrito")
        ];

        camposSoloLetras.forEach(function (campo) {

            if (!campo) {
                return;
            }

            campo.addEventListener("input", function () {

                this.value = this.value
                    .replace(/[^\p{L}\s'-]/gu, "")
                    .replace(/\s{2,}/g, " ");
            });
        });

        const dni =
            document.getElementById("dni");

        if (dni) {
            dni.addEventListener("input", function () {

                this.value = this.value
                    .replace(/\D/g, "")
                    .slice(0, 8);
            });
        }

        const telefono =
            document.getElementById("telefono");

        if (telefono) {
            telefono.addEventListener("input", function () {

                this.value = this.value
                    .replace(/\D/g, "")
                    .slice(0, 9);
            });
        }
    });
</script>
</body>
</html>
